{
  "schemaVersion": 1,
  "stateRef": "refs/heads/automation/upstream-adoption-state",
  "rulesets": [
    {
      "name": "Mint main finalization",
      "target": "branch",
      "include": ["~DEFAULT_BRANCH"],
      "rules": [
        {
          "type": "pull_request",
          "parameters": {
            "allowed_merge_methods": ["merge", "squash", "rebase"],
            "dismiss_stale_reviews_on_push": true,
            "require_code_owner_review": false,
            "require_last_push_approval": true,
            "required_approving_review_count": 1,
            "required_review_thread_resolution": true
          }
        },
        {"type": "non_fast_forward"}
      ],
      "bypass": [{"actor": "Mint State Finalizer", "mode": "always"}]
    },
    {
      "name": "Mint adoption state",
      "target": "branch",
      "include": ["refs/heads/automation/upstream-adoption-state"],
      "rules": [
        {"type": "deletion"},
        {"type": "non_fast_forward"},
        {
          "type": "pull_request",
          "parameters": {
            "allowed_merge_methods": ["squash"],
            "dismiss_stale_reviews_on_push": true,
            "require_code_owner_review": false,
            "require_last_push_approval": true,
            "required_approving_review_count": 1,
            "required_review_thread_resolution": true
          }
        }
      ],
      "bypass": [{"actor": "Mint State Finalizer", "mode": "always"}]
    },
    {
      "name": "Mint adoption candidates",
      "target": "branch",
      "include": ["refs/heads/automation/adopt/*"],
      "rules": [{"type": "deletion"}, {"type": "non_fast_forward"}],
      "bypass": [{"actor": "Mint Adoption Controller", "mode": "always"}]
    },
    {
      "name": "Mint desktop tag creation",
      "target": "tag",
      "include": ["refs/tags/desktop-v*"],
      "rules": [{"type": "creation"}],
      "bypass": [
        {"actor": "Mint State Finalizer", "mode": "always"},
        {"actor": "RepositoryRole:maintain", "mode": "always"}
      ]
    },
    {
      "name": "Mint desktop tag immutability",
      "target": "tag",
      "include": ["refs/tags/desktop-v*"],
      "rules": [{"type": "update"}, {"type": "deletion"}, {"type": "non_fast_forward"}],
      "bypass": []
    }
  ]
}
