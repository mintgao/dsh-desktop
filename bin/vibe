SECRET_PATTERNS = (
    re.compile(r"-----BEGIN (?:RSA |EC |OPENSSH )?PRIVATE KEY-----", re.IGNORECASE),
    re.compile(r"\b(?:gh[pousr]_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,})\b"),
    re.compile(r"\bglpat-[A-Za-z0-9_-]{20,}\b"),
    re.compile(r"\b(?:AKIA|ASIA|AIDA|AROA|AIPA|ANPA|ANVA|ASCA)[A-Z0-9]{16}\b"),
    re.compile(r"\b(?:sk|rk)_(?:live|test)_[A-Za-z0-9]{16,}\b"),
    re.compile(r"\bxox[baprs]-[A-Za-z0-9-]{10,}\b"),
    re.compile(r"\bnpm_[A-Za-z0-9]{36,}\b"),
    re.compile(r"\bpypi-[A-Za-z0-9_-]{40,}\b"),
    re.compile(r"\bAIza[0-9A-Za-z_-]{35}\b"),
    re.compile(r"\bSG\.[A-Za-z0-9_-]{16,}\.[A-Za-z0-9_-]{16,}\b"),
    re.compile(r"\bSK[0-9a-fA-F]{32}\b"),
    re.compile(
        r"\beyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}\b"
    ),
    re.compile(r"\bsk-[A-Za-z0-9_-]{16,}\b"),
    re.compile(
        r"\b(?:authorization|api[_ -]?key|access[_ -]?token|password|secret)"
        r"\s*[:=]\s*\S+",
        re.IGNORECASE,
    ),
)


def contains_secret(value: str) -> bool:
    return any(pattern.search(value) is not None for pattern in SECRET_PATTERNS)


class VibeError(RuntimeError):
    """A user-facing CLI error."""

    def __init__(
        self,
        message: str,
        code: str = "operation_error",
        write_state: str = "none",
        recovery: Optional[Dict[str, object]] = None,
    ) -> None:
        super().__init__(message)
        self.code = code
        if write_state not in WRITE_STATES:
            raise ValueError(f"unknown write state: {write_state}")
        self.write_state = write_state
        self.recovery = recovery


class RemoteFeedbackError(RuntimeError):
    """A recoverable remote feedback operation failure."""


def source_root() -> Path:
    return Path(__file__).resolve().parent.parent


def framework_version(root: Path) -> str:
    path = root / ".vibe/core/version"
    if not path.is_file():
        raise VibeError(f"Framework version is missing: {path}")
    return path.read_text(encoding="utf-8").strip()


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def sha256_text(text: str) -> str:
    return hashlib.sha256(text.encode("utf-8")).hexdigest()


def atomic_write_text(path: Path, content: str, mode: Optional[int] = None) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile(
        "w", encoding="utf-8", dir=str(path.parent), delete=False
    ) as handle:
        handle.write(content)
        temporary = Path(handle.name)
    if mode is not None:
        os.chmod(temporary, mode)
    os.replace(temporary, path)


def atomic_write_bytes(path: Path, content: bytes, mode: Optional[int] = None) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile("wb", dir=str(path.parent), delete=False) as handle:
        handle.write(content)
        temporary = Path(handle.name)
    if mode is not None:
        os.chmod(temporary, mode)
    os.replace(temporary, path)


def atomic_copy(source: Path, target: Path) -> None:
    if source.resolve() == target.resolve():
        return
    target.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile("wb", dir=str(target.parent), delete=False) as handle:
        temporary = Path(handle.name)
        with source.open("rb") as incoming:
            shutil.copyfileobj(incoming, handle)
    shutil.copymode(source, temporary)
    os.replace(temporary, target)


def atomic_write_json(path: Path, value: object) -> None:
    atomic_write_text(
        path,
        json.dumps(value, ensure_ascii=False, indent=2, sort_keys=True) + "\n",
    )


def print_json(value: object) -> None:
    print(json.dumps(value, ensure_ascii=False, sort_keys=True))


def result_envelope(command: str, status: str, **values: object) -> Dict[str, object]:
    allowed_statuses = AGENT_COMMAND_STATUSES.get(command)
    if allowed_statuses is not None and status not in allowed_statuses:
        raise ValueError(f"unknown {command} result status: {status}")
    result: Dict[str, object] = {
        "schema_version": AGENT_RESULT_SCHEMA,
        "command": command,
        "status": status,
    }
    result.update(values)
    return result


def writes_performed(write_state: str) -> bool:
    if write_state not in WRITE_STATES:
        raise ValueError(f"unknown write state: {write_state}")
    return write_state != "none"


def mutation_recovery(target: Path) -> Dict[str, object]:
    return {
        "action": "inspect-before-retry",
        "target": str(target),
        "steps": [
            "Inspect the scoped Vibe Kit paths and preserve any conflict evidence.",
            f"Run {target / 'bin/vibe'} doctor {target} when the installed CLI is runnable.",
            "Recover with Git or the same selected trusted payload; do not blindly retry.",
        ],
    }


def mutation_filesystem_error(
    operation: str, target: Path, error: BaseException
) -> VibeError:
    return VibeError(
        f"{operation} encountered a filesystem error after project mutation began: {error}",
        "filesystem_error",
        "unknown-partial",
        mutation_recovery(target),
    )


def validate_source_provenance(
    source_type: str,
    source_ref: Optional[str],
    artifact_sha256: Optional[str],
    version: str,
) -> Dict[str, object]:
    if source_type not in SOURCE_TYPES:
        raise VibeError(
            f"source type must be one of {', '.join(SOURCE_TYPES)}",
            "invalid_source_type",
        )
    normalized_ref = source_ref.strip() if source_ref is not None else None
    normalized_digest = (
        artifact_sha256.strip().lower() if artifact_sha256 is not None else None
    )
    if source_ref is not None and not normalized_ref:
        raise VibeError("source ref must not be empty", "invalid_source_ref")
    if artifact_sha256 is not None and not re.fullmatch(
        r"[0-9a-f]{64}", normalized_digest or ""
    ):
        raise VibeError(
            "artifact SHA-256 must contain exactly 64 hexadecimal characters",
            "invalid_artifact_sha256",
        )
    exact_ref = False
    if normalized_ref is not None:
        exact_ref = bool(
            re.fullmatch(r"[0-9a-fA-F]{40,64}", normalized_ref)
            or re.fullmatch(r"v?\d+\.\d+\.\d+", normalized_ref)
            or re.fullmatch(
                r"https://github\.com/mintgao/vibe-kit/(?:releases/tag|tree)/v?\d+\.\d+\.\d+/?",
                normalized_ref,
            )
        )
        if not exact_ref:
            raise VibeError(
                "source ref must be an exact SemVer tag, canonical Release/tag URL, or commit digest",
                "invalid_source_ref",
            )
        ref_version_match = re.search(r"v?(\d+\.\d+\.\d+)/?$", normalized_ref)
        if ref_version_match and ref_version_match.group(1) != version:
            raise VibeError(
                f"source ref version {ref_version_match.group(1)} does not match payload version {version}",
                "source_version_mismatch",
            )
    if source_type in ("github-release", "offline-bundle"):
        if normalized_ref is None:
            raise VibeError(
                f"{source_type} requires an exact source ref",
                "missing_source_ref",
            )
        if normalized_digest is None:
            raise VibeError(
                f"{source_type} requires the verified artifact SHA-256",
                "missing_artifact_sha256",
            )
    if source_type == "plugin-bundled" and normalized_ref is None:
        normalized_ref = version
    return {
        "type": source_type,
        "ref": normalized_ref,
        "artifact_sha256": normalized_digest,
        "payload_tree_sha256": payload_tree_sha256(source_root()),
    }


def is_iso8601(value: object) -> bool:
    if not isinstance(value, str) or not value.strip():
        return False
    candidate = value.strip()
    try:
        dt.datetime.fromisoformat(candidate.replace("Z", "+00:00"))
        return True
    except ValueError:
        try:
            dt.date.fromisoformat(candidate)
            return True
        except ValueError:
            return False


def onboarding_readiness(target: Path) -> Tuple[str, List[str]]:
    path = target / ONBOARDING_PATH
    if not path.is_file():
        return "review-required", [
            "onboarding state is missing; review repository context before substantive work"
        ]
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, UnicodeError, json.JSONDecodeError) as error:
        raise VibeError(
            f"invalid onboarding state {path}: {error}",
            "invalid_onboarding_state",
        ) from error
    if not isinstance(value, dict) or value.get("schema_version") != 1:
        raise VibeError(
            f"invalid onboarding state {path}: expected schema_version 1 object",
            "invalid_onboarding_state",
        )
    status = value.get("status")
    if status not in ONBOARDING_STATUSES:
        raise VibeError(
            f"invalid onboarding status in {path}; expected one of {', '.join(ONBOARDING_STATUSES)}",
            "invalid_onboarding_state",
        )
    if status == "complete":
        evidence = value.get("evidence")
        if not is_iso8601(value.get("updated_at")):
            raise VibeError(
                f"invalid onboarding state {path}: complete requires an ISO-8601 updated_at value",
                "invalid_onboarding_state",
            )
        if not isinstance(evidence, list) or not evidence or any(
            not isinstance(item, str) or not item.strip() for item in evidence
        ):
            raise VibeError(
                f"invalid onboarding state {path}: complete requires a non-empty string list of evidence paths",
                "invalid_onboarding_state",
            )
    return str(status), []


def onboarding_result(target: Path) -> Dict[str, object]:
    try:
        status, _ = onboarding_readiness(target)
    except VibeError:
        return {"status": "invalid", "kind": "derived"}
    kind = "persisted" if status in ONBOARDING_STATUSES else "derived"
    return {"status": status, "kind": kind}


def managed_source_files(root: Path) -> List[Path]:
    files: List[Path] = []
    for relative in ("AGENT_INSTALL.md", "agent-install.json", "bin/vibe"):
        explicit = root / relative
        if explicit.is_file():
            files.append(explicit)

    core = root / ".vibe/core"
    if core.is_dir():
        files.extend(path for path in core.rglob("*") if path.is_file())

    agents = root / ".codex/agents"
    if agents.is_dir():
        files.extend(path for path in agents.glob("vibe-*.toml") if path.is_file())

    skills = root / ".agents/skills"
    if skills.is_dir():
        for directory in skills.glob("vibe-*"):
            if directory.is_dir():
                files.extend(path for path in directory.rglob("*") if path.is_file())

    unique = {path.relative_to(root): path for path in files}
    return [unique[key] for key in sorted(unique, key=lambda item: item.as_posix())]


def extract_agents_block(text: str) -> Optional[str]:
    start_count = text.count(AGENTS_START)
    end_count = text.count(AGENTS_END)
    if start_count == 0 and end_count == 0:
        return None
    if start_count != 1 or end_count != 1:
        raise VibeError("AGENTS.md has malformed Vibe Kit managed markers.")
    start = text.index(AGENTS_START)
    end = text.index(AGENTS_END, start) + len(AGENTS_END)
    return text[start:end]


def incoming_agents_block(root: Path) -> str:
    source = root / "AGENTS.md"
    if not source.is_file():
        raise VibeError(f"Framework AGENTS.md is missing: {source}")
    block = extract_agents_block(source.read_text(encoding="utf-8"))
    if block is None:
        raise VibeError("Framework AGENTS.md does not contain managed markers.")
    return block


def strict_semver(value: object) -> bool:
    return isinstance(value, str) and re.fullmatch(r"\d+\.\d+\.\d+", value) is not None


def canonical_json_sha256(value: object) -> str:
    encoded = json.dumps(
        value, ensure_ascii=False, sort_keys=True, separators=(",", ":")
    ).encode("utf-8")
    return hashlib.sha256(encoded).hexdigest()


def reject_duplicate_json_keys(pairs: Sequence[Tuple[str, object]]) -> Dict[str, object]:
    result: Dict[str, object] = {}
    for key, value in pairs:
        if key in result:
            raise ValueError("duplicate JSON object key")
        result[key] = value
    return result


def load_json_object_strict(path: Path) -> Dict[str, object]:
    try:
        raw = path.read_bytes()
        text = raw.decode("utf-8")
        value = json.loads(text, object_pairs_hook=reject_duplicate_json_keys)
    except (OSError, UnicodeError, json.JSONDecodeError, ValueError) as error:
        raise VibeError(f"invalid JSON object: {path}") from error
    if not isinstance(value, dict):
        raise VibeError(f"invalid JSON object: {path}")
    return value


def payload_tree_sha256_from_hashes(hashes: Dict[str, str]) -> str:
    digest = hashlib.sha256()
    for relative, file_hash in sorted(hashes.items()):
        digest.update(relative.encode("utf-8"))
        digest.update(b"\0")
        digest.update(file_hash.encode("ascii"))
        digest.update(b"\n")
    return digest.hexdigest()


def payload_tree_sha256(root: Path) -> str:
    version = framework_version(root)
    hashes = {
        path.relative_to(root).as_posix(): sha256(path)
        for path in release_payload_files(root, version)
    }
    return payload_tree_sha256_from_hashes(hashes)


def load_agent_install_contract(root: Path) -> Dict[str, object]:
    path = root / "agent-install.json"
    try:
        return load_json_object_strict(path)
    except VibeError as error:
        raise VibeError(f"Agent-install contract is invalid: {path}") from error


def safe_project_relative_path(relative: object) -> Optional[PurePosixPath]:
    if not isinstance(relative, str) or not relative or "\\" in relative or ":" in relative:
        return None
    value = PurePosixPath(relative)
    if value.is_absolute() or any(part in ("", ".", "..") for part in value.parts):
        return None
    return value


def authenticated_path_state(
    root: Path, relative: str
) -> Tuple[str, Optional[str]]:
    """Return absent/regular/invalid without following a project-internal symlink."""
    value = safe_project_relative_path(relative)
    if value is None:
        return "invalid", None
    components: List[Tuple[Path, Tuple[int, int, int, int, int]]] = []
    current = root
    try:
        for index, part in enumerate(value.parts):
            current = current / part
            metadata = os.lstat(str(current))
            if stat.S_ISLNK(metadata.st_mode):
                return "invalid", None
            leaf = index == len(value.parts) - 1
            if leaf:
                if not stat.S_ISREG(metadata.st_mode):
                    return "invalid", None
            elif not stat.S_ISDIR(metadata.st_mode):
                return "invalid", None
            components.append(
                (
                    current,
                    (
                        metadata.st_mode,
                        metadata.st_dev,
                        metadata.st_ino,
                        metadata.st_size,
                        metadata.st_mtime_ns,
                    ),
                )
            )
    except FileNotFoundError:
        return "absent", None
    except OSError:
        return "invalid", None

    flags = os.O_RDONLY
    if hasattr(os, "O_CLOEXEC"):
        flags |= os.O_CLOEXEC
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    digest = hashlib.sha256()
    try:
        descriptor = os.open(str(current), flags)
        with os.fdopen(descriptor, "rb") as handle:
            opened = os.fstat(handle.fileno())
            if not stat.S_ISREG(opened.st_mode):
                return "invalid", None
            leaf_signature = components[-1][1]
            if (opened.st_mode, opened.st_dev, opened.st_ino, opened.st_size) != (
                leaf_signature[0],
                leaf_signature[1],
                leaf_signature[2],
                leaf_signature[3],
            ):
                return "invalid", None
            for chunk in iter(lambda: handle.read(1024 * 1024), b""):
                digest.update(chunk)
        for path, signature in components:
            metadata = os.lstat(str(path))
            if stat.S_ISLNK(metadata.st_mode) or (
                metadata.st_mode,
                metadata.st_dev,
                metadata.st_ino,
                metadata.st_size,
                metadata.st_mtime_ns,
            ) != signature:
                return "invalid", None
    except OSError:
        return "invalid", None
    return "regular", digest.hexdigest()


def predecessor_migration_evidence(phase: str) -> Dict[str, object]:
    entry = PREDECESSOR_MIGRATION_ENTRY
    predecessor = entry["predecessor"]
    return {
        "schema_version": COMPATIBILITY_MIGRATION_REGISTRY_SCHEMA,
        "migration_id": entry["migration_id"],
        "phase": phase,
        "authentication": "target-cli-compiled-registry",
        "from_version": predecessor["framework_version"],
        "to_version": entry["target"]["framework_version"],
        "paths": list(PREDECESSOR_MIGRATION_PATHS),
        "predecessor_install_identity_sha256": predecessor[
            "install_identity_sha256"
        ],
        "predecessor_contract_set_sha256": "5ae7da78e4799f23056afc16b8b1511384b12db50dfb5209a64e5b465a71b15d",
        "registry_sha256": PREDECESSOR_MIGRATION_REGISTRY_SHA256,
    }


def validate_target_predecessor_migration_contract(root: Path) -> None:
    if framework_version(root) != "0.8.0":
        raise VibeError("predecessor migration is supported only by target 0.8.0")
    contract = load_agent_install_contract(root)
    try:
        protocol = load_json_object_strict(root / ".vibe/core/protocol.json")
    except VibeError as error:
        raise VibeError("target predecessor-migration protocol mirror is invalid") from error
    bridge = contract.get("maintenance_bridge")
    contract_mirror = (
        bridge.get("predecessor_migrations") if isinstance(bridge, dict) else None
    )
    protocol_mirror = protocol.get("predecessor_migrations")
    if (
        PREDECESSOR_MIGRATION_REGISTRY_SHA256
        != EXPECTED_PREDECESSOR_MIGRATION_REGISTRY_SHA256
        or not valid_predecessor_migration_mirror(contract_mirror)
        or not valid_predecessor_migration_mirror(protocol_mirror)
        or contract_mirror != protocol_mirror
    ):
        raise VibeError("target predecessor-migration registry mirror is invalid")


def authenticate_v050_predecessor(target: Path) -> bool:
    entry = PREDECESSOR_MIGRATION_ENTRY
    predecessor = entry["predecessor"]
    try:
        manifest_state, manifest_hash = authenticated_path_state(
            target, MANIFEST_PATH.as_posix()
        )
        installed_state, installed_hash = authenticated_path_state(
            target, INSTALLED_VERSION_PATH.as_posix()
        )
        core_version_state, core_version_hash = authenticated_path_state(
            target, ".vibe/core/version"
        )
        protocol_state, protocol_hash = authenticated_path_state(
            target, ".vibe/core/protocol.json"
        )
        agents_state, agents_hash = authenticated_path_state(target, "AGENTS.md")
        if (
            manifest_state != "regular"
            or installed_state != "regular"
            or core_version_state != "regular"
            or protocol_state != "regular"
            or agents_state != "regular"
        ):
            return False
        manifest = load_json_object_strict(target / MANIFEST_PATH)
        if authenticated_path_state(target, MANIFEST_PATH.as_posix()) != (
            "regular",
            manifest_hash,
        ):
            return False
        if (
            type(manifest.get("schema_version")) is not int
            or manifest.get("schema_version") != predecessor["manifest_schema"]
            or manifest.get("framework_version") != predecessor["framework_version"]
        ):
            return False
        official_version_hash = hashlib.sha256(b"0.5.0\n").hexdigest()
        if installed_hash != official_version_hash or core_version_hash != (
            official_version_hash
        ):
            return False
        managed_files = manifest.get("managed_files")
        agents_block_hash = manifest.get("agents_block_hash")
        if (
            not isinstance(managed_files, dict)
            or not isinstance(agents_block_hash, str)
            or re.fullmatch(r"[0-9a-f]{64}", agents_block_hash) is None
            or any(path in managed_files for path in PREDECESSOR_MIGRATION_PATHS)
        ):
            return False
        normalized_managed: Dict[str, str] = {}
        for relative, expected in managed_files.items():
            if (
                safe_project_relative_path(relative) is None
                or not isinstance(expected, str)
                or re.fullmatch(r"[0-9a-f]{64}", expected) is None
            ):
                return False
            state, actual = authenticated_path_state(target, relative)
            if state != "regular" or actual != expected:
                return False
            normalized_managed[relative] = expected
        if normalized_managed.get(".vibe/core/protocol.json") != protocol_hash:
            return False
        protocol = load_json_object_strict(target / ".vibe/core/protocol.json")
        if authenticated_path_state(target, ".vibe/core/protocol.json") != (
            "regular",
            protocol_hash,
        ):
            return False
        codex = (
            protocol.get("adapters", {}).get("codex", {})
            if isinstance(protocol.get("adapters"), dict)
            else {}
        )
        if (
            protocol.get("manifest_schema") != predecessor["manifest_schema"]
            or protocol.get("core_protocol") != predecessor["core_protocol"]
            or protocol.get("agent_install_protocol")
            != predecessor["agent_install_protocol"]
            or not isinstance(codex, dict)
            or codex.get("version") != predecessor["adapter_protocol"]
            or codex.get("core_protocol") != predecessor["core_protocol"]
        ):
            return False
        agents_text = (target / "AGENTS.md").read_text(encoding="utf-8")
        if authenticated_path_state(target, "AGENTS.md") != (
            "regular",
            agents_hash,
        ):
            return False
        agents_block = extract_agents_block(agents_text)
        if agents_block is None or sha256_text(agents_block) != agents_block_hash:
            return False
        identity = {
            "agents_block_hash": agents_block_hash,
            "framework_version": manifest["framework_version"],
            "managed_files": dict(sorted(normalized_managed.items())),
            "schema_version": manifest["schema_version"],
        }
        if canonical_json_sha256(identity) != predecessor["install_identity_sha256"]:
            return False
        for relative, expected in entry["paths"].items():
            state, actual = authenticated_path_state(target, relative)
            if state != "regular" or actual != expected:
                return False
    except (OSError, UnicodeError, VibeError, KeyError, TypeError):
        return False
    return True


def canonical_install_identity(manifest: Dict[str, object]) -> Optional[str]:
    managed = manifest.get("managed_files")
    if not isinstance(managed, dict):
        return None
    normalized: Dict[str, str] = {}
    for relative, value in managed.items():
        if (
            safe_project_relative_path(relative) is None
            or not isinstance(value, str)
            or re.fullmatch(r"[0-9a-f]{64}", value) is None
        ):
            return None
        normalized[str(relative)] = value
    identity = {
        "schema_version": manifest.get("schema_version"),
        "framework_version": manifest.get("framework_version"),
        "managed_files": dict(sorted(normalized.items())),
        "agents_block_hash": manifest.get("agents_block_hash"),
    }
    return canonical_json_sha256(identity)


def authenticate_legacy_onboarding_family(
    target: Path, manifest: Dict[str, object]
) -> Optional[Dict[str, object]]:
    """Match only one compiled v0.2-v0.4 pre-onboarding contract identity."""
    version = manifest.get("framework_version")
    candidates = [
        entry for entry in PREDECESSOR_MIGRATION_REGISTRY["entries"]
        if entry.get("mode") == "create-pending-onboarding-if-absent"
        and entry.get("framework_version") == version
    ]
    if len(candidates) != 1:
        return None
    entry = candidates[0]
    try:
        raw_manifest = (target / MANIFEST_PATH).read_bytes()
        if hashlib.sha256(raw_manifest).hexdigest() != entry["manifest_sha256"]:
            return None
        if (
            manifest.get("schema_version") != entry["manifest_schema"]
            or canonical_install_identity(manifest) != entry["install_identity_sha256"]
            or manifest.get("managed_files") != entry["managed_files"]
            or manifest.get("agents_block_hash") != entry["agents_block_sha256"]
        ):
            return None
        for relative, expected in entry["managed_files"].items():
            if authenticated_path_state(target, relative) != ("regular", expected):
                return None
        agents_state, _ = authenticated_path_state(target, "AGENTS.md")
        if agents_state != "regular":
            return None
        block = extract_agents_block((target / "AGENTS.md").read_text(encoding="utf-8"))
        if block is None or sha256_text(block) != entry["agents_block_sha256"]:
            return None
        for relative in ("AGENT_INSTALL.md", "agent-install.json", ONBOARDING_PATH.as_posix()):
            if authenticated_path_state(target, relative)[0] != "absent":
                return None
    except (OSError, UnicodeError, VibeError, KeyError, TypeError):
        return None
    return entry


def onboarding_bridge_result(
    state: str,
    family: Optional[str],
    eligible: bool,
    from_state: str,
    to_state: str,
) -> Dict[str, object]:
    return {
        "schema_version": MAINTENANCE_BRIDGE_SCHEMA_VERSION,
        "state": state,
        "family": family,
        "eligible": eligible,
        "path": ONBOARDING_PATH.as_posix(),
        "from_state": from_state,
        "to_state": to_state,
        "created_content_sha256": ONBOARDING_PENDING_SHA256,
    }


def onboarding_bridge_decision(
    target: Path, manifest: Dict[str, object]
) -> Dict[str, object]:
    state, _ = authenticated_path_state(target, ONBOARDING_PATH.as_posix())
    if state == "regular":
        try:
            persisted, _ = onboarding_readiness(target)
        except VibeError:
            return onboarding_bridge_result("blocked", None, False, "invalid", "unchanged")
        return onboarding_bridge_result("preserved", None, False, persisted, persisted)
    if state != "absent":
        return onboarding_bridge_result("blocked", None, False, "invalid", "unchanged")
    family = authenticate_legacy_onboarding_family(target, manifest)
    if family is not None:
        return onboarding_bridge_result(
            "planned", str(family["migration_id"]), True, "absent", "pending"
        )
    version = str(manifest.get("framework_version", ""))
    if re.fullmatch(r"0\.[56]\.\d+", version):
        return onboarding_bridge_result("blocked", None, False, "missing-state-loss", "unchanged")
    if re.fullmatch(r"0\.[234]\.\d+", version):
        return onboarding_bridge_result("blocked", None, False, "unknown-pre-onboarding-family", "unchanged")
    return onboarding_bridge_result("not-needed", None, False, "absent", "unchanged")


def predecessor_migration_decision(target: Path) -> str:
    official_members = 0
    for relative, expected in PREDECESSOR_MIGRATION_ENTRY["paths"].items():
        state, actual = authenticated_path_state(target, relative)
        if state == "regular" and actual == expected:
            official_members += 1
    if official_members == 0:
        return "ordinary"
    if official_members != len(PREDECESSOR_MIGRATION_PATHS):
        return "conflict"
    return "eligible" if authenticate_v050_predecessor(target) else "conflict"


def normalized_agent_install_sha256(path: Path) -> str:
    value = load_json_object_strict(path)
    activation = value.get("activation")
    if not isinstance(activation, dict):
        raise VibeError("Agent-install activation contract is missing")
    declared = activation.get("activation_set_sha256")
    if not isinstance(declared, str) or re.fullmatch(r"[0-9a-f]{64}", declared) is None:
        raise VibeError("Agent-install activation-set digest is invalid")
    normalized = copy.deepcopy(value)
    normalized_activation = normalized["activation"]
    if not isinstance(normalized_activation, dict):
        raise VibeError("Agent-install activation contract is missing")
    normalized_activation["activation_set_sha256"] = ACTIVATION_DIGEST_SENTINEL
    encoded = json.dumps(
        normalized,
        ensure_ascii=False,
        sort_keys=True,
        separators=(",", ":"),
    ).encode("utf-8")
    return hashlib.sha256(encoded).hexdigest()


def normalized_agent_install_bytes_sha256(content: bytes) -> str:
    try:
        value = json.loads(
            content.decode("utf-8"), object_pairs_hook=reject_duplicate_json_keys
        )
    except (UnicodeError, json.JSONDecodeError, ValueError) as error:
        raise VibeError("Agent-install contract bytes are invalid") from error
    if not isinstance(value, dict) or not isinstance(value.get("activation"), dict):
        raise VibeError("Agent-install activation contract bytes are invalid")
    normalized = copy.deepcopy(value)
    normalized["activation"]["activation_set_sha256"] = ACTIVATION_DIGEST_SENTINEL
    canonical = json.dumps(
        normalized, ensure_ascii=False, sort_keys=True, separators=(",", ":")
    ).encode("utf-8")
    return hashlib.sha256(canonical).hexdigest()


def reference_activation_identity_from_entries(
    entries: Dict[str, bytes], contract: Dict[str, object], protocol: Dict[str, object]
) -> Tuple[List[str], Dict[str, str], str]:
    """Independently recompute release activation identity from actual entry bytes."""
    paths = sorted(
        [
            relative
            for relative in entries
            if relative in ("AGENT_INSTALL.md", "agent-install.json", "bin/vibe")
            or relative.startswith(".vibe/core/")
            or relative.startswith(".agents/skills/vibe-")
            or relative.startswith(".codex/agents/vibe-")
        ]
        + ["AGENTS.md#managed-block"]
    )
    hashes: Dict[str, str] = {}
    for relative in paths:
        if relative == "AGENTS.md#managed-block":
            try:
                block = extract_agents_block(entries["AGENTS.md"].decode("utf-8"))
            except (KeyError, UnicodeError, VibeError) as error:
                raise VibeError("release AGENTS.md managed block is invalid") from error
            if block is None:
                raise VibeError("release AGENTS.md managed block is missing")
            hashes[relative] = hashlib.sha256(block.encode("utf-8")).hexdigest()
        elif relative == "agent-install.json":
            hashes[relative] = normalized_agent_install_bytes_sha256(entries[relative])
        else:
            hashes[relative] = hashlib.sha256(entries[relative]).hexdigest()
    adapter = contract.get("adapter")
    if not isinstance(adapter, dict):
        raise VibeError("release Agent-install adapter is invalid")
    fingerprint = {
        "kit_version": contract.get("kit_version"),
        "core_protocol": protocol.get("core_protocol"),
        "agent_install_schema": contract.get("schema_version"),
        "agent_install_protocol": contract.get("protocol_version"),
        "adapter_name": adapter.get("name"),
        "adapter_protocol": adapter.get("protocol"),
    }
    canonical = json.dumps(
        {"fingerprint": fingerprint, "path_hashes": dict(sorted(hashes.items()))},
        ensure_ascii=False,
        sort_keys=True,
        separators=(",", ":"),
    ).encode("utf-8")
    return paths, dict(sorted(hashes.items())), hashlib.sha256(canonical).hexdigest()


def activation_paths(root: Path) -> List[str]:
    paths = [
        path.relative_to(root).as_posix()
        for path in managed_source_files(root)
    ]
    paths.append("AGENTS.md#managed-block")
    return sorted(paths)


def activation_path_hashes(root: Path, paths: Sequence[str]) -> Dict[str, str]:
    hashes: Dict[str, str] = {}
    for relative in paths:
        if relative == "AGENTS.md#managed-block":
            hashes[relative] = sha256_text(incoming_agents_block(root))
            continue
        path = root / relative
        if not path.is_file():
            raise VibeError(f"Activation path is missing: {relative}")
        hashes[relative] = (
            normalized_agent_install_sha256(path)
            if relative == "agent-install.json"
            else sha256(path)
        )
    return dict(sorted(hashes.items()))


def activation_fingerprint_base(root: Path) -> Dict[str, object]:
    protocol = release_protocol(root)
    contract = load_agent_install_contract(root)
    adapter = contract.get("adapter")
    if not isinstance(adapter, dict):
        raise VibeError("Agent-install adapter contract is missing")
    return {
        "kit_version": framework_version(root),
        "core_protocol": protocol.get("core_protocol"),
        "agent_install_schema": contract.get("schema_version"),
        "agent_install_protocol": contract.get("protocol_version"),
        "adapter_name": adapter.get("name"),
        "adapter_protocol": adapter.get("protocol"),
    }


def activation_set_digest(
    fingerprint: Dict[str, object], path_hashes: Dict[str, str]
) -> str:
    return canonical_json_sha256(
        {"fingerprint": fingerprint, "path_hashes": dict(sorted(path_hashes.items()))}
    )


def source_activation_identity(root: Path) -> Dict[str, object]:
    paths = activation_paths(root)
    path_hashes = activation_path_hashes(root, paths)
    fingerprint = activation_fingerprint_base(root)
    digest = activation_set_digest(fingerprint, path_hashes)
    return {
        "fingerprint": {
            **fingerprint,
            "manifest_sha256": None,
            "activation_set_sha256": digest,
        },
        "paths": paths,
        "path_hashes": path_hashes,
        "activation_set_sha256": digest,
    }


def merge_agents_text(current: str, incoming_block: str) -> str:
    current_block = extract_agents_block(current)
    if current_block is None:
        if not current.strip():
            return incoming_block + "\n\n"
        return incoming_block + "\n\n" + current.lstrip()
    return current.replace(current_block, incoming_block, 1)


def json_scalar(value: str) -> str:
    return json.dumps(value, ensure_ascii=False)


def detect_package_manager(target: Path) -> str:
    if (target / "pnpm-lock.yaml").exists():
        return "pnpm"
    if (target / "yarn.lock").exists():
        return "yarn"
    if (target / "bun.lockb").exists() or (target / "bun.lock").exists():
        return "bun"
    return "npm"


def js_script_command(manager: str, script: str) -> str:
    if manager == "npm":
        return f"npm run {script}"
    if manager == "bun":
        return f"bun run {script}"
    return f"{manager} {script}"


def detect_project(target: Path) -> Tuple[str, str, Dict[str, str]]:
    language = "Unknown"
    framework = "Unknown"
    commands = {"install": "", "lint": "", "typecheck": "", "test": "", "build": ""}

    package_path = target / "package.json"
    if package_path.is_file():
        language = "TypeScript" if (target / "tsconfig.json").exists() else "JavaScript"
        framework = "Node.js"
        try:
            package = json.loads(package_path.read_text(encoding="utf-8"))
        except (json.JSONDecodeError, OSError):
            package = {}
        dependencies: Dict[str, object] = {}
        for key in ("dependencies", "devDependencies", "peerDependencies"):
            value = package.get(key, {}) if isinstance(package, dict) else {}
            if isinstance(value, dict):
                dependencies.update(value)
        if "next" in dependencies:
            framework = "Next.js"
        elif "nuxt" in dependencies:
            framework = "Nuxt"
        elif "@sveltejs/kit" in dependencies:
            framework = "SvelteKit"
        elif "vite" in dependencies:
            framework = "Vite"
        elif "react" in dependencies:
            framework = "React"
        elif "vue" in dependencies:
            framework = "Vue"

        manager = detect_package_manager(target)
        if manager == "pnpm":
            commands["install"] = "pnpm install --frozen-lockfile"
        elif manager == "yarn":
            commands["install"] = "yarn install --frozen-lockfile"
        elif manager == "bun":
            commands["install"] = "bun install --frozen-lockfile"
        elif (target / "package-lock.json").exists():
            commands["install"] = "npm ci"
        else:
            commands["install"] = "npm install"

        scripts = package.get("scripts", {}) if isinstance(package, dict) else {}
        if isinstance(scripts, dict):
            for key in VERIFY_ORDER:
                if key in scripts:
                    commands[key] = js_script_command(manager, key)
            if not commands["typecheck"] and "check" in scripts:
                commands["typecheck"] = js_script_command(manager, "check")
        return language, framework, commands

    pyproject = target / "pyproject.toml"
    requirements = target / "requirements.txt"
    if pyproject.is_file() or requirements.is_file() or (target / "setup.py").is_file():
        language = "Python"
        framework = "Python"
        evidence = ""
        for path in (pyproject, requirements):
            if path.is_file():
                evidence += path.read_text(encoding="utf-8", errors="ignore").lower()
        if "django" in evidence:
            framework = "Django"
        elif "fastapi" in evidence:
            framework = "FastAPI"
        elif "flask" in evidence:
            framework = "Flask"
        if "ruff" in evidence:
            commands["lint"] = "ruff check ."
        if "mypy" in evidence:
            commands["typecheck"] = "mypy ."
        if "pytest" in evidence or (target / "pytest.ini").exists():
            commands["test"] = "pytest"
        return language, framework, commands

    if (target / "Cargo.toml").is_file():
        return "Rust", "Cargo", {
            "install": "",
            "lint": "cargo fmt --check",
            "typecheck": "cargo check",
            "test": "cargo test",
            "build": "cargo build",
        }
    if (target / "go.mod").is_file():
        return "Go", "Go modules", {
            "install": "go mod download",
            "lint": "gofmt -l .",
            "typecheck": "go vet ./...",
            "test": "go test ./...",
            "build": "go build ./...",
        }
    if (target / "Package.swift").is_file():
        return "Swift", "Swift Package Manager", {
            "install": "swift package resolve",
            "lint": "",
            "typecheck": "",
            "test": "swift test",
            "build": "swift build",
        }
    return language, framework, commands


def project_yaml(
    target: Path, lifecycle: str, name: Optional[str] = None
) -> Tuple[str, str, str]:
    language, framework, commands = detect_project(target)
    project_name = name or target.resolve().name
    lines = [
        "schema_version: 1",
        "project:",
        f"  name: {json_scalar(project_name)}",
        f"  lifecycle: {json_scalar(lifecycle)}",
        "stack:",
        f"  language: {json_scalar(language)}",
        f"  framework: {json_scalar(framework)}",
        "commands:",
    ]
    for key in ("install",) + VERIFY_ORDER:
        lines.append(f"  {key}: {json_scalar(commands.get(key, ''))}")
    lines.extend(("feedback:", '  mode: "ask"'))
    return "\n".join(lines) + "\n", language, framework


def render_template(source: Path, replacements: Dict[str, str]) -> str:
    content = source.read_text(encoding="utf-8")
    for key, value in replacements.items():
        content = content.replace("{{" + key + "}}", value)
    return content


def ensure_project_owned_files(
    source: Path,
    target: Path,
    lifecycle: str,
    name: Optional[str],
) -> List[Path]:
    created: List[Path] = []
    yaml_content, language, framework = project_yaml(target, lifecycle, name)
    project_config = target / ".vibe/project.yaml"
    if not project_config.exists():
        atomic_write_text(project_config, yaml_content)
        created.append(project_config)

    rules = target / ".vibe/project-rules.md"
    if not rules.exists():
        atomic_copy(source / "templates/project/project-rules.md", rules)
        created.append(rules)

    onboarding = target / ONBOARDING_PATH
    if not onboarding.exists():
        atomic_copy(source / "templates/project/onboarding.json", onboarding)
        created.append(onboarding)

    replacements = {"LANGUAGE": language, "FRAMEWORK": framework}
    for filename in ("product.md", "architecture.md", "design-system.md"):
        destination = target / "docs/context" / filename
        if not destination.exists():
            content = render_template(source / "templates/context" / filename, replacements)
            atomic_write_text(destination, content)
            created.append(destination)

    work_index = target / "docs/work-items/index.md"
    if not work_index.exists():
        atomic_write_text(
            work_index,
            "# Work items\n\nCreate one with `./bin/vibe work-item <slug> --size M`.\n",
        )
        created.append(work_index)
    decision_index = target / "docs/decisions/index.md"
    if not decision_index.exists():
        atomic_write_text(
            decision_index,
            "# Decision records\n\nRecord durable architectural choices here when the tradeoff matters beyond one work item.\n",
        )
        created.append(decision_index)
    return created


def manifest_value(
    version: str,
    managed_hashes: Dict[str, str],
    agents_block_hash: str,
    provenance: Dict[str, object],
) -> Dict[str, object]:
    activation = source_activation_identity(source_root())
    return {
        "schema_version": 1,
        "framework_version": version,
        "managed_files": dict(sorted(managed_hashes.items())),
        "agents_block_hash": agents_block_hash,
        "source": provenance,
        "target_fingerprint": activation["fingerprint"],
        "activation": {
            "algorithm": ACTIVATION_SET_ALGORITHM,
            "paths": activation["paths"],
            "path_hashes": activation["path_hashes"],
            "activation_set_sha256": activation["activation_set_sha256"],
            "runtime_discovery_roots": list(RUNTIME_DISCOVERY_ROOTS),
        },
    }


def write_manifest(
    target: Path,
    version: str,
    managed_hashes: Dict[str, str],
    agents_block_hash: str,
    provenance: Dict[str, object],
) -> None:
    manifest = manifest_value(
        version, managed_hashes, agents_block_hash, provenance
    )
    atomic_write_text(
        target / MANIFEST_PATH,
        json.dumps(manifest, ensure_ascii=False, indent=2) + "\n",
    )
    atomic_write_text(target / INSTALLED_VERSION_PATH, version + "\n")


def load_manifest(target: Path) -> Dict[str, object]:
    path = target / MANIFEST_PATH
    if not path.is_file():
        raise VibeError(f"Vibe Kit is not installed: {path} is missing.")
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except (json.JSONDecodeError, OSError) as error:
        raise VibeError(f"Cannot read manifest {path}: {error}") from error
    if not isinstance(data.get("managed_files"), dict):
        raise VibeError(f"Invalid managed file manifest: {path}")
    return data


def read_version_file(path: Path) -> Tuple[Optional[str], str]:
    if not path.is_file():
        return None, "<missing>"
    try:
        value = path.read_text(encoding="utf-8").strip()
    except (OSError, UnicodeError) as error:
        return None, f"<unreadable: {error}>"
    if not value:
        return None, "<empty>"
    return value, value


def read_manifest_for_doctor(
    target: Path,
) -> Tuple[Optional[Dict[str, object]], Optional[str], str]:
    path = target / MANIFEST_PATH
    if not path.is_file():
        return None, None, "<missing>"
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except (json.JSONDecodeError, OSError, UnicodeError) as error:
        return None, None, f"<unreadable: {error}>"
    if not isinstance(data, dict):
        return None, None, "<invalid: expected JSON object>"
    raw_version = data.get("framework_version")
    if raw_version is None:
        return data, None, "<missing>"
    value = str(raw_version).strip()
    if not value:
        return data, None, "<empty>"
    return data, value, value


def version_integrity(
    target: Path, manifest_version: Optional[str], manifest_display: str
) -> Tuple[bool, str]:
    installed, installed_display = read_version_file(target / INSTALLED_VERSION_PATH)
    core, core_display = read_version_file(target / ".vibe/core/version")
    values = (installed, manifest_version, core)
    if all(value is not None for value in values) and len(set(values)) == 1:
        return True, str(installed)

    quoted_target = shlex.quote(str(target))
    quoted_cli = shlex.quote(str(target / "bin/vibe"))
    diagnostic = "\n".join(
        (
            "Vibe Kit version integrity failed:",
            f"  .vibe/version: {installed_display}",
            f"  manifest.framework_version: {manifest_display}",
            f"  .vibe/core/version: {core_display}",
            "Repair from the trusted Vibe Kit checkout for the version you intend to install:",
            f"  /path/to/vibe-kit/bin/vibe upgrade {quoted_target}",
            "Then rerun:",
            f"  {quoted_cli} doctor {quoted_target}",
        )
    )
    return False, diagnostic


def install(
    command: str,
    target: Path,
    name: Optional[str],
    output_format: str,
    source_type: str,
    source_ref: Optional[str],
    artifact_sha256: Optional[str],
) -> int:
    source = source_root()
    version = framework_version(source)
    provenance = validate_source_provenance(
        source_type, source_ref, artifact_sha256, version
    )
    target = target.resolve()
    if command == "adopt" and (not target.is_dir() or not any(target.iterdir())):
        raise VibeError("adopt requires a non-empty existing project; use init instead.")
    if (target / MANIFEST_PATH).exists():
        raise VibeError("Vibe Kit is already installed; use upgrade instead.")

    files = managed_source_files(source)
    if not files:
        raise VibeError("No managed framework files were found in the source checkout.")
    collisions: List[str] = []
    for incoming in files:
        relative = incoming.relative_to(source)
        existing = target / relative
        if existing.exists() and existing.resolve() != incoming.resolve():
            if not existing.is_file() or sha256(existing) != sha256(incoming):
                collisions.append(relative.as_posix())
    agents_path = target / "AGENTS.md"
    current_agents = ""
    if agents_path.exists():
        current_agents = agents_path.read_text(encoding="utf-8")
        extract_agents_block(current_agents)
    if collisions:
        joined = "\n  - ".join(collisions)
        raise VibeError(
            "Installation stopped before making changes because managed paths already exist:\n"
            f"  - {joined}\nMove or rename them, then retry."
        )

    block = incoming_agents_block(source)
    try:
        target.mkdir(parents=True, exist_ok=True)
        for incoming in files:
            atomic_copy(incoming, target / incoming.relative_to(source))

        atomic_write_text(agents_path, merge_agents_text(current_agents, block))
        lifecycle = "new" if command == "init" else "existing"
        created = ensure_project_owned_files(source, target, lifecycle, name)

        managed_hashes = {
            incoming.relative_to(source).as_posix(): sha256(
                target / incoming.relative_to(source)
            )
            for incoming in files
        }
        write_manifest(target, version, managed_hashes, sha256_text(block), provenance)
    except (OSError, UnicodeError) as error:
        raise mutation_filesystem_error(command, target, error) from error
    if output_format == "json":
        write_state = "project-files-written"
        activation = source_activation_identity(source)
        print_json(
            result_envelope(
                command,
                "success",
                operation=command,
                target=str(target),
                kit_version=version,
                source=provenance,
                write_state=write_state,
                writes_performed=writes_performed(write_state),
                managed_files_installed=len(managed_hashes),
                project_owned_files_created=len(created),
                onboarding=onboarding_result(target),
                target_fingerprint=activation["fingerprint"],
                activation={
                    "state": "not-proven",
                    "path": "none",
                    "manual_new_task_supported": True,
                    "same_task_reload_claimed": False,
                    "automatic_successor_handoff_claimed": False,
                },
                handoff={
                    "required": True,
                    "action": "create-new-project-task",
                    "instruction": "Open one new Codex task in this project; the new task loads the installed rules.",
                },
            )
        )
        return 0
    print(f"Vibe Kit {version} {command} complete: {target}")
    print(f"Managed files installed: {len(managed_hashes)}")
    print(f"Project-owned files created: {len(created)}")
    print("Start a new Codex task so AGENTS.md and repository skills are loaded.")
    print("In the new task, state the development goal normally; onboarding is automatic.")
    return 0


PROJECT_OWNED_INSTALL_PATHS = (
    ".vibe/project.yaml",
    ".vibe/project-rules.md",
    ONBOARDING_PATH.as_posix(),
    "docs/context/product.md",
    "docs/context/architecture.md",
    "docs/context/design-system.md",
    "docs/work-items/index.md",
    "docs/decisions/index.md",
)


def plan_entry(action: str, relative: str, note: str = "") -> Dict[str, str]:
    return {"action": action, "path": relative, "note": note}


LEAF_ATOMICITY_UNSUPPORTED_ERRNOS = {
    errno.ENOSYS,
    errno.ENOTSUP,
    getattr(errno, "EOPNOTSUPP", errno.ENOTSUP),
    errno.EINVAL,
    errno.EXDEV,
}


class LeafAtomicityAdapter:
    """Stdlib-only fd-relative no-clobber/exchange rename adapter."""

    RENAME_EXCHANGE = 0x00000002
    RENAME_NOREPLACE_LINUX = 0x00000001
    RENAME_NOREPLACE_DARWIN = 0x00000004

    def __init__(self, system: Optional[str] = None, library: object = None) -> None:
        self.system = system or platform.system()
        if self.system == "Darwin":
            symbol = "renameatx_np"
            self.noreplace_flag = self.RENAME_NOREPLACE_DARWIN
        elif self.system == "Linux":
            symbol = "renameat2"
            self.noreplace_flag = self.RENAME_NOREPLACE_LINUX
        else:
            raise VibeError(
                "lossless upgrade leaf mutation is unsupported on this platform",
                "upgrade_leaf_atomicity_unsupported",
            )
        try:
            libc = library if library is not None else ctypes.CDLL(None, use_errno=True)
            function = getattr(libc, symbol)
        except (AttributeError, OSError) as error:
            raise VibeError(
                "required lossless rename primitive is unavailable",
                "upgrade_leaf_atomicity_unsupported",
            ) from error
        try:
            function.argtypes = (
                ctypes.c_int,
                ctypes.c_char_p,
                ctypes.c_int,
                ctypes.c_char_p,
                ctypes.c_uint,
            )
            function.restype = ctypes.c_int
        except AttributeError:
            # Python-callable test doubles deliberately need no ctypes metadata.
            pass
        self._rename = function

    def _call(
        self, source_parent: int, source: str, destination_parent: int,
        destination: str, flags: int,
    ) -> None:
        ctypes.set_errno(0)
        result = self._rename(
            source_parent,
            os.fsencode(source),
            destination_parent,
            os.fsencode(destination),
            flags,
        )
        if result != 0:
            value = ctypes.get_errno() or errno.EIO
            raise OSError(value, os.strerror(value), destination)

    def exchange(
        self, source_parent: int, source: str, destination_parent: int,
        destination: str,
    ) -> None:
        self._call(
            source_parent, source, destination_parent, destination,
            self.RENAME_EXCHANGE,
        )

    def no_replace(
        self, source_parent: int, source: str, destination_parent: int,
        destination: str,
    ) -> None:
        self._call(
            source_parent, source, destination_parent, destination,
            self.noreplace_flag,
        )


def leaf_atomicity_api_preflight() -> LeafAtomicityAdapter:
    required = (os.open, os.mkdir, os.rename, os.unlink, os.rmdir, os.stat, os.link)
    supported = (
        hasattr(os, "O_NOFOLLOW")
        and hasattr(os, "O_DIRECTORY")
        and all(item in os.supports_dir_fd for item in required)
        and os.link in os.supports_follow_symlinks
    )
    if not supported:
        raise VibeError(
            "required fd-relative lossless upgrade primitives are unavailable",
            "upgrade_leaf_atomicity_unsupported",
        )
    return LeafAtomicityAdapter()


def transaction_platform_supported() -> bool:
    try:
        leaf_atomicity_api_preflight()
    except VibeError:
        return False
    return True


class ProjectRootFD:
    """Pinned-root, no-follow filesystem access for upgrade transaction paths."""

    def __init__(self, root: Path) -> None:
        flags = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW
        if hasattr(os, "O_CLOEXEC"):
            flags |= os.O_CLOEXEC
        self.root = root
        self.fd = os.open(str(root), flags)
        if not stat.S_ISDIR(os.fstat(self.fd).st_mode):
            os.close(self.fd)
            raise VibeError("upgrade target is not a supported directory")

    def close(self) -> None:
        if self.fd >= 0:
            os.close(self.fd)
            self.fd = -1

    def __enter__(self) -> "ProjectRootFD":
        return self

    def __exit__(self, *_: object) -> None:
        self.close()

    def identity_sha256(self) -> str:
        metadata = os.fstat(self.fd)
        return canonical_json_sha256(
            {"root_device": metadata.st_dev, "root_inode": metadata.st_ino}
        )

    @staticmethod
    def object_identity(metadata: os.stat_result) -> Dict[str, int]:
        return {"device": int(metadata.st_dev), "inode": int(metadata.st_ino)}

    def open_directory(self, relative: str) -> int:
        if relative in ("", "."):
            return os.dup(self.fd)
        value = safe_project_relative_path(relative)
        if value is None:
            raise VibeError("unsafe project directory path", "unsafe_transaction_path")
        descriptor = os.dup(self.fd)
        flags = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW
        if hasattr(os, "O_CLOEXEC"):
            flags |= os.O_CLOEXEC
        try:
            for part in value.parts:
                child = os.open(part, flags, dir_fd=descriptor)
                metadata = os.fstat(child)
                if not stat.S_ISDIR(metadata.st_mode):
                    os.close(child)
                    raise VibeError("project directory component is invalid")
                os.close(descriptor)
                descriptor = child
            return descriptor
        except BaseException:
            os.close(descriptor)
            raise

    def directory_object(self, relative: str) -> Dict[str, int]:
        descriptor = self.open_directory(relative)
        try:
            return self.object_identity(os.fstat(descriptor))
        finally:
            os.close(descriptor)

    def require_directory_object(
        self, relative: str, expected: Dict[str, object]
    ) -> int:
        descriptor = self.open_directory(relative)
        if self.object_identity(os.fstat(descriptor)) != expected:
            os.close(descriptor)
            raise VibeError(
                "upgrade parent directory identity changed",
                "upgrade_leaf_race_preserved",
            )
        return descriptor

    def parent_layout(
        self, relative: str
    ) -> Tuple[str, str, Dict[str, int], Optional[str]]:
        """Return parent presence, deepest parent identity and first absent root."""
        value = safe_project_relative_path(relative)
        if value is None:
            raise VibeError("unsafe upgrade path", "unsafe_transaction_path")
        parent_parts = list(value.parts[:-1])
        descriptor = os.dup(self.fd)
        flags = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW
        if hasattr(os, "O_CLOEXEC"):
            flags |= os.O_CLOEXEC
        traversed: List[str] = []
        try:
            for index, part in enumerate(parent_parts):
                try:
                    child = os.open(part, flags, dir_fd=descriptor)
                except FileNotFoundError:
                    parent_path = "/".join(traversed) or "."
                    final_root = "/".join(parent_parts[: index + 1])
                    return (
                        "absent",
                        parent_path,
                        self.object_identity(os.fstat(descriptor)),
                        final_root,
                    )
                metadata = os.fstat(child)
                if not stat.S_ISDIR(metadata.st_mode):
                    os.close(child)
                    raise VibeError(
                        "upgrade parent path is not a no-follow directory",
                        "upgrade_path_invalid",
                    )
                os.close(descriptor)
                descriptor = child
                traversed.append(part)
            return (
                "existing",
                "/".join(traversed) or ".",
                self.object_identity(os.fstat(descriptor)),
                None,
            )
        finally:
            os.close(descriptor)

    def read_entry(
        self, relative: str
    ) -> Tuple[str, Optional[bytes], Optional[int], Optional[Dict[str, int]]]:
        try:
            parent, leaf = self.parent(relative)
        except FileNotFoundError:
            return "absent", None, None, None
        flags = os.O_RDONLY | os.O_NOFOLLOW
        if hasattr(os, "O_CLOEXEC"):
            flags |= os.O_CLOEXEC
        try:
            try:
                descriptor = os.open(leaf, flags, dir_fd=parent)
            except FileNotFoundError:
                return "absent", None, None, None
            try:
                first = os.fstat(descriptor)
                if not stat.S_ISREG(first.st_mode):
                    return "invalid", None, None, self.object_identity(first)
                chunks = []
                while True:
                    chunk = os.read(descriptor, 1024 * 1024)
                    if not chunk:
                        break
                    chunks.append(chunk)
                second = os.fstat(descriptor)
                signature = lambda item: (
                    item.st_dev, item.st_ino, item.st_mode, item.st_size,
                    item.st_mtime_ns, item.st_ctime_ns,
                )
                if signature(first) != signature(second):
                    raise VibeError(
                        "upgrade leaf changed while it was read",
                        "upgrade_leaf_race_preserved",
                    )
                return (
                    "regular",
                    b"".join(chunks),
                    stat.S_IMODE(second.st_mode),
                    self.object_identity(second),
                )
            finally:
                os.close(descriptor)
        except OSError:
            return "invalid", None, None, None
        finally:
            os.close(parent)

    def create_regular_exclusive(
        self, relative: str, content: bytes, mode: int
    ) -> Dict[str, int]:
        parent, leaf = self.parent(relative)
        flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW
        if hasattr(os, "O_CLOEXEC"):
            flags |= os.O_CLOEXEC
        descriptor: Optional[int] = None
        try:
            descriptor = os.open(leaf, flags, mode, dir_fd=parent)
            offset = 0
            while offset < len(content):
                offset += os.write(descriptor, content[offset:])
            os.fchmod(descriptor, mode)
            os.fsync(descriptor)
            metadata = os.fstat(descriptor)
            identity = self.object_identity(metadata)
            os.close(descriptor)
            descriptor = None
            os.fsync(parent)
            return identity
        finally:
            if descriptor is not None:
                os.close(descriptor)
            os.close(parent)

    def unlink_exact_private(
        self, relative: str, identity: Dict[str, object],
        image: Optional[Dict[str, object]] = None,
    ) -> None:
        state, content, mode, observed = self.read_entry(relative)
        if observed != identity or (
            image is not None and bytes_identity(state, content, mode) != image
        ):
            raise VibeError("private transaction object changed")
        parent, leaf = self.parent(relative)
        try:
            current = os.stat(leaf, dir_fd=parent, follow_symlinks=False)
            if self.object_identity(current) != identity:
                raise VibeError("private transaction object changed")
            os.unlink(leaf, dir_fd=parent)
            os.fsync(parent)
        finally:
            os.close(parent)

    def link_no_clobber(self, source: str, destination: str) -> None:
        source_parent, source_leaf = self.parent(source)
        destination_parent, destination_leaf = self.parent(destination)
        try:
            os.link(
                source_leaf,
                destination_leaf,
                src_dir_fd=source_parent,
                dst_dir_fd=destination_parent,
                follow_symlinks=False,
            )
            os.fsync(destination_parent)
        finally:
            os.close(source_parent)
            os.close(destination_parent)

    def parent(self, relative: str, create: bool = False, mode: int = 0o700) -> Tuple[int, str]:
        value = safe_project_relative_path(relative)
        if value is None:
            raise VibeError("unsafe transaction path", "unsafe_transaction_path")
        descriptor = os.dup(self.fd)
        flags = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW
        if hasattr(os, "O_CLOEXEC"):
            flags |= os.O_CLOEXEC
        try:
            for part in value.parts[:-1]:
                try:
                    child = os.open(part, flags, dir_fd=descriptor)
                except FileNotFoundError:
                    if not create:
                        raise
                    os.mkdir(part, mode=mode, dir_fd=descriptor)
                    os.fsync(descriptor)
                    child = os.open(part, flags, dir_fd=descriptor)
                if not stat.S_ISDIR(os.fstat(child).st_mode):
                    os.close(child)
                    raise VibeError("transaction directory component is invalid")
                os.close(descriptor)
                descriptor = child
            return descriptor, value.name
        except BaseException:
            os.close(descriptor)
            raise

    def read(self, relative: str) -> Tuple[str, Optional[bytes], Optional[int]]:
        try:
            parent, leaf = self.parent(relative)
        except FileNotFoundError:
            return "absent", None, None
        flags = os.O_RDONLY | os.O_NOFOLLOW
        if hasattr(os, "O_CLOEXEC"):
            flags |= os.O_CLOEXEC
        try:
            try:
                descriptor = os.open(leaf, flags, dir_fd=parent)
            except FileNotFoundError:
                return "absent", None, None
            try:
                metadata = os.fstat(descriptor)
                if not stat.S_ISREG(metadata.st_mode):
                    return "invalid", None, None
                chunks = []
                while True:
                    chunk = os.read(descriptor, 1024 * 1024)
                    if not chunk:
                        break
                    chunks.append(chunk)
                return "regular", b"".join(chunks), stat.S_IMODE(metadata.st_mode)
            finally:
                os.close(descriptor)
        except OSError:
            return "invalid", None, None
        finally:
            os.close(parent)

    def path_state(self, relative: str) -> str:
        try:
            parent, leaf = self.parent(relative)
        except FileNotFoundError:
            return "absent"
        except OSError:
            return "invalid"
        try:
            try:
                metadata = os.stat(leaf, dir_fd=parent, follow_symlinks=False)
            except FileNotFoundError:
                return "absent"
            if stat.S_ISREG(metadata.st_mode):
                return "regular"
            if stat.S_ISDIR(metadata.st_mode) and not stat.S_ISLNK(metadata.st_mode):
                return "directory"
            return "invalid"
        except OSError:
            return "invalid"
        finally:
            os.close(parent)

    def mkdir(
        self, relative: str, mode: int = 0o700, *, parents: bool = False,
        exist_ok: bool = False,
    ) -> None:
        parent, leaf = self.parent(relative, create=parents, mode=mode)
        try:
            try:
                os.mkdir(leaf, mode=mode, dir_fd=parent)
            except FileExistsError:
                if not exist_ok:
                    raise
                metadata = os.stat(leaf, dir_fd=parent, follow_symlinks=False)
                if not stat.S_ISDIR(metadata.st_mode) or stat.S_ISLNK(metadata.st_mode):
                    raise VibeError("transaction directory member is invalid")
            os.fsync(parent)
        finally:
            os.close(parent)

    def list_names(self, relative: str) -> List[str]:
        parent, leaf = self.parent(relative)
        flags = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW
        if hasattr(os, "O_CLOEXEC"):
            flags |= os.O_CLOEXEC
        try:
            descriptor = os.open(leaf, flags, dir_fd=parent)
            try:
                if not stat.S_ISDIR(os.fstat(descriptor).st_mode):
                    raise VibeError("transaction directory member is invalid")
                return sorted(os.listdir(descriptor))
            finally:
                os.close(descriptor)
        finally:
            os.close(parent)

    def write(self, relative: str, content: bytes, mode: int) -> None:
        parent, leaf = self.parent(relative, create=True)
        temporary = ".vibe-tmp-" + hashlib.sha256(os.urandom(32)).hexdigest()[:16]
        flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW
        if hasattr(os, "O_CLOEXEC"):
            flags |= os.O_CLOEXEC
        descriptor: Optional[int] = None
        try:
            descriptor = os.open(temporary, flags, mode, dir_fd=parent)
            offset = 0
            while offset < len(content):
                offset += os.write(descriptor, content[offset:])
            os.fchmod(descriptor, mode)
            os.fsync(descriptor)
            os.close(descriptor)
            descriptor = None
            try:
                existing = os.stat(leaf, dir_fd=parent, follow_symlinks=False)
            except FileNotFoundError:
                existing = None
            if existing is not None:
                raise VibeError("refusing to replace an existing transaction member")
            os.rename(temporary, leaf, src_dir_fd=parent, dst_dir_fd=parent)
            final = os.open(leaf, os.O_RDONLY | os.O_NOFOLLOW, dir_fd=parent)
            try:
                os.fsync(final)
            finally:
                os.close(final)
            os.fsync(parent)
        except BaseException:
            if descriptor is not None:
                os.close(descriptor)
            try:
                os.unlink(temporary, dir_fd=parent)
                os.fsync(parent)
            except OSError:
                pass
            raise
        finally:
            os.close(parent)

    def append(self, relative: str, content: bytes, expected: bytes) -> None:
        parent, leaf = self.parent(relative)
        flags = os.O_RDWR | os.O_APPEND | os.O_NOFOLLOW
        if not expected:
            flags |= os.O_CREAT
        if hasattr(os, "O_CLOEXEC"):
            flags |= os.O_CLOEXEC
        try:
            descriptor = os.open(leaf, flags, 0o600, dir_fd=parent)
            try:
                metadata = os.fstat(descriptor)
                if not stat.S_ISREG(metadata.st_mode):
                    raise VibeError("transaction journal is not a regular file")
                os.lseek(descriptor, 0, os.SEEK_SET)
                chunks = []
                while True:
                    chunk = os.read(descriptor, 1024 * 1024)
                    if not chunk:
                        break
                    chunks.append(chunk)
                if b"".join(chunks) != expected:
                    raise VibeError("transaction journal changed during append")
                os.lseek(descriptor, 0, os.SEEK_END)
                offset = 0
                while offset < len(content):
                    offset += os.write(descriptor, content[offset:])
                os.fchmod(descriptor, 0o600)
                os.fsync(descriptor)
            finally:
                os.close(descriptor)
            os.fsync(parent)
        finally:
            os.close(parent)

    def remove(self, relative: str) -> None:
        parent, leaf = self.parent(relative)
        try:
            os.unlink(leaf, dir_fd=parent)
            os.fsync(parent)
        finally:
            os.close(parent)

    def remove_tree(
        self, relative: str,
        expected_parent: Optional[Dict[str, object]] = None,
    ) -> None:
        parent, leaf = self.parent(relative)
        flags = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW
        if hasattr(os, "O_CLOEXEC"):
            flags |= os.O_CLOEXEC

        def remove_members(descriptor: int) -> None:
            for name in os.listdir(descriptor):
                metadata = os.stat(name, dir_fd=descriptor, follow_symlinks=False)
                if stat.S_ISREG(metadata.st_mode):
                    os.unlink(name, dir_fd=descriptor)
                elif stat.S_ISDIR(metadata.st_mode) and not stat.S_ISLNK(metadata.st_mode):
                    child = os.open(name, flags, dir_fd=descriptor)
                    try:
                        remove_members(child)
                    finally:
                        os.close(child)
                    os.rmdir(name, dir_fd=descriptor)
                else:
                    raise VibeError("refusing unsupported transaction member type")
            os.fsync(descriptor)

        try:
            if (
                expected_parent is not None
                and self.object_identity(os.fstat(parent)) != expected_parent
            ):
                raise VibeError(
                    "directory-unit parent changed before private cleanup",
                    "upgrade_directory_race_preserved",
                )
            active = os.open(leaf, flags, dir_fd=parent)
            try:
                remove_members(active)
            finally:
                os.close(active)
            os.rmdir(leaf, dir_fd=parent)
            os.fsync(parent)
        finally:
            os.close(parent)


def bytes_identity(state: str, content: Optional[bytes], mode: Optional[int]) -> Dict[str, object]:
    return {
        "state": state,
        "type": "regular" if state == "regular" else state,
        "sha256": hashlib.sha256(content).hexdigest() if content is not None else None,
        "mode": mode,
    }


def transaction_shape(
    transaction_id: Optional[str], outcome: str, phase: str, commit_marker: str,
    failed_path: Optional[str] = None, failure_kind: Optional[str] = None,
) -> Dict[str, object]:
    return {
        "schema_version": TRANSACTION_JOURNAL_SCHEMA,
        "transaction_id": transaction_id,
        "outcome": outcome,
        "phase": phase,
        "commit_marker": commit_marker,
        "failed_path": failed_path,
        "failure_kind": failure_kind,
    }


def project_identity_sha256(target: Path) -> str:
    with ProjectRootFD(target) as project:
        return project.identity_sha256()


def transaction_member_path(member: str = "") -> str:
    base = TRANSACTION_ACTIVE_PATH.as_posix()
    return f"{base}/{member}" if member else base


def load_project_json(project: ProjectRootFD, relative: str) -> Dict[str, object]:
    state, content, _ = project.read(relative)
    if state != "regular" or content is None:
        raise VibeError(f"invalid JSON object: {relative}")
    try:
        value = json.loads(
            content.decode("utf-8"), object_pairs_hook=reject_duplicate_json_keys
        )
    except (UnicodeError, json.JSONDecodeError, ValueError) as error:
        raise VibeError(f"invalid JSON object: {relative}") from error
    if not isinstance(value, dict):
        raise VibeError(f"invalid JSON object: {relative}")
    return value


def validate_transaction_events(
    project: ProjectRootFD, transaction_id: str
) -> None:
    state, content, _ = project.read(transaction_member_path("events.jsonl"))
    if state != "regular" or content is None or len(content) > 1024 * 1024:
        raise VibeError("transaction journal is missing or invalid")
    previous = "0" * 64
    lines = content.splitlines(keepends=True)
    if not lines or len(lines) > 4096:
        raise VibeError("transaction journal is empty or too large")
    for sequence, line in enumerate(lines):
        if not line.endswith(b"\n") or len(line) > 4096:
            raise VibeError("transaction journal record is invalid")
        try:
            item = json.loads(line, object_pairs_hook=reject_duplicate_json_keys)
        except (UnicodeDecodeError, json.JSONDecodeError, ValueError) as error:
            raise VibeError("transaction journal record is invalid") from error
        if (
            not exact_keys(
                item,
                (
                    "schema_version", "transaction_id", "sequence", "phase",
                    "previous_sha256", "recorded_at",
                ),
            )
            or item.get("schema_version") != TRANSACTION_JOURNAL_SCHEMA
            or item.get("transaction_id") != transaction_id
            or item.get("sequence") != sequence
            or item.get("previous_sha256") != previous
            or item.get("phase") not in (
                "preparing", "prepared", "committing", "commit-complete",
                "rolling-back", "rollback-complete", "cleaning",
                "recovery-required",
            )
            or not is_iso8601(item.get("recorded_at"))
        ):
            raise VibeError("transaction journal record is inconsistent")
        previous = hashlib.sha256(line).hexdigest()


def image_identity_valid(value: object, *, absent_allowed: bool) -> bool:
    if not exact_keys(value, ("state", "type", "sha256", "mode")):
        return False
    if value.get("state") == "absent":
        return absent_allowed and value == {
            "state": "absent", "type": "absent", "sha256": None, "mode": None,
        }
    return bool(
        value.get("state") == "regular"
        and value.get("type") == "regular"
        and re.fullmatch(r"[0-9a-f]{64}", str(value.get("sha256", "")))
        and isinstance(value.get("mode"), int)
        and not isinstance(value.get("mode"), bool)
    )


def validate_transaction_payload(
    project: ProjectRootFD, owner: Dict[str, object], transaction_id: str
) -> Tuple[Dict[str, object], Dict[str, object]]:
    intent = load_project_json(project, transaction_member_path("intent.json"))
    intent_keys = (
        "schema_version", "transaction_id", "project_identity_sha256",
        "from_version", "target_version", "allowed_paths", "changes",
        "leaf_capability_probes", "directory_units",
        "directory_capability_probes", "manifest_identity", "agents_identity",
        "onboarding_identity", "postimage_set_sha256",
        "directory_postimage_set_sha256",
    )
    if (
        not exact_keys(intent, intent_keys)
        or intent.get("schema_version") != TRANSACTION_JOURNAL_SCHEMA
        or intent.get("transaction_id") != transaction_id
        or intent.get("project_identity_sha256") != owner.get("project_identity_sha256")
    ):
        raise VibeError("transaction member identity mismatch")
    changes = intent.get("changes")
    if not isinstance(changes, list) or not changes:
        raise VibeError("transaction has no changes")
    if intent.get("allowed_paths") != [item.get("path") for item in changes]:
        raise VibeError("transaction allowed path set is inconsistent")
    slots: List[str] = []
    for item in changes:
        if not exact_keys(item, (
            "slot", "path", "leaf_protocol", "temporary_path", "directory_unit",
            "preimage", "postimage", "preimage_object",
        )):
            raise VibeError("invalid transaction change")
        slot = item.get("slot")
        path = item.get("path")
        if (
            not isinstance(slot, str) or re.fullmatch(r"[0-9]{4}", slot) is None
            or safe_project_relative_path(path) is None
            or not image_identity_valid(item.get("preimage"), absent_allowed=True)
            or not image_identity_valid(item.get("postimage"), absent_allowed=False)
        ):
            raise VibeError("invalid transaction change identity")
        slots.append(slot)
        protocol = item.get("leaf_protocol")
        if protocol == "directory-unit-member-v1":
            if (
                item.get("temporary_path") is not None
                or not isinstance(item.get("directory_unit"), str)
                or item["preimage"]["state"] != "absent"
                or item.get("preimage_object") is not None
            ):
                raise VibeError("invalid directory-unit member")
        elif protocol in ("link-no-clobber-v1", "exchange-preserve-v1"):
            if (
                safe_project_relative_path(item.get("temporary_path")) is None
                or item.get("directory_unit") is not None
                or (protocol == "link-no-clobber-v1" and (
                    item["preimage"]["state"] != "absent"
                    or item.get("preimage_object") is not None
                ))
                or (protocol == "exchange-preserve-v1" and (
                    item["preimage"]["state"] != "regular"
                    or not object_identity_valid(item.get("preimage_object"))
                ))
            ):
                raise VibeError("invalid existing-parent leaf change")
        else:
            raise VibeError("unknown transaction leaf protocol")
        for key, directory in (("preimage", "preimage"), ("postimage", "stage")):
            identity = item[key]
            if identity["state"] == "regular":
                state, image, _ = project.read(
                    transaction_member_path(f"{directory}/{slot}")
                )
                if state != "regular" or image is None or hashlib.sha256(image).hexdigest() != identity["sha256"]:
                    raise VibeError("transaction image digest mismatch")
    if len(slots) != len(set(slots)) or len(intent["allowed_paths"]) != len(set(intent["allowed_paths"])):
        raise VibeError("transaction contains duplicates")

    units = intent.get("directory_units")
    if not isinstance(units, list):
        raise VibeError("invalid directory units")
    unit_ids = []
    unit_members: Dict[str, str] = {}
    for unit in units:
        if not exact_keys(unit, (
            "unit_id", "sequence", "parent_path", "parent_object", "final_root",
            "staging_root", "protocol", "preimage_state", "directories", "members",
            "tree_sha256",
        )):
            raise VibeError("invalid directory unit")
        unit_id = unit.get("unit_id")
        if (
            not isinstance(unit_id, str) or re.fullmatch(r"d[0-9]{4}", unit_id) is None
            or not isinstance(unit.get("sequence"), int)
            or isinstance(unit.get("sequence"), bool)
            or safe_project_relative_path(unit.get("parent_path")) is None and unit.get("parent_path") != "."
            or not object_identity_valid(unit.get("parent_object"))
            or safe_project_relative_path(unit.get("final_root")) is None
            or safe_project_relative_path(unit.get("staging_root")) is None
            or unit.get("protocol") != "directory-no-clobber-v1"
            or unit.get("preimage_state") != "absent"
            or not isinstance(unit.get("directories"), list)
            or not isinstance(unit.get("members"), list)
        ):
            raise VibeError("invalid directory unit identity")
        unit_ids.append(unit_id)
        final_root = str(unit["final_root"])
        parent_path = str(unit["parent_path"])
        if PurePosixPath(final_root).parent.as_posix() != parent_path:
            raise VibeError("directory unit is not an adjacent sibling publication")
        if PurePosixPath(str(unit["staging_root"])).parent.as_posix() != parent_path:
            raise VibeError("directory staging root is not adjacent")
        directories = unit["directories"]
        members = unit["members"]
        if any(
            not exact_keys(directory, ("path", "mode"))
            or safe_project_relative_path(directory.get("path")) is None
            or directory.get("mode") != 0o755
            for directory in directories
        ):
            raise VibeError("invalid directory unit directory")
        directory_paths = [str(directory["path"]) for directory in directories]
        if (
            directory_paths != sorted(
                directory_paths,
                key=lambda value: (path_depth(value), os.fsencode(value)),
            )
            or len(directory_paths) != len(set(directory_paths))
            or final_root not in directory_paths
            or any(
                not PurePosixPath(value).is_relative_to(PurePosixPath(final_root))
                for value in directory_paths
            )
        ):
            raise VibeError("directory unit directory set is incomplete or unordered")
        member_slots: List[int] = []
        member_paths: List[str] = []
        required_directories = {final_root}
        for member in members:
            if (
                not exact_keys(member, ("slot", "path", "postimage"))
                or not isinstance(member.get("slot"), str)
                or re.fullmatch(r"[0-9]{4}", member["slot"]) is None
                or safe_project_relative_path(member.get("path")) is None
                or not image_identity_valid(member.get("postimage"), absent_allowed=False)
                or not PurePosixPath(str(member["path"])).is_relative_to(PurePosixPath(final_root))
            ):
                raise VibeError("invalid directory unit member")
            member_slots.append(int(member["slot"]))
            member_paths.append(str(member["path"]))
            parent = PurePosixPath(str(member["path"])).parent
            while parent.is_relative_to(PurePosixPath(final_root)):
                required_directories.add(parent.as_posix())
                if parent.as_posix() == final_root:
                    break
                parent = parent.parent
            if str(member["slot"]) in unit_members:
                raise VibeError("directory unit member slot is duplicated")
            unit_members[str(member["slot"])] = unit_id
        if (
            not member_slots
            or member_slots != sorted(member_slots)
            or member_slots != list(range(min(member_slots), max(member_slots) + 1))
            or unit.get("sequence") != min(member_slots)
            or len(member_paths) != len(set(member_paths))
            or set(directory_paths) != required_directories
        ):
            raise VibeError("directory unit member order or completeness is invalid")
        if unit["tree_sha256"] != canonical_json_sha256({
            "directories": directories, "members": members
        }):
            raise VibeError("directory unit tree digest mismatch")
    expected_unit_ids = [f"d{index:04d}" for index in range(1, len(units) + 1)]
    ordered_units = sorted(
        units,
        key=lambda value: (
            int(value["sequence"]), os.fsencode(str(value["final_root"])),
        ),
    )
    final_roots = [PurePosixPath(str(unit["final_root"])) for unit in units]
    if (
        len(unit_ids) != len(set(unit_ids))
        or unit_ids != expected_unit_ids
        or units != ordered_units
        or any(
            left != right and (
                left.is_relative_to(right) or right.is_relative_to(left)
            )
            for index, left in enumerate(final_roots)
            for right in final_roots[index + 1:]
        )
    ):
        raise VibeError("directory unit order is invalid")
    for item in changes:
        if item["directory_unit"] is not None:
            if unit_members.get(str(item["slot"])) != item["directory_unit"]:
                raise VibeError("directory unit back-reference mismatch")
            unit = next(value for value in units if value["unit_id"] == item["directory_unit"])
            member = next(value for value in unit["members"] if value["slot"] == item["slot"])
            if member["path"] != item["path"] or member["postimage"] != item["postimage"]:
                raise VibeError("directory unit member identity disagrees with change")
    expected_unit_slots = {
        str(item["slot"])
        for item in changes if item["directory_unit"] is not None
    }
    if set(unit_members) != expected_unit_slots:
        raise VibeError("directory unit member set is incomplete")
    directory_postimage = canonical_json_sha256([
        {"unit_id": unit["unit_id"], "final_root": unit["final_root"], "tree_sha256": unit["tree_sha256"]}
        for unit in units
    ])
    if intent.get("directory_postimage_set_sha256") != directory_postimage:
        raise VibeError("directory postimage-set digest mismatch")

    probe_paths: List[str] = []
    for key, expected_keys in (
        ("leaf_capability_probes", (
            "parent_path", "probe_a_path", "probe_b_path", "requires_hard_link",
            "requires_no_replace", "requires_exchange",
        )),
        ("directory_capability_probes", (
            "parent_path", "parent_object", "probe_a_path", "probe_b_path",
            "requires_directory_no_replace",
        )),
    ):
        probes = intent.get(key)
        if not isinstance(probes, list) or any(not exact_keys(probe, expected_keys) for probe in probes):
            raise VibeError("invalid transaction capability probes")
        parents = [probe.get("parent_path") for probe in probes]
        if parents != sorted(parents, key=lambda value: os.fsencode(str(value))) or len(parents) != len(set(parents)):
            raise VibeError("transaction capability probe order is invalid")
        for probe in probes:
            if (
                safe_project_relative_path(probe.get("parent_path")) is None
                and probe.get("parent_path") != "."
            ):
                raise VibeError("unsafe capability probe parent")
            for path_key in ("probe_a_path", "probe_b_path"):
                if (
                    safe_project_relative_path(probe.get(path_key)) is None
                    or PurePosixPath(str(probe[path_key])).parent.as_posix()
                    != probe["parent_path"]
                ):
                    raise VibeError("capability probe is not an adjacent private entry")
                probe_paths.append(str(probe[path_key]))
            if key == "leaf_capability_probes" and any(
                probe.get(flag) is not True
                for flag in ("requires_hard_link", "requires_no_replace", "requires_exchange")
            ):
                raise VibeError("leaf capability requirements are not exact")
            if key == "directory_capability_probes" and (
                probe.get("requires_directory_no_replace") is not True
                or not object_identity_valid(probe.get("parent_object"))
            ):
                raise VibeError("directory capability requirements are not exact")
    expected_leaf_parents = sorted({
        PurePosixPath(str(item["path"])).parent.as_posix()
        for item in changes if item["directory_unit"] is None
    }, key=os.fsencode)
    expected_directory_parents = sorted({
        str(unit["parent_path"]) for unit in units
    }, key=os.fsencode)
    if (
        [probe["parent_path"] for probe in intent["leaf_capability_probes"]]
        != expected_leaf_parents
        or [probe["parent_path"] for probe in intent["directory_capability_probes"]]
        != expected_directory_parents
        or len(probe_paths) != len(set(probe_paths))
    ):
        raise VibeError("transaction capability probe set is incomplete")
    directory_parent_objects = {
        str(unit["parent_path"]): unit["parent_object"] for unit in units
    }
    if any(
        probe["parent_object"]
        != directory_parent_objects[str(probe["parent_path"])]
        for probe in intent["directory_capability_probes"]
    ):
        raise VibeError("directory capability parent identity is inconsistent")

    capabilities = load_project_json(
        project, transaction_member_path("capabilities.json")
    )
    intent_sha = canonical_json_sha256(intent)
    probe_sha = canonical_json_sha256({
        "leaf_capability_probes": intent["leaf_capability_probes"],
        "directory_capability_probes": intent["directory_capability_probes"],
    })
    if (
        not exact_keys(capabilities, (
            "schema_version", "transaction_id", "intent_sha256",
            "probe_set_sha256", "verified_at",
        ))
        or capabilities.get("schema_version") != TRANSACTION_JOURNAL_SCHEMA
        or capabilities.get("transaction_id") != transaction_id
        or capabilities.get("intent_sha256") != intent_sha
        or capabilities.get("probe_set_sha256") != probe_sha
        or not is_iso8601(capabilities.get("verified_at"))
    ):
        raise VibeError("invalid transaction capabilities")

    prepared = load_project_json(project, transaction_member_path("prepared.json"))
    if (
        not exact_keys(prepared, (
            "schema_version", "transaction_id", "intent_sha256", "stage_set_sha256",
            "preimage_set_sha256", "capabilities_sha256", "leaf_temporaries",
            "leaf_temporary_set_sha256", "directory_stages",
            "directory_stage_set_sha256", "directory_postimage_set_sha256",
            "prepared_at",
        ))
        or prepared.get("schema_version") != TRANSACTION_JOURNAL_SCHEMA
        or prepared.get("transaction_id") != transaction_id
        or prepared.get("intent_sha256") != intent_sha
        or prepared.get("capabilities_sha256") != canonical_json_sha256(capabilities)
        or prepared.get("stage_set_sha256") != canonical_json_sha256([
            {"slot": item["slot"], "sha256": item["postimage"]["sha256"]} for item in changes
        ])
        or prepared.get("preimage_set_sha256") != canonical_json_sha256([
            {"slot": item["slot"], "identity": item["preimage"]} for item in changes
        ])
        or prepared.get("leaf_temporary_set_sha256") != canonical_json_sha256(prepared.get("leaf_temporaries"))
        or prepared.get("directory_stage_set_sha256") != canonical_json_sha256(prepared.get("directory_stages"))
        or prepared.get("directory_postimage_set_sha256") != directory_postimage
        or not is_iso8601(prepared.get("prepared_at"))
    ):
        raise VibeError("invalid prepared transaction")
    leaf_temporaries = prepared.get("leaf_temporaries")
    if not isinstance(leaf_temporaries, list):
        raise VibeError("invalid prepared leaf temporaries")
    for temporary in leaf_temporaries:
        if (
            not exact_keys(temporary, (
                "slot", "path", "temporary_path", "leaf_protocol", "postimage",
                "postimage_object",
            ))
            or not object_identity_valid(temporary.get("postimage_object"))
            or not image_identity_valid(temporary.get("postimage"), absent_allowed=False)
        ):
            raise VibeError("invalid prepared leaf temporary")
        change = next(
            (item for item in changes if item["slot"] == temporary["slot"]), None
        )
        if (
            change is None or change["directory_unit"] is not None
            or temporary["path"] != change["path"]
            or temporary["temporary_path"] != change["temporary_path"]
            or temporary["leaf_protocol"] != change["leaf_protocol"]
            or temporary["postimage"] != change["postimage"]
        ):
            raise VibeError("prepared leaf temporary back-reference mismatch")
    expected_leaf_slots = [
        item["slot"] for item in changes if item["directory_unit"] is None
    ]
    if [item["slot"] for item in leaf_temporaries] != expected_leaf_slots:
        raise VibeError("prepared leaf temporary set is incomplete or unordered")
    directory_stages = prepared.get("directory_stages")
    if not isinstance(directory_stages, list):
        raise VibeError("invalid prepared directory stages")
    for stage in directory_stages:
        if (
            not exact_keys(stage, (
                "unit_id", "final_root", "staging_root", "parent_object",
                "staging_object", "tree_sha256", "tree_objects", "verified_at",
            ))
            or not object_identity_valid(stage.get("parent_object"))
            or not object_identity_valid(stage.get("staging_object"))
            or not isinstance(stage.get("tree_objects"), list)
            or not is_iso8601(stage.get("verified_at"))
        ):
            raise VibeError("invalid prepared directory stage")
        unit = next(
            (value for value in units if value["unit_id"] == stage["unit_id"]), None
        )
        if (
            unit is None or stage["final_root"] != unit["final_root"]
            or stage["staging_root"] != unit["staging_root"]
            or stage["parent_object"] != unit["parent_object"]
            or stage["tree_sha256"] != unit["tree_sha256"]
        ):
            raise VibeError("prepared directory stage back-reference mismatch")
        tree_paths = [str(item.get("path")) for item in stage["tree_objects"]]
        expected_tree_paths = [
            str(item["path"]) for item in unit["directories"]
        ] + [str(item["path"]) for item in unit["members"]]
        expected_tree_paths.sort(
            key=lambda value: (path_depth(value), os.fsencode(value))
        )
        if tree_paths != expected_tree_paths:
            raise VibeError("prepared directory tree object set is incomplete or unordered")
        expected_tree = {
            str(item["path"]): {
                "type": "directory", "mode": item["mode"], "sha256": None,
            }
            for item in unit["directories"]
        }
        expected_tree.update({
            str(item["path"]): {
                "type": "regular", "mode": item["postimage"]["mode"],
                "sha256": item["postimage"]["sha256"],
            }
            for item in unit["members"]
        })
        object_pairs = []
        for tree_object in stage["tree_objects"]:
            if (
                not exact_keys(tree_object, (
                    "path", "type", "device", "inode", "mode", "sha256",
                ))
                or tree_object.get("type") not in ("directory", "regular")
                or not object_identity_valid({
                    "device": tree_object.get("device"), "inode": tree_object.get("inode")
                })
                or not isinstance(tree_object.get("mode"), int)
                or isinstance(tree_object.get("mode"), bool)
                or (tree_object.get("type") == "directory" and tree_object.get("sha256") is not None)
                or (tree_object.get("type") == "regular" and re.fullmatch(r"[0-9a-f]{64}", str(tree_object.get("sha256", ""))) is None)
            ):
                raise VibeError("invalid prepared tree object")
            expected_object = expected_tree[str(tree_object["path"])]
            if any(
                tree_object[key] != expected_object[key]
                for key in ("type", "mode", "sha256")
            ):
                raise VibeError("prepared tree object disagrees with intent")
            object_pairs.append((tree_object["device"], tree_object["inode"]))
        if len(object_pairs) != len(set(object_pairs)):
            raise VibeError("prepared directory tree object identities are duplicated")
        root_object = next(
            item for item in stage["tree_objects"]
            if item["path"] == unit["final_root"]
        )
        if stage["staging_object"] != {
            "device": root_object["device"], "inode": root_object["inode"]
        }:
            raise VibeError("prepared directory root identity is inconsistent")
    if [stage["unit_id"] for stage in directory_stages] != unit_ids:
        raise VibeError("prepared directory stages are incomplete or unordered")
    if intent.get("postimage_set_sha256") != canonical_json_sha256([
        {"path": item["path"], "postimage": item["postimage"]} for item in changes
    ]):
        raise VibeError("transaction postimage-set identity is invalid")
    by_path = {item["path"]: item["postimage"] for item in changes}
    if (
        intent.get("manifest_identity") != by_path.get(MANIFEST_PATH.as_posix())
        or intent.get("agents_identity") != by_path.get("AGENTS.md")
        or intent.get("onboarding_identity") != by_path.get(ONBOARDING_PATH.as_posix())
    ):
        raise VibeError("transaction named identity is invalid")
    return intent, prepared


def active_transaction_state(target: Path) -> Tuple[str, Dict[str, object]]:
    transaction_id: Optional[str] = None
    try:
        with ProjectRootFD(target) as project:
            active_state = project.path_state(transaction_member_path())
            if active_state == "absent":
                return "absent", transaction_shape(None, "not-applied", "absent", "absent")
            if active_state != "directory" or not transaction_control_members_allowlisted_project(project):
                raise VibeError("transaction control path is invalid")
            members = project.list_names(transaction_member_path())
            owner_state = project.path_state(transaction_member_path("owner.json"))
            if owner_state == "absent":
                if not members or all(name.startswith(".vibe-tmp-") for name in members):
                    return "bootstrap", transaction_shape(None, "recovery-required", "preparing", "absent")
                raise VibeError("transaction owner is missing")
            owner = load_project_json(project, transaction_member_path("owner.json"))
            transaction_id = owner.get("transaction_id")  # type: ignore[assignment]
            if (
                set(owner) != {"schema_version", "transaction_id", "project_identity_sha256", "created_at"}
                or owner.get("schema_version") != TRANSACTION_JOURNAL_SCHEMA
                or not isinstance(transaction_id, str) or not transaction_id
                or not is_iso8601(owner.get("created_at"))
                or not re.fullmatch(r"[0-9a-f]{64}", str(owner.get("project_identity_sha256", "")))
                or owner.get("project_identity_sha256") != project.identity_sha256()
            ):
                raise VibeError("invalid owner")
            prepared_state = project.path_state(transaction_member_path("prepared.json"))
            commit_state = project.path_state(transaction_member_path("commit.json"))
            if prepared_state == "absent":
                if commit_state != "absent":
                    raise VibeError("commit marker exists without prepared state")
                return "unprepared", transaction_shape(transaction_id, "recovery-required", "preparing", "absent")
            if prepared_state != "regular":
                raise VibeError("prepared transaction member is invalid")
            intent, _ = validate_transaction_payload(project, owner, transaction_id)
            intent_sha = canonical_json_sha256(intent)
            validate_transaction_events(project, transaction_id)
            if commit_state == "regular":
                commit = load_project_json(project, transaction_member_path("commit.json"))
                if (
                    set(commit) != {
                        "schema_version", "transaction_id", "intent_sha256",
                        "postimage_set_sha256", "directory_postimage_set_sha256",
                        "committed_at",
                    }
                    or commit.get("schema_version") != TRANSACTION_COMMIT_SCHEMA
                    or commit.get("transaction_id") != transaction_id
                    or commit.get("intent_sha256") != intent_sha
                    or commit.get("postimage_set_sha256") != intent.get("postimage_set_sha256")
                    or commit.get("directory_postimage_set_sha256") != intent.get("directory_postimage_set_sha256")
                    or not is_iso8601(commit.get("committed_at"))
                ):
                    raise VibeError("invalid commit marker")
                return "committed", transaction_shape(transaction_id, "committed", "commit-complete", "valid")
            if commit_state != "absent":
                raise VibeError("invalid commit marker")
            return "prepared", transaction_shape(transaction_id, "recovery-required", "prepared", "absent")
    except (OSError, UnicodeError, VibeError, KeyError, TypeError, ValueError):
        return "invalid", transaction_shape(transaction_id, "unknown-partial", "invalid", "invalid")


def fsync_path_directory(path: Path) -> None:
    descriptor = os.open(str(path), os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    try:
        os.fsync(descriptor)
    finally:
        os.close(descriptor)


def write_private_json(
    project: ProjectRootFD, relative: str, value: object
) -> None:
    content = json.dumps(value, ensure_ascii=False, sort_keys=True, separators=(",", ":")).encode("utf-8") + b"\n"
    write_private_bytes(project, relative, content)


def write_private_bytes(
    project: ProjectRootFD, relative: str, content: bytes
) -> None:
    project.write(relative, content, 0o600)


def append_transaction_event(
    project: ProjectRootFD, transaction_id: str, phase: str, previous: str
) -> str:
    path = transaction_member_path("events.jsonl")
    state, existing, _ = project.read(path)
    if state == "absent":
        existing = b""
    elif state != "regular" or existing is None:
        raise VibeError("transaction journal is invalid")
    lines = existing.splitlines(keepends=True)
    if len(existing) > 1024 * 1024 or len(lines) > 4095:
        raise VibeError("transaction journal is too large")
    sequence = len(lines)
    event = {
        "schema_version": TRANSACTION_JOURNAL_SCHEMA,
        "transaction_id": transaction_id,
        "sequence": sequence,
        "phase": phase,
        "previous_sha256": previous,
        "recorded_at": utc_now(),
    }
    line = json.dumps(event, ensure_ascii=False, sort_keys=True, separators=(",", ":")).encode("utf-8") + b"\n"
    project.append(path, line, existing)
    return hashlib.sha256(line).hexdigest()


def transaction_event_head(project: ProjectRootFD) -> str:
    state, content, _ = project.read(transaction_member_path("events.jsonl"))
    if state == "absent":
        return "0" * 64
    if state != "regular" or content is None:
        raise VibeError("transaction journal is invalid")
    lines = content.splitlines(keepends=True)
    return hashlib.sha256(lines[-1]).hexdigest() if lines else "0" * 64


def remove_transaction_control(target: Path) -> None:
    with ProjectRootFD(target) as project:
        remove_transaction_control_project(project)


def remove_transaction_control_project(project: ProjectRootFD) -> None:
    if not transaction_control_members_allowlisted_project(project):
        raise VibeError("transaction state contains an unknown or unsafe member")
    project.remove_tree(TRANSACTION_ACTIVE_PATH.as_posix())


def transaction_control_members_allowlisted_project(project: ProjectRootFD) -> bool:
    allowed_root = {
        "owner.json", "intent.json", "prepared.json", "events.jsonl",
        "capabilities.json", "commit.json", "stage", "preimage",
        "directory-cleanup",
    }
    try:
        if project.path_state(transaction_member_path()) != "directory":
            return False
        for name in project.list_names(transaction_member_path()):
            state = project.path_state(transaction_member_path(name))
            if name.startswith(".vibe-tmp-"):
                if state == "regular":
                    continue
                return False
            if name not in allowed_root:
                return False
            if name in ("stage", "preimage", "directory-cleanup"):
                if state != "directory":
                    return False
                for child in project.list_names(transaction_member_path(name)):
                    expected = (
                        r"d[0-9]{4}\.json"
                        if name == "directory-cleanup" else r"[0-9]{4}"
                    )
                    if (
                        re.fullmatch(expected, child) is None
                        or project.path_state(transaction_member_path(f"{name}/{child}"))
                        != "regular"
                    ):
                        return False
            else:
                if state != "regular":
                    return False
    except (OSError, ValueError, VibeError):
        return False
    return True


def transaction_control_members_allowlisted(target: Path) -> bool:
    try:
        with ProjectRootFD(target) as project:
            return transaction_control_members_allowlisted_project(project)
    except (OSError, VibeError):
        return False


def transaction_installation_state(
    target: Path, intent: Dict[str, object]
) -> Tuple[str, List[str]]:
    with ProjectRootFD(target) as project:
        return transaction_installation_state_project(project, intent)


def directory_unit_installation_state(
    project: ProjectRootFD, unit: Dict[str, object]
) -> str:
    """Classify one absent-parent unit as predecessor, target or divergent."""
    final_root = str(unit["final_root"])
    root_state = project.path_state(final_root)
    if root_state == "absent":
        return "pre"
    if root_state != "directory":
        return "unknown"
    expected_directories = {
        str(item["path"]): int(item["mode"])
        for item in unit["directories"]
    }
    expected_members = {
        str(item["path"]): item["postimage"]
        for item in unit["members"]
    }
    observed = set()

    def walk(relative: str) -> bool:
        expected_mode = expected_directories.get(relative)
        if expected_mode is None:
            return False
        try:
            descriptor = project.open_directory(relative)
            try:
                if stat.S_IMODE(os.fstat(descriptor).st_mode) != expected_mode:
                    return False
                names = sorted(os.listdir(descriptor), key=os.fsencode)
            finally:
                os.close(descriptor)
        except (OSError, VibeError):
            return False
        observed.add(relative)
        for name in names:
            child = f"{relative}/{name}"
            state = project.path_state(child)
            if state == "directory":
                if not walk(child):
                    return False
            elif state == "regular":
                expected_image = expected_members.get(child)
                if expected_image is None:
                    return False
                try:
                    observed_state, content, mode, _ = project.read_entry(child)
                except (OSError, VibeError):
                    return False
                if bytes_identity(observed_state, content, mode) != expected_image:
                    return False
                observed.add(child)
            else:
                return False
        return True

    expected_paths = set(expected_directories) | set(expected_members)
    return "post" if walk(final_root) and observed == expected_paths else "unknown"


def transaction_installation_state_project(
    project: ProjectRootFD, intent: Dict[str, object]
) -> Tuple[str, List[str]]:
    mismatched: List[str] = []
    states = set()
    directory_member_slots = {
        str(member["slot"])
        for unit in intent.get("directory_units", [])
        for member in unit["members"]
    }
    for unit in intent.get("directory_units", []):
        state = directory_unit_installation_state(project, unit)
        states.add(state)
        if state == "unknown":
            mismatched.append(str(unit["final_root"]))
    for item in intent["changes"]:
        if str(item["slot"]) in directory_member_slots:
            continue
        try:
            state, content, mode = project.read(item["path"])
        except (OSError, VibeError):
            states.add("unknown")
            mismatched.append(str(item["path"]))
            continue
        current = bytes_identity(state, content, mode)
        if current == item["preimage"]:
            states.add("pre")
        elif current == item["postimage"]:
            states.add("post")
        else:
            states.add("unknown")
            mismatched.append(item["path"])
    if "unknown" in states:
        return "unknown", mismatched
    if states == {"pre"}:
        return "predecessor", []
    if states == {"post"}:
        return "target", []
    return "recovery-required", []


def independently_authenticated_installation(
    target: Path,
) -> Tuple[bool, Optional[str], Optional[str]]:
    """Prove an inactive/prepared predecessor from its exact installed contract."""
    try:
        with ProjectRootFD(target) as project:
            manifest_state, manifest_bytes, _ = project.read(MANIFEST_PATH.as_posix())
            if manifest_state != "regular" or manifest_bytes is None:
                return False, None, MANIFEST_PATH.as_posix()
            manifest = load_project_json(project, MANIFEST_PATH.as_posix())
            version = manifest.get("framework_version")
            managed = manifest.get("managed_files")
            agents_hash = manifest.get("agents_block_hash")
            if (
                manifest.get("schema_version") != 1
                or not strict_semver(version)
                or not isinstance(managed, dict) or not managed
                or not isinstance(agents_hash, str)
                or re.fullmatch(r"[0-9a-f]{64}", agents_hash) is None
                or canonical_install_identity(manifest) is None
            ):
                return False, str(version) if version is not None else None, MANIFEST_PATH.as_posix()
            version_bytes = (str(version) + "\n").encode("utf-8")
            installed_state, installed_bytes, _ = project.read(
                INSTALLED_VERSION_PATH.as_posix()
            )
            if installed_state != "regular" or installed_bytes != version_bytes:
                return False, str(version), INSTALLED_VERSION_PATH.as_posix()
            normalized: Dict[str, str] = {}
            for relative, expected in managed.items():
                if (
                    safe_project_relative_path(relative) is None
                    or not isinstance(expected, str)
                    or re.fullmatch(r"[0-9a-f]{64}", expected) is None
                ):
                    return False, str(version), MANIFEST_PATH.as_posix()
                state, content, _ = project.read(str(relative))
                if (
                    state != "regular" or content is None
                    or hashlib.sha256(content).hexdigest() != expected
                ):
                    return False, str(version), str(relative)
                normalized[str(relative)] = expected
            for required in ("bin/vibe", ".vibe/core/version", ".vibe/core/protocol.json"):
                if required not in normalized:
                    return False, str(version), MANIFEST_PATH.as_posix()
            if normalized[".vibe/core/version"] != hashlib.sha256(version_bytes).hexdigest():
                return False, str(version), ".vibe/core/version"
            agents_state, agents_bytes, _ = project.read("AGENTS.md")
            if agents_state != "regular" or agents_bytes is None:
                return False, str(version), "AGENTS.md"
            try:
                agents_block = extract_agents_block(agents_bytes.decode("utf-8"))
            except (UnicodeError, VibeError):
                return False, str(version), "AGENTS.md"
            if agents_block is None or sha256_text(agents_block) != agents_hash:
                return False, str(version), "AGENTS.md"

            legacy = [
                entry for entry in PREDECESSOR_MIGRATION_REGISTRY["entries"]
                if entry.get("mode") == "create-pending-onboarding-if-absent"
                and entry.get("framework_version") == version
            ]
            if legacy:
                if len(legacy) != 1:
                    return False, str(version), MANIFEST_PATH.as_posix()
                entry = legacy[0]
                if (
                    hashlib.sha256(manifest_bytes).hexdigest() != entry["manifest_sha256"]
                    or manifest.get("managed_files") != entry["managed_files"]
                    or canonical_install_identity(manifest) != entry["install_identity_sha256"]
                    or agents_hash != entry["agents_block_sha256"]
                ):
                    return False, str(version), MANIFEST_PATH.as_posix()
                for relative in (
                    "AGENT_INSTALL.md", "agent-install.json", ONBOARDING_PATH.as_posix()
                ):
                    if project.path_state(relative) != "absent":
                        return False, str(version), relative
            if version == PREDECESSOR_MIGRATION_ENTRY["predecessor"]["framework_version"]:
                predecessor = PREDECESSOR_MIGRATION_ENTRY["predecessor"]
                if canonical_install_identity(manifest) != predecessor["install_identity_sha256"]:
                    return False, str(version), MANIFEST_PATH.as_posix()
                for relative, expected in PREDECESSOR_MIGRATION_ENTRY["paths"].items():
                    state, content, _ = project.read(relative)
                    if (
                        state != "regular" or content is None
                        or hashlib.sha256(content).hexdigest() != expected
                    ):
                        return False, str(version), relative
            return True, str(version), None
    except (OSError, UnicodeError, VibeError, KeyError, TypeError):
        return False, None, None


def upgrade_change(
    project: ProjectRootFD, slot: int, relative: str, content: bytes, mode: int
) -> Dict[str, object]:
    state, previous, previous_mode, previous_object = project.read_entry(relative)
    if state not in ("absent", "regular"):
        raise VibeError(
            f"upgrade path is not a regular file: {relative}",
            "upgrade_path_invalid",
        )
    parent_state, parent_path, parent_object, final_root = project.parent_layout(
        relative
    )
    if state == "regular" and parent_state != "existing":
        raise VibeError("regular upgrade leaf has an absent parent")
    return {
        "slot": f"{slot:04d}",
        "path": relative,
        "preimage": bytes_identity(state, previous, previous_mode),
        "postimage": bytes_identity("regular", content, mode),
        "_preimage_object": previous_object,
        "_parent_state": parent_state,
        "_parent_path": parent_path,
        "_parent_object": parent_object,
        "_final_root": final_root,
        "_preimage_bytes": previous,
        "_postimage_bytes": content,
    }


def sibling_path(parent_path: str, basename: str) -> str:
    return basename if parent_path == "." else f"{parent_path}/{basename}"


def path_depth(relative: str) -> int:
    return len(PurePosixPath(relative).parts)


def object_identity_valid(value: object) -> bool:
    return bool(
        exact_keys(value, ("device", "inode"))
        and all(
            isinstance(value.get(key), int)
            and not isinstance(value.get(key), bool)
            and value.get(key) >= 0
            for key in ("device", "inode")
        )
    )


def revalidate_change_preimage(
    project: ProjectRootFD, change: Dict[str, object]
) -> None:
    if project.directory_object(str(change["_parent_path"])) != change["_parent_object"]:
        raise VibeError(
            "upgrade parent changed before transaction preparation",
            "upgrade_leaf_race_preserved",
        )
    final_root = change.get("_final_root")
    if final_root is not None:
        if project.path_state(str(final_root)) != "absent":
            raise VibeError(
                "upgrade directory root appeared before preparation",
                "upgrade_directory_race_preserved",
            )
        return
    state, content, mode, observed_object = project.read_entry(str(change["path"]))
    if (
        bytes_identity(state, content, mode) != change["preimage"]
        or observed_object != change["_preimage_object"]
    ):
        raise VibeError(
            "upgrade preimage changed before transaction preparation",
            "upgrade_leaf_race_preserved",
        )


def transaction_layout(
    project: ProjectRootFD,
    transaction_id: str,
    changes: Sequence[Dict[str, object]],
) -> Tuple[
    List[Dict[str, object]],
    List[Dict[str, object]],
    List[Dict[str, object]],
    List[Dict[str, object]],
]:
    managed_paths = {
        path.relative_to(source_root()).as_posix()
        for path in managed_source_files(source_root())
    }
    groups: Dict[str, List[Dict[str, object]]] = {}
    for change in changes:
        revalidate_change_preimage(project, change)
        final_root = change.get("_final_root")
        if final_root is None:
            continue
        relative = str(change["path"])
        if relative not in managed_paths or change["preimage"]["state"] != "absent":
            raise VibeError("absent-parent directory unit is outside managed scope")
        groups.setdefault(str(final_root), []).append(change)

    roots = sorted(groups, key=lambda root: (min(int(item["slot"]) for item in groups[root]), os.fsencode(root)))
    for left in roots:
        for right in roots:
            if left != right and PurePosixPath(right).is_relative_to(PurePosixPath(left)):
                raise VibeError("directory units overlap")

    directory_units: List[Dict[str, object]] = []
    unit_for_path: Dict[str, str] = {}
    for index, final_root in enumerate(roots, start=1):
        members_source = sorted(groups[final_root], key=lambda item: str(item["slot"]))
        member_slots = [int(item["slot"]) for item in members_source]
        if member_slots != list(range(min(member_slots), max(member_slots) + 1)):
            raise VibeError("directory unit members are not contiguous in slot order")
        unit_id = f"d{index:04d}"
        parent_path = str(members_source[0]["_parent_path"])
        parent_object = copy.deepcopy(members_source[0]["_parent_object"])
        if any(
            item["_parent_path"] != parent_path
            or item["_parent_object"] != parent_object
            for item in members_source
        ):
            raise VibeError("directory unit parent identities disagree")
        directories_set = {final_root}
        root_parts = PurePosixPath(final_root).parts
        for item in members_source:
            member_parent = PurePosixPath(str(item["path"])).parent
            while len(member_parent.parts) >= len(root_parts):
                directories_set.add(member_parent.as_posix())
                if member_parent.parts == root_parts:
                    break
                member_parent = member_parent.parent
        directories = [
            {"path": value, "mode": 0o755}
            for value in sorted(
                directories_set, key=lambda value: (path_depth(value), os.fsencode(value))
            )
        ]
        members = [
            {
                "slot": item["slot"],
                "path": item["path"],
                "postimage": copy.deepcopy(item["postimage"]),
            }
            for item in members_source
        ]
        tree_sha = canonical_json_sha256(
            {"directories": directories, "members": members}
        )
        staging_root = sibling_path(
            parent_path,
            f"{DIRECTORY_STAGE_PREFIX}{transaction_id[:16]}-{unit_id}",
        )
        unit = {
            "unit_id": unit_id,
            "sequence": min(int(item["slot"]) for item in members_source),
            "parent_path": parent_path,
            "parent_object": parent_object,
            "final_root": final_root,
            "staging_root": staging_root,
            "protocol": "directory-no-clobber-v1",
            "preimage_state": "absent",
            "directories": directories,
            "members": members,
            "tree_sha256": tree_sha,
        }
        directory_units.append(unit)
        for item in members_source:
            unit_for_path[str(item["path"])] = unit_id

    intent_changes: List[Dict[str, object]] = []
    for change in changes:
        unit_id = unit_for_path.get(str(change["path"]))
        if unit_id is None:
            parent_path = str(change["_parent_path"])
            temporary_path: Optional[str] = sibling_path(
                parent_path,
                f"{LEAF_TEMPORARY_PREFIX}{transaction_id[:16]}-{change['slot']}",
            )
            leaf_protocol = (
                "link-no-clobber-v1"
                if change["preimage"]["state"] == "absent"
                else "exchange-preserve-v1"
            )
        else:
            temporary_path = None
            leaf_protocol = "directory-unit-member-v1"
        intent_changes.append({
            "slot": change["slot"],
            "path": change["path"],
            "leaf_protocol": leaf_protocol,
            "temporary_path": temporary_path,
            "directory_unit": unit_id,
            "preimage": copy.deepcopy(change["preimage"]),
            "postimage": copy.deepcopy(change["postimage"]),
            "preimage_object": copy.deepcopy(change["_preimage_object"]),
        })

    leaf_parents = sorted({
        str(change["_parent_path"])
        for change in changes if unit_for_path.get(str(change["path"])) is None
    }, key=os.fsencode)
    leaf_probes = []
    for index, parent_path in enumerate(leaf_parents, start=1):
        stem = f"{CAPABILITY_PROBE_PREFIX}{transaction_id[:12]}-l{index:04d}"
        leaf_probes.append({
            "parent_path": parent_path,
            "probe_a_path": sibling_path(parent_path, stem + "-a"),
            "probe_b_path": sibling_path(parent_path, stem + "-b"),
            "requires_hard_link": True,
            "requires_no_replace": True,
            "requires_exchange": True,
        })
    directory_parents: Dict[str, Dict[str, object]] = {}
    for unit in directory_units:
        directory_parents[str(unit["parent_path"])] = copy.deepcopy(unit["parent_object"])
    directory_probes = []
    for index, parent_path in enumerate(sorted(directory_parents, key=os.fsencode), start=1):
        stem = f"{CAPABILITY_PROBE_PREFIX}{transaction_id[:12]}-d{index:04d}"
        directory_probes.append({
            "parent_path": parent_path,
            "parent_object": directory_parents[parent_path],
            "probe_a_path": sibling_path(parent_path, stem + "-a"),
            "probe_b_path": sibling_path(parent_path, stem + "-b"),
            "requires_directory_no_replace": True,
        })
    return intent_changes, directory_units, leaf_probes, directory_probes


def entry_matches(
    project: ProjectRootFD, relative: str, image: Dict[str, object],
    identity: Optional[Dict[str, object]],
) -> bool:
    state, content, mode, observed = project.read_entry(relative)
    return bytes_identity(state, content, mode) == image and observed == identity


def atomicity_os_error(error: OSError) -> BaseException:
    if error.errno in LEAF_ATOMICITY_UNSUPPORTED_ERRNOS:
        return VibeError(
            "required lossless rename primitive is unsupported by this filesystem",
            "upgrade_leaf_atomicity_unsupported",
        )
    return error


def expect_exists(error: OSError) -> None:
    if error.errno != errno.EEXIST:
        raise atomicity_os_error(error)


def leaf_capability_probe(
    project: ProjectRootFD,
    adapter: LeafAtomicityAdapter,
    probe: Dict[str, object],
) -> None:
    parent_path = str(probe["parent_path"])
    a_path = str(probe["probe_a_path"])
    b_path = str(probe["probe_b_path"])
    a_image = bytes_identity("regular", b"vibe-probe-a\n", 0o600)
    b_image = bytes_identity("regular", b"vibe-probe-b\n", 0o600)
    a_object = project.create_regular_exclusive(a_path, b"vibe-probe-a\n", 0o600)
    b_object = project.create_regular_exclusive(b_path, b"vibe-probe-b\n", 0o600)
    parent = project.open_directory(parent_path)
    a_leaf = PurePosixPath(a_path).name
    b_leaf = PurePosixPath(b_path).name
    try:
        adapter.exchange(parent, a_leaf, parent, b_leaf)
        os.fsync(parent)
        if not entry_matches(project, a_path, b_image, b_object) or not entry_matches(
            project, b_path, a_image, a_object
        ):
            raise VibeError("exchange capability probe did not preserve identities")
        adapter.exchange(parent, a_leaf, parent, b_leaf)
        os.fsync(parent)
        if not entry_matches(project, a_path, a_image, a_object) or not entry_matches(
            project, b_path, b_image, b_object
        ):
            raise VibeError("exchange capability round trip failed")

        project.unlink_exact_private(b_path, b_object, b_image)
        os.link(
            a_leaf, b_leaf, src_dir_fd=parent, dst_dir_fd=parent,
            follow_symlinks=False,
        )
        os.fsync(parent)
        if not entry_matches(project, b_path, a_image, a_object):
            raise VibeError("hard-link capability probe lost identity")
        try:
            os.link(
                a_leaf, b_leaf, src_dir_fd=parent, dst_dir_fd=parent,
                follow_symlinks=False,
            )
        except OSError as error:
            expect_exists(error)
        else:
            raise VibeError("hard-link capability probe overwrote a destination")
        project.unlink_exact_private(b_path, a_object, a_image)

        try:
            adapter.no_replace(parent, a_leaf, parent, b_leaf)
        except OSError as error:
            raise atomicity_os_error(error)
        os.fsync(parent)
        if project.path_state(a_path) != "absent" or not entry_matches(
            project, b_path, a_image, a_object
        ):
            raise VibeError("no-replace capability probe failed")
        recreated = project.create_regular_exclusive(a_path, b"vibe-probe-b\n", 0o600)
        try:
            adapter.no_replace(parent, a_leaf, parent, b_leaf)
        except OSError as error:
            expect_exists(error)
        else:
            raise VibeError("no-replace capability probe replaced an existing leaf")
        if not entry_matches(project, a_path, b_image, recreated) or not entry_matches(
            project, b_path, a_image, a_object
        ):
            raise VibeError("no-replace EEXIST probe mutated an entry")
        project.unlink_exact_private(a_path, recreated, b_image)
        project.unlink_exact_private(b_path, a_object, a_image)
    finally:
        os.close(parent)


def exact_probe_directory(
    project: ProjectRootFD, relative: str, root_object: Dict[str, object],
    marker_object: Dict[str, object], marker_bytes: bytes,
) -> bool:
    try:
        descriptor = project.open_directory(relative)
    except (OSError, VibeError):
        return False
    try:
        if project.object_identity(os.fstat(descriptor)) != root_object:
            return False
        if sorted(os.listdir(descriptor)) != ["marker"]:
            return False
    finally:
        os.close(descriptor)
    image = bytes_identity("regular", marker_bytes, 0o600)
    return entry_matches(project, f"{relative}/marker", image, marker_object)


def remove_exact_probe_directory(
    project: ProjectRootFD, relative: str, root_object: Dict[str, object],
    marker_object: Dict[str, object], marker_bytes: bytes,
    parent_object: Dict[str, object],
) -> None:
    if not exact_probe_directory(
        project, relative, root_object, marker_object, marker_bytes
    ):
        raise VibeError("directory capability probe changed during cleanup")
    project.remove_tree(relative, parent_object)


def directory_capability_probe(
    project: ProjectRootFD,
    adapter: LeafAtomicityAdapter,
    probe: Dict[str, object],
) -> None:
    parent_path = str(probe["parent_path"])
    if project.directory_object(parent_path) != probe["parent_object"]:
        raise VibeError("directory capability parent identity changed")
    a_path = str(probe["probe_a_path"])
    b_path = str(probe["probe_b_path"])
    marker_a = b"vibe-directory-probe-a\n"
    marker_b = b"vibe-directory-probe-b\n"
    project.mkdir(a_path, 0o700)
    a_root = project.directory_object(a_path)
    a_marker = project.create_regular_exclusive(f"{a_path}/marker", marker_a, 0o600)
    project.mkdir(b_path, 0o700)
    b_root = project.directory_object(b_path)
    b_marker = project.create_regular_exclusive(f"{b_path}/marker", marker_b, 0o600)
    a_leaf = PurePosixPath(a_path).name
    b_leaf = PurePosixPath(b_path).name
    parent = project.require_directory_object(parent_path, probe["parent_object"])
    try:
        try:
            adapter.no_replace(parent, a_leaf, parent, b_leaf)
        except OSError as error:
            expect_exists(error)
        else:
            raise VibeError("directory no-replace probe replaced an existing root")
        if not exact_probe_directory(project, a_path, a_root, a_marker, marker_a) or not exact_probe_directory(
            project, b_path, b_root, b_marker, marker_b
        ):
            raise VibeError("directory EEXIST probe mutated a root")
    finally:
        os.close(parent)
    if project.directory_object(parent_path) != probe["parent_object"]:
        raise VibeError("directory capability parent identity changed")
    remove_exact_probe_directory(
        project, b_path, b_root, b_marker, marker_b, probe["parent_object"]
    )
    parent = project.require_directory_object(parent_path, probe["parent_object"])
    try:
        try:
            adapter.no_replace(parent, a_leaf, parent, b_leaf)
            os.fsync(parent)
        except OSError as error:
            raise atomicity_os_error(error)
    finally:
        os.close(parent)
    parent = project.require_directory_object(parent_path, probe["parent_object"])
    try:
        try:
            adapter.no_replace(parent, b_leaf, parent, a_leaf)
            os.fsync(parent)
        except OSError as error:
            raise atomicity_os_error(error)
    finally:
        os.close(parent)
    if not exact_probe_directory(project, a_path, a_root, a_marker, marker_a):
        raise VibeError("directory no-replace round trip failed")
    if project.directory_object(parent_path) != probe["parent_object"]:
        raise VibeError("directory capability parent identity changed")
    remove_exact_probe_directory(
        project, a_path, a_root, a_marker, marker_a, probe["parent_object"]
    )


def run_transaction_capability_probes(
    project: ProjectRootFD,
    transaction_id: str,
    intent: Dict[str, object],
    adapter: LeafAtomicityAdapter,
) -> Dict[str, object]:
    for probe in intent["leaf_capability_probes"]:
        leaf_capability_probe(project, adapter, probe)
    for probe in intent["directory_capability_probes"]:
        directory_capability_probe(project, adapter, probe)
    probe_set = {
        "leaf_capability_probes": intent["leaf_capability_probes"],
        "directory_capability_probes": intent["directory_capability_probes"],
    }
    return {
        "schema_version": TRANSACTION_JOURNAL_SCHEMA,
        "transaction_id": transaction_id,
        "intent_sha256": canonical_json_sha256(intent),
        "probe_set_sha256": canonical_json_sha256(probe_set),
        "verified_at": utc_now(),
    }


def logical_to_staging_path(unit: Dict[str, object], logical: str) -> str:
    root = PurePosixPath(str(unit["final_root"]))
    suffix = PurePosixPath(logical).relative_to(root)
    stage = PurePosixPath(str(unit["staging_root"]))
    return stage.as_posix() if str(suffix) == "." else (stage / suffix).as_posix()


def construct_directory_stage(
    project: ProjectRootFD, unit: Dict[str, object]
) -> Dict[str, object]:
    if project.directory_object(str(unit["parent_path"])) != unit["parent_object"]:
        raise VibeError("directory-unit parent identity changed")
    if project.path_state(str(unit["final_root"])) != "absent" or project.path_state(
        str(unit["staging_root"])
    ) != "absent":
        raise VibeError("directory-unit namespace changed")
    for directory in unit["directories"]:
        actual = logical_to_staging_path(unit, str(directory["path"]))
        project.mkdir(actual, int(directory["mode"]))
        descriptor = project.open_directory(actual)
        try:
            os.fchmod(descriptor, int(directory["mode"]))
            os.fsync(descriptor)
        finally:
            os.close(descriptor)
    tree_objects: List[Dict[str, object]] = []
    for directory in unit["directories"]:
        logical = str(directory["path"])
        actual = logical_to_staging_path(unit, logical)
        descriptor = project.open_directory(actual)
        try:
            metadata = os.fstat(descriptor)
            if stat.S_IMODE(metadata.st_mode) != int(directory["mode"]):
                raise VibeError("directory stage mode mismatch")
            tree_objects.append({
                "path": logical,
                "type": "directory",
                **project.object_identity(metadata),
                "mode": stat.S_IMODE(metadata.st_mode),
                "sha256": None,
            })
        finally:
            os.close(descriptor)
    for member in unit["members"]:
        slot = str(member["slot"])
        state, content, _ = project.read(transaction_member_path(f"stage/{slot}"))
        if state != "regular" or content is None or hashlib.sha256(content).hexdigest() != member["postimage"]["sha256"]:
            raise VibeError("directory stage source changed")
        actual = logical_to_staging_path(unit, str(member["path"]))
        identity = project.create_regular_exclusive(
            actual, content, int(member["postimage"]["mode"])
        )
        tree_objects.append({
            "path": member["path"],
            "type": "regular",
            **identity,
            "mode": member["postimage"]["mode"],
            "sha256": member["postimage"]["sha256"],
        })
    tree_objects.sort(key=lambda item: (path_depth(str(item["path"])), os.fsencode(str(item["path"]))))
    staging_object = project.directory_object(str(unit["staging_root"]))
    stage = {
        "unit_id": unit["unit_id"],
        "final_root": unit["final_root"],
        "staging_root": unit["staging_root"],
        "parent_object": copy.deepcopy(unit["parent_object"]),
        "staging_object": staging_object,
        "tree_sha256": unit["tree_sha256"],
        "tree_objects": tree_objects,
        "verified_at": utc_now(),
    }
    if not verify_directory_tree(project, unit, stage, at_final=False):
        raise VibeError("constructed directory stage failed exact verification")
    return stage


def verify_directory_tree(
    project: ProjectRootFD, unit: Dict[str, object], stage: Dict[str, object],
    *, at_final: bool,
) -> bool:
    base = str(unit["final_root"] if at_final else unit["staging_root"])
    expected = {str(item["path"]): item for item in stage["tree_objects"]}
    observed_paths: List[str] = []

    def walk(actual: str, logical: str) -> bool:
        try:
            descriptor = project.open_directory(actual)
        except (OSError, VibeError):
            return False
        try:
            metadata = os.fstat(descriptor)
            item = expected.get(logical)
            if (
                item is None or item["type"] != "directory"
                or project.object_identity(metadata) != {"device": item["device"], "inode": item["inode"]}
                or stat.S_IMODE(metadata.st_mode) != item["mode"]
            ):
                return False
            observed_paths.append(logical)
            names = sorted(os.listdir(descriptor), key=os.fsencode)
        finally:
            os.close(descriptor)
        for name in names:
            actual_child = f"{actual}/{name}"
            logical_child = f"{logical}/{name}"
            state = project.path_state(actual_child)
            if state == "directory":
                if not walk(actual_child, logical_child):
                    return False
            elif state == "regular":
                item = expected.get(logical_child)
                if item is None or item["type"] != "regular":
                    return False
                image = {
                    "state": "regular", "type": "regular",
                    "sha256": item["sha256"], "mode": item["mode"],
                }
                if not entry_matches(
                    project, actual_child, image,
                    {"device": item["device"], "inode": item["inode"]},
                ):
                    return False
                observed_paths.append(logical_child)
            else:
                return False
        return True

    return walk(base, str(unit["final_root"])) and set(observed_paths) == set(expected)


def create_leaf_temporaries(
    project: ProjectRootFD, intent: Dict[str, object]
) -> List[Dict[str, object]]:
    result = []
    for item in intent["changes"]:
        if item["directory_unit"] is not None:
            continue
        state, content, _ = project.read(
            transaction_member_path(f"stage/{item['slot']}")
        )
        if state != "regular" or content is None or hashlib.sha256(content).hexdigest() != item["postimage"]["sha256"]:
            raise VibeError("staged postimage changed")
        identity = project.create_regular_exclusive(
            str(item["temporary_path"]), content, int(item["postimage"]["mode"])
        )
        result.append({
            "slot": item["slot"],
            "path": item["path"],
            "temporary_path": item["temporary_path"],
            "leaf_protocol": item["leaf_protocol"],
            "postimage": copy.deepcopy(item["postimage"]),
            "postimage_object": identity,
        })
    return sorted(result, key=lambda item: str(item["slot"]))


def namespace_snapshot(
    project: ProjectRootFD, relative: str
) -> Dict[str, object]:
    try:
        parent, leaf = project.parent(relative)
    except FileNotFoundError:
        return {"state": "absent", "object": None, "image": None}
    try:
        try:
            metadata = os.stat(leaf, dir_fd=parent, follow_symlinks=False)
        except FileNotFoundError:
            return {"state": "absent", "object": None, "image": None}
        identity = project.object_identity(metadata)
        if stat.S_ISREG(metadata.st_mode):
            state, content, mode, observed = project.read_entry(relative)
            return {
                "state": "regular", "object": observed,
                "image": bytes_identity(state, content, mode),
            }
        if stat.S_ISDIR(metadata.st_mode):
            kind = "directory"
        elif stat.S_ISLNK(metadata.st_mode):
            kind = "symlink"
        else:
            kind = "other"
        return {"state": kind, "object": identity, "image": None}
    finally:
        os.close(parent)


def mutate_leaf_forward(
    project: ProjectRootFD,
    adapter: LeafAtomicityAdapter,
    item: Dict[str, object],
    temporary: Dict[str, object],
) -> None:
    relative = str(item["path"])
    temporary_path = str(item["temporary_path"])
    parent_path = PurePosixPath(relative).parent.as_posix()
    parent_path = "." if parent_path == "." else parent_path
    parent = project.open_directory(parent_path)
    final_leaf = PurePosixPath(relative).name
    temporary_leaf = PurePosixPath(temporary_path).name
    try:
        if not entry_matches(
            project, temporary_path, temporary["postimage"],
            temporary["postimage_object"],
        ):
            raise VibeError("prepared leaf temporary changed")
        if item["leaf_protocol"] == "link-no-clobber-v1":
            try:
                project.link_no_clobber(temporary_path, relative)
            except OSError as error:
                if error.errno == errno.EEXIST:
                    raise VibeError(
                        "a third-party object won the final leaf race",
                        "upgrade_leaf_race_preserved",
                    ) from error
                raise atomicity_os_error(error)
            if not entry_matches(
                project, relative, item["postimage"], temporary["postimage_object"]
            ) or not entry_matches(
                project, temporary_path, temporary["postimage"],
                temporary["postimage_object"],
            ):
                raise VibeError(
                    "published hard-link pair diverged",
                    "upgrade_leaf_race_preserved",
                )
            return

        if item["leaf_protocol"] != "exchange-preserve-v1":
            raise VibeError("unknown prepared leaf protocol")
        try:
            adapter.exchange(parent, temporary_leaf, parent, final_leaf)
        except OSError as error:
            raise atomicity_os_error(error)
        os.fsync(parent)
        final_exact = entry_matches(
            project, relative, item["postimage"], temporary["postimage_object"]
        )
        displaced_exact = entry_matches(
            project, temporary_path, item["preimage"], item["preimage_object"]
        )
        if final_exact and displaced_exact:
            return
        displaced = namespace_snapshot(project, temporary_path)
        if final_exact:
            try:
                adapter.exchange(parent, temporary_leaf, parent, final_leaf)
                os.fsync(parent)
            except OSError as error:
                raise VibeError(
                    "external final-leaf race could not be compensated",
                    "upgrade_leaf_race_preserved",
                ) from error
            if namespace_snapshot(project, relative) != displaced or not entry_matches(
                project, temporary_path, item["postimage"],
                temporary["postimage_object"],
            ):
                raise VibeError(
                    "external final-leaf race compensation is ambiguous",
                    "upgrade_leaf_race_preserved",
                )
            project.unlink_exact_private(
                temporary_path, temporary["postimage_object"], item["postimage"]
            )
        raise VibeError(
            "external final-leaf race was preserved",
            "upgrade_leaf_race_preserved",
        )
    finally:
        os.close(parent)


def publish_directory_unit(
    project: ProjectRootFD,
    adapter: LeafAtomicityAdapter,
    unit: Dict[str, object],
    stage: Dict[str, object],
) -> None:
    stage_leaf = PurePosixPath(str(unit["staging_root"])).name
    final_leaf = PurePosixPath(str(unit["final_root"])).name
    if project.path_state(str(unit["final_root"])) != "absent" or not verify_directory_tree(
        project, unit, stage, at_final=False
    ):
        raise VibeError(
            "directory-unit namespace changed before publication",
            "upgrade_directory_race_preserved",
        )
    parent = project.require_directory_object(
        str(unit["parent_path"]), unit["parent_object"]
    )
    try:
        try:
            adapter.no_replace(parent, stage_leaf, parent, final_leaf)
        except OSError as error:
            if error.errno == errno.EEXIST:
                raise VibeError(
                    "a third-party object won the final directory race",
                    "upgrade_directory_race_preserved",
                ) from error
            raise atomicity_os_error(error)
        os.fsync(parent)
        if project.path_state(str(unit["staging_root"])) != "absent" or not verify_directory_tree(
            project, unit, stage, at_final=True
        ):
            raise VibeError(
                "published directory unit diverged",
                "upgrade_directory_race_preserved",
            )
        for directory in reversed(unit["directories"]):
            descriptor = project.open_directory(str(directory["path"]))
            try:
                os.fsync(descriptor)
            finally:
                os.close(descriptor)
    finally:
        os.close(parent)


def load_prepared_transaction(
    project: ProjectRootFD,
) -> Dict[str, object]:
    return load_project_json(project, transaction_member_path("prepared.json"))


def transaction_maps(
    intent: Dict[str, object], prepared: Dict[str, object]
) -> Tuple[Dict[str, Dict[str, object]], Dict[str, Dict[str, object]], Dict[str, Dict[str, object]]]:
    changes = {str(item["slot"]): item for item in intent["changes"]}
    temporaries = {str(item["slot"]): item for item in prepared["leaf_temporaries"]}
    stages = {str(item["unit_id"]): item for item in prepared["directory_stages"]}
    return changes, temporaries, stages


def verify_prepared_pairs(
    project: ProjectRootFD, intent: Dict[str, object], prepared: Dict[str, object]
) -> Tuple[bool, Optional[str]]:
    _, temporaries, stages = transaction_maps(intent, prepared)
    for unit in intent["directory_units"]:
        stage = stages.get(str(unit["unit_id"]))
        if stage is None or project.path_state(str(unit["staging_root"])) != "absent" or not verify_directory_tree(
            project, unit, stage, at_final=True
        ):
            return False, str(unit["final_root"])
    for item in intent["changes"]:
        if item["directory_unit"] is not None:
            continue
        temporary = temporaries.get(str(item["slot"]))
        if temporary is None:
            return False, str(item["path"])
        if not entry_matches(
            project, str(item["path"]), item["postimage"],
            temporary["postimage_object"],
        ):
            return False, str(item["path"])
        if item["leaf_protocol"] == "link-no-clobber-v1":
            if not entry_matches(
                project, str(item["temporary_path"]), item["postimage"],
                temporary["postimage_object"],
            ):
                return False, str(item["path"])
        elif not entry_matches(
            project, str(item["temporary_path"]), item["preimage"],
            item["preimage_object"],
        ):
            return False, str(item["path"])
    return True, None


def cleanup_committed_private_objects(
    project: ProjectRootFD, intent: Dict[str, object], prepared: Dict[str, object]
) -> None:
    _, temporaries, _ = transaction_maps(intent, prepared)
    for item in intent["changes"]:
        if item["directory_unit"] is not None:
            continue
        temporary = temporaries[str(item["slot"])]
        expected_image = (
            item["postimage"]
            if item["leaf_protocol"] == "link-no-clobber-v1"
            else item["preimage"]
        )
        expected_object = (
            temporary["postimage_object"]
            if item["leaf_protocol"] == "link-no-clobber-v1"
            else item["preimage_object"]
        )
        if project.path_state(str(item["temporary_path"])) == "absent":
            continue
        project.unlink_exact_private(
            str(item["temporary_path"]), expected_object, expected_image
        )


def committed_pairs_valid(
    project: ProjectRootFD, intent: Dict[str, object], prepared: Dict[str, object]
) -> Tuple[bool, Optional[str]]:
    _, temporaries, stages = transaction_maps(intent, prepared)
    for unit in intent["directory_units"]:
        stage = stages.get(str(unit["unit_id"]))
        if stage is None or project.path_state(str(unit["staging_root"])) != "absent" or not verify_directory_tree(
            project, unit, stage, at_final=True
        ):
            return False, str(unit["final_root"])
    for item in intent["changes"]:
        if item["directory_unit"] is not None:
            continue
        temporary = temporaries.get(str(item["slot"]))
        if temporary is None or not entry_matches(
            project, str(item["path"]), item["postimage"],
            temporary["postimage_object"],
        ):
            return False, str(item["path"])
        temporary_path = str(item["temporary_path"])
        if project.path_state(temporary_path) == "absent":
            continue
        image = (
            item["postimage"]
            if item["leaf_protocol"] == "link-no-clobber-v1"
            else item["preimage"]
        )
        identity = (
            temporary["postimage_object"]
            if item["leaf_protocol"] == "link-no-clobber-v1"
            else item["preimage_object"]
        )
        if not entry_matches(project, temporary_path, image, identity):
            return False, str(item["path"])
    return True, None


def _prepare_transaction_state_impl(
    target: Path,
    from_version: str,
    target_version: str,
    changes: Sequence[Dict[str, object]],
) -> Tuple[str, Dict[str, object], str]:
    adapter = leaf_atomicity_api_preflight()
    with ProjectRootFD(target) as project:
        active_state = project.path_state(transaction_member_path())
        if active_state != "absent":
            raise VibeError("upgrade transaction control path is not safely absent")
        project.mkdir(transaction_member_path(), 0o700, parents=True)
        transaction_id = hashlib.sha256(os.urandom(32)).hexdigest()
        project_identity = project.identity_sha256()
        owner = {
            "schema_version": TRANSACTION_JOURNAL_SCHEMA,
            "transaction_id": transaction_id,
            "project_identity_sha256": project_identity,
            "created_at": utc_now(),
        }
        write_private_json(
            project, transaction_member_path("owner.json"), owner
        )
        previous_event = append_transaction_event(
            project, transaction_id, "preparing", "0" * 64
        )
        intent_changes, directory_units, leaf_probes, directory_probes = (
            transaction_layout(project, transaction_id, changes)
        )
        project.mkdir(transaction_member_path("stage"), 0o700)
        project.mkdir(transaction_member_path("preimage"), 0o700)
        for change in changes:
            slot = str(change["slot"])
            write_private_bytes(
                project,
                transaction_member_path(f"stage/{slot}"),
                bytes(change["_postimage_bytes"]),
            )
            if change["preimage"]["state"] == "regular":
                write_private_bytes(
                    project,
                    transaction_member_path(f"preimage/{slot}"),
                    bytes(change["_preimage_bytes"]),
                )
        directory_postimage_set_sha256 = canonical_json_sha256([
            {
                "unit_id": unit["unit_id"],
                "final_root": unit["final_root"],
                "tree_sha256": unit["tree_sha256"],
            }
            for unit in sorted(directory_units, key=lambda item: str(item["unit_id"]))
        ])
        intent = {
            "schema_version": TRANSACTION_JOURNAL_SCHEMA,
            "transaction_id": transaction_id,
            "project_identity_sha256": project_identity,
            "from_version": from_version,
            "target_version": target_version,
            "allowed_paths": [item["path"] for item in intent_changes],
            "changes": intent_changes,
            "leaf_capability_probes": leaf_probes,
            "directory_units": directory_units,
            "directory_capability_probes": directory_probes,
            "manifest_identity": next(
                (item["postimage"] for item in intent_changes if item["path"] == MANIFEST_PATH.as_posix()),
                None,
            ),
            "agents_identity": next(
                (item["postimage"] for item in intent_changes if item["path"] == "AGENTS.md"),
                None,
            ),
            "onboarding_identity": next(
                (item["postimage"] for item in intent_changes if item["path"] == ONBOARDING_PATH.as_posix()),
                None,
            ),
            "postimage_set_sha256": canonical_json_sha256(
                [{"path": item["path"], "postimage": item["postimage"]} for item in intent_changes]
            ),
            "directory_postimage_set_sha256": directory_postimage_set_sha256,
        }
        write_private_json(
            project, transaction_member_path("intent.json"), intent
        )
        intent_sha = canonical_json_sha256(intent)
        capabilities = run_transaction_capability_probes(
            project, transaction_id, intent, adapter
        )
        write_private_json(
            project, transaction_member_path("capabilities.json"), capabilities
        )
        directory_stages = [
            construct_directory_stage(project, unit) for unit in directory_units
        ]
        leaf_temporaries = create_leaf_temporaries(project, intent)
        for change in changes:
            revalidate_change_preimage(project, change)
        for unit, stage in zip(directory_units, directory_stages):
            if (
                project.directory_object(str(unit["parent_path"])) != unit["parent_object"]
                or project.path_state(str(unit["final_root"])) != "absent"
                or not verify_directory_tree(project, unit, stage, at_final=False)
            ):
                raise VibeError(
                    "directory-unit state changed before prepared",
                    "upgrade_directory_race_preserved",
                )
        prepared = {
            "schema_version": TRANSACTION_JOURNAL_SCHEMA,
            "transaction_id": transaction_id,
            "intent_sha256": intent_sha,
            "stage_set_sha256": canonical_json_sha256(
                [{"slot": item["slot"], "sha256": item["postimage"]["sha256"]} for item in intent_changes]
            ),
            "preimage_set_sha256": canonical_json_sha256(
                [{"slot": item["slot"], "identity": item["preimage"]} for item in intent_changes]
            ),
            "capabilities_sha256": canonical_json_sha256(capabilities),
            "leaf_temporaries": leaf_temporaries,
            "leaf_temporary_set_sha256": canonical_json_sha256(leaf_temporaries),
            "directory_stages": directory_stages,
            "directory_stage_set_sha256": canonical_json_sha256(directory_stages),
            "directory_postimage_set_sha256": directory_postimage_set_sha256,
            "prepared_at": utc_now(),
        }
        write_private_json(
            project, transaction_member_path("prepared.json"), prepared
        )
        append_transaction_event(project, transaction_id, "prepared", previous_event)
        return transaction_id, intent, intent_sha


def prepare_transaction_state(
    target: Path,
    from_version: str,
    target_version: str,
    changes: Sequence[Dict[str, object]],
) -> Tuple[str, Dict[str, object], str]:
    try:
        return _prepare_transaction_state_impl(
            target, from_version, target_version, changes
        )
    except (OSError, UnicodeError, VibeError) as error:
        kind, _ = active_transaction_state(target)
        if kind not in ("bootstrap", "unprepared"):
            raise
        try:
            predecessor_proven, _, _ = independently_authenticated_installation(
                target
            )
            if not predecessor_proven:
                raise VibeError(
                    "exact predecessor changed during transaction preparation",
                    "upgrade_predecessor_not_proven",
                )
            if kind == "unprepared":
                with ProjectRootFD(target) as project:
                    cleanup_unprepared_private_objects(project)
            remove_transaction_control(target)
        except (OSError, UnicodeError, VibeError):
            raise error
        raise VibeError(
            str(error),
            error.code if isinstance(error, VibeError) else "upgrade_prepare_failed",
            "transaction-control-written",
        ) from error


def write_directory_cleanup_marker(
    project: ProjectRootFD,
    transaction_id: str,
    unit: Dict[str, object],
    stage: Dict[str, object],
    cleanup_kind: str,
) -> str:
    root = transaction_member_path("directory-cleanup")
    project.mkdir(root, 0o700, exist_ok=True)
    relative = f"{root}/{unit['unit_id']}.json"
    marker = {
        "schema_version": TRANSACTION_JOURNAL_SCHEMA,
        "transaction_id": transaction_id,
        "unit_id": unit["unit_id"],
        "cleanup_kind": cleanup_kind,
        "final_root": unit["final_root"],
        "staging_root": unit["staging_root"],
        "staging_object": stage["staging_object"],
        "tree_sha256": unit["tree_sha256"],
        "started_at": utc_now(),
    }
    if project.path_state(relative) == "absent":
        write_private_json(project, relative, marker)
    else:
        existing = load_project_json(project, relative)
        if (
            set(existing) != set(marker)
            or not is_iso8601(existing.get("started_at"))
            or any(
                existing.get(key) != marker.get(key)
                for key in marker if key != "started_at"
            )
        ):
            raise VibeError("directory cleanup marker is inconsistent")
    return relative


def cleanup_exact_directory_stage(
    project: ProjectRootFD,
    transaction_id: str,
    unit: Dict[str, object],
    stage: Dict[str, object],
    cleanup_kind: str,
) -> None:
    if project.directory_object(str(unit["parent_path"])) != unit["parent_object"]:
        raise VibeError("directory-unit parent changed before private cleanup")
    marker_path = transaction_member_path(
        f"directory-cleanup/{unit['unit_id']}.json"
    )
    marker_exists = project.path_state(marker_path) == "regular"
    if not marker_exists:
        if not verify_directory_tree(project, unit, stage, at_final=False):
            raise VibeError("private directory stage is not exact")
        marker_path = write_directory_cleanup_marker(
            project, transaction_id, unit, stage, cleanup_kind
        )
    else:
        marker = load_project_json(project, marker_path)
        if (
            set(marker) != {
                "schema_version", "transaction_id", "unit_id", "cleanup_kind",
                "final_root", "staging_root", "staging_object", "tree_sha256",
                "started_at",
            }
            or marker.get("schema_version") != TRANSACTION_JOURNAL_SCHEMA
            or marker.get("transaction_id") != transaction_id
            or marker.get("unit_id") != unit["unit_id"]
            or marker.get("cleanup_kind") != cleanup_kind
            or marker.get("final_root") != unit["final_root"]
            or marker.get("staging_root") != unit["staging_root"]
            or marker.get("staging_object") != stage["staging_object"]
            or marker.get("tree_sha256") != unit["tree_sha256"]
            or not is_iso8601(marker.get("started_at"))
            or not directory_stage_subset_valid(project, unit, stage)
        ):
            raise VibeError("prepared directory cleanup subset is invalid")
    if project.path_state(str(unit["staging_root"])) != "absent":
        project.remove_tree(str(unit["staging_root"]), unit["parent_object"])
    project.remove(marker_path)


def directory_stage_subset_valid(
    project: ProjectRootFD, unit: Dict[str, object], stage: Dict[str, object]
) -> bool:
    staging_root = str(unit["staging_root"])
    if project.path_state(staging_root) == "absent":
        return True
    expected = {
        logical_to_staging_path(unit, str(item["path"])): item
        for item in stage["tree_objects"]
    }

    def walk(actual: str) -> bool:
        item = expected.get(actual)
        if item is None or item["type"] != "directory":
            return False
        try:
            descriptor = project.open_directory(actual)
        except (OSError, VibeError):
            return False
        try:
            metadata = os.fstat(descriptor)
            if (
                project.object_identity(metadata) != {
                    "device": item["device"], "inode": item["inode"]
                }
                or stat.S_IMODE(metadata.st_mode) != item["mode"]
            ):
                return False
            names = list(os.listdir(descriptor))
        finally:
            os.close(descriptor)
        for name in names:
            child = f"{actual}/{name}"
            child_item = expected.get(child)
            if child_item is None:
                return False
            if child_item["type"] == "directory":
                if not walk(child):
                    return False
            else:
                image = {
                    "state": "regular", "type": "regular",
                    "sha256": child_item["sha256"], "mode": child_item["mode"],
                }
                if not entry_matches(
                    project, child, image,
                    {"device": child_item["device"], "inode": child_item["inode"]},
                ):
                    return False
        return True

    return walk(staging_root)


def rollback_directory_unit(
    project: ProjectRootFD,
    adapter: LeafAtomicityAdapter,
    transaction_id: str,
    unit: Dict[str, object],
    stage: Dict[str, object],
) -> bool:
    final_root = str(unit["final_root"])
    staging_root = str(unit["staging_root"])
    final_state = project.path_state(final_root)
    stage_state = project.path_state(staging_root)
    if final_state == "absent" and stage_state == "absent":
        marker = transaction_member_path(
            f"directory-cleanup/{unit['unit_id']}.json"
        )
        if project.path_state(marker) == "regular":
            marker_kind = str(load_project_json(project, marker)["cleanup_kind"])
            cleanup_exact_directory_stage(
                project, transaction_id, unit, stage, marker_kind
            )
        return True
    marker = transaction_member_path(
        f"directory-cleanup/{unit['unit_id']}.json"
    )
    if (
        final_state == "absent"
        and project.path_state(marker) == "regular"
        and directory_stage_subset_valid(project, unit, stage)
    ):
        cleanup_exact_directory_stage(
            project, transaction_id, unit, stage,
            str(load_project_json(project, marker)["cleanup_kind"]),
        )
        return True
    if final_state == "absent" and verify_directory_tree(
        project, unit, stage, at_final=False
    ):
        cleanup_exact_directory_stage(
            project, transaction_id, unit, stage, "not-applied"
        )
        return True
    if verify_directory_tree(project, unit, stage, at_final=True) and stage_state == "absent":
        parent = project.require_directory_object(
            str(unit["parent_path"]), unit["parent_object"]
        )
        final_leaf = PurePosixPath(final_root).name
        stage_leaf = PurePosixPath(staging_root).name
        try:
            try:
                adapter.no_replace(parent, final_leaf, parent, stage_leaf)
            except OSError as error:
                if error.errno == errno.EEXIST:
                    return False
                raise atomicity_os_error(error)
            os.fsync(parent)
        finally:
            os.close(parent)
        if project.path_state(final_root) == "absent" and verify_directory_tree(
            project, unit, stage, at_final=False
        ):
            cleanup_exact_directory_stage(
                project, transaction_id, unit, stage, "rollback"
            )
            return True
        # Whatever was detached is preserved. Restore at most once without clobbering.
        if project.path_state(final_root) == "absent" and project.path_state(staging_root) != "absent":
            parent = project.require_directory_object(
                str(unit["parent_path"]), unit["parent_object"]
            )
            try:
                try:
                    adapter.no_replace(parent, stage_leaf, parent, final_leaf)
                    os.fsync(parent)
                except OSError as error:
                    if error.errno != errno.EEXIST:
                        raise atomicity_os_error(error)
            finally:
                os.close(parent)
        return False
    return False


def rollback_leaf(
    project: ProjectRootFD,
    adapter: LeafAtomicityAdapter,
    item: Dict[str, object],
    temporary: Dict[str, object],
) -> bool:
    relative = str(item["path"])
    temporary_path = str(item["temporary_path"])
    final_snapshot = namespace_snapshot(project, relative)
    temporary_snapshot = namespace_snapshot(project, temporary_path)
    final_pre = (
        final_snapshot["image"] == item["preimage"]
        and final_snapshot["object"] == item["preimage_object"]
    )
    final_post = (
        final_snapshot["image"] == item["postimage"]
        and final_snapshot["object"] == temporary["postimage_object"]
    )
    temp_post = (
        temporary_snapshot["image"] == item["postimage"]
        and temporary_snapshot["object"] == temporary["postimage_object"]
    )
    if item["leaf_protocol"] == "link-no-clobber-v1":
        if final_snapshot["state"] == "absent" and temporary_snapshot["state"] == "absent":
            return True
        if final_snapshot["state"] == "absent" and temp_post:
            project.unlink_exact_private(
                temporary_path, temporary["postimage_object"], item["postimage"]
            )
            return True
        if final_post and (temp_post or temporary_snapshot["state"] == "absent"):
            if temp_post:
                project.unlink_exact_private(
                    temporary_path, temporary["postimage_object"], item["postimage"]
                )
            parent_path = PurePosixPath(relative).parent.as_posix()
            parent = project.open_directory("." if parent_path == "." else parent_path)
            final_leaf = PurePosixPath(relative).name
            temp_leaf = PurePosixPath(temporary_path).name
            try:
                try:
                    adapter.no_replace(parent, final_leaf, parent, temp_leaf)
                except OSError as error:
                    if error.errno == errno.EEXIST:
                        return False
                    raise atomicity_os_error(error)
                os.fsync(parent)
            finally:
                os.close(parent)
            if project.path_state(relative) != "absent" or not entry_matches(
                project, temporary_path, item["postimage"],
                temporary["postimage_object"],
            ):
                moved = namespace_snapshot(project, temporary_path)
                if (
                    project.path_state(relative) == "absent"
                    and moved["state"] == "regular"
                    and isinstance(moved["object"], dict)
                    and isinstance(moved["image"], dict)
                ):
                    try:
                        project.link_no_clobber(temporary_path, relative)
                    except OSError as error:
                        if error.errno != errno.EEXIST:
                            raise atomicity_os_error(error)
                    else:
                        if (
                            namespace_snapshot(project, relative) == moved
                            and namespace_snapshot(project, temporary_path) == moved
                        ):
                            project.unlink_exact_private(
                                temporary_path, moved["object"], moved["image"]
                            )
                return False
            project.unlink_exact_private(
                temporary_path, temporary["postimage_object"], item["postimage"]
            )
            return True
        return False

    if final_pre and temporary_snapshot["state"] == "absent":
        return True
    if final_pre and temp_post:
        project.unlink_exact_private(
            temporary_path, temporary["postimage_object"], item["postimage"]
        )
        return True
    temp_pre = (
        temporary_snapshot["image"] == item["preimage"]
        and temporary_snapshot["object"] == item["preimage_object"]
    )
    if not (final_post and temp_pre):
        return False
    parent_path = PurePosixPath(relative).parent.as_posix()
    parent = project.open_directory("." if parent_path == "." else parent_path)
    final_leaf = PurePosixPath(relative).name
    temp_leaf = PurePosixPath(temporary_path).name
    try:
        try:
            adapter.exchange(parent, temp_leaf, parent, final_leaf)
        except OSError as error:
            raise atomicity_os_error(error)
        os.fsync(parent)
    finally:
        os.close(parent)
    if not entry_matches(
        project, relative, item["preimage"], item["preimage_object"]
    ) or not entry_matches(
        project, temporary_path, item["postimage"], temporary["postimage_object"]
    ):
        return False
    project.unlink_exact_private(
        temporary_path, temporary["postimage_object"], item["postimage"]
    )
    return True


def rollback_upgrade_transaction(
    target: Path, intent: Dict[str, object]
) -> Tuple[bool, Optional[str]]:
    transaction_id = str(intent["transaction_id"])
    adapter = leaf_atomicity_api_preflight()
    with ProjectRootFD(target) as project:
        prepared = load_prepared_transaction(project)
        _, temporaries, stages = transaction_maps(intent, prepared)
        previous = append_transaction_event(
            project, transaction_id, "rolling-back", transaction_event_head(project)
        )
        completed_units = set()
        for item in reversed(intent["changes"]):
            relative = str(item["path"])
            unit_id = item["directory_unit"]
            if unit_id is not None:
                if unit_id in completed_units:
                    continue
                unit = next(
                    value for value in intent["directory_units"]
                    if value["unit_id"] == unit_id
                )
                if not rollback_directory_unit(
                    project, adapter, transaction_id, unit, stages[str(unit_id)]
                ):
                    return False, str(unit["final_root"])
                completed_units.add(unit_id)
                continue
            temporary = temporaries.get(str(item["slot"]))
            if temporary is None or not rollback_leaf(
                project, adapter, item, temporary
            ):
                return False, relative
        state, mismatched = transaction_installation_state_project(project, intent)
        if state != "predecessor":
            return False, mismatched[0] if mismatched else None
        append_transaction_event(
            project, transaction_id, "rollback-complete", previous
        )
        remove_transaction_control_project(project)
        return True, None


def execute_upgrade_transaction(
    target: Path,
    from_version: str,
    target_version: str,
    changes: Sequence[Dict[str, object]],
) -> Dict[str, object]:
    if not changes:
        return {
            "status": "success", "write_state": "none", "installation_state": "target",
            "transaction": transaction_shape(None, "not-applied", "absent", "absent"),
            "error": None, "next_action": None,
        }
    transaction_id: Optional[str] = None
    intent: Optional[Dict[str, object]] = None
    commit_durable = False
    failed_path: Optional[str] = None
    try:
        adapter = leaf_atomicity_api_preflight()
        transaction_id, intent, intent_sha = prepare_transaction_state(
            target, from_version, target_version, changes
        )
        with ProjectRootFD(target) as project:
            prepared = load_prepared_transaction(project)
            _, temporaries, stages = transaction_maps(intent, prepared)
            previous = append_transaction_event(
                project, transaction_id, "committing", transaction_event_head(project)
            )
            published_units = set()
            for item in intent["changes"]:
                failed_path = str(item["path"])
                unit_id = item["directory_unit"]
                if unit_id is not None:
                    if unit_id in published_units:
                        continue
                    unit = next(
                        value for value in intent["directory_units"]
                        if value["unit_id"] == unit_id
                    )
                    failed_path = str(unit["final_root"])
                    publish_directory_unit(
                        project, adapter, unit, stages[str(unit_id)]
                    )
                    published_units.add(unit_id)
                else:
                    temporary = temporaries.get(str(item["slot"]))
                    if temporary is None:
                        raise VibeError("prepared leaf temporary is missing")
                    mutate_leaf_forward(project, adapter, item, temporary)
                previous = append_transaction_event(
                    project, transaction_id, "committing", previous
                )
            pairs_valid, pair_path = verify_prepared_pairs(
                project, intent, prepared
            )
            if not pairs_valid:
                failed_path = pair_path or failed_path
                raise VibeError(
                    "prepared final/private pair validation failed",
                    "upgrade_leaf_race_preserved",
                )
            state, mismatched = transaction_installation_state_project(project, intent)
            if state != "target":
                failed_path = mismatched[0] if mismatched else failed_path
                raise VibeError("target postimage validation failed", "upgrade_postimage_invalid")
            commit = {
                "schema_version": TRANSACTION_COMMIT_SCHEMA,
                "transaction_id": transaction_id,
                "intent_sha256": intent_sha,
                "postimage_set_sha256": intent["postimage_set_sha256"],
                "directory_postimage_set_sha256": intent["directory_postimage_set_sha256"],
                "committed_at": utc_now(),
            }
            write_private_json(
                project, transaction_member_path("commit.json"), commit
            )
            commit_durable = True
        try:
            with ProjectRootFD(target) as project:
                append_transaction_event(
                    project, transaction_id, "commit-complete", previous
                )
                cleanup_committed_private_objects(project, intent, prepared)
            remove_transaction_control(target)
        except (OSError, UnicodeError, VibeError) as cleanup_error:
            return {
                "status": "error", "write_state": "project-files-written",
                "installation_state": "target",
                "transaction": transaction_shape(
                    transaction_id, "committed", "commit-complete", "valid",
                    TRANSACTION_ACTIVE_PATH.as_posix(), type(cleanup_error).__name__,
                ),
                "error": {
                    "code": "upgrade_commit_cleanup_incomplete",
                    "message": bounded_diagnostic_detail(target, str(cleanup_error)),
                },
                "next_action": {
                    "code": "recover-upgrade",
                    "detail": "The target committed; finalize transaction cleanup before other maintenance.",
                },
            }
        return {
            "status": "success", "write_state": "project-files-written",
            "installation_state": "target",
            "transaction": transaction_shape(transaction_id, "committed", "complete", "valid"),
            "error": None, "next_action": None,
        }
    except (OSError, UnicodeError, VibeError) as error:
        if commit_durable:
            return {
                "status": "error", "write_state": "project-files-written",
                "installation_state": "target",
                "transaction": transaction_shape(
                    transaction_id, "committed", "commit-complete", "valid",
                    TRANSACTION_ACTIVE_PATH.as_posix(), type(error).__name__,
                ),
                "error": {
                    "code": "upgrade_commit_cleanup_incomplete",
                    "message": bounded_diagnostic_detail(target, str(error)),
                },
                "next_action": {
                    "code": "recover-upgrade",
                    "detail": "The target committed; finalize transaction cleanup before other maintenance.",
                },
            }
        if transaction_id is None or intent is None:
            active_kind, active_shape = active_transaction_state(target)
            if active_kind == "absent":
                unsupported = (
                    isinstance(error, VibeError)
                    and error.code == "upgrade_leaf_atomicity_unsupported"
                )
                invocation_write_state = (
                    error.write_state if isinstance(error, VibeError) else "none"
                )
                if invocation_write_state != "none":
                    active_shape["phase"] = "complete"
                return {
                    "status": "blocked" if unsupported else "error",
                    "write_state": invocation_write_state,
                    "installation_state": "predecessor", "transaction": active_shape,
                    "error": {
                        "code": "upgrade_leaf_atomicity_unsupported" if unsupported else "upgrade_prepare_failed",
                        "message": bounded_diagnostic_detail(target, str(error)),
                    },
                    "next_action": {
                        "code": "use-supported-upgrade-filesystem" if unsupported else "rerun-upgrade-plan",
                        "detail": "Use a filesystem with the required no-clobber primitives." if unsupported else "Run a fresh read-only upgrade plan.",
                    },
                }
            unknown = active_kind == "invalid"
            active_shape.update({
                "outcome": "unknown-partial" if unknown else "recovery-required",
                "phase": "invalid" if unknown else "recovery-required",
                "failure_kind": type(error).__name__,
            })
            return {
                "status": "error",
                "write_state": "unknown-partial" if unknown else "recovery-required",
                "installation_state": "unknown" if unknown else "recovery-required",
                "transaction": active_shape,
                "error": {"code": "upgrade_prepare_failed", "message": bounded_diagnostic_detail(target, str(error))},
                "next_action": {
                    "code": "inspect-upgrade-transaction" if unknown else "recover-upgrade",
                    "detail": "Inspect the transaction evidence." if unknown else "Run recover-upgrade before any other maintenance.",
                },
            }
        try:
            rolled_back, rollback_failed_path = rollback_upgrade_transaction(target, intent)
        except (OSError, UnicodeError, VibeError) as rollback_error:
            rolled_back = False
            rollback_failed_path = failed_path
            error = rollback_error
        if rolled_back:
            return {
                "status": "error", "write_state": "rolled-back",
                "installation_state": "predecessor",
                "transaction": transaction_shape(transaction_id, "rolled-back", "complete", "absent", failed_path, type(error).__name__),
                "error": {"code": "upgrade_failed_rolled_back", "message": bounded_diagnostic_detail(target, str(error))},
                "next_action": {"code": "rerun-upgrade-plan", "detail": "The predecessor was restored; inspect the failure and plan again."},
            }
        active_kind, active_shape = active_transaction_state(target)
        observed_state = "unknown"
        if active_kind in ("prepared", "committed"):
            observed_state, _ = transaction_installation_state(target, intent)
        unknown = active_kind == "invalid" or observed_state == "unknown"
        installation_state = "unknown" if unknown else "recovery-required"
        outcome = "unknown-partial" if unknown else "recovery-required"
        active_shape.update({
            "outcome": outcome,
            "phase": "invalid" if unknown else "recovery-required",
            "failed_path": rollback_failed_path,
            "failure_kind": type(error).__name__,
        })
        race_code = (
            error.code
            if isinstance(error, VibeError) and error.code in (
                "upgrade_leaf_race_preserved", "upgrade_directory_race_preserved"
            )
            else None
        )
        if race_code is None and observed_state == "unknown" and rollback_failed_path:
            race_code = (
                "upgrade_directory_race_preserved"
                if any(
                    unit.get("final_root") == rollback_failed_path
                    for unit in intent.get("directory_units", [])
                )
                else "upgrade_leaf_race_preserved"
            )
        if race_code is not None:
            active_shape.update({
                "outcome": "unknown-partial",
                "phase": "invalid",
                "failed_path": rollback_failed_path or failed_path,
                "failure_kind": (
                    "external-directory-race-preserved"
                    if race_code == "upgrade_directory_race_preserved"
                    else "external-leaf-race-preserved"
                ),
            })
            return {
                "status": "error", "write_state": "unknown-partial",
                "installation_state": "unknown", "transaction": active_shape,
                "error": {"code": race_code, "message": bounded_diagnostic_detail(target, str(error))},
                "next_action": {
                    "code": "inspect-upgrade-transaction",
                    "detail": "Inspect the preserved final/private pair; no object was overwritten.",
                },
            }
        return {
            "status": "error", "write_state": outcome,
            "installation_state": installation_state, "transaction": active_shape,
            "error": {"code": "upgrade_recovery_required", "message": bounded_diagnostic_detail(target, str(error))},
            "next_action": {
                "code": "inspect-upgrade-transaction" if outcome == "unknown-partial" else "recover-upgrade",
                "detail": "Inspect the transaction state." if outcome == "unknown-partial" else "Run recover-upgrade before any other maintenance.",
            },
        }


def install_plan(operation: str, target: Path) -> Tuple[List[Dict[str, str]], str, str]:
    source = source_root()
    target = target.resolve()
    version = framework_version(source)
    if target.exists() and not target.is_dir():
        raise VibeError(f"target is not a directory: {target}")
    if operation == "adopt" and (
        not target.is_dir() or not any(target.iterdir())
    ):
        raise VibeError("adopt requires a non-empty existing project; use init instead.")
    if (target / MANIFEST_PATH).exists():
        raise VibeError("Vibe Kit is already installed; use plan upgrade instead.")

    entries: List[Dict[str, str]] = []
    for incoming in managed_source_files(source):
        relative = incoming.relative_to(source).as_posix()
        existing = target / relative
        if not existing.exists():
            entries.append(plan_entry("create", relative, "framework-managed"))
        elif existing.is_file() and sha256(existing) == sha256(incoming):
            entries.append(plan_entry("no-op", relative, "identical managed content"))
        else:
            entries.append(plan_entry("conflict", relative, "managed path already exists"))

    agents_path = target / "AGENTS.md"
    incoming_block = incoming_agents_block(source)
    if not agents_path.exists():
        entries.append(plan_entry("create", "AGENTS.md", "managed block"))
    elif not agents_path.is_file():
        entries.append(plan_entry("conflict", "AGENTS.md", "path is not a file"))
    else:
        current = agents_path.read_text(encoding="utf-8")
        current_block = extract_agents_block(current)
        merged = merge_agents_text(current, incoming_block)
        action = "no-op" if merged == current else "update"
        note = "managed block already current" if action == "no-op" else "merge managed block; preserve project instructions"
        entries.append(plan_entry(action, "AGENTS.md", note))

    for relative in PROJECT_OWNED_INSTALL_PATHS:
        action = "preserve" if (target / relative).exists() else "create"
        entries.append(plan_entry(action, relative, "project-owned"))
    for relative in (MANIFEST_PATH.as_posix(), INSTALLED_VERSION_PATH.as_posix()):
        action = "update" if (target / relative).exists() else "create"
        entries.append(plan_entry(action, relative, "installation state"))
    return entries, "<not installed>", version


def upgrade_plan(
    target: Path,
) -> Tuple[List[Dict[str, str]], str, str, List[Dict[str, object]], Dict[str, object]]:
    source = source_root()
    target = target.resolve()
    version = framework_version(source)
    if not transaction_platform_supported():
        return (
            [plan_entry(
                "conflict", LEAF_ATOMICITY_PLAN_PATH,
                "lossless leaf atomicity requires a supported filesystem",
            )],
            "<predecessor>", version, [],
            onboarding_bridge_result("not-needed", None, False, "unknown", "unchanged"),
        )
    active_kind, _ = active_transaction_state(target)
    if active_kind != "absent":
        bridge = onboarding_bridge_result("not-needed", None, False, "unknown", "unchanged")
        return (
            [plan_entry(
                "conflict", TRANSACTION_ACTIVE_PATH.as_posix(),
                (
                    "invalid upgrade transaction control path; inspect-upgrade-transaction required"
                    if active_kind == "invalid"
                    else "active upgrade transaction; recover-upgrade required"
                ),
            )],
            "<transaction-active>", version, [], bridge,
        )
    if version == "0.8.0":
        validate_target_predecessor_migration_contract(source)
        migration_decision = predecessor_migration_decision(target)
    else:
        migration_decision = "ordinary"
    try:
        manifest = load_manifest(target)
    except VibeError:
        if migration_decision == "conflict":
            return (
                [
                    plan_entry(
                        "conflict", relative, PREDECESSOR_MIGRATION_CONFLICT_NOTE
                    )
                    for relative in PREDECESSOR_MIGRATION_PATHS
                ],
                "<invalid>",
                version,
                [],
                onboarding_bridge_result("blocked", None, False, "unknown", "unchanged"),
            )
        raise
    bridge = onboarding_bridge_decision(target, manifest)
    if bridge["state"] == "planned":
        entries_bridge = plan_entry(
            "create", ONBOARDING_PATH.as_posix(),
            "legacy compatibility bridge; pending only, no context inferred",
        )
    elif bridge["state"] == "blocked":
        entries_bridge = plan_entry(
            "conflict", ONBOARDING_PATH.as_posix(),
            "onboarding state is invalid, lost, or not an authenticated legacy family",
        )
    else:
        entries_bridge = plan_entry(
            "preserve" if bridge["state"] == "preserved" else "no-op",
            ONBOARDING_PATH.as_posix(), "project-owned onboarding state",
        )
    previous = {str(key): str(value) for key, value in manifest["managed_files"].items()}
    incoming_files = managed_source_files(source)
    incoming_by_relative = {
        path.relative_to(source).as_posix(): path for path in incoming_files
    }
    entries: List[Dict[str, str]] = []

    for relative, incoming in incoming_by_relative.items():
        if relative in PREDECESSOR_MIGRATION_PATHS:
            if migration_decision == "eligible":
                entries.append(plan_entry("update", relative, PREDECESSOR_MIGRATION_NOTE))
                continue
            if migration_decision == "conflict":
                entries.append(
                    plan_entry(
                        "conflict", relative, PREDECESSOR_MIGRATION_CONFLICT_NOTE
                    )
                )
                continue
        destination = target / relative
        incoming_hash = sha256(incoming)
        recorded_hash = previous.get(relative)
        path_state, current_hash = authenticated_path_state(target, relative)
        if path_state == "absent":
            entries.append(plan_entry("create", relative, "missing managed file"))
            continue
        if path_state != "regular" or current_hash is None:
            entries.append(plan_entry("conflict", relative, "managed path is not a file"))
            continue
        if recorded_hash is None and current_hash != incoming_hash:
            entries.append(plan_entry("conflict", relative, "untracked managed path differs"))
        elif (
            recorded_hash is not None
            and current_hash != recorded_hash
            and incoming_hash != recorded_hash
            and current_hash != incoming_hash
        ):
            entries.append(plan_entry("conflict", relative, "local and incoming content both changed"))
        elif (
            recorded_hash is not None
            and current_hash != recorded_hash
            and incoming_hash == recorded_hash
        ):
            entries.append(plan_entry("preserve", relative, "local modification; source unchanged"))
        elif current_hash == incoming_hash:
            entries.append(plan_entry("no-op", relative, "already matches target release"))
        else:
            entries.append(plan_entry("update", relative, "managed release change"))

    for relative in sorted(set(previous) - set(incoming_by_relative)):
        entries.append(plan_entry("preserve", relative, "stale managed path; manual review"))

    agents_path = target / "AGENTS.md"
    incoming_block = incoming_agents_block(source)
    recorded_block_hash = str(manifest.get("agents_block_hash", ""))
    if not agents_path.exists():
        entries.append(plan_entry("create", "AGENTS.md", "missing managed block"))
    elif not agents_path.is_file():
        entries.append(plan_entry("conflict", "AGENTS.md", "path is not a file"))
    else:
        current_text = agents_path.read_text(encoding="utf-8")
        current_block = extract_agents_block(current_text)
        current_hash = sha256_text(current_block) if current_block is not None else ""
        incoming_hash = sha256_text(incoming_block)
        if recorded_block_hash and (
            current_hash != recorded_block_hash
            and incoming_hash != recorded_block_hash
            and current_hash != incoming_hash
        ):
            entries.append(plan_entry("conflict", "AGENTS.md", "local and incoming managed block both changed"))
        elif not recorded_block_hash and current_block is not None and current_hash != incoming_hash:
            entries.append(plan_entry("conflict", "AGENTS.md", "untracked managed block differs"))
        elif recorded_block_hash and current_hash != recorded_block_hash and incoming_hash == recorded_block_hash:
            entries.append(plan_entry("preserve", "AGENTS.md", "local managed-block modification; source unchanged"))
        else:
            merged = merge_agents_text(current_text, incoming_block)
            action = "no-op" if merged == current_text else "update"
            entries.append(plan_entry(action, "AGENTS.md", "managed block"))

    current_version = str(manifest.get("framework_version", "<unknown>"))
    for relative in (MANIFEST_PATH.as_posix(), INSTALLED_VERSION_PATH.as_posix()):
        path = target / relative
        expected_version = version + "\n" if relative == INSTALLED_VERSION_PATH.as_posix() else None
        if expected_version is not None and path.is_file() and path.read_text(encoding="utf-8") == expected_version:
            action = "no-op"
        else:
            action = "update"
        entries.append(plan_entry(action, relative, "installation state"))
    entries.append(entries_bridge)
    migrations = (
        [predecessor_migration_evidence("planned")]
        if migration_decision == "eligible"
        else []
    )
    return entries, current_version, version, migrations, bridge


def print_plan(
    operation: str,
    target: Path,
    entries: Sequence[Dict[str, str]],
    current: str,
    target_version: str,
    output_format: str,
    provenance: Dict[str, object],
    compatibility_migrations: Sequence[Dict[str, object]] = (),
    onboarding_bridge: Optional[Dict[str, object]] = None,
) -> int:
    conflicts = [entry for entry in entries if entry["action"] == "conflict"]
    invalid_transaction = any(
        entry["path"] == TRANSACTION_ACTIVE_PATH.as_posix()
        and "inspect-upgrade-transaction" in entry.get("note", "")
        for entry in conflicts
    )
    atomicity_unsupported = any(
        entry["path"] == LEAF_ATOMICITY_PLAN_PATH for entry in conflicts
    )
    counts: Dict[str, int] = {}
    for entry in entries:
        counts[entry["action"]] = counts.get(entry["action"], 0) + 1
    if output_format == "json":
        transaction_conflict = any(
            entry["path"] == TRANSACTION_ACTIVE_PATH.as_posix()
            for entry in conflicts
        )
        if atomicity_unsupported:
            next_action: Optional[Dict[str, str]] = {
                "code": "use-supported-upgrade-filesystem",
                "detail": "Use a filesystem with hard-link, no-replace and exchange support.",
            }
        elif invalid_transaction:
            next_action = {
                "code": "inspect-upgrade-transaction",
                "detail": "Inspect the unsafe or unclassifiable transaction control path.",
            }
        elif transaction_conflict:
            next_action = {
                "code": "recover-upgrade",
                "detail": "Run recover-upgrade before planning again.",
            }
        elif conflicts:
            next_action = {
                "code": "review-conflict-candidates",
                "detail": "Resolve every blocking plan entry.",
            }
        else:
            next_action = None
        values: Dict[str, object] = {
            "operation": operation,
            "target": str(target.resolve()),
            "current_version": current,
            "target_version": target_version,
            "source": provenance,
            "entries": list(entries),
            "counts": dict(sorted(counts.items())),
            "files_changed": False,
            "write_state": "none",
            "writes_performed": False,
            "installation_state": (
                "unknown" if any(entry["path"] == TRANSACTION_ACTIVE_PATH.as_posix() for entry in conflicts)
                else "predecessor"
            ),
            "error": (
                {
                    "code": "upgrade_leaf_atomicity_unsupported",
                    "message": "Lossless upgrade leaf mutation is unsupported by this platform or filesystem.",
                }
                if atomicity_unsupported else None
            ),
            "onboarding_bridge": onboarding_bridge,
            "next_action": next_action,
            "recovery": (
                {
                    "action": "inspect-conflicts",
                    "paths": [entry["path"] for entry in conflicts],
                }
                if conflicts
                else None
            ),
        }
        if compatibility_migrations:
            values["compatibility_migrations"] = list(compatibility_migrations)
        print_json(
            result_envelope(
                "plan",
                "blocked" if conflicts else "safe",
                **values,
            )
        )
        return 2 if conflicts else 0
    print(f"Vibe Kit plan: {operation}")
    print(f"Target: {target.resolve()}")
    print(f"Current version: {current}")
    print(f"Target version: {target_version}")
    print(f"Status: {'blocked' if conflicts else 'safe'}")
    for entry in entries:
        suffix = f" — {entry['note']}" if entry.get("note") else ""
        print(f"{entry['action'].upper():8} {entry['path']}{suffix}")
    summary = ", ".join(f"{key}={counts[key]}" for key in sorted(counts))
    print(f"Summary: {summary}")
    print("No files were changed.")
    return 2 if conflicts else 0


def plan(
    operation: str,
    target: Path,
    output_format: str,
    source_type: str,
    source_ref: Optional[str],
    artifact_sha256: Optional[str],
) -> int:
    version = framework_version(source_root())
    provenance = validate_source_provenance(
        source_type, source_ref, artifact_sha256, version
    )
    if operation in ("init", "adopt"):
        entries, current, target_version = install_plan(operation, target)
        compatibility_migrations: List[Dict[str, object]] = []
        onboarding_bridge = None
    else:
        entries, current, target_version, compatibility_migrations, onboarding_bridge = (
            upgrade_plan(target)
        )
    return print_plan(
        operation,
        target,
        entries,
        current,
        target_version,
        output_format,
        provenance,
        compatibility_migrations,
        onboarding_bridge,
    )


def write_conflict_candidates(
    source: Path, target: Path, conflicts: Sequence[Tuple[str, Optional[Path]]]
) -> Path:
    stamp = dt.datetime.now(dt.timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    parent = target / ".vibe/conflicts"
    parent.mkdir(parents=True, exist_ok=True)
    temporary = parent / (".tmp-" + hashlib.sha256(os.urandom(32)).hexdigest()[:16])
    root = parent / stamp
    suffix = 0
    while root.exists():
        suffix += 1
        root = parent / f"{stamp}-{suffix}"
    try:
        temporary.mkdir(mode=0o700)
        for relative, incoming in conflicts:
            candidate = temporary / (relative + ".incoming")
            if incoming is None:
                atomic_write_text(candidate, incoming_agents_block(source) + "\n", 0o600)
            else:
                atomic_write_bytes(candidate, incoming.read_bytes(), 0o600)
        for path in sorted(temporary.rglob("*"), reverse=True):
            if path.is_dir():
                fsync_path_directory(path)
        fsync_path_directory(temporary)
        os.rename(str(temporary), str(root))
        fsync_path_directory(parent)
        return root
    except BaseException:
        if temporary.is_dir() and not temporary.is_symlink():
            shutil.rmtree(temporary, ignore_errors=True)
        raise


def unique_conflicts(
    conflicts: Sequence[Tuple[str, Optional[Path]]]
) -> List[Tuple[str, Optional[Path]]]:
    result: List[Tuple[str, Optional[Path]]] = []
    seen = set()
    for relative, incoming in conflicts:
        if relative not in seen:
            result.append((relative, incoming))
            seen.add(relative)
    return result


def report_upgrade_conflicts(
    source: Path,
    target: Path,
    version: str,
    provenance: Dict[str, object],
    conflicts: Sequence[Tuple[str, Optional[Path]]],
    output_format: str,
) -> int:
    conflicts = unique_conflicts(conflicts)
    try:
        root = write_conflict_candidates(source, target, conflicts)
    except (OSError, UnicodeError) as error:
        raise mutation_filesystem_error("upgrade", target, error) from error
    if output_format == "json":
        write_state = "conflict-evidence-written"
        print_json(
            result_envelope(
                "upgrade",
                "blocked",
                operation="upgrade",
                target=str(target),
                from_version=None,
                target_version=version,
                source=provenance,
                write_state=write_state,
                writes_performed=writes_performed(write_state),
                installation_state="predecessor",
                transaction=transaction_shape(None, "not-applied", "absent", "absent"),
                onboarding_bridge=None,
                compatibility_migrations=[],
                summary="Upgrade is blocked by managed conflicts.",
                error={"code": "managed_conflict", "message": "Managed conflicts require review."},
                next_action={"code": "review-conflict-candidates", "detail": "Review the complete incoming candidate set."},
                managed_files_changed=False,
                conflict_candidates=str(root),
                conflicts=[relative for relative, _ in conflicts],
                recovery={"action": "inspect-conflict-candidates"},
            )
        )
        return 2
    print("Upgrade aborted; no managed framework files were changed.", file=sys.stderr)
    print(f"Incoming conflict candidates: {root}", file=sys.stderr)
    for relative, _ in conflicts:
        print(f"  - {relative}", file=sys.stderr)
    return 2


def report_upgrade_blocked_no_write(
    target: Path,
    from_version: Optional[str],
    target_version: str,
    provenance: Dict[str, object],
    code: str,
    message: str,
    transaction: Dict[str, object],
    installation_state: str,
    onboarding_bridge: Optional[Dict[str, object]],
    next_code: str,
    output_format: str,
) -> int:
    if output_format == "json":
        print_json(result_envelope(
            "upgrade", "blocked", operation="upgrade", target=str(target),
            from_version=from_version, target_version=target_version, source=provenance,
            write_state="none", writes_performed=False,
            installation_state=installation_state, transaction=transaction,
            onboarding_bridge=onboarding_bridge, compatibility_migrations=[],
            summary=message, error={"code": code, "message": message},
            next_action={"code": next_code, "detail": message},
        ))
        return 2
    print(f"error: {message}", file=sys.stderr)
    print(f"Next action: {next_code}", file=sys.stderr)
    return 2


def report_upgrade_unknown_partial_migration(
    target: Path,
    version: str,
    provenance: Dict[str, object],
    error: BaseException,
    output_format: str,
) -> int:
    failure = mutation_filesystem_error("upgrade", target, error)
    if output_format == "json":
        print_json(
            result_envelope(
                "upgrade",
                "error",
                operation="upgrade",
                target=str(target),
                kit_version=version,
                source=provenance,
                error={"code": failure.code, "message": str(failure)},
                write_state=failure.write_state,
                writes_performed=True,
                recovery=failure.recovery,
                compatibility_migrations=[
                    predecessor_migration_evidence("unknown-partial")
                ],
            )
        )
        return 2
    print(f"error: {failure}", file=sys.stderr)
    return 2


def upgrade(
    target: Path,
    output_format: str,
    source_type: str,
    source_ref: Optional[str],
    artifact_sha256: Optional[str],
) -> int:
    source = source_root()
    target = target.resolve()
    version = framework_version(source)
    provenance = validate_source_provenance(
        source_type, source_ref, artifact_sha256, version
    )
    if not transaction_platform_supported():
        return report_upgrade_blocked_no_write(
            target, None, version, provenance, "upgrade_leaf_atomicity_unsupported",
            "Required lossless no-clobber/exchange primitives are unavailable.",
            transaction_shape(None, "not-applied", "absent", "absent"),
            "predecessor", None, "use-supported-upgrade-filesystem", output_format,
        )
    active_kind, active_shape = active_transaction_state(target)
    if active_kind != "absent":
        return report_upgrade_blocked_no_write(
            target, None, version, provenance,
            "upgrade_transaction_state_invalid" if active_kind == "invalid" else "upgrade_transaction_active",
            "An upgrade transaction is active; ordinary upgrade never auto-recovers.",
            active_shape, "unknown" if active_kind == "invalid" else "recovery-required",
            None, "inspect-upgrade-transaction" if active_kind == "invalid" else "recover-upgrade",
            output_format,
        )
    if version == "0.8.0":
        validate_target_predecessor_migration_contract(source)
        migration_decision = predecessor_migration_decision(target)
    else:
        migration_decision = "ordinary"
    try:
        manifest = load_manifest(target)
    except VibeError:
        if migration_decision == "conflict":
            return report_upgrade_conflicts(
                source,
                target,
                version,
                provenance,
                [
                    (relative, source / relative)
                    for relative in PREDECESSOR_MIGRATION_PATHS
                ],
                output_format,
            )
        raise
    from_version = str(manifest.get("framework_version", "<unknown>"))
    bridge = onboarding_bridge_decision(target, manifest)
    if bridge["state"] == "blocked":
        return report_upgrade_blocked_no_write(
            target, from_version, version, provenance, "onboarding_bridge_blocked",
            "Onboarding state is invalid, lost, or not an authenticated legacy family; no upgrade files were written.",
            transaction_shape(None, "not-applied", "absent", "absent"),
            "predecessor", bridge, "resolve-project-context", output_format,
        )
    previous = {str(key): str(value) for key, value in manifest["managed_files"].items()}
    incoming_files = managed_source_files(source)
    incoming_by_relative = {
        path.relative_to(source).as_posix(): path for path in incoming_files
    }
    conflicts: List[Tuple[str, Optional[Path]]] = []

    for relative, incoming in incoming_by_relative.items():
        if relative in PREDECESSOR_MIGRATION_PATHS:
            if migration_decision == "eligible":
                continue
            if migration_decision == "conflict":
                conflicts.append((relative, incoming))
                continue
        destination = target / relative
        incoming_hash = sha256(incoming)
        recorded_hash = previous.get(relative)
        if relative in PREDECESSOR_MIGRATION_PATHS:
            path_state, current_hash = authenticated_path_state(target, relative)
            if path_state == "absent":
                continue
            if path_state != "regular" or current_hash is None:
                conflicts.append((relative, incoming))
                continue
        else:
            if not destination.exists():
                continue
            if not destination.is_file():
                conflicts.append((relative, incoming))
                continue
            current_hash = sha256(destination)
        if recorded_hash is None:
            if current_hash != incoming_hash:
                conflicts.append((relative, incoming))
        elif (
            current_hash != recorded_hash
            and incoming_hash != recorded_hash
            and current_hash != incoming_hash
        ):
            conflicts.append((relative, incoming))

    agents_path = target / "AGENTS.md"
    incoming_block = incoming_agents_block(source)
    recorded_block_hash = str(manifest.get("agents_block_hash", ""))
    current_block: Optional[str] = None
    if agents_path.is_file():
        current_block = extract_agents_block(agents_path.read_text(encoding="utf-8"))
    incoming_block_hash = sha256_text(incoming_block)
    current_block_hash = sha256_text(current_block) if current_block is not None else ""
    if recorded_block_hash:
        if (
            current_block_hash != recorded_block_hash
            and incoming_block_hash != recorded_block_hash
            and current_block_hash != incoming_block_hash
        ):
            conflicts.append(("AGENTS.md", None))
    elif current_block is not None and current_block_hash != incoming_block_hash:
        conflicts.append(("AGENTS.md", None))

    if conflicts:
        return report_upgrade_conflicts(
            source, target, version, provenance, conflicts, output_format
        )

    if migration_decision == "eligible":
        try:
            validate_target_predecessor_migration_contract(source)
        except VibeError:
            return report_upgrade_conflicts(
                source,
                target,
                version,
                provenance,
                [
                    (relative, incoming_by_relative[relative])
                    for relative in PREDECESSOR_MIGRATION_PATHS
                ],
                output_format,
            )
        if predecessor_migration_decision(target) != "eligible":
            return report_upgrade_conflicts(
                source,
                target,
                version,
                provenance,
                [
                    (relative, incoming_by_relative[relative])
                    for relative in PREDECESSOR_MIGRATION_PATHS
                ],
                output_format,
            )

    try:
        updated = 0
        preserved_local = 0
        new_hashes: Dict[str, str] = {}
        changes: List[Dict[str, object]] = []
        ordered_relatives = list(incoming_by_relative)
        if migration_decision == "eligible":
            ordered_relatives = list(PREDECESSOR_MIGRATION_PATHS) + [
                relative
                for relative in ordered_relatives
                if relative not in PREDECESSOR_MIGRATION_PATHS
            ]
        with ProjectRootFD(target) as project:
            for relative in ordered_relatives:
                incoming = incoming_by_relative[relative]
                incoming_bytes = incoming.read_bytes()
                incoming_hash = hashlib.sha256(incoming_bytes).hexdigest()
                recorded_hash = previous.get(relative)
                path_state, current_bytes, current_mode = project.read(relative)
                current_hash = (
                    hashlib.sha256(current_bytes).hexdigest()
                    if current_bytes is not None else None
                )
                if migration_decision == "eligible" and relative in PREDECESSOR_MIGRATION_PATHS:
                    expected = PREDECESSOR_MIGRATION_ENTRY["paths"][relative]
                    if path_state != "regular" or current_hash != expected:
                        raise VibeError("predecessor migration member changed during apply preflight")
                if (
                    recorded_hash is not None and current_hash is not None
                    and current_hash != recorded_hash and incoming_hash == recorded_hash
                ):
                    new_hashes[relative] = recorded_hash
                    preserved_local += 1
                    continue
                if current_hash != incoming_hash:
                    changes.append(upgrade_change(
                        project, len(changes), relative, incoming_bytes,
                        stat.S_IMODE(incoming.stat().st_mode),
                    ))
                    updated += 1
                new_hashes[relative] = incoming_hash

        stale = sorted(set(previous) - set(incoming_by_relative))
        for relative in stale:
            new_hashes[relative] = previous[relative]

        with ProjectRootFD(target) as project:
            current_agents_text = (
                agents_path.read_text(encoding="utf-8") if agents_path.exists() else ""
            )
            if (
                recorded_block_hash and current_block_hash != recorded_block_hash
                and incoming_block_hash == recorded_block_hash
            ):
                new_block_hash = recorded_block_hash
                preserved_local += 1
            else:
                merged = merge_agents_text(current_agents_text, incoming_block)
                if merged != current_agents_text:
                    changes.append(upgrade_change(
                        project, len(changes), "AGENTS.md", merged.encode("utf-8"), 0o644
                    ))
                    updated += 1
                new_block_hash = incoming_block_hash
            if bridge["state"] == "planned":
                changes.append(upgrade_change(
                    project, len(changes), ONBOARDING_PATH.as_posix(),
                    ONBOARDING_PENDING_BYTES, 0o644,
                ))
            manifest_bytes = (
                json.dumps(
                    manifest_value(version, new_hashes, new_block_hash, provenance),
                    ensure_ascii=False, indent=2,
                ) + "\n"
            ).encode("utf-8")
            changes.append(upgrade_change(
                project, len(changes), MANIFEST_PATH.as_posix(), manifest_bytes, 0o644
            ))
            changes.append(upgrade_change(
                project, len(changes), INSTALLED_VERSION_PATH.as_posix(),
                (version + "\n").encode("utf-8"), 0o644,
            ))
    except (OSError, UnicodeError, VibeError) as error:
        return report_upgrade_blocked_no_write(
            target, from_version, version, provenance, "upgrade_preflight_changed",
            bounded_diagnostic_detail(target, str(error)),
            transaction_shape(None, "not-applied", "absent", "absent"),
            "predecessor", bridge, "rerun-upgrade-plan", output_format,
        )
    transaction_result = execute_upgrade_transaction(
        target, from_version, version, changes
    )
    if bridge["state"] == "planned" and transaction_result["installation_state"] == "target":
        bridge = {**bridge, "state": "applied"}
    if output_format == "json":
        activation = source_activation_identity(source)
        values: Dict[str, object] = {
            "operation": "upgrade",
            "target": str(target),
            "from_version": from_version,
            "target_version": version,
            "source": provenance,
            "write_state": transaction_result["write_state"],
            "writes_performed": writes_performed(transaction_result["write_state"]),
            "installation_state": transaction_result["installation_state"],
            "transaction": transaction_result["transaction"],
            "onboarding_bridge": bridge,
            "compatibility_migrations": (
                [predecessor_migration_evidence("applied")]
                if migration_decision == "eligible" and transaction_result["installation_state"] == "target"
                else []
            ),
            "summary": (
                "Upgrade committed and target installation verified."
                if transaction_result["status"] == "success"
                else (
                    "Target upgrade committed; transaction cleanup remains and must be finalized with recover-upgrade."
                    if (
                        transaction_result["installation_state"] == "target"
                        and transaction_result["transaction"].get("outcome") == "committed"
                    )
                    else "Upgrade did not commit; inspect the reported recovery state."
                )
            ),
            "error": transaction_result["error"],
            "next_action": transaction_result["next_action"],
            "managed_files_updated": updated,
            "locally_modified_entries_preserved": preserved_local,
            "stale_managed_paths_preserved": stale,
            "target_fingerprint": activation["fingerprint"],
            "activation": {
                "state": "not-proven",
                "path": "none",
                "manual_new_task_supported": True,
                "same_task_reload_claimed": False,
                "automatic_successor_handoff_claimed": False,
            },
        }
        print_json(
            result_envelope(
                "upgrade",
                transaction_result["status"],
                **values,
            )
        )
        return 0 if transaction_result["status"] == "success" else 2
    if transaction_result["status"] != "success":
        print(f"error: {transaction_result['error']['message']}", file=sys.stderr)
        print(f"Write state: {transaction_result['write_state']}", file=sys.stderr)
        print(f"Next action: {transaction_result['next_action']['code']}", file=sys.stderr)
        return 2
    print(f"Vibe Kit upgrade complete: {target}")
    print(f"Framework version: {version}")
    print(f"Managed files updated: {updated}")
    if preserved_local:
        print(f"Locally modified managed entries preserved: {preserved_local}")
    if stale:
        print(f"Stale managed paths preserved for manual review: {len(stale)}")
    return 0


def print_recovery_result(
    output_format: str,
    status: str,
    target: Path,
    from_version: Optional[str],
    target_version: Optional[str],
    write_state: str,
    installation_state: str,
    transaction: Dict[str, object],
    error: Optional[Dict[str, str]],
    next_action: Optional[Dict[str, str]],
) -> int:
    if output_format == "json":
        print_json(result_envelope(
            "recover-upgrade", status, target=str(target),
            from_version=from_version, target_version=target_version,
            write_state=write_state, writes_performed=writes_performed(write_state),
            installation_state=installation_state, transaction=transaction,
            error=error, next_action=next_action,
        ))
    elif status == "success":
        print(f"Upgrade recovery complete: {target}")
        print(f"Installation state: {installation_state}")
        print(f"Outcome: {transaction['outcome']}")
    else:
        print(f"error: {error['message'] if error else 'upgrade recovery blocked'}", file=sys.stderr)
        print(f"Next action: {next_action['code'] if next_action else 'inspect-upgrade-transaction'}", file=sys.stderr)
    return 0 if status == "success" else 2


def partial_directory_stage_is_intent_exact(
    project: ProjectRootFD, unit: Dict[str, object]
) -> bool:
    staging_root = str(unit["staging_root"])
    if project.path_state(staging_root) == "absent":
        return True
    expected_directories = {
        logical_to_staging_path(unit, str(item["path"])): item
        for item in unit["directories"]
    }
    expected_files = {
        logical_to_staging_path(unit, str(item["path"])): item
        for item in unit["members"]
    }

    def walk(relative: str) -> bool:
        item = expected_directories.get(relative)
        if item is None:
            return False
        try:
            descriptor = project.open_directory(relative)
        except (OSError, VibeError):
            return False
        try:
            if stat.S_IMODE(os.fstat(descriptor).st_mode) != item["mode"]:
                return False
            names = list(os.listdir(descriptor))
        finally:
            os.close(descriptor)
        for name in names:
            child = f"{relative}/{name}"
            state = project.path_state(child)
            if state == "directory":
                if not walk(child):
                    return False
            elif state == "regular":
                member = expected_files.get(child)
                if member is None:
                    return False
                image = member["postimage"]
                observed_state, content, mode, _ = project.read_entry(child)
                if bytes_identity(observed_state, content, mode) != image:
                    return False
            else:
                return False
        return True

    return walk(staging_root)


def cleanup_unprepared_private_objects(project: ProjectRootFD) -> None:
    intent_path = transaction_member_path("intent.json")
    if project.path_state(intent_path) == "absent":
        return
    intent = load_project_json(project, intent_path)
    owner = load_project_json(project, transaction_member_path("owner.json"))
    transaction_id = owner.get("transaction_id")
    required = {
        "schema_version", "transaction_id", "project_identity_sha256",
        "from_version", "target_version", "allowed_paths", "changes",
        "leaf_capability_probes", "directory_units",
        "directory_capability_probes", "manifest_identity", "agents_identity",
        "onboarding_identity", "postimage_set_sha256",
        "directory_postimage_set_sha256",
    }
    if (
        set(intent) != required
        or intent.get("transaction_id") != transaction_id
        or intent.get("project_identity_sha256") != project.identity_sha256()
    ):
        raise VibeError("unprepared intent is invalid")
    for unit in intent["directory_units"]:
        if (
            project.directory_object(str(unit["parent_path"])) != unit["parent_object"]
            or project.path_state(str(unit["final_root"])) != "absent"
            or not partial_directory_stage_is_intent_exact(project, unit)
        ):
            raise VibeError("unprepared directory stage cannot be cleaned safely")
    for item in intent["changes"]:
        temporary_path = item.get("temporary_path")
        if temporary_path is None or project.path_state(str(temporary_path)) == "absent":
            continue
        state, content, mode, identity = project.read_entry(str(temporary_path))
        if bytes_identity(state, content, mode) != item["postimage"] or identity is None:
            raise VibeError("unprepared leaf temporary cannot be cleaned safely")
        project.unlink_exact_private(str(temporary_path), identity, item["postimage"])
    allowed_probe_images = {
        hashlib.sha256(value).hexdigest(): value
        for value in (b"vibe-probe-a\n", b"vibe-probe-b\n")
    }
    for probe in intent["leaf_capability_probes"]:
        for key in ("probe_a_path", "probe_b_path"):
            relative = str(probe[key])
            if project.path_state(relative) == "absent":
                continue
            state, content, mode, identity = project.read_entry(relative)
            digest = hashlib.sha256(content).hexdigest() if content is not None else None
            if state != "regular" or mode != 0o600 or digest not in allowed_probe_images or identity is None:
                raise VibeError("unprepared leaf probe cannot be cleaned safely")
            project.unlink_exact_private(
                relative, identity, bytes_identity(state, content, mode)
            )
    for probe in intent["directory_capability_probes"]:
        if project.directory_object(str(probe["parent_path"])) != probe["parent_object"]:
            raise VibeError("unprepared directory probe parent changed")
        for key in ("probe_a_path", "probe_b_path"):
            relative = str(probe[key])
            state = project.path_state(relative)
            if state == "absent":
                continue
            if state != "directory":
                raise VibeError("unprepared directory probe cannot be cleaned safely")
            descriptor = project.open_directory(relative)
            try:
                names = sorted(os.listdir(descriptor))
            finally:
                os.close(descriptor)
            if names not in ([], ["marker"]):
                raise VibeError("unprepared directory probe has extra members")
            if names:
                marker_state, marker, marker_mode, _ = project.read_entry(
                    f"{relative}/marker"
                )
                if (
                    marker_state != "regular" or marker_mode != 0o600
                    or marker not in (
                        b"vibe-directory-probe-a\n",
                        b"vibe-directory-probe-b\n",
                    )
                ):
                    raise VibeError("unprepared directory probe marker diverged")
            project.remove_tree(relative, probe["parent_object"])
    for unit in intent["directory_units"]:
        if project.path_state(str(unit["staging_root"])) != "absent":
            project.remove_tree(
                str(unit["staging_root"]), unit["parent_object"]
            )


def recover_upgrade(target: Path, output_format: str) -> int:
    target = target.resolve()
    kind, shape = active_transaction_state(target)
    if kind == "absent":
        proven, manifest_version, _ = independently_authenticated_installation(target)
        observed = (
            "target" if proven and manifest_version == framework_version(source_root())
            else "predecessor" if proven else "unknown"
        )
        return print_recovery_result(
            output_format, "blocked", target, manifest_version, framework_version(source_root()),
            "none", observed, shape,
            {"code": "upgrade_transaction_absent", "message": "No active upgrade transaction exists."},
            {"code": "rerun-upgrade-plan", "detail": "Run a read-only upgrade plan."},
        )
    if kind == "invalid":
        return print_recovery_result(
            output_format, "blocked", target, None, None, "none", "unknown", shape,
            {"code": "upgrade_transaction_state_invalid", "message": "Transaction evidence cannot be classified; automatic recovery is forbidden."},
            {"code": "inspect-upgrade-transaction", "detail": "Inspect the private transaction state without overwriting project files."},
        )
    if kind in ("bootstrap", "unprepared"):
        proven, predecessor_version, failed_path = independently_authenticated_installation(
            target
        )
        if not proven:
            shape.update({
                "outcome": "unknown-partial", "phase": "invalid",
                "failed_path": failed_path,
                "failure_kind": "predecessor-not-proven",
            })
            return print_recovery_result(
                output_format, "blocked", target, predecessor_version, None,
                "none", "unknown", shape,
                {
                    "code": "upgrade_predecessor_not_proven",
                    "message": "The exact predecessor managed bytes, AGENTS block, and install state no longer match; transaction evidence is preserved.",
                },
                {
                    "code": "inspect-upgrade-transaction",
                    "detail": "Inspect the divergent predecessor path; automatic cleanup is forbidden.",
                },
            )
        try:
            if kind == "unprepared":
                with ProjectRootFD(target) as project:
                    cleanup_unprepared_private_objects(project)
            remove_transaction_control(target)
        except (OSError, UnicodeError, VibeError) as error:
            shape.update({"outcome": "recovery-required", "phase": "recovery-required"})
            return print_recovery_result(
                output_format, "error", target, None, None, "recovery-required",
                "recovery-required", shape,
                {"code": "upgrade_recovery_failed", "message": bounded_diagnostic_detail(target, str(error))},
                {"code": "recover-upgrade", "detail": "Resolve the filesystem error and run recovery again."},
            )
        shape.update({"outcome": "not-applied", "phase": "complete"})
        return print_recovery_result(
            output_format, "success", target, predecessor_version, None,
            "transaction-control-written", "predecessor", shape, None, None,
        )
    try:
        with ProjectRootFD(target) as project:
            intent = load_project_json(
                project, transaction_member_path("intent.json")
            )
            prepared = load_prepared_transaction(project)
        from_version = str(intent["from_version"])
        target_version = str(intent["target_version"])
        observed, mismatched = transaction_installation_state(target, intent)
        if observed == "unknown":
            directory_roots = {
                str(unit["final_root"])
                for unit in intent.get("directory_units", [])
            }
            failed_path = mismatched[0] if mismatched else None
            directory_race = failed_path in directory_roots
            shape.update({
                "outcome": "unknown-partial", "phase": "invalid",
                "failed_path": failed_path,
                "failure_kind": (
                    "external-directory-race-preserved"
                    if directory_race else "external-divergence"
                ),
            })
            return print_recovery_result(
                output_format, "blocked", target, from_version, target_version,
                "none", "unknown", shape,
                {
                    "code": (
                        "upgrade_directory_race_preserved"
                        if directory_race else "upgrade_transaction_diverged"
                    ),
                    "message": (
                        "A third-party final directory entry is preserved."
                        if directory_race
                        else "A scoped path matches neither recorded preimage nor postimage."
                    ),
                },
                {
                    "code": "inspect-upgrade-transaction",
                    "detail": (
                        "Inspect the preserved final directory entry and private stage; automatic overwrite is forbidden."
                        if directory_race
                        else "Inspect the divergent scoped path; automatic overwrite is forbidden."
                    ),
                },
            )
        if kind == "committed":
            with ProjectRootFD(target) as project:
                pairs_valid, pair_path = committed_pairs_valid(
                    project, intent, prepared
                )
            if observed != "target" or not pairs_valid:
                shape.update({"outcome": "unknown-partial", "phase": "invalid"})
                shape["failed_path"] = pair_path if not pairs_valid else (
                    mismatched[0] if mismatched else None
                )
                return print_recovery_result(
                    output_format, "blocked", target, from_version, target_version,
                    "none", "unknown", shape,
                    {"code": "upgrade_committed_target_diverged", "message": "A valid commit marker does not match exact target postimages."},
                    {"code": "inspect-upgrade-transaction", "detail": "Inspect the committed transaction and target paths."},
                )
            with ProjectRootFD(target) as project:
                cleanup_committed_private_objects(project, intent, prepared)
            remove_transaction_control(target)
            shape.update({"outcome": "committed", "phase": "complete"})
            return print_recovery_result(
                output_format, "success", target, from_version, target_version,
                "transaction-control-written", "target", shape, None, None,
            )
        if observed == "predecessor":
            cleaned, failed_path = rollback_upgrade_transaction(target, intent)
            if cleaned:
                shape.update({"outcome": "not-applied", "phase": "complete"})
                return print_recovery_result(
                    output_format, "success", target, from_version, target_version,
                    "transaction-control-written", "predecessor", shape, None, None,
                )
            shape.update({
                "outcome": "unknown-partial", "phase": "invalid",
                "failed_path": failed_path,
                "failure_kind": "private-state-diverged",
            })
            return print_recovery_result(
                output_format, "blocked", target, from_version, target_version,
                "none", "unknown", shape,
                {"code": "upgrade_transaction_diverged", "message": "Prepared private transaction state diverged during recovery."},
                {"code": "inspect-upgrade-transaction", "detail": "Inspect the preserved private state."},
            )
        rolled_back, failed_path = rollback_upgrade_transaction(target, intent)
        if rolled_back:
            shape.update({
                "outcome": "rolled-back", "phase": "complete", "commit_marker": "absent",
                "failed_path": None, "failure_kind": None,
            })
            return print_recovery_result(
                output_format, "success", target, from_version, target_version,
                "rolled-back", "predecessor", shape, None, None,
            )
        shape.update({
            "outcome": "recovery-required", "phase": "recovery-required",
            "failed_path": failed_path, "failure_kind": "rollback-incomplete",
        })
        return print_recovery_result(
            output_format, "blocked", target, from_version, target_version,
            "recovery-required", "recovery-required", shape,
            {"code": "upgrade_recovery_incomplete", "message": "Recovery could not restore every exact predecessor preimage."},
            {"code": "recover-upgrade", "detail": "Resolve the reported filesystem condition and run recovery again."},
        )
    except (OSError, UnicodeError, VibeError, KeyError, TypeError) as error:
        kind_after, shape_after = active_transaction_state(target)
        unknown = kind_after == "invalid"
        shape_after.update({
            "outcome": "unknown-partial" if unknown else "recovery-required",
            "phase": "invalid" if unknown else "recovery-required",
            "failure_kind": type(error).__name__,
        })
        return print_recovery_result(
            output_format, "error", target, None, None,
            "unknown-partial" if unknown else "recovery-required",
            "unknown" if unknown else "recovery-required", shape_after,
            {"code": "upgrade_recovery_failed", "message": bounded_diagnostic_detail(target, str(error))},
            {"code": "inspect-upgrade-transaction" if unknown else "recover-upgrade", "detail": "Inspect transaction evidence." if unknown else "Resolve the filesystem error and run recovery again."},
        )


def validate_skill(path: Path) -> List[str]:
    errors: List[str] = []
    content = path.read_text(encoding="utf-8", errors="replace")
    if not content.startswith("---\n"):
        errors.append(f"{path}: missing YAML frontmatter")
        return errors
    parts = content.split("---", 2)
    frontmatter = parts[1] if len(parts) == 3 else ""
    name_match = re.search(r"(?m)^name:\s*([^\s]+)\s*$", frontmatter)
    if not name_match:
        errors.append(f"{path}: missing skill name")
    else:
        name = name_match.group(1)
        if not re.fullmatch(r"[a-z0-9-]{1,63}", name):
            errors.append(f"{path}: invalid skill name {name!r}")
        if name != path.parent.name:
            errors.append(f"{path}: skill name does not match its folder")
    if not re.search(r"(?m)^description:\s*\S+", frontmatter):
        errors.append(f"{path}: missing skill description")
    if re.search(r"(?i)\b(TODO|TBD)\b", content):
        errors.append(f"{path}: unfinished placeholder")
    return errors


def validate_agent(path: Path) -> List[str]:
    content = path.read_text(encoding="utf-8", errors="replace")
    errors = []
    for key in ("name", "description", "developer_instructions"):
        if not re.search(rf"(?m)^{key}\s*=", content):
            errors.append(f"{path}: missing {key}")
    return errors


def bounded_diagnostic_detail(target: Path, detail: str) -> str:
    sanitized = detail.replace(str(target.resolve()), ".")
    sanitized = re.sub(r"\x1b\[[0-?]*[ -/]*[@-~]", "", sanitized)
    sanitized = "".join(
        character
        for character in sanitized
        if character in "\n\t" or ord(character) >= 32
    )
    encoded = sanitized.encode("utf-8", errors="replace")
    if len(encoded) > 512:
        encoded = encoded[:509]
        while True:
            try:
                sanitized = encoded.decode("utf-8") + "..."
                break
            except UnicodeDecodeError:
                encoded = encoded[:-1]
    else:
        sanitized = encoded.decode("utf-8", errors="replace")
    return sanitized


def doctor_diagnostic(
    target: Path, code: str, path: Optional[str], detail: str
) -> Dict[str, object]:
    registry = DIAGNOSTIC_REGISTRY.get(code)
    if registry is None:
        raise ValueError(f"unknown doctor diagnostic code: {code}")
    level, readiness_effect = registry
    return {
        "code": code,
        "level": level,
        "readiness_effect": readiness_effect,
        "path": path,
        "detail": bounded_diagnostic_detail(target, detail),
    }


def runtime_discovery_path(relative: str) -> bool:
    return (
        relative in ("AGENT_INSTALL.md", "agent-install.json", "bin/vibe")
        or relative.startswith(".vibe/core/")
        or relative.startswith(".agents/skills/")
        or relative.startswith(".codex/agents/")
        or relative == "AGENTS.md#managed-block"
    )


def doctor(target: Path, output_format: str) -> int:
    target = target.resolve()
    errors: List[str] = []
    warnings: List[str] = []
    diagnostics: List[Dict[str, object]] = []
    readiness = "review-required"
    readiness_kind = "derived"
    active_kind, active_shape = active_transaction_state(target)

    def add(code: str, detail: str, path: Optional[str] = None) -> None:
        diagnostic = doctor_diagnostic(target, code, path, detail)
        diagnostics.append(diagnostic)
        if diagnostic["level"] == "warning":
            warnings.append(detail)
        else:
            errors.append(detail)

    if active_kind != "absent":
        add(
            "upgrade-transaction-state-invalid" if active_kind == "invalid" else "upgrade-transaction-active",
            (
                "upgrade transaction state cannot be classified; inspect-upgrade-transaction"
                if active_kind == "invalid"
                else "upgrade transaction is active; run recover-upgrade"
            ),
            TRANSACTION_ACTIVE_PATH.as_posix(),
        )

    manifest, manifest_version, manifest_display = read_manifest_for_doctor(target)
    versions_ok, version_result = version_integrity(
        target, manifest_version, manifest_display
    )
    if not versions_ok:
        add("version-integrity-failed", version_result)

    if manifest is None:
        add(
            "manifest-missing-or-invalid",
            f"installation manifest is missing or invalid: {MANIFEST_PATH.as_posix()}",
            MANIFEST_PATH.as_posix(),
        )
    else:
        managed_files = manifest.get("managed_files")
        if not isinstance(managed_files, dict):
            add(
                "manifest-missing-or-invalid",
                f"invalid managed file manifest: {MANIFEST_PATH.as_posix()}",
                MANIFEST_PATH.as_posix(),
            )
            managed_files = {}
        for relative, expected in managed_files.items():
            relative_text = str(relative)
            path = target / relative_text
            if not path.is_file():
                add(
                    "managed-file-missing",
                    f"missing managed file: {relative_text}",
                    relative_text,
                )
            elif sha256(path) != str(expected):
                add(
                    "managed-file-hash-mismatch",
                    f"locally modified managed file: {relative_text}",
                    relative_text,
                )
        agents = target / "AGENTS.md"
        if not agents.is_file():
            add("agents-file-missing", "missing AGENTS.md", "AGENTS.md")
        else:
            try:
                block = extract_agents_block(agents.read_text(encoding="utf-8"))
            except (OSError, UnicodeError, VibeError) as error:
                block = None
                add(
                    "agents-block-missing",
                    f"invalid Vibe Kit block in AGENTS.md: {error}",
                    "AGENTS.md#managed-block",
                )
            if block is None:
                if not any(
                    item["code"] == "agents-block-missing" for item in diagnostics
                ):
                    add(
                        "agents-block-missing",
                        "missing Vibe Kit block in AGENTS.md",
                        "AGENTS.md#managed-block",
                    )
            elif manifest.get("agents_block_hash") and sha256_text(block) != manifest.get(
                "agents_block_hash"
            ):
                add(
                    "agents-block-hash-mismatch",
                    "locally modified Vibe Kit block in AGENTS.md",
                    "AGENTS.md#managed-block",
                )

        guide_path = target / "AGENT_INSTALL.md"
        guide_expected = managed_files.get("AGENT_INSTALL.md")
        if not guide_path.is_file() or not validate_agent_install_guide_bytes(
            guide_path.read_bytes() if guide_path.is_file() else b""
        ) or guide_expected != (sha256(guide_path) if guide_path.is_file() else None):
            add(
                "agent-install-guide-invalid",
                "installed Agent-install guide is missing, modified, or malformed",
                "AGENT_INSTALL.md",
            )

        contract_path = target / "agent-install.json"
        contract_value: Optional[Dict[str, object]] = None
        try:
            contract_value = load_agent_install_contract(target)
        except VibeError:
            pass
        protocol_value: Dict[str, object] = {}
        try:
            protocol_value = release_protocol(target)
        except VibeError:
            pass
        contract_takeover = (
            contract_value.get("takeover") if isinstance(contract_value, dict) else None
        )
        contract_activation = (
            contract_value.get("activation") if isinstance(contract_value, dict) else None
        )
        contract_expected = managed_files.get("agent-install.json")
        contract_valid = (
            isinstance(contract_value, dict)
            and contract_expected == sha256(contract_path)
            and not validate_agent_install_contract_shape(contract_value)
            and contract_value.get("kit_version") == manifest_version
            and protocol_value.get("core_protocol") == CORE_PROTOCOL
            and protocol_value.get("agent_install_protocol") == AGENT_INSTALL_PROTOCOL
            and protocol_value.get("takeover_contract_registry_sha256")
            == TAKEOVER_CONTRACT_REGISTRY_SHA256
            and valid_predecessor_migration_mirror(
                protocol_value.get("predecessor_migrations")
            )
            and isinstance(contract_takeover, dict)
            and contract_takeover.get("contract_registry_sha256")
            == TAKEOVER_CONTRACT_REGISTRY_SHA256
            and isinstance(contract_activation, dict)
        )
        if not contract_valid:
            add(
                "agent-install-contract-invalid",
                "installed Agent-install machine contract is missing, modified, or inconsistent",
                "agent-install.json",
            )

        activation = manifest.get("activation")
        fingerprint_value = manifest.get("target_fingerprint")
        activation_valid = isinstance(activation, dict) and isinstance(
            fingerprint_value, dict
        )
        if activation_valid:
            paths = activation.get("paths")
            expected_hashes = activation.get("path_hashes")
            expected_digest = activation.get("activation_set_sha256")
            roots = activation.get("runtime_discovery_roots")
            base_fingerprint = {
                key: fingerprint_value.get(key)
                for key in (
                    "kit_version",
                    "core_protocol",
                    "agent_install_schema",
                    "agent_install_protocol",
                    "adapter_name",
                    "adapter_protocol",
                )
            }
            activation_valid = (
                isinstance(paths, list)
                and paths == sorted(set(paths))
                and all(isinstance(item, str) and item for item in paths)
                and isinstance(expected_hashes, dict)
                and set(expected_hashes) == set(paths)
                and all(
                    isinstance(value, str)
                    and re.fullmatch(r"[0-9a-f]{64}", value)
                    for value in expected_hashes.values()
                )
                and isinstance(expected_digest, str)
                and re.fullmatch(r"[0-9a-f]{64}", expected_digest) is not None
                and activation.get("algorithm") == ACTIVATION_SET_ALGORITHM
                and roots == list(RUNTIME_DISCOVERY_ROOTS)
                and base_fingerprint
                == {
                    "kit_version": manifest_version,
                    "core_protocol": CORE_PROTOCOL,
                    "agent_install_schema": AGENT_INSTALL_SCHEMA,
                    "agent_install_protocol": AGENT_INSTALL_PROTOCOL,
                    "adapter_name": "codex",
                    "adapter_protocol": CODEX_ADAPTER_PROTOCOL,
                }
                and activation_set_digest(base_fingerprint, expected_hashes)
                == expected_digest
                and fingerprint_value.get("activation_set_sha256")
                == expected_digest
                and isinstance(contract_activation, dict)
                and contract_activation.get("activation_set_algorithm")
                == ACTIVATION_SET_ALGORITHM
                and contract_activation.get("activation_paths") == paths
                and contract_activation.get("activation_set_sha256") == expected_digest
            )
        if not activation_valid:
            add(
                "manifest-missing-or-invalid",
                "installation manifest activation identity is missing, unknown, or inconsistent",
                MANIFEST_PATH.as_posix(),
            )
        else:
            expected_paths = set(activation["paths"])
            stale_candidates = set(str(key) for key in managed_files) - expected_paths
            try:
                discovered = {
                    path.relative_to(target).as_posix()
                    for path in managed_source_files(target)
                }
                stale_candidates.update(discovered - expected_paths)
            except (OSError, UnicodeError) as error:
                add(
                    "diagnostic-internal-error",
                    f"could not inspect runtime discovery roots: {error}",
                )
            for relative in sorted(stale_candidates):
                code = (
                    "stale-runtime-path-preserved"
                    if runtime_discovery_path(relative)
                    else "stale-nonruntime-path-preserved"
                )
                add(code, f"stale managed path preserved: {relative}", relative)

            actual_hashes: Dict[str, str] = {}
            for relative in activation["paths"]:
                if relative == "AGENTS.md#managed-block":
                    agents_path = target / "AGENTS.md"
                    if agents_path.is_file():
                        try:
                            actual_block = extract_agents_block(
                                agents_path.read_text(encoding="utf-8")
                            )
                        except (OSError, UnicodeError, VibeError):
                            actual_block = None
                        if actual_block is not None:
                            actual_hashes[relative] = sha256_text(actual_block)
                    continue
                actual_path = target / relative
                if actual_path.is_file():
                    try:
                        actual_hashes[relative] = (
                            normalized_agent_install_sha256(actual_path)
                            if relative == "agent-install.json"
                            else sha256(actual_path)
                        )
                    except VibeError:
                        pass
            actual_digest = (
                activation_set_digest(base_fingerprint, actual_hashes)
                if set(actual_hashes) == expected_paths
                else None
            )
            manifest["_doctor_activation"] = {
                "status": "match" if actual_digest == expected_digest else "mismatch",
                "expected_activation_set_sha256": expected_digest,
                "actual_activation_set_sha256": actual_digest,
                "differing_paths": sorted(
                    relative
                    for relative in expected_paths
                    if actual_hashes.get(relative)
                    != activation["path_hashes"].get(relative)
                ),
                "stale_runtime_paths": sorted(
                    item for item in stale_candidates if runtime_discovery_path(item)
                ),
                "stale_nonruntime_paths": sorted(
                    item for item in stale_candidates if not runtime_discovery_path(item)
                ),
            }

    for required in (
        Path(".vibe/project.yaml"),
        Path(".vibe/project-rules.md"),
        Path(".vibe/core/operating-model.md"),
    ):
        if not (target / required).is_file():
            add(
                "required-project-file-missing",
                f"missing required file: {required.as_posix()}",
                required.as_posix(),
            )

    project_config = target / ".vibe/project.yaml"
    if project_config.is_file():
        try:
            parse_feedback_mode(project_config)
        except VibeError as error:
            add("project-config-invalid", str(error), ".vibe/project.yaml")

    if not (target / ONBOARDING_PATH).is_file():
        readiness = "review-required"
        readiness_kind = "derived"
        add(
            "onboarding-state-missing",
            "onboarding state is missing; review repository context before substantive work",
            ONBOARDING_PATH.as_posix(),
        )
    else:
        try:
            readiness, _ = onboarding_readiness(target)
            readiness_kind = (
                "persisted" if readiness in ONBOARDING_STATUSES else "derived"
            )
        except VibeError as error:
            add("onboarding-state-invalid", str(error), ONBOARDING_PATH.as_posix())
            readiness = "invalid"
            readiness_kind = "derived"

    for skill in (target / ".agents/skills").glob("vibe-*/SKILL.md"):
        for error in validate_skill(skill):
            add(
                "skill-contract-invalid",
                error,
                skill.relative_to(target).as_posix(),
            )
    for agent in (target / ".codex/agents").glob("vibe-*.toml"):
        for error in validate_agent(agent):
            add(
                "agent-contract-invalid",
                error,
                agent.relative_to(target).as_posix(),
            )

    if output_format == "json":
        status = "broken" if errors else ("warning" if warnings else "healthy")
        raw_manifest_sha256 = (
            sha256(target / MANIFEST_PATH)
            if (target / MANIFEST_PATH).is_file()
            else None
        )
        print_json(
            result_envelope(
                "doctor",
                status,
                target=str(target),
                kit_version=version_result if versions_ok else None,
                version_integrity={
                    "status": "ok" if versions_ok else "failed",
                    "detail": version_result,
                },
                onboarding={"status": readiness, "kind": readiness_kind},
                manifest_sha256=raw_manifest_sha256,
                target_fingerprint=(
                    {
                        **manifest.get("target_fingerprint", {}),
                        "manifest_sha256": raw_manifest_sha256,
                    }
                    if isinstance(manifest, dict)
                    and isinstance(manifest.get("target_fingerprint"), dict)
                    else None
                ),
                activation=(
                    manifest.get("_doctor_activation")
                    if isinstance(manifest, dict)
                    else None
                ),
                diagnostics=diagnostics,
                diagnostic_registry={
                    "non_blocking_warning_codes": list(
                        DOCTOR_NON_BLOCKING_WARNING_CODES
                    )
                },
                warnings=warnings,
                errors=errors,
                network_used=False,
                write_state="none",
                writes_performed=False,
                installation_state=(
                    "unknown" if active_kind == "invalid" else
                    ("recovery-required" if active_kind != "absent" else (
                        "target" if versions_ok else "unknown"
                    ))
                ),
                transaction=active_shape,
                next_action=(
                    {"code": "inspect-upgrade-transaction", "detail": "Inspect invalid transaction evidence."}
                    if active_kind == "invalid" else
                    ({"code": "recover-upgrade", "detail": "Run recover-upgrade before activation or further maintenance."}
                     if active_kind != "absent" else None)
                ),
            )
        )
        return 1 if errors else 0
    if versions_ok:
        print(f"Version integrity: OK ({version_result})")
    print(f"Onboarding readiness: {readiness}")
    for warning in warnings:
        print(f"WARN: {warning}")
    for error in errors:
        print(f"ERROR: {error}", file=sys.stderr)
    if errors:
        return 1
    print(
        f"Vibe Kit doctor passed with {len(warnings)} warning(s): {target}"
    )
    return 0


def parse_feedback_mode_value(raw: str, path: Path) -> str:
    value = raw.strip()
    if value.startswith('"'):
        match = re.fullmatch(r'("(?:[^"\\]|\\.)*")\s*(?:#.*)?', value)
        if not match:
            raise VibeError(f"invalid feedback.mode value in {path}")
        try:
            parsed = json.loads(match.group(1))
        except json.JSONDecodeError as error:
            raise VibeError(f"invalid feedback.mode value in {path}") from error
    elif value.startswith("'"):
        match = re.fullmatch(r"'([^']*)'\s*(?:#.*)?", value)
        if not match:
            raise VibeError(f"invalid feedback.mode value in {path}")
        parsed = match.group(1)
    else:
        match = re.fullmatch(r"([A-Za-z0-9_-]+)\s*(?:#.*)?", value)
        if not match:
            raise VibeError(f"invalid feedback.mode value in {path}")
        parsed = match.group(1)
    if parsed not in FEEDBACK_MODES:
        raise VibeError(
            f"feedback.mode must be one of {', '.join(FEEDBACK_MODES)} in {path}; "
            "fix the project-owned configuration before proactive feedback runs"
        )
    return str(parsed)


def parse_feedback_mode(path: Path) -> Tuple[str, str]:
    if not path.is_file():
        return "ask", "default-missing"
    section_count = 0
    mode_count = 0
    mode: Optional[str] = None
    in_feedback = False
    for line_number, raw_line in enumerate(
        path.read_text(encoding="utf-8").splitlines(), 1
    ):
        if re.match(r"^feedback\s*:", raw_line):
            if not re.fullmatch(r"feedback:\s*(?:#.*)?", raw_line):
                raise VibeError(
                    f"feedback section must be a block mapping in {path}:{line_number}"
                )
            section_count += 1
            if section_count > 1:
                raise VibeError(f"duplicate feedback section in {path}:{line_number}")
            in_feedback = True
            continue
        if not in_feedback:
            continue
        if not raw_line.strip() or raw_line.lstrip().startswith("#"):
            continue
        if raw_line[0] not in (" ", "\t"):
            in_feedback = False
            continue
        if "\t" in raw_line:
            raise VibeError(
                f"tabs are not allowed in the feedback section of {path}:{line_number}"
            )
        if re.match(r"^\s+mode\s*:", raw_line):
            match = re.match(r"^  mode:\s*(.*)$", raw_line)
            if not match:
                raise VibeError(
                    f"feedback.mode must use two-space indentation in {path}:{line_number}"
                )
            mode_count += 1
            if mode_count > 1:
                raise VibeError(f"duplicate feedback.mode in {path}:{line_number}")
            mode = parse_feedback_mode_value(match.group(1), path)
    if mode is None:
        return "ask", "default-missing"
    return mode, "project"


def feedback_mode(target: Path) -> Tuple[str, str]:
    return parse_feedback_mode(target.resolve() / ".vibe/project.yaml")


def feedback_mode_command(target: Path) -> int:
    mode, source = feedback_mode(target)
    print(f"Feedback mode: {mode}")
    print(f"Source: {source}")
    print("Network: not used")
    return 0


def parse_commands(path: Path) -> Dict[str, str]:
    commands: Dict[str, str] = {}
    in_commands = False
    for raw_line in path.read_text(encoding="utf-8").splitlines():
        if raw_line.strip() == "commands:":
            in_commands = True
            continue
        if not in_commands:
            continue
        if raw_line and not raw_line.startswith(" "):
            break
        match = re.match(r"^\s{2}([A-Za-z0-9_-]+):\s*(.*)$", raw_line)
        if not match:
            continue
        key, raw_value = match.groups()
        raw_value = raw_value.strip()
        if not raw_value:
            commands[key] = ""
            continue
        try:
            value = json.loads(raw_value)
        except json.JSONDecodeError:
            value = raw_value
        commands[key] = str(value)
    return commands


def sanitize_verify_stream(target: Path, content: bytes) -> Tuple[str, bool]:
    text = content.decode("utf-8", errors="replace")
    text = re.sub(r"\x1b\[[0-?]*[ -/]*[@-~]", "", text)
    text = "".join(
        character
        for character in text
        if character in "\n\t" or ord(character) >= 32
    )
    canonical_root = str(target.resolve())
    root_aliases = [canonical_root]
    if canonical_root.startswith("/private/"):
        root_aliases.append(canonical_root[len("/private"):])
    for root_alias in sorted(root_aliases, key=len, reverse=True):
        text = text.replace(root_alias, ".")
    for pattern in SECRET_PATTERNS:
        text = pattern.sub("[REDACTED]", text)
    encoded = text.encode("utf-8", errors="replace")
    truncated = len(encoded) > VERIFY_OUTPUT_LIMIT
    if truncated:
        encoded = encoded[-VERIFY_OUTPUT_LIMIT:]
        while True:
            try:
                text = encoded.decode("utf-8")
                break
            except UnicodeDecodeError:
                encoded = encoded[1:]
    else:
        text = encoded.decode("utf-8", errors="replace")
    return text, truncated


def verify_output(
    stdout: bytes, stderr: bytes, target: Path
) -> Dict[str, object]:
    stdout_tail, stdout_truncated = sanitize_verify_stream(target, stdout)
    stderr_tail, stderr_truncated = sanitize_verify_stream(target, stderr)
    return {
        "stdout_tail": stdout_tail,
        "stderr_tail": stderr_tail,
        "stdout_truncated": stdout_truncated,
        "stderr_truncated": stderr_truncated,
    }


def verify(target: Path, only: Sequence[str], output_format: str) -> int:
    target = target.resolve()
    config = target / ".vibe/project.yaml"
    if not config.is_file():
        raise VibeError(f"Project configuration is missing: {config}")
    commands = parse_commands(config)
    requested = [key for key in VERIFY_ORDER if key in set(only)] if only else []
    selected = requested if only else list(VERIFY_ORDER)
    checks: List[Dict[str, object]] = []
    for key in selected:
        command = commands.get(key, "")
        if not command:
            checks.append(
                {
                    "name": key,
                    "configured": False,
                    "applicability": "not-applicable",
                    "required": False,
                    "outcome": "unconfigured",
                    "exit_code": None,
                    "reason_code": "not-configured",
                    "provenance": {
                        "kind": "cli",
                        "task_id": None,
                        "operation_id": None,
                    },
                    "output": verify_output(b"", b"", target),
                }
            )
            continue
        if output_format == "text":
            print(f"\n==> {key}: {command}", flush=True)
        try:
            result = subprocess.run(
                command,
                cwd=str(target),
                shell=True,
                check=False,
                capture_output=True,
            )
        except OSError as error:
            captured = verify_output(b"", str(error).encode("utf-8"), target)
            checks.append(
                {
                    "name": key,
                    "configured": True,
                    "applicability": "applicable",
                    "required": True,
                    "outcome": "skipped",
                    "exit_code": None,
                    "reason_code": "process-start-failed",
                    "provenance": {
                        "kind": "cli",
                        "task_id": None,
                        "operation_id": None,
                    },
                    "output": captured,
                }
            )
            if output_format == "text":
                print(captured["stderr_tail"], file=sys.stderr, end="")
            continue
        captured = verify_output(result.stdout, result.stderr, target)
        outcome = "passed" if result.returncode == 0 else "failed"
        checks.append(
            {
                "name": key,
                "configured": True,
                "applicability": "applicable",
                "required": True,
                "outcome": outcome,
                "exit_code": result.returncode,
                "reason_code": None,
                "provenance": {
                    "kind": "cli",
                    "task_id": None,
                    "operation_id": None,
                },
                "output": captured,
            }
        )
        if output_format == "text":
            if captured["stdout_tail"]:
                print(captured["stdout_tail"], end="")
            if captured["stderr_tail"]:
                print(captured["stderr_tail"], file=sys.stderr, end="")

    summary = {
        outcome: sum(1 for check in checks if check["outcome"] == outcome)
        for outcome in ("passed", "failed", "unconfigured", "skipped")
    }
    if summary["skipped"]:
        status = "blocked"
        exit_code = 2
    elif summary["failed"]:
        status = "failed"
        exit_code = 1
    else:
        status = "passed"
        exit_code = 0
    if output_format == "json":
        print_json(
            result_envelope(
                "verify",
                status,
                target=str(target),
                selection={
                    "mode": "only" if only else "default",
                    "requested": requested,
                    "coverage": "partial" if only else "all-configured",
                },
                producer="cli",
                cli_invoked=True,
                checks=checks,
                summary=summary,
            )
        )
        return exit_code
    configured_names = [
        str(check["name"]) for check in checks if check["configured"]
    ]
    if not configured_names:
        print("No project verification checks are configured.")
    elif status == "passed":
        print("\nVerification passed: " + ", ".join(configured_names))
    elif status == "failed":
        failures = [
            f"{check['name']} ({check['exit_code']})"
            for check in checks
            if check["outcome"] == "failed"
        ]
        print("\nVerification failed: " + ", ".join(failures), file=sys.stderr)
    else:
        skipped = [
            str(check["name"])
            for check in checks
            if check["outcome"] == "skipped"
        ]
        print("\nVerification blocked: " + ", ".join(skipped), file=sys.stderr)
    return exit_code


def normalized_slug(value: str) -> str:
    slug = re.sub(r"[^a-z0-9]+", "-", value.lower()).strip("-")
    if not slug:
        raise VibeError("Work-item slug must contain an ASCII letter or digit.")
    return slug


def work_item(target: Path, slug_value: str, size: str, title: Optional[str]) -> int:
    target = target.resolve()
    slug = normalized_slug(slug_value)
    date = dt.date.today().isoformat()
    identifier = dt.date.today().strftime("%Y%m%d") + "-" + slug
    destination = target / "docs/work-items" / identifier
    if destination.exists():
        raise VibeError(f"Work item already exists: {destination}")
    template_root = target / ".vibe/core/templates"
    if not template_root.is_dir():
        raise VibeError("Vibe Kit work-item templates are missing; run doctor or upgrade.")
    replacements = {
        "TITLE": title or slug.replace("-", " ").title(),
        "ID": identifier,
        "SIZE": size.upper(),
        "DATE": date,
    }
    destination.mkdir(parents=True)
    atomic_write_text(
        destination / "brief.md",
        render_template(template_root / "work-item-brief.md", replacements),
    )
    atomic_write_text(
        destination / "verification.md",
        render_template(template_root / "work-item-verification.md", replacements),
    )
    print(f"Created work item: {destination}")
    return 0


def release_payload_files(root: Path, version: str) -> List[Path]:
    files = list(managed_source_files(root))
    for relative in (
        "AGENTS.md",
        "AGENT_INSTALL.md",
        "agent-install.json",
        "README.md",
        "CHANGELOG.md",
        "LICENSE",
    ):
        path = root / relative
        if path.is_file():
            files.append(path)
    templates = root / "templates"
    if templates.is_dir():
        files.extend(path for path in templates.rglob("*") if path.is_file())
    release_notes = root / "docs/releases" / f"{version}.md"
    if release_notes.is_file():
        files.append(release_notes)
    unique = {path.relative_to(root): path for path in files}
    result = [unique[key] for key in sorted(unique, key=lambda item: item.as_posix())]
    for path in result:
        if path.is_symlink():
            raise VibeError(f"release payload cannot contain a symlink: {path}")
        if "__pycache__" in path.parts or path.suffix == ".pyc":
            raise VibeError(f"release payload contains generated Python cache: {path}")
    return result


def release_file_mode(relative: str) -> int:
    if relative == "bin/vibe" or relative.endswith("/scripts/vibe_from_plugin.py"):
        return 0o755
    return 0o644


def normalized_zip(
    destination: Path, entries: Dict[str, Tuple[bytes, int]]
) -> None:
    destination.parent.mkdir(parents=True, exist_ok=True)
    with zipfile.ZipFile(
        destination, "w", compression=zipfile.ZIP_DEFLATED, compresslevel=9
    ) as archive:
        for name in sorted(entries):
            if not archive_name_is_safe(name):
                raise VibeError(f"unsafe release archive path: {name}")
            content, mode = entries[name]
            info = zipfile.ZipInfo(name, date_time=(1980, 1, 1, 0, 0, 0))
            info.create_system = 3
            info.external_attr = ((0o100000 | mode) & 0xFFFF) << 16
            info.compress_type = zipfile.ZIP_DEFLATED
            archive.writestr(info, content, compress_type=zipfile.ZIP_DEFLATED, compresslevel=9)


def release_source_metadata(root: Path) -> Dict[str, object]:
    ref: Optional[str] = None
    try:
        result = subprocess.run(
            ["git", "rev-parse", "--verify", "HEAD"],
            cwd=str(root),
            text=True,
            capture_output=True,
            check=False,
        )
        if result.returncode == 0 and re.fullmatch(r"[0-9a-fA-F]{40,64}", result.stdout.strip()):
            ref = result.stdout.strip().lower()
    except OSError:
        pass
    tree_state = "uncommitted"
    if ref is not None:
        try:
            status = subprocess.run(
                ["git", "status", "--porcelain", "--untracked-files=all"],
                cwd=str(root),
                text=True,
                capture_output=True,
                check=False,
            )
            if status.returncode == 0 and not status.stdout.strip():
                tree_state = "clean"
        except OSError:
            pass
    return {"type": "git-working-tree", "ref": ref, "tree_state": tree_state}


def plugin_source_entries(
    root: Path, version: str, expected_payload_tree_sha256: str
) -> Dict[str, Tuple[bytes, int]]:
    plugin_root = root / "distribution/plugin-src/vibe-kit"
    manifest_path = plugin_root / ".codex-plugin/plugin.json"
    if not manifest_path.is_file():
        raise VibeError(f"Plugin source is missing: {manifest_path}")
    try:
        manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as error:
        raise VibeError(f"Plugin manifest is invalid: {error}") from error
    if manifest.get("name") != "vibe-kit" or manifest.get("version") != version:
        raise VibeError("Plugin name/version must match the Vibe Kit release")
    if manifest.get("payload_tree_sha256") != expected_payload_tree_sha256:
        raise VibeError("Plugin payload-tree identity must match the Vibe Kit release payload")
    for forbidden in ("mcpServers", "hooks", "apps"):
        if forbidden in manifest:
            raise VibeError(f"bootstrap Plugin must not declare {forbidden}")
    skill_root = plugin_root / "skills"
    skills = sorted(path.name for path in skill_root.iterdir() if path.is_dir())
    if skills != ["vibe-bootstrap", "vibe-maintain"]:
        raise VibeError("bootstrap Plugin must contain exactly vibe-bootstrap and vibe-maintain")

    entries: Dict[str, Tuple[bytes, int]] = {}
    for path in sorted(plugin_root.rglob("*")):
        if not path.is_file():
            continue
        if path.is_symlink():
            raise VibeError(f"Plugin source cannot contain a symlink: {path}")
        if "__pycache__" in path.parts or path.suffix == ".pyc" or path.name == ".DS_Store":
            continue
        relative = path.relative_to(plugin_root).as_posix()
        entries[relative] = (path.read_bytes(), release_file_mode(relative))
    return entries


def release_protocol(root: Path) -> Dict[str, object]:
    path = root / ".vibe/core/protocol.json"
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as error:
        raise VibeError(f"release protocol is invalid: {error}") from error
    if not isinstance(value, dict):
        raise VibeError("release protocol must be a JSON object")
    return value


def release_marketplace_payload() -> Dict[str, object]:
    return {
        "name": "personal",
        "interface": {"displayName": "Personal Plugins"},
        "plugins": [
            {
                "name": "vibe-kit",
                "source": {"source": "local", "path": "./plugins/vibe-kit"},
                "policy": {
                    "installation": "AVAILABLE",
                    "authentication": "ON_INSTALL",
                },
                "category": "Productivity",
            }
        ],
    }


def package_release(output: Optional[Path], status: str) -> int:
    root = source_root()
    version = framework_version(root)
    validate_target_predecessor_migration_contract(root)
    destination = (
        output.resolve()
        if output is not None
        else (root / "dist" / f"vibe-kit-{version}").resolve()
    )
    if destination.exists() and not destination.is_dir():
        raise VibeError(f"release output is not a directory: {destination}")
    if destination.is_dir() and any(destination.iterdir()):
        raise VibeError(f"release output is not empty: {destination}")

    source_metadata = release_source_metadata(root)
    if status in ("prerelease", "stable") and (
        source_metadata.get("ref") is None
        or source_metadata.get("tree_state") != "clean"
    ):
        raise VibeError(
            f"{status} packaging requires a clean committed Git source; commit the reviewed tree first"
        )
    payload_entries: Dict[str, Tuple[bytes, int]] = {}
    for path in release_payload_files(root, version):
        relative = path.relative_to(root).as_posix()
        payload_entries[relative] = (path.read_bytes(), release_file_mode(relative))
    protocol = release_protocol(root)
    try:
        packaged_contract = json.loads(
            payload_entries["agent-install.json"][0].decode("utf-8"),
            object_pairs_hook=reject_duplicate_json_keys,
        )
        if not isinstance(packaged_contract, dict):
            raise ValueError("contract is not an object")
        _, _, packaged_activation_digest = reference_activation_identity_from_entries(
            {relative: value[0] for relative, value in payload_entries.items()},
            packaged_contract,
            protocol,
        )
        declared_activation_digest = packaged_contract.get("activation", {}).get(
            "activation_set_sha256"
        ) if isinstance(packaged_contract.get("activation"), dict) else None
        if declared_activation_digest != packaged_activation_digest:
            raise ValueError("activation digest is not finalized")
    except (KeyError, UnicodeError, json.JSONDecodeError, ValueError, VibeError) as error:
        raise VibeError(
            "release Agent-install activation identity must complete the v2 two-pass calculation"
        ) from error
    payload_hashes = {
        relative: hashlib.sha256(content).hexdigest()
        for relative, (content, _) in sorted(payload_entries.items())
    }
    payload_digest = payload_tree_sha256_from_hashes(payload_hashes)
    plugin_entries = plugin_source_entries(root, version, payload_digest)

    destination.mkdir(parents=True, exist_ok=True)
    release_name = f"vibe-kit-{version}.zip"
    plugin_name = f"vibe-kit-plugin-{version}.zip"
    release_archive = destination / release_name
    plugin_archive = destination / plugin_name
    normalized_zip(
        release_archive,
        {f"vibe-kit-{version}/{name}": value for name, value in payload_entries.items()},
    )
    combined_plugin_entries = {
        f"vibe-kit/{name}": value for name, value in plugin_entries.items()
    }
    combined_plugin_entries.update(
        {f"vibe-kit/payload/{name}": value for name, value in payload_entries.items()}
    )
    normalized_zip(plugin_archive, combined_plugin_entries)

    marketplace_root = destination / "marketplace"
    plugin_output = marketplace_root / "plugins/vibe-kit"
    for relative, (content, mode) in plugin_entries.items():
        atomic_write_bytes(plugin_output / relative, content, mode)
    for relative, (content, mode) in payload_entries.items():
        atomic_write_bytes(plugin_output / "payload" / relative, content, mode)
    marketplace_path = marketplace_root / "marketplace.json"
    atomic_write_json(marketplace_path, release_marketplace_payload())

    marketplace_files = {
        path.relative_to(marketplace_root).as_posix(): sha256(path)
        for path in sorted((marketplace_root / "plugins").rglob("*"))
        if path.is_file()
    }

    artifact_paths = [release_archive, plugin_archive, marketplace_path]
    artifacts = []
    for path in artifact_paths:
        artifacts.append(
            {
                "path": path.relative_to(destination).as_posix(),
                "sha256": sha256(path),
                "size": path.stat().st_size,
            }
        )
    manifest = {
        "schema_version": RELEASE_MANIFEST_SCHEMA,
        "status": status,
        "kit_version": version,
        "agent_install_schema": AGENT_INSTALL_SCHEMA,
        "manifest_schema": protocol.get("manifest_schema"),
        "core_protocol": protocol.get("core_protocol"),
        "feedback_protocol": protocol.get("feedback_protocol"),
        "agent_install_protocol": protocol.get("agent_install_protocol"),
        "takeover_contract_registry_sha256": protocol.get(
            "takeover_contract_registry_sha256"
        ),
        "predecessor_migrations": protocol.get("predecessor_migrations"),
        "takeover_schema": TAKEOVER_SCHEMA_VERSION,
        "maintenance_bridge_schema": MAINTENANCE_BRIDGE_SCHEMA_VERSION,
        "compatibility_migration_registry_schema": COMPATIBILITY_MIGRATION_REGISTRY_SCHEMA,
        "cli_result_schema": AGENT_RESULT_SCHEMA,
        "transaction_journal_schema": TRANSACTION_JOURNAL_SCHEMA,
        "transaction_commit_schema": TRANSACTION_COMMIT_SCHEMA,
        "publication_intent_schema": PUBLICATION_INTENT_SCHEMA,
        "publication_receipt_schema": PUBLICATION_RECEIPT_SCHEMA,
        "issue_closeout_intent_schema": ISSUE_CLOSEOUT_INTENT_SCHEMA,
        "payload_tree_sha256": payload_digest,
        "activation_set_sha256": load_agent_install_contract(root).get(
            "activation", {}
        ).get("activation_set_sha256"),
        "adapters": protocol.get("adapters"),
        "runtime": {
            "python": ">=3.9",
            "os_supported": ["macOS", "Linux"],
            "os_tested_for_candidate": ["macOS"],
        },
        "source": source_metadata,
        "payload_files": payload_hashes,
        "marketplace_files": marketplace_files,
        "artifacts": artifacts,
        "public_assets": [
            {"name": "SHA256SUMS", "role": "checksum"},
            {"name": "release-manifest.json", "role": "manifest"},
            {"name": release_name, "role": "direct"},
            {"name": f"vibe-kit-distribution-{version}.zip", "role": "distribution"},
            {"name": plugin_name, "role": "plugin"},
        ],
    }
    manifest_path = destination / "release-manifest.json"
    atomic_write_json(manifest_path, manifest)
    checksum_paths = artifact_paths + [manifest_path] + [
        marketplace_root / relative for relative in marketplace_files
    ]
    checksums = "".join(
        f"{sha256(path)}  {path.relative_to(destination).as_posix()}\n"
        for path in sorted(checksum_paths, key=lambda item: item.relative_to(destination).as_posix())
    )
    atomic_write_text(destination / "SHA256SUMS", checksums)

    bundle_name = f"vibe-kit-distribution-{version}.zip"
    bundle_path = destination / bundle_name
    bundle_entries = {
        f"vibe-kit-{version}/{path.relative_to(destination).as_posix()}": (
            path.read_bytes(),
            release_file_mode(path.relative_to(destination).as_posix()),
        )
        for path in sorted(destination.rglob("*"))
        if path.is_file() and path != bundle_path
    }
    normalized_zip(bundle_path, bundle_entries)
    bundled_files, bundle_errors = read_normalized_archive(
        bundle_path, f"vibe-kit-{version}"
    )
    expected_bundle_files = {
        path.relative_to(destination).as_posix(): path.read_bytes()
        for path in sorted(destination.rglob("*"))
        if path.is_file() and path != bundle_path
    }
    if bundle_errors or bundled_files != expected_bundle_files:
        details = "; ".join(bundle_errors) or "bundle contents differ from release directory"
        raise VibeError(f"distribution bundle validation failed: {details}")
    result = validate_release(destination)
    if result != 0:
        return result
    print(f"Vibe Kit release candidate built: {destination}")
    print(f"Version: {version}")
    print(f"Artifacts: {release_name}, {plugin_name}, {bundle_name}, marketplace/")
    print(f"Distribution bundle SHA-256: {sha256(bundle_path)}")
    print(f"Publication status: {status}")
    return 0


def archive_name_is_safe(name: str) -> bool:
    if not name or name.startswith("/") or "\\" in name or ":" in name:
        return False
    path = PurePosixPath(name)
    return all(part not in ("", ".", "..") for part in path.parts)


def read_normalized_archive(path: Path, expected_root: str) -> Tuple[Dict[str, bytes], List[str]]:
    errors: List[str] = []
    entries: Dict[str, bytes] = {}
    try:
        with zipfile.ZipFile(path, "r") as archive:
            infos = archive.infolist()
            if len(infos) > RELEASE_ARCHIVE_MAX_FILES:
                errors.append(f"{path.name}: too many archive entries")
                return entries, errors
            total_size = 0
            for info in infos:
                name = info.filename
                if info.is_dir():
                    continue
                if not archive_name_is_safe(name):
                    errors.append(f"{path.name}: unsafe archive path {name!r}")
                    continue
                if info.flag_bits & 0x1:
                    errors.append(f"{path.name}: encrypted entries are not supported")
                    continue
                file_type = (info.external_attr >> 16) & 0o170000
                if file_type == 0o120000:
                    errors.append(f"{path.name}: symlink entries are not allowed")
                    continue
                if info.file_size > RELEASE_ARCHIVE_MAX_FILE_SIZE:
                    errors.append(f"{path.name}: entry is too large: {name}")
                    continue
                total_size += info.file_size
                if total_size > RELEASE_ARCHIVE_MAX_TOTAL_SIZE:
                    errors.append(f"{path.name}: uncompressed payload is too large")
                    break
                prefix = expected_root.rstrip("/") + "/"
                if not name.startswith(prefix):
                    errors.append(f"{path.name}: entry is outside expected root {expected_root}: {name}")
                    continue
                relative = name[len(prefix):]
                if not relative or relative in entries:
                    errors.append(f"{path.name}: invalid or duplicate entry {name}")
                    continue
                entries[relative] = archive.read(info)
    except (OSError, zipfile.BadZipFile) as error:
        errors.append(f"{path.name}: cannot read ZIP: {error}")
    return entries, errors


def validate_agent_install_contract_shape(contract: Dict[str, object]) -> List[str]:
    errors: List[str] = []
    expected_top_level = {
        "schema_version",
        "protocol_version",
        "kit_version",
        "adapter",
        "maintenance_bridge",
        "canonical_source",
        "release_channels",
        "source_identity",
        "lifecycle",
        "activation",
        "takeover",
        "cli",
        "onboarding",
        "transactions",
        "publication",
        "privacy",
        "evolution",
        "trust",
    }
    if set(contract) != expected_top_level:
        errors.append("agent install contract top-level fields are unknown or incomplete")
    adapter = contract.get("adapter")
    expected_capabilities = {
        "same_task_reload": {
            "status": "conditional",
            "current_claim": False,
            "required_receipt": "host-reload",
        },
        "automatic_successor_handoff": {
            "status": "conditional",
            "current_claim": False,
            "required_receipt": "host-successor-start",
        },
        "manual_new_task": {
            "status": "supported",
            "required_receipt": "manual-task-start",
        },
    }
    if not isinstance(adapter, dict) or adapter.get("capabilities") != expected_capabilities:
        errors.append("agent install adapter capability claims are unsupported")

    bridge = contract.get("maintenance_bridge")
    expected_bridge = {
        "schema_version": MAINTENANCE_BRIDGE_SCHEMA_VERSION,
        "supported_installed_manifest_schemas": [1],
        "supported_installed_agent_protocols": [0, 1, 2, 3],
        "minimum_installed_kit_version": "0.2.0",
        "maximum_installed_kit_version_exclusive": "0.8.0",
        "target_agent_install_schema": AGENT_INSTALL_SCHEMA,
        "target_agent_install_protocol": AGENT_INSTALL_PROTOCOL,
        "target_cli_result_schema": AGENT_RESULT_SCHEMA,
        "predecessor_migrations": PREDECESSOR_MIGRATION_MIRROR,
        "operations": ["plan-upgrade", "upgrade", "recover-upgrade", "doctor"],
    }
    if bridge != expected_bridge:
        errors.append("agent install maintenance bridge is unsupported")

    source_identity = contract.get("source_identity")
    expected_source_identity = {
        "source_types": list(SOURCE_TYPES[1:3]) + [SOURCE_TYPES[0]],
    }
    if not isinstance(source_identity, dict):
        errors.append("agent install source identity contract is missing")
    else:
        if source_identity.get("source_types") != [
            "github-release",
            "plugin-bundled",
            "offline-bundle",
            "local-payload",
        ]:
            errors.append("agent install source types are unsupported")
        if source_identity.get("payload_tree_algorithm") != (
            "sha256-path-nul-file-sha256-newline-v1"
        ):
            errors.append("agent install payload-tree algorithm is unsupported")
        for key in (
            "github_release_requires",
            "offline_bundle_requires",
            "plugin_bundled_requires",
            "local_payload_requires",
        ):
            value = source_identity.get(key)
            if not isinstance(value, list) or not value or len(set(value)) != len(value):
                errors.append(f"agent install source requirement is invalid: {key}")

    lifecycle = contract.get("lifecycle")
    expected_lifecycle = {
        "stages": [
            "source-resolved",
            "planned",
            "applied",
            "upgraded",
            "activated",
            "adapted",
            "verified",
            "re-evaluated",
            "ready",
        ],
        "stage_states": ["not-started", "satisfied", "blocked", "not-applicable"],
        "overall_statuses": ["in-progress", "ready", "degraded", "blocked"],
        "new_project_operation": "init",
        "existing_project_operation": "adopt",
        "existing_installation_policy": "request-version-change-decision",
        "ready_owner": "host-agent-adapter",
        "cli_ready_claim": False,
    }
    if lifecycle != expected_lifecycle:
        errors.append("agent install lifecycle contract is unsupported")

    activation = contract.get("activation")
    if not isinstance(activation, dict):
        errors.append("agent install activation contract is missing")
    else:
        expected_activation_static = {
            "activation_set_algorithm": ACTIVATION_SET_ALGORITHM,
            "runtime_discovery_roots": list(RUNTIME_DISCOVERY_ROOTS),
            "paths": [
                "none",
                "same-task-reload",
                "automatic-successor-handoff",
                "manual-new-task",
            ],
            "receipt_kinds": [
                "host-reload",
                "host-successor-start",
                "manual-task-start",
            ],
            "stale_runtime_diagnostic": "stale-runtime-path-preserved",
            "stale_nonruntime_diagnostic": "stale-nonruntime-path-preserved",
            "current_repository_capability": "manual-fallback-only",
        }
        for key, expected in expected_activation_static.items():
            if activation.get(key) != expected:
                errors.append(f"agent install activation field is unsupported: {key}")
        declared_paths = activation.get("activation_paths")
        if not isinstance(declared_paths, list) or declared_paths != sorted(
            set(declared_paths)
        ):
            errors.append("agent install activation paths are invalid")
        if not re.fullmatch(
            r"[0-9a-f]{64}", str(activation.get("activation_set_sha256", ""))
        ):
            errors.append("agent install activation-set digest is invalid")

    takeover = contract.get("takeover")
    registry_enums = TAKEOVER_CONTRACT_REGISTRY["enums"]
    if not isinstance(registry_enums, dict):
        raise AssertionError("compiled takeover enum registry is invalid")
    expected_takeover_lists = {
        "evidence_kinds": registry_enums["evidence_kinds"],
        "adapted_outcomes": registry_enums["adapted_outcomes"],
        "re_evaluated_outcomes": registry_enums["re_evaluated_outcomes"],
        "reason_codes": registry_enums["reason_codes"],
        "next_action_codes": registry_enums["next_action_codes"],
        "goal_kinds": registry_enums["goal_kinds"],
        "goal_custody": registry_enums["goal_custody"],
        "goal_continuation": registry_enums["goal_continuation"],
    }
    if not isinstance(takeover, dict):
        errors.append("agent install takeover contract is missing")
    else:
        if takeover.get("schema_version") != TAKEOVER_SCHEMA_VERSION:
            errors.append("agent install takeover schema is unsupported")
        if takeover.get("storage") != "host-task-state-only":
            errors.append("agent install takeover storage boundary is unsupported")
        if takeover.get("unknown_or_inconsistent_state") != "fail-closed":
            errors.append("agent install takeover evolution is unsupported")
        for key, expected in expected_takeover_lists.items():
            if takeover.get(key) != expected:
                errors.append(f"agent install takeover enum is unsupported: {key}")
        if takeover.get("validator") != {
            "command": "validate-takeover",
            "input": "stdin-json",
            "result_schema_version": AGENT_RESULT_SCHEMA,
            "statuses": list(AGENT_COMMAND_STATUSES["validate-takeover"]),
            "persistence": "none",
            "authority": "structural-consistency-only",
        }:
            errors.append("agent install takeover validator contract is unsupported")
        registry = takeover.get("contract_registry")
        registry_digest = takeover.get("contract_registry_sha256")
        if registry != TAKEOVER_CONTRACT_REGISTRY:
            errors.append("agent install takeover contract registry is unsupported")
        if registry_digest != TAKEOVER_CONTRACT_REGISTRY_SHA256 or (
            isinstance(registry, dict)
            and canonical_json_sha256(registry) != registry_digest
        ):
            errors.append("agent install takeover contract registry digest is invalid")

    cli = contract.get("cli")
    if not isinstance(cli, dict):
        return ["agent install contract CLI result contract is missing"]
    if cli.get("result_schema_version") != AGENT_RESULT_SCHEMA:
        errors.append("agent install contract result schema is unsupported")
    expected_statuses = {
        command: list(statuses)
        for command, statuses in AGENT_COMMAND_STATUSES.items()
    }
    if cli.get("command_statuses") != expected_statuses:
        errors.append("agent install contract command statuses are unsupported")
    if cli.get("write_states") != list(WRITE_STATES):
        errors.append("agent install contract write states are unsupported")
    if cli.get("writes_performed_rule") != "false-only-for-none":
        errors.append("agent install contract writes_performed rule is unsupported")
    doctor_contract = cli.get("doctor")
    expected_warning_registry = {
        code: effect
        for code, (level, effect) in DIAGNOSTIC_REGISTRY.items()
        if level == "warning"
    }
    expected_error_codes = [
        code for code, (level, _) in DIAGNOSTIC_REGISTRY.items() if level == "error"
    ]
    if not isinstance(doctor_contract, dict) or doctor_contract != {
        "diagnostic_shape": [
            "code", "level", "readiness_effect", "path", "detail"
        ],
        "warning_registry": expected_warning_registry,
        "error_codes": expected_error_codes,
        "non_blocking_warning_allowlist": list(DOCTOR_NON_BLOCKING_WARNING_CODES),
    }:
        errors.append("agent install doctor diagnostic contract is unsupported")
    verify_contract = cli.get("verify")
    if not isinstance(verify_contract, dict) or verify_contract != {
        "statuses": list(AGENT_COMMAND_STATUSES["verify"]),
        "default_order": list(VERIFY_ORDER),
        "outcomes": ["passed", "failed", "unconfigured", "skipped"],
        "skipped_reasons": [
            "host-permission-denied",
            "host-capability-unavailable",
            "side-effect-not-authorized",
            "execution-interrupted",
            "process-start-failed",
        ],
        "takeover_required_selection": {
            "mode": "default", "coverage": "all-configured"
        },
        "output_tail_bytes": VERIFY_OUTPUT_LIMIT,
        "network_attestation": "not-provided",
    }:
        errors.append("agent install verify contract is unsupported")

    onboarding = contract.get("onboarding")
    if not isinstance(onboarding, dict):
        errors.append("agent install contract onboarding contract is missing")
    else:
        if onboarding.get("schema_version") != 1:
            errors.append("agent install contract onboarding schema is unsupported")
        if onboarding.get("persisted_statuses") != list(ONBOARDING_STATUSES):
            errors.append(
                "agent install contract persisted onboarding states are unsupported"
            )
        if onboarding.get("derived_statuses") != list(DERIVED_ONBOARDING_STATUSES):
            errors.append(
                "agent install contract derived onboarding states are unsupported"
            )
        if onboarding.get("complete_requirements") != {
            "updated_at": "iso-8601",
            "evidence": "non-empty-string-list",
        }:
            errors.append(
                "agent install contract complete onboarding requirements are unsupported"
            )
        if onboarding.get("preserve_project_owned_state") is not True:
            errors.append(
                "agent install contract onboarding preservation rule is unsupported"
            )
        if onboarding.get("adaptation_requires_activation") is not True or (
            onboarding.get("contradiction_policy")
            != "block-without-uncertain-overwrite"
        ):
            errors.append("agent install adaptation contract is unsupported")

    if contract.get("privacy") != {
        "takeover_repository_persistence": False,
        "goal_text_in_cli_receipts": False,
        "goal_text_in_release_artifacts": False,
        "transfer_scope": "minimal-active-objective-and-durable-evidence-references",
    }:
        errors.append("agent install takeover privacy contract is unsupported")

    evolution = contract.get("evolution")
    expected_evolution = {
        "unknown_schema_or_protocol": "fail-closed",
        "unknown_enum": "fail-closed",
        "schema_2_optional_field_rule": "none-unless-explicitly-versioned",
        "breaking_change_rule": "bump-result-schema-and-or-agent-install-protocol",
    }
    if evolution != expected_evolution:
        errors.append("agent install contract evolution rules are unsupported")
    expected_transactions = {
        "journal_schema": TRANSACTION_JOURNAL_SCHEMA,
        "commit_marker_schema": TRANSACTION_COMMIT_SCHEMA,
        "active_path": TRANSACTION_ACTIVE_PATH.as_posix(),
        "evidence_trust": "integrity-checked-but-untrusted",
        "same_os_principal_malicious_tamper": "out-of-threat-model",
        "recovery_command": "recover-upgrade",
        "ordinary_upgrade_auto_recovers": False,
    }
    if contract.get("transactions") != expected_transactions:
        errors.append("agent install transaction contract is unsupported")
    expected_publication = {
        "intent_schema": PUBLICATION_INTENT_SCHEMA,
        "receipt_schema": PUBLICATION_RECEIPT_SCHEMA,
        "issue_closeout_intent_schema": ISSUE_CLOSEOUT_INTENT_SCHEMA,
        "commands": ["publication-plan", "validate-publication"],
        "public_asset_roles": ["checksum", "manifest", "direct", "distribution", "plugin"],
        "network_credentials_owner": "agent-host",
        "cli_network_authority": False,
    }
    if contract.get("publication") != expected_publication:
        errors.append("agent install publication contract is unsupported")
    return errors


def validate_agent_install_guide_bytes(content: bytes) -> bool:
    try:
        text = content.decode("utf-8")
    except UnicodeError:
        return False
    return (
        text.startswith("# Agent installation and takeover contract\n")
        and "https://github.com/mintgao/vibe-kit" in text
        and "`agent-install.json`" in text
        and "validate-takeover" in text
    )


def authentication_error(code: str, path: str) -> Dict[str, str]:
    return {"code": code, "path": path}


def installed_takeover_contract_context(
    root: Path,
) -> Tuple[Optional[Dict[str, object]], List[Dict[str, str]]]:
    """Authenticate the installed takeover contract before candidate validation."""
    root = root.resolve()
    errors: List[Dict[str, str]] = []

    def add(code: str, path: str) -> None:
        item = authentication_error(code, path)
        if item not in errors:
            errors.append(item)

    manifest, manifest_version, manifest_display = read_manifest_for_doctor(root)
    versions_ok, _ = version_integrity(root, manifest_version, manifest_display)
    if not versions_ok or manifest is None:
        add("installed-version-integrity-failed", MANIFEST_PATH.as_posix())

    guide_path = root / "AGENT_INSTALL.md"
    contract_path = root / "agent-install.json"
    if not guide_path.is_file():
        add("installed-agent-contract-missing", "AGENT_INSTALL.md")
    else:
        try:
            guide_valid = validate_agent_install_guide_bytes(guide_path.read_bytes())
        except OSError:
            guide_valid = False
        if not guide_valid:
            add("installed-agent-contract-schema-mismatch", "AGENT_INSTALL.md")
    if not contract_path.is_file():
        add("installed-agent-contract-missing", "agent-install.json")
        return None, errors

    try:
        contract = load_agent_install_contract(root)
    except VibeError:
        add("installed-agent-contract-schema-mismatch", "agent-install.json")
        return None, errors

    managed_files = manifest.get("managed_files") if isinstance(manifest, dict) else None
    try:
        contract_hash = sha256(contract_path)
    except OSError:
        contract_hash = None
    try:
        guide_hash = sha256(guide_path) if guide_path.is_file() else None
    except OSError:
        guide_hash = None
    if not isinstance(managed_files, dict) or managed_files.get(
        "agent-install.json"
    ) != contract_hash:
        add("installed-agent-contract-hash-mismatch", "agent-install.json")
    if not isinstance(managed_files, dict) or managed_files.get(
        "AGENT_INSTALL.md"
    ) != guide_hash:
        add("installed-agent-contract-hash-mismatch", "AGENT_INSTALL.md")

    if (
        contract.get("schema_version") != AGENT_INSTALL_SCHEMA
        or contract.get("protocol_version") != AGENT_INSTALL_PROTOCOL
        or contract.get("kit_version") != manifest_version
        or validate_agent_install_contract_shape(contract)
    ):
        add("installed-agent-contract-schema-mismatch", "agent-install.json")

    try:
        protocol = release_protocol(root)
    except VibeError:
        protocol = {}
    adapter = contract.get("adapter")
    codex = protocol.get("adapters", {}).get("codex", {}) if isinstance(
        protocol.get("adapters"), dict
    ) else {}
    if (
        protocol.get("core_protocol") != CORE_PROTOCOL
        or protocol.get("agent_install_protocol") != AGENT_INSTALL_PROTOCOL
        or protocol.get("takeover_contract_registry_sha256")
        != TAKEOVER_CONTRACT_REGISTRY_SHA256
        or not valid_predecessor_migration_mirror(
            protocol.get("predecessor_migrations")
        )
        or not isinstance(adapter, dict)
        or adapter.get("name") != "codex"
        or adapter.get("protocol") != CODEX_ADAPTER_PROTOCOL
        or not isinstance(codex, dict)
        or codex.get("version") != CODEX_ADAPTER_PROTOCOL
        or codex.get("core_protocol") != CORE_PROTOCOL
    ):
        add("installed-core-contract-mismatch", ".vibe/core/protocol.json")

    takeover = contract.get("takeover")
    registry = takeover.get("contract_registry") if isinstance(takeover, dict) else None
    registry_digest = (
        takeover.get("contract_registry_sha256") if isinstance(takeover, dict) else None
    )
    if (
        registry != TAKEOVER_CONTRACT_REGISTRY
        or registry_digest != TAKEOVER_CONTRACT_REGISTRY_SHA256
        or not isinstance(registry, dict)
        or canonical_json_sha256(registry) != TAKEOVER_CONTRACT_REGISTRY_SHA256
    ):
        add("compiled-contract-registry-mismatch", "agent-install.json#/takeover/contract_registry")

    activation_contract = contract.get("activation")
    manifest_activation = manifest.get("activation") if isinstance(manifest, dict) else None
    manifest_fingerprint = (
        manifest.get("target_fingerprint") if isinstance(manifest, dict) else None
    )
    actual_digest: Optional[str] = None
    expected_digest: Optional[str] = None
    try:
        paths = activation_paths(root)
        hashes = activation_path_hashes(root, paths)
        fingerprint = activation_fingerprint_base(root)
        actual_digest = activation_set_digest(fingerprint, hashes)
        expected_digest = (
            activation_contract.get("activation_set_sha256")
            if isinstance(activation_contract, dict)
            else None
        )
        activation_valid = (
            isinstance(activation_contract, dict)
            and activation_contract.get("activation_set_algorithm")
            == ACTIVATION_SET_ALGORITHM
            and activation_contract.get("activation_paths") == paths
            and isinstance(manifest_activation, dict)
            and manifest_activation.get("algorithm") == ACTIVATION_SET_ALGORITHM
            and manifest_activation.get("paths") == paths
            and manifest_activation.get("path_hashes") == hashes
            and manifest_activation.get("activation_set_sha256") == actual_digest
            and isinstance(manifest_fingerprint, dict)
            and manifest_fingerprint.get("activation_set_sha256") == actual_digest
            and expected_digest == actual_digest
        )
    except (OSError, UnicodeError, VibeError):
        activation_valid = False
    if not activation_valid:
        add("installed-activation-identity-mismatch", "agent-install.json#/activation")

    if errors:
        return None, errors
    raw_manifest_sha256 = sha256(root / MANIFEST_PATH)
    context = {
        "project_root": str(root),
        "manifest_sha256": raw_manifest_sha256,
        "activation_set_sha256": actual_digest,
        "target_fingerprint": {
            "kit_version": manifest_version,
            "core_protocol": CORE_PROTOCOL,
            "agent_install_schema": AGENT_INSTALL_SCHEMA,
            "agent_install_protocol": AGENT_INSTALL_PROTOCOL,
            "adapter_name": "codex",
            "adapter_protocol": CODEX_ADAPTER_PROTOCOL,
            "manifest_sha256": raw_manifest_sha256,
            "activation_set_sha256": actual_digest,
        },
    }
    return context, []


def takeover_validation_error(code: str, path: str) -> Dict[str, str]:
    return {"code": code, "path": path}


def validate_takeover_object(
    candidate: object, context: Dict[str, object]
) -> List[Dict[str, str]]:
    """Validate schema-2 takeover structure; never authenticate host evidence truth."""
    errors: List[Dict[str, str]] = []

    def add(code: str, path: str) -> None:
        item = takeover_validation_error(code, path)
        if item not in errors:
            errors.append(item)

    def closed(value: object, fields: Sequence[str], path: str) -> bool:
        if not isinstance(value, dict):
            add("exact-result-shape", path)
            return False
        if set(value) != set(fields):
            add("exact-result-shape", path)
            return False
        return True

    def opaque(value: object, maximum: int = 256) -> bool:
        return (
            isinstance(value, str)
            and 1 <= len(value) <= maximum
            and all(ord(character) >= 32 and character != "\x7f" for character in value)
        )

    def nullable_opaque(value: object, maximum: int = 256) -> bool:
        return value is None or opaque(value, maximum)

    def digest(value: object) -> bool:
        return isinstance(value, str) and re.fullmatch(r"[0-9a-f]{64}", value) is not None

    def nullable_digest(value: object) -> bool:
        return value is None or digest(value)

    registry = TAKEOVER_CONTRACT_REGISTRY
    shape = registry["result_shape"]
    enums = registry["enums"]
    limits = registry["array_limits"]
    if not isinstance(shape, dict) or not isinstance(enums, dict) or not isinstance(limits, dict):
        return [takeover_validation_error("compiled-contract-registry-mismatch", "$")]
    top_fields = shape["required_top_level"]
    if not closed(candidate, top_fields, "$"):
        return errors
    result = candidate
    if not isinstance(result, dict):
        return errors

    if result.get("takeover_schema_version") != TAKEOVER_SCHEMA_VERSION:
        add("exact-result-shape", "$.takeover_schema_version")
    if not opaque(result.get("takeover_id")):
        add("exact-result-shape", "$.takeover_id")
    if result.get("evidence_origin") not in enums["evidence_origins"]:
        add("exact-result-shape", "$.evidence_origin")
    if not nullable_opaque(result.get("completion_owner_task_id")):
        add("exact-result-shape", "$.completion_owner_task_id")
    project_root = result.get("project_root")
    if not opaque(project_root, 4096) or not isinstance(project_root, str) or (
        not Path(project_root).is_absolute()
        or str(Path(project_root).resolve()) != project_root
    ):
        add("exact-result-shape", "$.project_root")
    elif project_root != context.get("project_root"):
        add("activation-identities-match-target", "$.project_root")
    if result.get("overall_status") not in enums["overall_statuses"]:
        add("exact-result-shape", "$.overall_status")
    if result.get("write_state") not in enums["write_states"]:
        add("exact-result-shape", "$.write_state")
    upgrade_transaction = result.get("upgrade_transaction")
    if closed(
        upgrade_transaction,
        shape["required_upgrade_transaction_fields"],
        "$.upgrade_transaction",
    ):
        transaction_id = upgrade_transaction.get("transaction_id")
        outcome = upgrade_transaction.get("outcome")
        marker = upgrade_transaction.get("commit_marker")
        installation_state = upgrade_transaction.get("installation_state")
        active_present = upgrade_transaction.get("active_state_present")
        if upgrade_transaction.get("schema_version") != TRANSACTION_JOURNAL_SCHEMA:
            add("exact-result-shape", "$.upgrade_transaction.schema_version")
        if transaction_id is not None and not opaque(transaction_id):
            add("exact-result-shape", "$.upgrade_transaction.transaction_id")
        if outcome not in enums["upgrade_transaction_outcomes"]:
            add("exact-result-shape", "$.upgrade_transaction.outcome")
        if marker not in enums["upgrade_commit_markers"]:
            add("exact-result-shape", "$.upgrade_transaction.commit_marker")
        if installation_state not in enums["upgrade_installation_states"]:
            add("exact-result-shape", "$.upgrade_transaction.installation_state")
        if type(active_present) is not bool:
            add("exact-result-shape", "$.upgrade_transaction.active_state_present")
        valid_null = (
            transaction_id is None
            and outcome in ("not-started", "not-applied", "unknown-partial")
            and marker in ("not-applicable", "invalid")
        )
        if transaction_id is None and not valid_null:
            add("stage-outcomes-consistent", "$.upgrade_transaction.transaction_id")
        expected_pairs = {
            "none": {"not-started", "not-applied"},
            "project-files-written": {"committed"},
            "conflict-evidence-written": {"not-applied"},
            "rolled-back": {"rolled-back"},
            "recovery-required": {"recovery-required"},
            "unknown-partial": {"unknown-partial"},
        }
        if outcome not in expected_pairs.get(result.get("write_state"), set()):
            add("stage-outcomes-consistent", "$.upgrade_transaction.outcome")
        if outcome == "committed" and not (
            marker == "valid" and installation_state == "target" and active_present is False
        ):
            add("upgrade-transaction-outcome-committed", "$.upgrade_transaction")
        if outcome in ("rolled-back", "not-applied") and installation_state != "predecessor":
            add("stage-outcomes-consistent", "$.upgrade_transaction.installation_state")
        if outcome in ("recovery-required", "unknown-partial") and active_present is not True:
            add("no-active-upgrade-transaction", "$.upgrade_transaction.active_state_present")
    if result.get("last_completed_stage") is not None and result.get(
        "last_completed_stage"
    ) not in TAKEOVER_STAGE_ORDER:
        add("last-completed-is-last-satisfied-stage", "$.last_completed_stage")

    source = result.get("source")
    if closed(source, shape["required_source_fields"], "$.source"):
        source_type = source.get("type")
        if source_type not in enums["source_types"]:
            add("exact-result-shape", "$.source.type")
        if not opaque(source.get("ref"), 4096):
            add("exact-result-shape", "$.source.ref")
        if not nullable_digest(source.get("artifact_sha256")):
            add("exact-result-shape", "$.source.artifact_sha256")
        if not digest(source.get("payload_tree_sha256")):
            add("exact-result-shape", "$.source.payload_tree_sha256")
        source_rules = registry["source_rules"]
        rule = source_rules.get(source_type) if isinstance(source_rules, dict) else None
        if isinstance(rule, dict):
            artifact_rule = rule.get("artifact_sha256")
            artifact = source.get("artifact_sha256")
            if artifact_rule == "required" and not digest(artifact):
                add("exact-result-shape", "$.source.artifact_sha256")
            if artifact_rule == "must-be-null" and artifact is not None:
                add("exact-result-shape", "$.source.artifact_sha256")

    versions = result.get("versions")
    fingerprint = result.get("target_fingerprint")
    if closed(versions, shape["required_versions_fields"], "$.versions"):
        if not strict_semver(versions.get("from")):
            add("exact-result-shape", "$.versions.from")
        if not strict_semver(versions.get("target")):
            add("exact-result-shape", "$.versions.target")
    if closed(fingerprint, shape["required_fingerprint_fields"], "$.target_fingerprint"):
        expected_static = {
            "core_protocol": CORE_PROTOCOL,
            "agent_install_schema": AGENT_INSTALL_SCHEMA,
            "agent_install_protocol": AGENT_INSTALL_PROTOCOL,
            "adapter_name": "codex",
            "adapter_protocol": CODEX_ADAPTER_PROTOCOL,
        }
        if not strict_semver(fingerprint.get("kit_version")):
            add("exact-result-shape", "$.target_fingerprint.kit_version")
        for key, expected in expected_static.items():
            if fingerprint.get(key) != expected:
                add("activation-identities-match-target", f"$.target_fingerprint.{key}")
        if not nullable_digest(fingerprint.get("manifest_sha256")):
            add("exact-result-shape", "$.target_fingerprint.manifest_sha256")
        if not nullable_digest(fingerprint.get("activation_set_sha256")):
            add("exact-result-shape", "$.target_fingerprint.activation_set_sha256")
        if isinstance(versions, dict) and versions.get("target") != fingerprint.get("kit_version"):
            add("activation-identities-match-target", "$.versions.target")

    activation = result.get("activation")
    if closed(activation, shape["required_activation_fields"], "$.activation"):
        if activation.get("path") not in enums["activation_paths"]:
            add("activation-receipt-bound", "$.activation.path")
        if activation.get("receipt_kind") is not None and activation.get(
            "receipt_kind"
        ) not in enums["receipt_kinds"]:
            add("activation-receipt-bound", "$.activation.receipt_kind")
        for key in ("receipt_id", "active_task_id", "handoff_idempotency_key"):
            if not nullable_opaque(activation.get(key)):
                add("exact-result-shape", f"$.activation.{key}")
        if not opaque(activation.get("source_task_id")):
            add("exact-result-shape", "$.activation.source_task_id")
        for key in ("observed_manifest_sha256", "observed_activation_set_sha256"):
            if not nullable_digest(activation.get(key)):
                add("exact-result-shape", f"$.activation.{key}")

    stages = result.get("stages")
    stage_values: Dict[str, Dict[str, object]] = {}
    all_sequences: List[int] = []
    evidence_by_stage: Dict[str, List[Dict[str, object]]] = {}
    if closed(stages, shape["required_stage_keys"], "$.stages"):
        for stage_name in TAKEOVER_STAGE_ORDER:
            stage = stages.get(stage_name)
            stage_path = f"$.stages.{stage_name}"
            if not closed(stage, shape["required_stage_fields"], stage_path):
                continue
            if not isinstance(stage, dict):
                continue
            stage_values[stage_name] = stage
            state = stage.get("state")
            if state not in enums["stage_states"]:
                add("stage-outcomes-consistent", f"{stage_path}.state")
            evidence = stage.get("evidence")
            if not isinstance(evidence, list) or len(evidence) > int(limits["evidence_per_stage"]):
                add("exact-result-shape", f"{stage_path}.evidence")
                evidence = []
            valid_evidence: List[Dict[str, object]] = []
            for index, item in enumerate(evidence):
                item_path = f"{stage_path}.evidence[{index}]"
                if not closed(item, shape["required_evidence_fields"], item_path):
                    continue
                if not isinstance(item, dict):
                    continue
                if item.get("kind") not in enums["evidence_kinds"]:
                    add("exact-result-shape", f"{item_path}.kind")
                placement = registry["evidence_placement"].get(item.get("kind"), [])
                if stage_name not in placement:
                    add("stage-dependencies-satisfied", f"{item_path}.kind")
                if not opaque(item.get("ref"), 4096):
                    add("exact-result-shape", f"{item_path}.ref")
                if not nullable_digest(item.get("sha256")):
                    add("exact-result-shape", f"{item_path}.sha256")
                if not nullable_opaque(item.get("task_id")):
                    add("exact-result-shape", f"{item_path}.task_id")
                sequence = item.get("sequence")
                if isinstance(sequence, bool) or not isinstance(sequence, int) or sequence < 0:
                    add("exact-result-shape", f"{item_path}.sequence")
                else:
                    all_sequences.append(sequence)
                item_kind = item.get("kind")
                source_task_for_evidence = (
                    activation.get("source_task_id")
                    if isinstance(activation, dict)
                    else None
                )
                active_task_for_evidence = (
                    activation.get("active_task_id")
                    if isinstance(activation, dict)
                    else None
                )
                expected_task = (
                    source_task_for_evidence
                    if stage_name in (
                        "source-resolved", "planned", "applied", "upgraded"
                    )
                    else active_task_for_evidence
                )
                if item.get("task_id") != expected_task:
                    add("activation-receipt-bound", f"{item_path}.task_id")
                if item_kind == "source-attestation" and isinstance(source, dict) and (
                    item.get("sha256") != source.get("payload_tree_sha256")
                ):
                    add("activation-identities-match-target", f"{item_path}.sha256")
                if item_kind in ("activation-receipt", "manual-task-start") and isinstance(
                    activation, dict
                ):
                    if item.get("ref") != activation.get("receipt_id"):
                        add("activation-receipt-bound", f"{item_path}.ref")
                    if item.get("sha256") != activation.get(
                        "observed_activation_set_sha256"
                    ):
                        add("activation-identities-match-target", f"{item_path}.sha256")
                valid_evidence.append(item)
            evidence_by_stage[stage_name] = valid_evidence

    goal = result.get("goal")
    custody_history: List[Dict[str, object]] = []
    if closed(goal, shape["required_goal_fields"], "$.goal"):
        if goal.get("kind") not in enums["goal_kinds"]:
            add("exact-result-shape", "$.goal.kind")
        if goal.get("custody") not in enums["goal_custody"]:
            add("custody-history-valid", "$.goal.custody")
        if goal.get("continuation") not in enums["goal_continuation"]:
            add("custody-history-valid", "$.goal.continuation")
        for key in ("transfer_id", "owner_task_id"):
            if not nullable_opaque(goal.get(key)):
                add("exact-result-shape", f"$.goal.{key}")
        history = goal.get("custody_history")
        if not isinstance(history, list) or len(history) > int(limits["custody_history"]):
            add("custody-history-valid", "$.goal.custody_history")
            history = []
        for index, item in enumerate(history):
            item_path = f"$.goal.custody_history[{index}]"
            if not closed(item, shape["required_custody_history_fields"], item_path):
                continue
            if not isinstance(item, dict):
                continue
            if item.get("state") not in enums["goal_custody"]:
                add("custody-history-valid", f"{item_path}.state")
            if not nullable_opaque(item.get("task_id")):
                add("custody-history-valid", f"{item_path}.task_id")
            sequence = item.get("sequence")
            if isinstance(sequence, bool) or not isinstance(sequence, int) or sequence < 0:
                add("custody-history-valid", f"{item_path}.sequence")
            else:
                all_sequences.append(sequence)
            custody_history.append(item)

    next_action = result.get("next_action")
    if next_action is not None and closed(
        next_action, shape["required_next_action_fields"], "$.next_action"
    ):
        if next_action.get("code") not in enums["next_action_codes"]:
            add("reason-action-consistent", "$.next_action.code")
        detail = next_action.get("detail")
        if not opaque(detail, 512) or (isinstance(detail, str) and ("\r" in detail or "\n" in detail)):
            add("exact-result-shape", "$.next_action.detail")

    # Stage state, outcome, predecessor and evidence placement rules.
    blocked_stages: List[str] = []
    satisfied_stages: List[str] = []
    for stage_name in TAKEOVER_STAGE_ORDER:
        stage = stage_values.get(stage_name)
        if stage is None:
            continue
        state = stage.get("state")
        outcome = stage.get("outcome")
        reason = stage.get("reason_code")
        if state == "satisfied":
            satisfied_stages.append(stage_name)
        if state == "blocked":
            blocked_stages.append(stage_name)
        if stage_name == "adapted":
            allowed = registry["stage_outcome_rules"]["adapted"].get(state, [])
            if outcome not in allowed and not (state == "not-started" and outcome is None):
                add("stage-outcomes-consistent", f"$.stages.{stage_name}.outcome")
        elif stage_name == "re-evaluated":
            allowed = registry["stage_outcome_rules"]["re-evaluated"].get(state, [])
            if outcome not in allowed and not (state == "not-started" and outcome is None):
                add("stage-outcomes-consistent", f"$.stages.{stage_name}.outcome")
        elif outcome is not None:
            add("stage-outcomes-consistent", f"$.stages.{stage_name}.outcome")
        if state == "blocked":
            if reason not in TAKEOVER_REASON_ACTION or TAKEOVER_REASON_STAGE.get(reason) != stage_name:
                add("reason-action-consistent", f"$.stages.{stage_name}.reason_code")
        elif reason is not None:
            add("reason-action-consistent", f"$.stages.{stage_name}.reason_code")
        if state == "not-applicable" and not (
            stage_name == "re-evaluated"
            and isinstance(goal, dict)
            and goal.get("kind") == "maintenance-only"
            and outcome == "maintenance-only"
        ):
            add("only-maintenance-re-evaluation-not-applicable", f"$.stages.{stage_name}")
        if state == "satisfied":
            dependencies = registry["stage_dependencies"].get(stage_name, [])
            if any(stage_values.get(name, {}).get("state") != "satisfied" for name in dependencies):
                add("stage-dependencies-satisfied", f"$.stages.{stage_name}")
            required_evidence = registry["evidence_rules"].get(stage_name, [])
            actual_kinds = {item.get("kind") for item in evidence_by_stage.get(stage_name, [])}
            if any(kind not in actual_kinds for kind in required_evidence):
                add("stage-dependencies-satisfied", f"$.stages.{stage_name}.evidence")
        elif state == "not-started" and evidence_by_stage.get(stage_name):
            add("stage-dependencies-satisfied", f"$.stages.{stage_name}.evidence")
        elif state == "not-applicable" and stage_name == "re-evaluated":
            actual_kinds = {
                item.get("kind") for item in evidence_by_stage.get(stage_name, [])
            }
            if "routing-record" not in actual_kinds:
                add("only-maintenance-re-evaluation-not-applicable", f"$.stages.{stage_name}.evidence")

    if len(blocked_stages) > 1:
        add("stage-dependencies-satisfied", "$.stages")
    if blocked_stages:
        blocked_index = TAKEOVER_STAGE_ORDER.index(blocked_stages[0])
        for later in TAKEOVER_STAGE_ORDER[blocked_index + 1:]:
            if stage_values.get(later, {}).get("state") != "not-started":
                add("stage-dependencies-satisfied", f"$.stages.{later}")
    computed_last = satisfied_stages[-1] if satisfied_stages else None
    if result.get("last_completed_stage") != computed_last:
        add("last-completed-is-last-satisfied-stage", "$.last_completed_stage")

    if len(all_sequences) != len(set(all_sequences)):
        add("custody-sequences-globally-unique", "$.stages")
    custody_sequences = [
        item.get("sequence") for item in custody_history if isinstance(item.get("sequence"), int)
    ]
    if custody_sequences != sorted(custody_sequences) or len(custody_sequences) != len(
        set(custody_sequences)
    ):
        add("custody-history-strictly-increasing", "$.goal.custody_history")

    source_task = activation.get("source_task_id") if isinstance(activation, dict) else None
    active_task = activation.get("active_task_id") if isinstance(activation, dict) else None
    if isinstance(goal, dict):
        kind = goal.get("kind")
        custody = goal.get("custody")
        if kind == "maintenance-only":
            if custody_history or custody != "none" or goal.get("transfer_id") is not None or (
                goal.get("owner_task_id") is not None
                or goal.get("continuation") != "not-applicable"
            ):
                add("custody-history-valid", "$.goal")
        elif kind == "unfinished":
            if not custody_history or custody_history[0].get("state") != "source-owned" or (
                custody_history[0].get("task_id") != source_task
            ):
                add("custody-first-state-valid", "$.goal.custody_history")
            for previous, current in zip(custody_history, custody_history[1:]):
                allowed = TAKEOVER_CUSTODY_TRANSITIONS.get(previous.get("state"), [])
                if current.get("state") not in allowed:
                    add("custody-transitions-direct", "$.goal.custody_history")
            for index, item in enumerate(custody_history):
                state = item.get("state")
                task_id = item.get("task_id")
                expected_history_task = {
                    "source-owned": source_task,
                    "automatic-transfer-pending": source_task,
                    "automatic-successor-owned": active_task,
                    "manual-transfer-required": None,
                    "manual-transfer-pending": active_task,
                    "manual-successor-owned": active_task,
                }.get(state)
                if task_id != expected_history_task:
                    add(
                        "custody-owner-derived",
                        f"$.goal.custody_history[{index}].task_id",
                    )
            if custody_history and custody_history[-1].get("state") != custody:
                add("custody-final-equals-current", "$.goal.custody")
            final_task = custody_history[-1].get("task_id") if custody_history else None
            derived_owner = final_task if custody in (
                "source-owned", "automatic-transfer-pending",
                "automatic-successor-owned", "manual-successor-owned",
            ) else None
            if goal.get("owner_task_id") != derived_owner:
                add("custody-owner-derived", "$.goal.owner_task_id")
            if custody in ("source-owned", "automatic-transfer-pending") and final_task != source_task:
                add("custody-owner-derived", "$.goal.custody_history")
            if custody in ("automatic-successor-owned", "manual-successor-owned") and final_task != active_task:
                add("custody-owner-derived", "$.goal.custody_history")
            if custody == "manual-transfer-required" and final_task is not None:
                add("custody-owner-derived", "$.goal.custody_history")
            if custody == "automatic-transfer-pending" and isinstance(activation, dict) and not opaque(
                activation.get("handoff_idempotency_key")
            ):
                add("custody-owner-derived", "$.activation.handoff_idempotency_key")
            if custody in (
                "automatic-transfer-pending", "automatic-successor-owned",
                "manual-transfer-required", "manual-transfer-pending",
                "manual-successor-owned",
            ) and not opaque(goal.get("transfer_id")):
                add("custody-history-valid", "$.goal.transfer_id")
            if custody == "source-owned" and goal.get("transfer_id") is not None:
                add("custody-history-valid", "$.goal.transfer_id")

    # Activation bindings, event ordering and content identities.
    if isinstance(activation, dict):
        path = activation.get("path")
        receipt_kind = activation.get("receipt_kind")
        if path == "none":
            for key in (
                "receipt_kind", "receipt_id", "active_task_id",
                "handoff_idempotency_key", "observed_manifest_sha256",
                "observed_activation_set_sha256",
            ):
                if activation.get(key) is not None:
                    add("activation-receipt-bound", f"$.activation.{key}")
        else:
            bindings = registry["activation_receipt_bindings"]
            binding = bindings.get(receipt_kind) if isinstance(bindings, dict) else None
            if not isinstance(binding, dict) or binding.get("path") != path:
                add("activation-receipt-bound", "$.activation")
            else:
                relation = binding.get("active_task_relation")
                if relation == "equals-source-task" and active_task != source_task:
                    add("activation-receipt-bound", "$.activation.active_task_id")
                if relation == "differs-from-source-task" and (
                    active_task is None or active_task == source_task
                ):
                    add("activation-receipt-bound", "$.activation.active_task_id")
                key_rule = binding.get("handoff_idempotency_key")
                if key_rule == "required" and not opaque(activation.get("handoff_idempotency_key")):
                    add("activation-receipt-bound", "$.activation.handoff_idempotency_key")
                if key_rule == "must-be-null" and activation.get("handoff_idempotency_key") is not None:
                    add("activation-receipt-bound", "$.activation.handoff_idempotency_key")
                activated_kinds = {
                    item.get("kind") for item in evidence_by_stage.get("activated", [])
                }
                if any(kind not in activated_kinds for kind in binding.get("required_evidence", [])):
                    add("activation-receipt-bound", "$.stages.activated.evidence")
            if not opaque(activation.get("receipt_id")):
                add("activation-receipt-bound", "$.activation.receipt_id")
        if stage_values.get("activated", {}).get("state") == "satisfied":
            expected_fp = context.get("target_fingerprint")
            if fingerprint != expected_fp:
                add("activation-identities-match-target", "$.target_fingerprint")
            if activation.get("observed_manifest_sha256") != context.get("manifest_sha256"):
                add("activation-identities-match-target", "$.activation.observed_manifest_sha256")
            if activation.get("observed_activation_set_sha256") != context.get(
                "activation_set_sha256"
            ):
                add("activation-identities-match-target", "$.activation.observed_activation_set_sha256")
            apply_sequences = [
                item.get("sequence") for item in evidence_by_stage.get("applied", [])
                if item.get("kind") == "apply-receipt" and isinstance(item.get("sequence"), int)
            ]
            activation_sequences = [
                item.get("sequence") for item in evidence_by_stage.get("activated", [])
                if item.get("kind") in ("activation-receipt", "manual-task-start")
                and isinstance(item.get("sequence"), int)
            ]
            if not apply_sequences or not activation_sequences or min(activation_sequences) <= max(apply_sequences):
                add("activation-after-apply", "$.stages.activated.evidence")
            if isinstance(goal, dict) and goal.get("kind") == "unfinished":
                history_sequence = {
                    item.get("state"): item.get("sequence") for item in custody_history
                }
                handoff_sequences = [
                    item.get("sequence")
                    for item in evidence_by_stage.get("activated", [])
                    if item.get("kind") == "handoff-claim"
                    and isinstance(item.get("sequence"), int)
                ]
                if path == "same-task-reload" and (
                    len(custody_history) != 1 or goal.get("custody") != "source-owned"
                ):
                    add("custody-history-valid", "$.goal.custody_history")
                if path == "automatic-successor-handoff":
                    owner_sequence = history_sequence.get("automatic-successor-owned")
                    if (
                        not handoff_sequences
                        or not activation_sequences
                        or min(handoff_sequences) <= min(activation_sequences)
                        or not isinstance(owner_sequence, int)
                        or owner_sequence <= max(handoff_sequences)
                    ):
                        add("successor-custody-terminal", "$.goal.custody_history")
                if path == "manual-new-task":
                    pending_sequence = history_sequence.get("manual-transfer-pending")
                    owner_sequence = history_sequence.get("manual-successor-owned")
                    if (
                        not isinstance(pending_sequence, int)
                        or not activation_sequences
                        or min(activation_sequences) <= pending_sequence
                        or not isinstance(owner_sequence, int)
                        or owner_sequence <= max(activation_sequences)
                    ):
                        add("successor-custody-terminal", "$.goal.custody_history")

    if stage_values.get("applied", {}).get("state") == "satisfied" and result.get(
        "write_state"
    ) != "project-files-written":
        add("write-state-project-files-written", "$.write_state")
    if stage_values.get("applied", {}).get("state") == "satisfied" and isinstance(
        upgrade_transaction, dict
    ) and not (
        upgrade_transaction.get("outcome") == "committed"
        and upgrade_transaction.get("commit_marker") == "valid"
        and upgrade_transaction.get("installation_state") == "target"
        and upgrade_transaction.get("active_state_present") is False
    ):
        add("upgrade-transaction-outcome-committed", "$.upgrade_transaction")
    if result.get("write_state") in ("rolled-back", "recovery-required", "unknown-partial"):
        if stage_values.get("applied", {}).get("state") != "blocked" or any(
            stage_values.get(name, {}).get("state") != "not-started"
            for name in TAKEOVER_STAGE_ORDER[3:]
        ):
            add("stage-dependencies-satisfied", "$.stages.applied")

    reason = None
    if blocked_stages:
        reason = stage_values[blocked_stages[0]].get("reason_code")
    overall = result.get("overall_status")
    if overall in ("blocked", "degraded"):
        if not blocked_stages or not isinstance(next_action, dict) or (
            TAKEOVER_REASON_ACTION.get(reason) != next_action.get("code")
        ):
            add("reason-action-consistent", "$.next_action")
    elif next_action is not None:
        add("reason-action-consistent", "$.next_action")
    if overall == "degraded" and not (
        result.get("write_state") == "project-files-written"
        and stage_values.get("upgraded", {}).get("state") == "satisfied"
        and stage_values.get("activated", {}).get("state") == "blocked"
        and reason == "manual-new-task-required"
        and isinstance(next_action, dict)
        and next_action.get("code") == "create-new-project-task"
    ):
        add("reason-action-consistent", "$.overall_status")

    ready_satisfied = stage_values.get("ready", {}).get("state") == "satisfied"
    if (overall == "ready") != ready_satisfied:
        add("overall-ready-iff-ready-stage-satisfied", "$.overall_status")
    if ready_satisfied:
        if blocked_stages or result.get("write_state") != "project-files-written":
            add("no-blocking-diagnostic", "$.stages.ready")
        if result.get("completion_owner_task_id") != active_task or active_task is None:
            add("completion-owner-is-active-task", "$.completion_owner_task_id")
        if next_action is not None or stage_values["ready"].get("reason_code") is not None:
            add("ready-has-no-reason-or-next-action", "$.stages.ready")
        if isinstance(goal, dict) and goal.get("kind") == "maintenance-only":
            if stage_values.get("re-evaluated", {}).get("state") != "not-applicable":
                add("only-maintenance-re-evaluation-not-applicable", "$.stages.re-evaluated")
        elif isinstance(goal, dict):
            if stage_values.get("re-evaluated", {}).get("state") != "satisfied" or (
                goal.get("continuation") not in ("ready-to-resume", "resumed")
            ):
                add("unfinished-goal-owner-is-completion-owner", "$.goal")
            if goal.get("owner_task_id") != result.get("completion_owner_task_id"):
                add("unfinished-goal-owner-is-completion-owner", "$.goal.owner_task_id")
            bindings = registry["activation_receipt_bindings"]
            binding = bindings.get(activation.get("receipt_kind")) if isinstance(
                activation, dict
            ) and isinstance(bindings, dict) else None
            if not isinstance(binding, dict) or goal.get("custody") != binding.get(
                "required_custody_at_ready"
            ):
                add("single-active-custodian", "$.goal.custody")
            if activation.get("path") in ("automatic-successor-handoff", "manual-new-task") and (
                result.get("completion_owner_task_id") == source_task
            ):
                add("successor-custody-terminal", "$.completion_owner_task_id")
    elif result.get("completion_owner_task_id") is not None:
        add("completion-owner-is-active-task", "$.completion_owner_task_id")
    return errors


def validate_takeover(root: Path, output_format: str) -> int:
    try:
        context, authentication_errors = installed_takeover_contract_context(root)
    except (OSError, UnicodeError, VibeError):
        context = None
        authentication_errors = [
            authentication_error(
                "installed-version-integrity-failed", MANIFEST_PATH.as_posix()
            )
        ]
    if authentication_errors or context is None:
        result = result_envelope(
            "validate-takeover",
            "error",
            structural_only=True,
            host_evidence_authenticated=False,
            ready_claim=False,
            errors=authentication_errors,
        )
        if output_format == "json":
            print_json(result)
        else:
            print("Takeover validation could not authenticate the installed contract.", file=sys.stderr)
        return 2
    try:
        raw = sys.stdin.read()
        candidate = json.loads(raw, object_pairs_hook=reject_duplicate_json_keys)
    except (OSError, UnicodeError, json.JSONDecodeError, ValueError):
        candidate = None
        validation_errors = [takeover_validation_error("exact-result-shape", "$")]
    else:
        validation_errors = validate_takeover_object(candidate, context)
    status = "invalid" if validation_errors else "valid"
    result = result_envelope(
        "validate-takeover",
        status,
        structural_only=True,
        host_evidence_authenticated=False,
        ready_claim=False,
        errors=validation_errors,
    )
    if output_format == "json":
        print_json(result)
    elif validation_errors:
        for item in validation_errors:
            print(f"INVALID: {item['code']} at {item['path']}", file=sys.stderr)
    else:
        print("Takeover structure is valid; host evidence is not authenticated.")
    return 1 if validation_errors else 0


def canonical_takeover_fixture(context: Dict[str, object]) -> Dict[str, object]:
    """Build the bounded maintenance-only canonical case used by release validation."""
    fingerprint = copy.deepcopy(context["target_fingerprint"])
    source_task = "controlled-source-task"
    active_task = "controlled-manual-successor"

    def evidence(
        kind: str, ref: str, sequence: int, task_id: Optional[str], digest_value: Optional[str] = None
    ) -> Dict[str, object]:
        return {
            "kind": kind,
            "ref": ref,
            "sha256": digest_value,
            "task_id": task_id,
            "sequence": sequence,
        }

    return {
        "takeover_schema_version": TAKEOVER_SCHEMA_VERSION,
        "takeover_id": "controlled-takeover",
        "evidence_origin": "controlled-fixture",
        "completion_owner_task_id": active_task,
        "project_root": context["project_root"],
        "source": {
            "type": "local-payload",
            "ref": "controlled-local-payload",
            "artifact_sha256": None,
            "payload_tree_sha256": "2" * 64,
        },
        "versions": {"from": "0.5.0", "target": fingerprint["kit_version"]},
        "target_fingerprint": fingerprint,
        "overall_status": "ready",
        "last_completed_stage": "ready",
        "write_state": "project-files-written",
        "upgrade_transaction": {
            "schema_version": TRANSACTION_JOURNAL_SCHEMA,
            "transaction_id": "controlled-upgrade-transaction",
            "outcome": "committed",
            "commit_marker": "valid",
            "installation_state": "target",
            "active_state_present": False,
        },
        "activation": {
            "path": "manual-new-task",
            "receipt_kind": "manual-task-start",
            "receipt_id": "manual-receipt",
            "source_task_id": source_task,
            "active_task_id": active_task,
            "handoff_idempotency_key": None,
            "observed_manifest_sha256": context["manifest_sha256"],
            "observed_activation_set_sha256": context["activation_set_sha256"],
        },
        "goal": {
            "kind": "maintenance-only",
            "custody": "none",
            "continuation": "not-applicable",
            "transfer_id": None,
            "owner_task_id": None,
            "custody_history": [],
        },
        "stages": {
            "source-resolved": {
                "state": "satisfied", "outcome": None, "reason_code": None,
                "evidence": [evidence("source-attestation", "source-receipt", 0, source_task, "2" * 64)],
            },
            "planned": {
                "state": "satisfied", "outcome": None, "reason_code": None,
                "evidence": [evidence("plan-receipt", "plan-receipt", 1, source_task)],
            },
            "applied": {
                "state": "satisfied", "outcome": None, "reason_code": None,
                "evidence": [evidence("apply-receipt", "apply-receipt", 2, source_task)],
            },
            "upgraded": {
                "state": "satisfied", "outcome": None, "reason_code": None,
                "evidence": [evidence("doctor-receipt", "upgrade-doctor", 3, source_task)],
            },
            "activated": {
                "state": "satisfied", "outcome": None, "reason_code": None,
                "evidence": [evidence("manual-task-start", "manual-receipt", 4, active_task, context["activation_set_sha256"])],
            },
            "adapted": {
                "state": "satisfied", "outcome": "unchanged-complete", "reason_code": None,
                "evidence": [
                    evidence("onboarding-state", ".vibe/onboarding.json", 5, active_task),
                    evidence("adaptation-review", "adaptation-review", 6, active_task),
                ],
            },
            "verified": {
                "state": "satisfied", "outcome": None, "reason_code": None,
                "evidence": [
                    evidence("doctor-receipt", "final-doctor", 7, active_task),
                    evidence("verify-receipt", "default-verify", 8, active_task),
                ],
            },
            "re-evaluated": {
                "state": "not-applicable", "outcome": "maintenance-only", "reason_code": None,
                "evidence": [evidence("routing-record", "maintenance-only", 9, active_task)],
            },
            "ready": {"state": "satisfied", "outcome": None, "reason_code": None, "evidence": []},
        },
        "next_action": None,
    }


def canonical_takeover_invalid_cases():
    """Return bounded canonical mutations for release-time production validation."""
    def dependency(value: Dict[str, object]) -> None:
        value["stages"]["planned"]["state"] = "not-started"
        value["stages"]["planned"]["evidence"] = []

    def action(value: Dict[str, object]) -> None:
        value["next_action"] = {"code": "fix-configured-check", "detail": "Invalid ready action."}

    def activation(value: Dict[str, object]) -> None:
        value["activation"]["active_task_id"] = value["activation"]["source_task_id"]

    def custody(value: Dict[str, object]) -> None:
        value["goal"]["custody"] = "source-owned"

    def false_ready(value: Dict[str, object]) -> None:
        value["overall_status"] = "in-progress"

    return {
        "dependency": dependency,
        "action": action,
        "activation": activation,
        "custody": custody,
        "false-ready": false_ready,
    }


def validate_release(release_dir: Path, output_format: str = "text") -> int:
    release_dir = release_dir.resolve()
    manifest_path = release_dir / "release-manifest.json"
    checksum_path = release_dir / "SHA256SUMS"
    if not manifest_path.is_file() or not checksum_path.is_file():
        raise VibeError("release-manifest.json and SHA256SUMS are required")
    try:
        manifest = json.loads(
            manifest_path.read_text(encoding="utf-8"),
            object_pairs_hook=reject_duplicate_json_keys,
        )
    except (OSError, json.JSONDecodeError, ValueError) as error:
        raise VibeError(f"release manifest is invalid: {error}") from error
    if not isinstance(manifest, dict):
        raise VibeError("release manifest must be a JSON object")

    errors: List[str] = []
    version = str(manifest.get("kit_version", ""))
    if not re.fullmatch(r"\d+\.\d+\.\d+", version):
        errors.append("manifest kit_version must be strict SemVer")
    if manifest.get("schema_version") != RELEASE_MANIFEST_SCHEMA:
        errors.append("unsupported release manifest schema")
    status = manifest.get("status")
    if status not in RELEASE_STATUSES:
        errors.append("release candidate status is missing or unsupported")
    if status in ("prerelease", "stable"):
        source = manifest.get("source")
        if not isinstance(source, dict):
            errors.append(f"{status} source metadata must be an object")
        elif (
            not re.fullmatch(r"[0-9a-f]{40,64}", str(source.get("ref", "")))
            or source.get("tree_state") != "clean"
        ):
            errors.append(f"{status} requires a committed clean source ref")
    release_name = f"vibe-kit-{version}.zip"
    plugin_name = f"vibe-kit-plugin-{version}.zip"
    distribution_name = f"vibe-kit-distribution-{version}.zip"

    expected_public_assets = [
        {"name": "SHA256SUMS", "role": "checksum"},
        {"name": "release-manifest.json", "role": "manifest"},
        {"name": release_name, "role": "direct"},
        {"name": distribution_name, "role": "distribution"},
        {"name": plugin_name, "role": "plugin"},
    ]
    if manifest.get("public_assets") != expected_public_assets:
        errors.append("release manifest does not declare the exact five public asset names and roles")

    checksum_entries: Dict[str, str] = {}
    checksum_lines = checksum_path.read_text(encoding="utf-8").splitlines()
    if checksum_lines != sorted(checksum_lines, key=lambda line: line.split("  ", 1)[-1].encode("utf-8")):
        errors.append("SHA256SUMS entries are not sorted by UTF-8 path bytes")
    for line in checksum_lines:
        match = re.fullmatch(r"([0-9a-f]{64})  (.+)", line)
        if not match or not archive_name_is_safe(match.group(2)):
            errors.append(f"invalid SHA256SUMS line: {line!r}")
            continue
        if match.group(2) in checksum_entries:
            errors.append(f"duplicate SHA256SUMS path: {match.group(2)}")
        checksum_entries[match.group(2)] = match.group(1)
    marketplace_hashes = manifest.get("marketplace_files")
    if not isinstance(marketplace_hashes, dict):
        errors.append("manifest marketplace_files must be an object")
        marketplace_hashes = {}
    expected_checksum_paths = {
        release_name,
        plugin_name,
        "marketplace/marketplace.json",
        "release-manifest.json",
    }
    expected_checksum_paths.update(
        "marketplace/" + str(relative) for relative in marketplace_hashes
    )
    if set(checksum_entries) != expected_checksum_paths:
        errors.append("SHA256SUMS does not cover the exact release artifact set")
    for relative, expected in checksum_entries.items():
        path = release_dir / relative
        if not path.is_file():
            errors.append(f"missing checksummed artifact: {relative}")
        elif sha256(path) != expected:
            errors.append(f"checksum mismatch: {relative}")

    distribution_path = release_dir / distribution_name
    expected_distribution_entries = {
        "SHA256SUMS": checksum_path.read_bytes(),
        **{
            relative: (release_dir / relative).read_bytes()
            for relative in checksum_entries
            if (release_dir / relative).is_file()
        },
    }
    if distribution_path.is_file():
        distribution_entries, distribution_errors = read_normalized_archive(
            distribution_path, f"vibe-kit-{version}"
        )
        errors.extend(distribution_errors)
    else:
        # A distribution archive intentionally cannot contain itself.  Accept its
        # extracted root as the same validation surface, but only when its complete
        # regular-file graph is exactly SHA256SUMS plus the covered members.
        distribution_entries = {}
        try:
            for path in sorted(release_dir.rglob("*")):
                metadata = os.lstat(str(path))
                if stat.S_ISLNK(metadata.st_mode):
                    errors.append("extracted distribution contains a symlink")
                    continue
                if stat.S_ISREG(metadata.st_mode):
                    distribution_entries[path.relative_to(release_dir).as_posix()] = path.read_bytes()
                elif not stat.S_ISDIR(metadata.st_mode):
                    errors.append("extracted distribution contains an unsupported path type")
        except OSError as error:
            errors.append(f"cannot inspect extracted distribution: {error}")
    if distribution_entries != expected_distribution_entries:
        errors.append("distribution ZIP does not contain exactly SHA256SUMS and its covered members")

    artifact_entries = manifest.get("artifacts")
    if not isinstance(artifact_entries, list):
        errors.append("manifest artifacts must be a list")
        artifact_entries = []
    expected_manifest_artifacts = {
        release_name,
        plugin_name,
        "marketplace/marketplace.json",
    }
    seen_artifacts = set()
    for item in artifact_entries:
        if not isinstance(item, dict):
            errors.append("manifest artifact entry must be an object")
            continue
        relative = str(item.get("path", ""))
        seen_artifacts.add(relative)
        path = release_dir / relative
        if not archive_name_is_safe(relative) or not path.is_file():
            errors.append(f"invalid or missing manifest artifact: {relative}")
            continue
        if item.get("sha256") != sha256(path) or item.get("size") != path.stat().st_size:
            errors.append(f"manifest artifact metadata mismatch: {relative}")
    if seen_artifacts != expected_manifest_artifacts:
        errors.append("manifest does not declare the exact artifact set")

    release_entries, release_errors = read_normalized_archive(
        release_dir / release_name, f"vibe-kit-{version}"
    )
    plugin_entries, plugin_errors = read_normalized_archive(
        release_dir / plugin_name, "vibe-kit"
    )
    errors.extend(release_errors)
    errors.extend(plugin_errors)
    payload_hashes = manifest.get("payload_files")
    if not isinstance(payload_hashes, dict):
        errors.append("manifest payload_files must be an object")
        payload_hashes = {}
    actual_payload_hashes = {
        relative: hashlib.sha256(content).hexdigest()
        for relative, content in sorted(release_entries.items())
    }
    if actual_payload_hashes != payload_hashes:
        errors.append("release ZIP payload does not match manifest payload_files")
    actual_payload_tree_sha256 = payload_tree_sha256_from_hashes(
        actual_payload_hashes
    )
    if manifest.get("payload_tree_sha256") != actual_payload_tree_sha256:
        errors.append("release manifest payload-tree identity does not match payload")
    core_version = release_entries.get(".vibe/core/version", b"").decode("utf-8", errors="replace").strip()
    if core_version != version:
        errors.append("release ZIP core version does not match kit_version")
    protocol_bytes = release_entries.get(".vibe/core/protocol.json")
    release_protocol_value: Dict[str, object] = {}
    if protocol_bytes is None:
        errors.append("release ZIP is missing protocol metadata")
    else:
        try:
            loaded_protocol = json.loads(
                protocol_bytes.decode("utf-8"),
                object_pairs_hook=reject_duplicate_json_keys,
            )
            if isinstance(loaded_protocol, dict):
                release_protocol_value = loaded_protocol
            else:
                errors.append("release protocol metadata must be an object")
        except (UnicodeDecodeError, json.JSONDecodeError, ValueError):
            errors.append("release protocol metadata is invalid")
    for protocol_key in (
        "manifest_schema",
        "core_protocol",
        "feedback_protocol",
        "agent_install_protocol",
        "takeover_contract_registry_sha256",
        "predecessor_migrations",
        "adapters",
    ):
        if manifest.get(protocol_key) != release_protocol_value.get(protocol_key):
            errors.append(
                f"release manifest {protocol_key} does not match payload protocol metadata"
            )
    if release_protocol_value.get("agent_install_protocol") != AGENT_INSTALL_PROTOCOL:
        errors.append("release Agent install protocol is unsupported")
    if release_protocol_value.get("core_protocol") != CORE_PROTOCOL:
        errors.append("release core protocol is unsupported")
    if release_protocol_value.get("takeover_contract_registry_sha256") != (
        TAKEOVER_CONTRACT_REGISTRY_SHA256
    ):
        errors.append("release takeover contract registry digest is unsupported")
    release_migration_mirror = release_protocol_value.get("predecessor_migrations")
    if (
        not valid_predecessor_migration_mirror(release_migration_mirror)
        or not valid_predecessor_migration_mirror(
            manifest.get("predecessor_migrations")
        )
        or manifest.get("predecessor_migrations") != release_migration_mirror
    ):
        errors.append("release predecessor-migration registry mirror is unsupported")
    packaged_cli = release_entries.get("bin/vibe")
    try:
        expected_cli = (source_root() / "bin/vibe").read_bytes()
    except OSError:
        expected_cli = b""
    if packaged_cli != expected_cli:
        errors.append("release compiled predecessor-migration registry authority is unsupported")
    codex_protocol = (
        release_protocol_value.get("adapters", {}).get("codex", {})
        if isinstance(release_protocol_value.get("adapters"), dict)
        else {}
    )
    if not isinstance(codex_protocol, dict) or (
        codex_protocol.get("version") != CODEX_ADAPTER_PROTOCOL
        or codex_protocol.get("core_protocol") != CORE_PROTOCOL
        or codex_protocol.get("upgrade_activation")
        != {
            "same_task_reload": "conditional-unclaimed",
            "automatic_successor_handoff": "conditional-unclaimed",
            "manual_new_task": "supported",
        }
    ):
        errors.append("release Codex adapter activation capability is unsupported")
    for required in (
        "bin/vibe",
        "AGENTS.md",
        "AGENT_INSTALL.md",
        "agent-install.json",
        "templates/project/project-rules.md",
        "templates/project/onboarding.json",
    ):
        if required not in release_entries:
            errors.append(f"release ZIP is missing required payload file: {required}")

    install_guide = release_entries.get("AGENT_INSTALL.md")
    if install_guide is not None:
        if not validate_agent_install_guide_bytes(install_guide):
            errors.append("AGENT_INSTALL.md is malformed")

    install_contract_bytes = release_entries.get("agent-install.json")
    install_contract: Dict[str, object] = {}
    if install_contract_bytes is not None:
        try:
            loaded_contract = json.loads(
                install_contract_bytes.decode("utf-8"),
                object_pairs_hook=reject_duplicate_json_keys,
            )
            if isinstance(loaded_contract, dict):
                install_contract = loaded_contract
            else:
                errors.append("agent-install.json must be an object")
        except (UnicodeDecodeError, json.JSONDecodeError, ValueError):
            errors.append("agent-install.json is malformed")
    if install_contract:
        if install_contract.get("schema_version") != AGENT_INSTALL_SCHEMA:
            errors.append("agent install contract schema is unsupported")
        if install_contract.get("protocol_version") != AGENT_INSTALL_PROTOCOL or (
            install_contract.get("protocol_version")
            != release_protocol_value.get("agent_install_protocol")
        ):
            errors.append("agent install contract protocol does not match payload protocol")
        if install_contract.get("kit_version") != version:
            errors.append("agent install contract version does not match release")
        canonical = install_contract.get("canonical_source")
        if not isinstance(canonical, dict) or canonical.get("repository") != (
            "https://github.com/mintgao/vibe-kit"
        ):
            errors.append("agent install contract canonical source is invalid")
        adapter = install_contract.get("adapter")
        codex = release_protocol_value.get("adapters", {}).get("codex", {}) if isinstance(
            release_protocol_value.get("adapters"), dict
        ) else {}
        if not isinstance(adapter, dict) or (
            adapter.get("name") != "codex"
            or adapter.get("protocol") != codex.get("version")
        ):
            errors.append("agent install contract adapter does not match payload protocol")
        channels = install_contract.get("release_channels")
        allowed_statuses = channels.get("allowed_statuses") if isinstance(channels, dict) else None
        if not isinstance(allowed_statuses, list) or status not in allowed_statuses:
            errors.append("agent install contract release channel does not match release status")
        errors.extend(validate_agent_install_contract_shape(install_contract))

        activation_contract = install_contract.get("activation")
        declared_activation_paths = (
            activation_contract.get("activation_paths")
            if isinstance(activation_contract, dict)
            else None
        )
        try:
            actual_activation_paths, activation_hashes, actual_activation_digest = (
                reference_activation_identity_from_entries(
                    release_entries, install_contract, release_protocol_value
                )
            )
        except VibeError:
            actual_activation_paths = []
            activation_hashes = {}
            actual_activation_digest = ""
            errors.append("release activation identity cannot be recomputed")
        if declared_activation_paths != actual_activation_paths:
            errors.append("agent install activation paths do not match release payload")
        if not isinstance(activation_contract, dict) or (
            activation_contract.get("activation_set_algorithm")
            != ACTIVATION_SET_ALGORITHM
            or
            activation_contract.get("activation_set_sha256")
            != actual_activation_digest
        ):
            errors.append("agent install activation-set identity does not match payload")
        if manifest.get("activation_set_sha256") != actual_activation_digest:
            errors.append("release manifest activation-set identity does not match payload")
        if manifest.get("agent_install_schema") != AGENT_INSTALL_SCHEMA:
            errors.append("release manifest Agent-install schema is unsupported")
        if manifest.get("takeover_schema") != TAKEOVER_SCHEMA_VERSION:
            errors.append("release manifest takeover schema is unsupported")
        if manifest.get("maintenance_bridge_schema") != MAINTENANCE_BRIDGE_SCHEMA_VERSION:
            errors.append("release manifest maintenance bridge schema is unsupported")
        expected_schema_fields = {
            "compatibility_migration_registry_schema": COMPATIBILITY_MIGRATION_REGISTRY_SCHEMA,
            "cli_result_schema": AGENT_RESULT_SCHEMA,
            "transaction_journal_schema": TRANSACTION_JOURNAL_SCHEMA,
            "transaction_commit_schema": TRANSACTION_COMMIT_SCHEMA,
            "publication_intent_schema": PUBLICATION_INTENT_SCHEMA,
            "publication_receipt_schema": PUBLICATION_RECEIPT_SCHEMA,
            "issue_closeout_intent_schema": ISSUE_CLOSEOUT_INTENT_SCHEMA,
        }
        for key, expected in expected_schema_fields.items():
            if manifest.get(key) != expected:
                errors.append(f"release manifest protocol schema is unsupported: {key}")

        # Exercise the production structural validator against bounded canonical cases.
        canonical_context = {
            "project_root": "/canonical/vibe-project",
            "manifest_sha256": "1" * 64,
            "activation_set_sha256": actual_activation_digest,
            "target_fingerprint": {
                "kit_version": version,
                "core_protocol": CORE_PROTOCOL,
                "agent_install_schema": AGENT_INSTALL_SCHEMA,
                "agent_install_protocol": AGENT_INSTALL_PROTOCOL,
                "adapter_name": "codex",
                "adapter_protocol": CODEX_ADAPTER_PROTOCOL,
                "manifest_sha256": "1" * 64,
                "activation_set_sha256": actual_activation_digest,
            },
        }
        canonical_valid = canonical_takeover_fixture(canonical_context)
        if validate_takeover_object(canonical_valid, canonical_context):
            errors.append("production takeover validator rejects canonical valid result")
        for case_name, mutation in canonical_takeover_invalid_cases().items():
            candidate = copy.deepcopy(canonical_valid)
            mutation(candidate)
            if not validate_takeover_object(candidate, canonical_context):
                errors.append(
                    f"production takeover validator accepts canonical invalid case: {case_name}"
                )

    plugin_manifest_bytes = plugin_entries.get(".codex-plugin/plugin.json")
    plugin_manifest: Dict[str, object] = {}
    if plugin_manifest_bytes is None:
        errors.append("Plugin ZIP is missing .codex-plugin/plugin.json")
    else:
        try:
            loaded = json.loads(plugin_manifest_bytes.decode("utf-8"))
            if isinstance(loaded, dict):
                plugin_manifest = loaded
            else:
                errors.append("Plugin manifest must be an object")
        except (UnicodeDecodeError, json.JSONDecodeError) as error:
            errors.append(f"Plugin manifest is invalid: {error}")
    if plugin_manifest.get("name") != "vibe-kit" or plugin_manifest.get("version") != version:
        errors.append("Plugin name/version does not match release")
    if plugin_manifest.get("payload_tree_sha256") != actual_payload_tree_sha256:
        errors.append("Plugin payload-tree identity does not match release payload")
    for forbidden in ("mcpServers", "hooks", "apps"):
        if forbidden in plugin_manifest:
            errors.append(f"Plugin declares forbidden capability: {forbidden}")
    skill_names = {
        PurePosixPath(relative).parts[1]
        for relative in plugin_entries
        if relative.startswith("skills/") and len(PurePosixPath(relative).parts) > 2
    }
    if skill_names != {"vibe-bootstrap", "vibe-maintain"}:
        errors.append("Plugin ZIP must contain exactly the bootstrap and maintenance Skills")
    plugin_payload = {
        relative[len("payload/"):]: content
        for relative, content in plugin_entries.items()
        if relative.startswith("payload/")
    }
    if plugin_payload != release_entries:
        errors.append("Plugin bundled payload differs from release ZIP payload")

    expanded_plugin_root = release_dir / "marketplace/plugins/vibe-kit"
    expanded_plugin = {
        path.relative_to(expanded_plugin_root).as_posix(): path.read_bytes()
        for path in sorted(expanded_plugin_root.rglob("*"))
        if path.is_file()
    } if expanded_plugin_root.is_dir() else {}
    expected_expanded_plugin = {
        relative: content
        for relative, content in plugin_entries.items()
    }
    if expanded_plugin != expected_expanded_plugin:
        errors.append("marketplace Plugin files differ from Plugin ZIP")
    actual_marketplace_hashes = {
        "plugins/vibe-kit/" + relative: hashlib.sha256(content).hexdigest()
        for relative, content in sorted(expanded_plugin.items())
    }
    if actual_marketplace_hashes != marketplace_hashes:
        errors.append("marketplace Plugin files do not match release manifest")

    marketplace_path = release_dir / "marketplace/marketplace.json"
    if marketplace_path.is_file():
        try:
            marketplace = json.loads(marketplace_path.read_text(encoding="utf-8"))
            entry = marketplace["plugins"][0]
            if (
                marketplace.get("name") != "personal"
                or entry.get("name") != "vibe-kit"
                or entry.get("source", {}).get("path") != "./plugins/vibe-kit"
            ):
                errors.append("marketplace entry does not point to the bundled Vibe Kit Plugin")
        except (OSError, json.JSONDecodeError, KeyError, IndexError, TypeError, AttributeError) as error:
            errors.append(f"marketplace catalog is invalid: {error}")

    if errors:
        if output_format == "json":
            print_json(
                result_envelope(
                    "validate-release",
                    "invalid",
                    release_directory=str(release_dir),
                    kit_version=version or None,
                    errors=errors,
                    network_used=False,
                )
            )
            return 1
        for error in errors:
            print(f"ERROR: {error}", file=sys.stderr)
        print(f"Release validation failed with {len(errors)} error(s).", file=sys.stderr)
        return 1
    if output_format == "json":
        print_json(
            result_envelope(
                "validate-release",
                "valid",
                release_directory=str(release_dir),
                kit_version=version,
                payload_files=len(release_entries),
                agent_install_schema=install_contract.get("schema_version"),
                agent_install_protocol=release_protocol_value.get(
                    "agent_install_protocol"
                ),
                payload_tree_sha256=actual_payload_tree_sha256,
                activation_set_sha256=(
                    install_contract.get("activation", {}).get(
                        "activation_set_sha256"
                    )
                    if isinstance(install_contract.get("activation"), dict)
                    else None
                ),
                network_used=False,
            )
        )
        return 0
    print(f"Release validation passed: {release_dir}")
    print(f"Version: {version}")
    print(f"Payload files: {len(release_entries)}")
    print("Network: not used")
    return 0


HISTORICAL_PUBLICATION_ALLOWED_OPERATIONS = (
    "fast-forward-main",
    "create-or-confirm-annotated-tag",
    "create-or-confirm-prerelease",
    "upload-or-confirm-five-assets",
    "read-back-publication",
    "download-and-verify-public-assets",
    "conditionally-comment-and-close-issues-1-through-5",
)
V080_PUBLICATION_PROFILE = "vibe-kit-v0.8.0-prerelease"
V080_PUBLICATION_ALLOWED_OPERATIONS = (
    "fast-forward-main",
    "create-or-confirm-annotated-tag",
    "create-or-confirm-prerelease",
    "upload-or-confirm-five-assets",
    "read-back-publication",
