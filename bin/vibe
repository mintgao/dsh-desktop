def legacy_onboarding_registry_entry(
    family_id: str,
    version: str,
    managed_files: Dict[str, str],
    manifest_sha256: str,
    install_identity_sha256: str,
    agents_block_sha256: str,
    core_protocol: int,
) -> Dict[str, object]:
    return {
        "migration_id": family_id,
        "mode": "create-pending-onboarding-if-absent",
        "framework_version": version,
        "manifest_schema": 1,
        "core_protocol": core_protocol,
        "adapter_protocol": core_protocol,
        "agent_install_protocol": 0,
        "manifest_sha256": manifest_sha256,
        "install_identity_sha256": install_identity_sha256,
        "agents_block_sha256": agents_block_sha256,
        "managed_files": dict(sorted(managed_files.items())),
    }


