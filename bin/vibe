PREDECESSOR_MIGRATION_REGISTRY_SHA256 = hashlib.sha256(
    json.dumps(
        PREDECESSOR_MIGRATION_REGISTRY,
        ensure_ascii=False,
        sort_keys=True,
        separators=(",", ":"),
    ).encode("utf-8")
).hexdigest()
