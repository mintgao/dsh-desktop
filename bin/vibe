def exact_keys(value: object, fields: Sequence[str]) -> bool:
    return isinstance(value, dict) and set(value) == set(fields)


def publication_assets(release_dir: Path, version: str) -> List[Dict[str, object]]:
    declarations = [
        ("SHA256SUMS", "checksum"),
        ("release-manifest.json", "manifest"),
        (f"vibe-kit-{version}.zip", "direct"),
        (f"vibe-kit-distribution-{version}.zip", "distribution"),
        (f"vibe-kit-plugin-{version}.zip", "plugin"),
    ]
    assets = []
    for name, role in declarations:
        path = release_dir / name
        if not path.is_file() or path.is_symlink():
            raise VibeError(f"publication asset is missing or invalid: {name}")
        assets.append({
            "name": name, "role": role, "size": path.stat().st_size,
            "sha256": sha256(path),
        })
    return sorted(assets, key=lambda item: str(item["name"]).encode("utf-8"))


def validate_publication_intent_v1(value: object) -> List[str]:
    errors: List[str] = []
    top = (
        "schema_version", "kind", "repository", "version", "source_commit",
        "main", "tag", "release", "assets", "asset_set_sha256", "local_gates",
        "remote_snapshot", "operations", "authorization_scope",
        "issue_closeout_policy", "recovery_policy",
    )
    if not exact_keys(value, top):
        return ["publication intent top-level fields are unknown or incomplete"]
    intent = value
    if not isinstance(intent, dict):
        return errors
    if intent.get("schema_version") != HISTORICAL_PUBLICATION_INTENT_SCHEMA or intent.get("kind") != "vibe-kit-publication":
        errors.append("publication intent schema/kind is unsupported")
    repository = intent.get("repository")
    if not exact_keys(repository, ("owner", "name", "canonical_url")) or repository != {
        "owner": "mintgao", "name": "vibe-kit", "canonical_url": "https://github.com/mintgao/vibe-kit"
    }:
        errors.append("publication repository identity is invalid")
    if intent.get("version") != "0.7.0" or not re.fullmatch(r"[0-9a-f]{40}", str(intent.get("source_commit", ""))):
        errors.append("publication version/source commit is invalid")
    main = intent.get("main")
    if not exact_keys(main, ("branch", "expected_old_oid", "target_oid", "policy")) or (
        not isinstance(main, dict) or main.get("branch") != "main"
        or main.get("policy") != "fast-forward-cas-only"
        or any(re.fullmatch(r"[0-9a-f]{40}", str(main.get(key, ""))) is None for key in ("expected_old_oid", "target_oid"))
        or main.get("target_oid") != intent.get("source_commit")
    ):
        errors.append("publication main compare-and-swap identity is invalid")
    tag = intent.get("tag")
    tag_fields = (
        "name", "object_type", "expected_tag_object_oid", "target_commit",
        "tagger_name", "tagger_email", "tagger_timestamp", "tagger_timezone",
        "message_sha256",
    )
    if not exact_keys(tag, tag_fields) or not isinstance(tag, dict) or (
        tag.get("name") != "v0.7.0" or tag.get("object_type") != "tag"
        or tag.get("target_commit") != intent.get("source_commit")
        or re.fullmatch(r"[0-9a-f]{40}", str(tag.get("expected_tag_object_oid", ""))) is None
        or re.fullmatch(r"[0-9a-f]{64}", str(tag.get("message_sha256", ""))) is None
        or not is_iso8601(tag.get("tagger_timestamp"))
        or re.fullmatch(r"[+-][0-9]{4}", str(tag.get("tagger_timezone", ""))) is None
    ):
        errors.append("publication annotated tag identity is invalid")
    release = intent.get("release")
    release_fields = (
        "title", "body_sha256", "body_source_path", "draft", "prerelease",
        "generated_notes", "platform_immutability_required",
    )
    if not exact_keys(release, release_fields) or not isinstance(release, dict) or (
        not isinstance(release.get("title"), str) or not release.get("title")
        or re.fullmatch(r"[0-9a-f]{64}", str(release.get("body_sha256", ""))) is None
        or release.get("body_source_path") != "docs/releases/0.7.0.md"
        or release.get("draft") is not False or release.get("prerelease") is not True
        or release.get("generated_notes") is not False
        or release.get("platform_immutability_required") is not False
    ):
        errors.append("publication release identity/state is invalid")
    assets = intent.get("assets")
    expected_roles = {"checksum", "manifest", "direct", "distribution", "plugin"}
    if not isinstance(assets, list) or len(assets) != 5 or assets != sorted(
        assets, key=lambda item: str(item.get("name", "")).encode("utf-8") if isinstance(item, dict) else b""
    ):
        errors.append("publication assets are not the exact sorted five-asset set")
    else:
        names = set()
        roles = set()
        for item in assets:
            if not exact_keys(item, ("name", "role", "size", "sha256")):
                errors.append("publication asset item shape is invalid")
                continue
            names.add(item.get("name")); roles.add(item.get("role"))
            if (
                not isinstance(item.get("name"), str) or not archive_name_is_safe(item["name"])
                or isinstance(item.get("size"), bool) or not isinstance(item.get("size"), int) or item["size"] < 0
                or re.fullmatch(r"[0-9a-f]{64}", str(item.get("sha256", ""))) is None
            ):
                errors.append("publication asset identity is invalid")
        expected_names_roles = {
            "SHA256SUMS": "checksum",
            "release-manifest.json": "manifest",
            "vibe-kit-0.7.0.zip": "direct",
            "vibe-kit-distribution-0.7.0.zip": "distribution",
            "vibe-kit-plugin-0.7.0.zip": "plugin",
        }
        if (
            len(names) != 5
            or roles != expected_roles
            or {item.get("name"): item.get("role") for item in assets} != expected_names_roles
        ):
            errors.append("publication asset names/roles are not one-to-one")
        if intent.get("asset_set_sha256") != canonical_json_sha256(assets):
            errors.append("publication asset-set digest is invalid")
    gates = intent.get("local_gates")
    gate_fields = (
        "source_clean", "source_commit_verified", "qa_passed", "package_a_sha256",
        "package_b_sha256", "byte_identical", "validate_release_passed",
    )
    if not exact_keys(gates, gate_fields) or not isinstance(gates, dict) or any(
        gates.get(key) is not True
        for key in ("source_clean", "source_commit_verified", "qa_passed", "byte_identical", "validate_release_passed")
    ) or any(re.fullmatch(r"[0-9a-f]{64}", str(gates.get(key, ""))) is None for key in ("package_a_sha256", "package_b_sha256")) or (
        isinstance(gates, dict)
        and gates.get("package_a_sha256") != gates.get("package_b_sha256")
    ):
        errors.append("publication local gates are incomplete")
    snapshot = intent.get("remote_snapshot")
    snapshot_fields = ("observed_at", "main_oid", "tag_state", "tag_oid", "release_state", "release_id", "asset_set")
    if not exact_keys(snapshot, snapshot_fields) or not isinstance(snapshot, dict) or (
        not is_iso8601(snapshot.get("observed_at"))
        or re.fullmatch(r"[0-9a-f]{40}", str(snapshot.get("main_oid", ""))) is None
        or snapshot.get("tag_state") not in ("absent", "present")
        or snapshot.get("release_state") not in ("absent", "present")
        or (snapshot.get("tag_oid") is None) != (snapshot.get("tag_state") == "absent")
        or (snapshot.get("release_id") is None) != (snapshot.get("release_state") == "absent")
        or (
            snapshot.get("tag_oid") is not None
            and re.fullmatch(r"[0-9a-f]{40}", str(snapshot.get("tag_oid"))) is None
        )
        or (
            snapshot.get("release_id") is not None
            and (isinstance(snapshot.get("release_id"), bool) or not isinstance(snapshot.get("release_id"), int))
        )
        or (
            isinstance(main, dict)
            and snapshot.get("main_oid") not in (main.get("expected_old_oid"), main.get("target_oid"))
        )
        or not isinstance(snapshot.get("asset_set"), list)
    ):
        errors.append("publication remote snapshot is invalid")
    elif isinstance(snapshot, dict):
        observed_names = []
        for item in snapshot["asset_set"]:
            if not exact_keys(item, ("name", "size", "sha256", "id", "download_url")):
                errors.append("publication remote asset observation shape is invalid")
                continue
            observed_names.append(item.get("name"))
            if (
                not isinstance(item.get("name"), str)
                or not archive_name_is_safe(item["name"])
                or isinstance(item.get("size"), bool)
                or not isinstance(item.get("size"), int)
                or item["size"] < 0
                or (
                    item.get("sha256") is not None
                    and re.fullmatch(r"[0-9a-f]{64}", str(item.get("sha256"))) is None
                )
                or (item.get("id") is not None and (
                    isinstance(item.get("id"), bool) or not isinstance(item.get("id"), int)
                ))
                or (item.get("download_url") is not None and not isinstance(item.get("download_url"), str))
            ):
                errors.append("publication remote asset observation is invalid")
        if len(observed_names) != len(set(observed_names)):
            errors.append("publication remote asset observations contain duplicates")
        expected_asset_names = {
            item.get("name") for item in assets if isinstance(item, dict)
        } if isinstance(assets, list) else set()
        if not set(observed_names).issubset(expected_asset_names):
            errors.append("publication remote snapshot contains an unauthorized asset")
    operations = intent.get("operations")
    publish_operation_kinds = list(PUBLICATION_ALLOWED_OPERATIONS[:-1])
    if not isinstance(operations, list) or len(operations) != len(publish_operation_kinds):
        errors.append("publication operation graph is missing")
    else:
        for index, item in enumerate(operations):
            if not exact_keys(item, ("sequence", "operation_id", "kind", "natural_key", "expected_precondition", "max_write_attempts")):
                errors.append("publication operation shape is invalid")
                continue
            if (
                item.get("sequence") != index
                or item.get("kind") != publish_operation_kinds[index]
                or item.get("max_write_attempts") != 2
                or not isinstance(item.get("operation_id"), str)
                or not item.get("operation_id")
                or not isinstance(item.get("natural_key"), str)
                or not item.get("natural_key")
            ):
                errors.append("publication operation ordering/policy is invalid")
            precondition = item.get("expected_precondition")
            if (
                not exact_keys(precondition, ("kind", "identity_sha256"))
                or not isinstance(precondition.get("kind"), str)
                or not precondition.get("kind")
                or re.fullmatch(r"[0-9a-f]{64}", str(precondition.get("identity_sha256", ""))) is None
            ):
                errors.append("publication operation precondition is invalid")
    scope = intent.get("authorization_scope")
    if not exact_keys(scope, ("repository", "version", "release_kind", "allowed_operations", "destructive_operations_allowed")) or not isinstance(scope, dict) or scope != {
        "repository": "mintgao/vibe-kit", "version": "0.7.0", "release_kind": "prerelease",
        "allowed_operations": list(PUBLICATION_ALLOWED_OPERATIONS),
        "destructive_operations_allowed": False,
    }:
        errors.append("publication authorization scope is invalid")
    if intent.get("issue_closeout_policy") != {
        "issues": [1, 2, 3, 4, 5], "requires_public_verification": True,
        "requires_separate_closeout_intent": True,
        "requires_separate_closeout_authorization": True,
    }:
        errors.append("publication issue closeout policy is invalid")
    if intent.get("recovery_policy") != {
        "read_back_before_retry": True, "delete": False, "replace": False, "force": False,
    }:
        errors.append("publication recovery policy is invalid")
    return errors


def closeout_id(parent_intent_sha256: str) -> str:
    return canonical_json_sha256({
        "schema_version": ISSUE_CLOSEOUT_INTENT_SCHEMA,
        "repository": "mintgao/vibe-kit", "version": "0.7.0",
        "parent_publication_intent_sha256": parent_intent_sha256,
        "issues": [1, 2, 3, 4, 5],
    })


def build_closeout_intent(request: Dict[str, object]) -> Tuple[Dict[str, object], Dict[str, str]]:
    fields = (
        "parent_publication_intent_sha256", "publication_receipt_sha256",
        "verification_receipt_sha256", "repository", "issues", "remote_snapshot",
        "operations", "authorization_scope",
    )
    if not exact_keys(request, fields):
        raise VibeError("issue closeout request fields are unknown or incomplete")
    for key in fields[:3]:
        if re.fullmatch(r"[0-9a-f]{64}", str(request.get(key, ""))) is None:
            raise VibeError("issue closeout receipt binding is invalid")
    if request.get("parent_publication_intent_sha256") != V070_PUBLISHED_INTENT_SHA256:
        raise VibeError(
            "issue closeout parent must equal the exact published v0.7.0 publication intent"
        )
    if request.get("repository") != {"owner": "mintgao", "name": "vibe-kit", "canonical_url": "https://github.com/mintgao/vibe-kit"}:
        raise VibeError("issue closeout repository identity is invalid")
    inputs = request.get("issues")
    if not isinstance(inputs, list) or [item.get("issue_number") for item in inputs if isinstance(item, dict)] != [1, 2, 3, 4, 5]:
        raise VibeError("issue closeout requires exactly issues 1 through 5")
    identifier = closeout_id(str(request["parent_publication_intent_sha256"]))
    issues = []
    bodies: Dict[str, str] = {}
    issue_inputs: Dict[int, Dict[str, object]] = {}
    for item in inputs:
        if not exact_keys(item, (
            "issue_number", "comment_body", "observed_state",
            "observed_matching_comment_id", "criterion_evidence_sha256",
        )):
            raise VibeError("issue closeout item fields are invalid")
        number = item["issue_number"]
        if isinstance(number, bool) or not isinstance(number, int):
            raise VibeError("issue closeout issue number must be an integer")
        marker = f"<!-- vibe-kit:v0.7.0:issue-{number}:{identifier} -->"
        body = item["comment_body"]
        if not isinstance(body, str) or body.count(marker) != 1 or "\r" in body:
            raise VibeError(f"issue {number} comment must contain its exact stable marker")
        if item["observed_state"] not in ("open", "closed"):
            raise VibeError("issue closeout observed state is invalid")
        observed_comment_id = item["observed_matching_comment_id"]
        if observed_comment_id is not None and (
            isinstance(observed_comment_id, bool)
            or not isinstance(observed_comment_id, int)
            or observed_comment_id <= 0
        ):
            raise VibeError("issue closeout observed comment ID is invalid")
        if re.fullmatch(r"[0-9a-f]{64}", str(item["criterion_evidence_sha256"])) is None:
            raise VibeError("issue closeout criterion evidence is invalid")
        bodies[str(number)] = body
        issue_inputs[number] = item
        issues.append({
            "issue_number": number, "marker": marker,
            "comment_body_sha256": sha256_text(body),
            "observed_state": item["observed_state"],
            "observed_matching_comment_id": item["observed_matching_comment_id"],
            "desired_state": "closed",
            "criterion_evidence_sha256": item["criterion_evidence_sha256"],
        })
    snapshot = request.get("remote_snapshot")
    if not exact_keys(snapshot, ("observed_at", "issues")) or not isinstance(snapshot, dict):
        raise VibeError("issue closeout remote snapshot shape is invalid")
    if not is_iso8601(snapshot.get("observed_at")):
        raise VibeError("issue closeout remote snapshot timestamp is invalid")
    snapshot_issues = snapshot.get("issues")
    if not isinstance(snapshot_issues, list) or [
        item.get("issue_number") for item in snapshot_issues if isinstance(item, dict)
    ] != [1, 2, 3, 4, 5]:
        raise VibeError("issue closeout snapshot requires exactly issues 1 through 5")
    for snapshot_item in snapshot_issues:
        if not exact_keys(
            snapshot_item,
            (
                "issue_number", "state", "marker_state", "matching_comment_id",
                "matching_comment_body_sha256",
            ),
        ):
            raise VibeError("issue closeout snapshot item shape is invalid")
        number = snapshot_item["issue_number"]
        if isinstance(number, bool) or not isinstance(number, int) or number not in issue_inputs:
            raise VibeError("issue closeout snapshot issue number is invalid")
        issue_input = issue_inputs[number]
        marker_state = snapshot_item["marker_state"]
        state = snapshot_item["state"]
        comment_id = snapshot_item["matching_comment_id"]
        body_hash = snapshot_item["matching_comment_body_sha256"]
        expected_body_hash = sha256_text(str(issue_input["comment_body"]))
        if state not in ("open", "closed") or marker_state not in ("absent", "exact"):
            raise VibeError("issue closeout snapshot state is invalid")
        if marker_state == "absent":
            if comment_id is not None or body_hash is not None or state == "closed":
                raise VibeError("issue closeout snapshot is not a safe monotonic state")
        elif (
            isinstance(comment_id, bool)
            or not isinstance(comment_id, int)
            or comment_id <= 0
            or body_hash != expected_body_hash
        ):
            raise VibeError("issue closeout exact marker observation is invalid")
        if (
            issue_input["observed_state"] != state
            or issue_input["observed_matching_comment_id"] != comment_id
        ):
            raise VibeError("issue closeout snapshot disagrees with issue observation")
    expected_operations = []
    for number, snapshot_item in enumerate(snapshot_issues, start=1):
        snapshot_sha = canonical_json_sha256(snapshot_item)
        for offset, kind in enumerate(("create-exact-evidence-comment", "close-issue")):
            sequence = 2 * (number - 1) + offset
            comment = kind == "create-exact-evidence-comment"
            expected_operations.append({
                "sequence": sequence,
                "operation_id": f"issue-{number}-{'comment' if comment else 'close'}",
                "issue_number": number,
                "kind": kind,
                "natural_key": (
                    f"issue:{number}:marker:{identifier}"
                    if comment else f"issue:{number}:state:closed"
                ),
                "expected_precondition": {
                    "kind": "issue-closeout-monotonic-resume",
                    "initial_snapshot_sha256": snapshot_sha,
                    "allowed_observations": (
                        ["open-absent", "open-exact", "closed-exact"]
                        if comment else ["open-exact", "closed-exact"]
                    ),
                },
                "max_write_attempts": 2,
            })
    if request.get("operations") != expected_operations:
        raise VibeError("issue closeout operations are not the exact ordered ten-operation graph")
    expected_scope = {
        "repository": "mintgao/vibe-kit",
        "issues": [1, 2, 3, 4, 5],
        "allowed_operations": ["create-exact-evidence-comment", "close-issue"],
        "destructive_operations_allowed": False,
        "requires_separate_closeout_authorization": True,
    }
    if request.get("authorization_scope") != expected_scope:
        raise VibeError("issue closeout declarative authorization scope is invalid")
    intent = {
        "schema_version": ISSUE_CLOSEOUT_INTENT_SCHEMA,
        "kind": "vibe-kit-issue-closeout", "closeout_id": identifier,
        "parent_publication_intent_sha256": request["parent_publication_intent_sha256"],
        "publication_receipt_sha256": request["publication_receipt_sha256"],
        "verification_receipt_sha256": request["verification_receipt_sha256"],
        "repository": request["repository"], "issues": issues,
        "remote_snapshot": request["remote_snapshot"],
        "operations": request["operations"],
        "authorization_scope": request["authorization_scope"],
    }
    return intent, bodies


def validate_closeout_authorization(
    value: object, intent: Dict[str, object]
) -> List[str]:
    fields = (
        "closeout_authorization_id", "repository", "issues",
        "allowed_operations", "closeout_intent_sha256",
        "destructive_operations_allowed",
    )
    if not exact_keys(value, fields) or not isinstance(value, dict):
        return ["closeout authorization fields are unknown or incomplete"]
    errors: List[str] = []
    if (
        not isinstance(value.get("closeout_authorization_id"), str)
        or not value.get("closeout_authorization_id")
        or len(value["closeout_authorization_id"]) > 256
    ):
        errors.append("closeout authorization identity is invalid")
    scope = intent.get("authorization_scope")
    if not isinstance(scope, dict) or any(
        value.get(key) != scope.get(key)
        for key in ("repository", "issues", "allowed_operations", "destructive_operations_allowed")
    ):
        errors.append("closeout authorization scope does not equal the intent")
    if value.get("closeout_intent_sha256") != canonical_json_sha256(intent):
        errors.append("closeout authorization does not bind the exact intent")
    return errors


def publication_repository() -> Dict[str, str]:
    return {
        "owner": "mintgao",
        "name": "vibe-kit",
        "canonical_url": "https://github.com/mintgao/vibe-kit",
    }


def valid_publication_error(value: object) -> bool:
    return exact_keys(value, ("code", "message", "next_action")) and all(
        isinstance(value.get(key), str) and bool(value.get(key)) and len(value[key]) <= 512
        for key in ("code", "message", "next_action")
    )


def valid_sha256(value: object) -> bool:
    return isinstance(value, str) and re.fullmatch(r"[0-9a-f]{64}", value) is not None


def valid_oid(value: object) -> bool:
    return isinstance(value, str) and re.fullmatch(r"[0-9a-f]{40}", value) is not None


def valid_positive_int(value: object) -> bool:
    return not isinstance(value, bool) and isinstance(value, int) and value > 0


def validate_canonical_command(value: object) -> List[str]:
    fields = (
        "sequence", "command_id", "argv", "exit_code", "status", "result",
        "result_sha256",
    )
    if not exact_keys(value, fields) or not isinstance(value, dict):
        return ["canonical command fields are unknown or incomplete"]
    errors: List[str] = []
    if (
        isinstance(value.get("sequence"), bool)
        or not isinstance(value.get("sequence"), int)
        or value["sequence"] < 0
        or not isinstance(value.get("command_id"), str)
        or not value["command_id"]
        or len(value["command_id"]) > 128
        or not isinstance(value.get("argv"), list)
        or not value["argv"]
        or any(not isinstance(arg, str) or not arg or len(arg) > 512 for arg in value["argv"])
        or any(arg.startswith("/") for arg in value["argv"])
        or value.get("status") not in ("passed", "failed", "blocked", "error")
    ):
        errors.append("canonical command identity is invalid")
    result = value.get("result")
    if not exact_keys(result, ("status", "passed_count", "failed_count", "skipped_count")):
        errors.append("canonical command result shape is invalid")
    elif (
        result.get("status") not in ("passed", "failed", "blocked", "error")
        or any(
            isinstance(result.get(key), bool)
            or not isinstance(result.get(key), int)
            or result[key] < 0
            for key in ("passed_count", "failed_count", "skipped_count")
        )
        or value.get("result_sha256") != canonical_json_sha256(result)
    ):
        errors.append("canonical command result is invalid")
    exit_code = value.get("exit_code")
    if exit_code is not None and (isinstance(exit_code, bool) or not isinstance(exit_code, int)):
        errors.append("canonical command exit code is invalid")
    if value.get("status") == "passed" and (
        exit_code != 0
        or not isinstance(result, dict)
        or result.get("status") != "passed"
        or result.get("failed_count") != 0
    ):
        errors.append("passed canonical command does not contain passing evidence")
    if value.get("status") in ("failed", "passed") and exit_code is None:
        errors.append("started canonical command requires an exit code")
    if value.get("status") in ("blocked", "error") and exit_code is not None:
        errors.append("pre-start blocked/error command requires a null exit code")
    return errors


def valid_receipt_header(
    value: Dict[str, object], kind: str, source_commit: str, source_tree_oid: str
) -> bool:
    return (
        value.get("schema_version") == 1
        and value.get("kind") == kind
        and value.get("repository") == "mintgao/vibe-kit"
        and value.get("version") == "0.8.0"
        and value.get("profile") == V080_PUBLICATION_PROFILE
        and value.get("source_commit") == source_commit
        and value.get("source_tree_oid") == source_tree_oid
    )


def validate_receipt_times(value: Dict[str, object]) -> bool:
    if not is_iso8601(value.get("started_at")) or not is_iso8601(value.get("finished_at")):
        return False
    try:
        started = dt.datetime.fromisoformat(str(value["started_at"]).replace("Z", "+00:00"))
        finished = dt.datetime.fromisoformat(str(value["finished_at"]).replace("Z", "+00:00"))
    except ValueError:
        return False
    return finished >= started


def validate_python_identity(value: object) -> bool:
    return exact_keys(
        value,
        ("implementation", "major", "minor", "patch", "platform", "executable_name"),
    ) and (
        value.get("implementation") == "CPython"
        and value.get("major") == 3
        and value.get("minor") == 9
        and not isinstance(value.get("patch"), bool)
        and isinstance(value.get("patch"), int)
        and value["patch"] >= 0
        and isinstance(value.get("platform"), str)
        and bool(value["platform"])
        and len(value["platform"]) <= 256
        and isinstance(value.get("executable_name"), str)
        and bool(value["executable_name"])
        and len(value["executable_name"]) <= 128
    )


def validate_v080_qa_receipt(
    value: object, source_commit: str, source_tree_oid: str
) -> List[str]:
    fields = (
        "schema_version", "kind", "execution_id", "executor_role", "started_at",
        "finished_at", "repository", "version", "profile", "source_commit",
        "source_tree_oid", "asset_set_sha256", "commands", "criterion_mapping",
        "status", "error",
    )
    if not exact_keys(value, fields) or not isinstance(value, dict):
        return ["prepublication QA receipt fields are unknown or incomplete"]
    errors: List[str] = []
    if not valid_receipt_header(value, "vibe-kit-v0.8-prepublication-qa", source_commit, source_tree_oid):
        errors.append("prepublication QA receipt identity is invalid")
    if value.get("executor_role") != "independent-qa" or not validate_receipt_times(value):
        errors.append("prepublication QA execution evidence is invalid")
    commands = value.get("commands")
    if not isinstance(commands, list) or not commands:
        errors.append("prepublication QA commands are missing")
        commands = []
    for index, command in enumerate(commands):
        command_errors = validate_canonical_command(command)
        if command_errors or command.get("sequence") != index:
            errors.append("prepublication QA command is invalid")
    criteria = value.get("criterion_mapping")
    required_post = {
        "AC-1": "none", "AC-2": "offline-publication-validation",
        "AC-3": "none", "AC-4": "public-download", "AC-5": "live-read-back",
        "AC-6": "offline-publication-validation", "AC-7": "live-read-back",
        "AC-8": "live-read-back", "AC-9": "public-smoke", "AC-10": "none",
        "AC-11": "live-read-back", "AC-12": "final-claim-gate",
    }
    if not isinstance(criteria, list) or len(criteria) != 12:
        errors.append("prepublication QA criterion mapping is incomplete")
    else:
        for index, item in enumerate(criteria, start=1):
            criterion = f"AC-{index}"
            if not exact_keys(
                item,
                ("criterion_id", "state", "evidence_command_sequences", "postpublication_requirement"),
            ):
                errors.append("prepublication QA criterion fields are invalid")
                continue
            sequences = item.get("evidence_command_sequences")
            if (
                item.get("criterion_id") != criterion
                or item.get("state") != V080_PREPUBLICATION_STATES[criterion]
                or item.get("postpublication_requirement") != required_post[criterion]
                or not isinstance(sequences, list)
                or any(isinstance(seq, bool) or not isinstance(seq, int) for seq in sequences)
                or sequences != sorted(set(sequences))
                or any(seq < 0 or seq >= len(commands) for seq in sequences)
                or (not sequences and item.get("state") != "not-runnable-before-publication")
            ):
                errors.append(f"prepublication QA mapping is invalid for {criterion}")
    if value.get("status") != "passed" or value.get("error") is not None:
        errors.append("prepublication QA receipt did not pass")
    if any(command.get("status") != "passed" for command in commands if isinstance(command, dict)):
        errors.append("prepublication QA receipt contains a non-passing command")
    return errors


def validate_v080_configured_receipt(
    value: object, source_commit: str, source_tree_oid: str
) -> List[str]:
    fields = (
        "schema_version", "kind", "execution_id", "executor_role", "started_at",
        "finished_at", "repository", "version", "profile", "source_commit",
        "source_tree_oid", "commands", "checks", "status", "error",
    )
    if not exact_keys(value, fields) or not isinstance(value, dict):
        return ["configured-check receipt fields are unknown or incomplete"]
    errors: List[str] = []
    if not valid_receipt_header(value, "vibe-kit-v0.8-configured-checks", source_commit, source_tree_oid):
        errors.append("configured-check receipt identity is invalid")
    if not isinstance(value.get("executor_role"), str) or not value.get("executor_role") or not validate_receipt_times(value):
        errors.append("configured-check execution evidence is invalid")
    commands = value.get("commands")
    if not isinstance(commands, list) or len(commands) != 1:
        errors.append("configured-check receipt requires one command")
    else:
        errors.extend(validate_canonical_command(commands[0]))
        if commands[0].get("sequence") != 0 or commands[0].get("argv") != [
            "./bin/vibe", "verify", ".", "--format", "json"
        ]:
            errors.append("configured-check command is not canonical")
    checks = value.get("checks")
    if not isinstance(checks, list) or [item.get("name") for item in checks if isinstance(item, dict)] != list(VERIFY_ORDER):
        errors.append("configured-check items are not the exact ordered matrix")
        checks = []
    for item in checks:
        if not exact_keys(item, ("name", "configured", "status", "exit_code", "result_sha256")):
            errors.append("configured-check item fields are invalid")
            continue
        configured = item.get("configured")
        status = item.get("status")
        exit_code = item.get("exit_code")
        result_sha = item.get("result_sha256")
        if not isinstance(configured, bool) or status not in (
            "passed", "failed", "not-configured", "blocked", "error"
        ):
            errors.append("configured-check item value is invalid")
        elif not configured and (status != "not-configured" or exit_code is not None or result_sha is not None):
            errors.append("unconfigured check nullability is invalid")
        elif configured and status == "passed" and (exit_code != 0 or not valid_sha256(result_sha)):
            errors.append("passing configured check evidence is invalid")
        elif configured and status in ("failed", "error") and (
            isinstance(exit_code, bool) or not isinstance(exit_code, int) or not valid_sha256(result_sha)
        ):
            errors.append("started configured check evidence is invalid")
        elif configured and status == "blocked" and (exit_code is not None or result_sha is not None):
            errors.append("blocked configured check nullability is invalid")
    if value.get("status") != "passed" or value.get("error") is not None or any(
        item.get("status") not in ("passed", "not-configured") for item in checks
    ):
        errors.append("configured-check receipt did not pass")
    return errors


def validate_v080_python_receipt(
    value: object, source_commit: str, source_tree_oid: str
) -> List[str]:
    fields = (
        "schema_version", "kind", "execution_id", "executor_role", "started_at",
        "finished_at", "repository", "version", "profile", "source_commit",
        "source_tree_oid", "interpreter", "commands", "status", "error",
    )
    if not exact_keys(value, fields) or not isinstance(value, dict):
        return ["Python 3.9 receipt fields are unknown or incomplete"]
    errors: List[str] = []
    if not valid_receipt_header(value, "vibe-kit-v0.8-python-3.9", source_commit, source_tree_oid):
        errors.append("Python 3.9 receipt identity is invalid")
    if not validate_python_identity(value.get("interpreter")) or not validate_receipt_times(value):
        errors.append("Python 3.9 execution evidence is invalid")
    command_ids = [
        "python39-default-verify", "python39-publication-focused-tests",
        "python39-package-a", "python39-validate-release-a", "python39-package-b",
        "python39-validate-release-b",
    ]
    commands = value.get("commands")
    if not isinstance(commands, list) or [item.get("command_id") for item in commands if isinstance(item, dict)] != command_ids:
        errors.append("Python 3.9 command set is invalid")
        commands = []
    for index, command in enumerate(commands):
        if validate_canonical_command(command) or command.get("sequence") != index or command.get("status") != "passed":
            errors.append("Python 3.9 command evidence is invalid")
    if value.get("status") != "passed" or value.get("error") is not None:
        errors.append("Python 3.9 receipt did not pass")
    return errors


def validate_v080_build_receipt(
    value: object, source_commit: str, source_tree_oid: str, build_id: str
) -> List[str]:
    fields = (
        "schema_version", "kind", "execution_id", "executor_role", "started_at",
        "finished_at", "repository", "version", "profile", "source_commit",
        "source_tree_oid", "build_id", "checkout_id", "output_id", "source_clean",
        "interpreter", "package_command", "assets", "asset_set_sha256",
        "validate_release_command", "validate_release_result_sha256", "status", "error",
    )
    if not exact_keys(value, fields) or not isinstance(value, dict):
        return [f"clean-build {build_id} receipt fields are unknown or incomplete"]
    errors: List[str] = []
    if not valid_receipt_header(value, "vibe-kit-v0.8-clean-build", source_commit, source_tree_oid):
        errors.append(f"clean-build {build_id} identity is invalid")
    if (
        value.get("executor_role") != "release-build-host"
        or value.get("build_id") != build_id
        or value.get("source_clean") is not True
        or not validate_receipt_times(value)
        or not validate_python_identity(value.get("interpreter"))
        or any(
            not isinstance(value.get(key), str) or not value.get(key) or len(value[key]) > 256
            for key in ("execution_id", "checkout_id", "output_id")
        )
    ):
        errors.append(f"clean-build {build_id} execution evidence is invalid")
    for field in ("package_command", "validate_release_command"):
        command = value.get(field)
        if validate_canonical_command(command) or not isinstance(command, dict) or command.get("status") != "passed":
            errors.append(f"clean-build {build_id} {field} is invalid")
    assets = value.get("assets")
    expected_names_roles = {
        "SHA256SUMS": "checksum",
        "release-manifest.json": "manifest",
        "vibe-kit-0.8.0.zip": "direct",
        "vibe-kit-distribution-0.8.0.zip": "distribution",
        "vibe-kit-plugin-0.8.0.zip": "plugin",
    }
    if (
        not isinstance(assets, list)
        or len(assets) != 5
        or assets != sorted(assets, key=lambda item: str(item.get("name", "")).encode("utf-8") if isinstance(item, dict) else b"")
    ):
        errors.append(f"clean-build {build_id} asset set is invalid")
    else:
        for item in assets:
            if (
                not exact_keys(item, ("name", "role", "size", "sha256"))
                or expected_names_roles.get(item.get("name")) != item.get("role")
                or isinstance(item.get("size"), bool)
                or not isinstance(item.get("size"), int)
                or item["size"] < 0
                or not valid_sha256(item.get("sha256"))
            ):
                errors.append(f"clean-build {build_id} asset identity is invalid")
        if value.get("asset_set_sha256") != canonical_json_sha256(assets):
            errors.append(f"clean-build {build_id} asset-set digest is invalid")
    if not valid_sha256(value.get("validate_release_result_sha256")):
        errors.append(f"clean-build {build_id} validation digest is invalid")
    if value.get("status") != "passed" or value.get("error") is not None:
        errors.append(f"clean-build {build_id} did not pass")
    return errors


def validate_v080_release_gate_bundle(
    value: object, source_commit: str
) -> Tuple[List[str], Optional[str], Optional[List[Dict[str, object]]]]:
    fields = (
        "schema_version", "kind", "repository", "version", "profile",
        "source_commit", "source_tree_oid", "generated_at", "qa",
        "configured_checks", "python_3_9", "builds", "receipt_sha256s",
    )
    if not exact_keys(value, fields) or not isinstance(value, dict):
        return ["release-gate bundle fields are unknown or incomplete"], None, None
    errors: List[str] = []
    tree = value.get("source_tree_oid")
    if (
        value.get("schema_version") != 1
        or value.get("kind") != "vibe-kit-v0.8-release-gate-evidence"
        or value.get("repository") != "mintgao/vibe-kit"
        or value.get("version") != "0.8.0"
        or value.get("profile") != V080_PUBLICATION_PROFILE
        or value.get("source_commit") != source_commit
        or not valid_oid(tree)
        or not is_iso8601(value.get("generated_at"))
    ):
        errors.append("release-gate bundle identity is invalid")
    if not isinstance(tree, str):
        tree = ""
    qa = value.get("qa")
    configured = value.get("configured_checks")
    python_receipt = value.get("python_3_9")
    builds = value.get("builds")
    errors.extend(validate_v080_qa_receipt(qa, source_commit, tree))
    errors.extend(validate_v080_configured_receipt(configured, source_commit, tree))
    errors.extend(validate_v080_python_receipt(python_receipt, source_commit, tree))
    if not isinstance(builds, list) or len(builds) != 2:
        errors.append("release-gate bundle requires builds A and B")
        builds = []
    else:
        errors.extend(validate_v080_build_receipt(builds[0], source_commit, tree, "A"))
        errors.extend(validate_v080_build_receipt(builds[1], source_commit, tree, "B"))
        if all(isinstance(item, dict) for item in builds):
            if any(
                builds[0].get(field) == builds[1].get(field)
                for field in ("execution_id", "checkout_id", "output_id")
            ):
                errors.append("clean builds A and B do not have distinct execution identities")
            if builds[0].get("assets") != builds[1].get("assets") or builds[0].get("asset_set_sha256") != builds[1].get("asset_set_sha256"):
                errors.append("clean builds A and B are not byte-identical")
    digest_map = value.get("receipt_sha256s")
    if not exact_keys(digest_map, ("qa", "configured_checks", "python_3_9", "build_a", "build_b")):
        errors.append("release-gate receipt digest map is invalid")
    else:
        children = {
            "qa": qa,
            "configured_checks": configured,
            "python_3_9": python_receipt,
            "build_a": builds[0] if len(builds) == 2 else None,
            "build_b": builds[1] if len(builds) == 2 else None,
        }
        for key, child in children.items():
            if digest_map.get(key) != canonical_json_sha256(child):
                errors.append(f"release-gate child digest is invalid: {key}")
    assets = builds[0].get("assets") if len(builds) == 2 and isinstance(builds[0], dict) else None
    return errors, tree or None, assets if isinstance(assets, list) else None


def validate_v080_authorization(value: object, intent: Dict[str, object]) -> List[str]:
    fields = (
        "authorization_id", "repository", "version", "release_kind",
        "allowed_operations", "publication_intent_sha256", "host_operation_id",
    )
    if not exact_keys(value, fields) or not isinstance(value, dict):
        return ["publication authorization fields are unknown or incomplete"]
    errors: List[str] = []
    if any(
        not isinstance(value.get(key), str) or not value.get(key) or len(value[key]) > 256
        for key in ("authorization_id", "host_operation_id")
    ):
        errors.append("publication authorization identity is invalid")
    expected = {
        "repository": "mintgao/vibe-kit",
        "version": "0.8.0",
        "release_kind": "prerelease",
        "allowed_operations": list(V080_PUBLICATION_ALLOWED_OPERATIONS),
        "publication_intent_sha256": canonical_json_sha256(intent),
    }
    if any(value.get(key) != expected[key] for key in expected):
        errors.append("publication authorization does not bind the exact intent and scope")
    return errors


def validate_v080_postpublication_acceptance(
    value: object,
    intent: Dict[str, object],
    authorization: Dict[str, object],
    source_tree_oid: str,
) -> List[str]:
    fields = (
        "schema_version", "kind", "execution_id", "executor_role", "started_at",
        "finished_at", "repository", "version", "profile", "source_commit",
        "source_tree_oid", "publication_intent_sha256", "authorization_id",
        "host_operation_id", "validate_publication_result_sha256", "criteria",
        "status", "error",
    )
    if not exact_keys(value, fields) or not isinstance(value, dict):
        return ["postpublication acceptance fields are unknown or incomplete"]
    errors: List[str] = []
    if (
        not valid_receipt_header(
            value, "vibe-kit-v0.8-postpublication-acceptance",
            str(intent.get("source_commit", "")), source_tree_oid,
        )
        or value.get("executor_role") != "independent-qa"
        or not validate_receipt_times(value)
        or value.get("publication_intent_sha256") != canonical_json_sha256(intent)
        or value.get("authorization_id") != authorization.get("authorization_id")
        or value.get("host_operation_id") != authorization.get("host_operation_id")
        or not valid_sha256(value.get("validate_publication_result_sha256"))
    ):
        errors.append("postpublication acceptance identity is invalid")
    criteria = value.get("criteria")
    allowed_kinds = {
        "local-gate-receipt", "publication-receipt", "live-read-back",
        "public-download", "public-smoke", "validate-publication",
    }
    if not isinstance(criteria, list) or len(criteria) != 12:
        errors.append("postpublication acceptance criteria are incomplete")
        criteria = []
    for index, item in enumerate(criteria, start=1):
        if not exact_keys(item, ("criterion_id", "state", "evidence_refs")) or (
            item.get("criterion_id") != f"AC-{index}"
            or item.get("state") not in ("passed", "failed", "blocked")
            or not isinstance(item.get("evidence_refs"), list)
            or not item.get("evidence_refs")
        ):
            errors.append(f"postpublication acceptance criterion AC-{index} is invalid")
            continue
        for reference in item["evidence_refs"]:
            if (
                not exact_keys(reference, ("kind", "sha256"))
                or reference.get("kind") not in allowed_kinds
                or not valid_sha256(reference.get("sha256"))
            ):
                errors.append(f"postpublication acceptance evidence for AC-{index} is invalid")
    if value.get("status") == "passed":
        if value.get("error") is not None or any(item.get("state") != "passed" for item in criteria):
            errors.append("passed postpublication acceptance does not contain twelve passes")
    elif value.get("status") not in ("failed", "blocked") or not valid_publication_error(value.get("error")):
        errors.append("non-passing postpublication acceptance lacks one next action")
    return errors


def v080_operation_initial_observation(
    snapshot: Dict[str, object], kind: str
) -> object:
    if kind == "fast-forward-main":
        return snapshot.get("main")
    if kind == "create-or-confirm-annotated-tag":
        return snapshot.get("tag")
    if kind == "create-or-confirm-prerelease":
        return snapshot.get("release")
    if kind == "upload-or-confirm-five-assets":
        return snapshot.get("assets")
    return snapshot


def v080_operation_identity(
    kind: str, natural_key: str, snapshot_sha: str, initial: object
) -> Dict[str, object]:
    return {
        "schema_version": 2,
        "profile": V080_PUBLICATION_PROFILE,
        "operation_kind": kind,
        "natural_key": natural_key,
        "remote_snapshot_sha256": snapshot_sha,
        "initial_observation": initial,
    }


def validate_v080_remote_snapshot(
    snapshot: object, intent: Dict[str, object]
) -> List[str]:
    fields = ("observed_at", "main", "tag", "release", "asset_list_complete", "assets")
    if not exact_keys(snapshot, fields) or not isinstance(snapshot, dict):
        return ["schema-2 remote snapshot fields are unknown or incomplete"]
    errors: List[str] = []
    main = snapshot.get("main")
    intent_main = intent.get("main") if isinstance(intent.get("main"), dict) else {}
    if (
        not is_iso8601(snapshot.get("observed_at"))
        or not exact_keys(main, ("branch", "observed_oid"))
        or main.get("branch") != "main"
        or not valid_oid(main.get("observed_oid"))
        or main.get("observed_oid") not in (intent_main.get("expected_old_oid"), intent_main.get("target_oid"))
    ):
        errors.append("schema-2 remote main snapshot is invalid")
    tag = snapshot.get("tag")
    tag_fields = (
        "state", "ref_oid", "object_type", "tag_object_oid", "peeled_commit",
        "tagger_name", "tagger_email", "tagger_timestamp", "tagger_timezone",
        "message_sha256",
    )
    intent_tag = intent.get("tag") if isinstance(intent.get("tag"), dict) else {}
    if not exact_keys(tag, tag_fields) or tag.get("state") not in ("absent", "present"):
        errors.append("schema-2 remote tag snapshot is invalid")
    elif tag.get("state") == "absent":
        if any(tag.get(key) is not None for key in tag_fields[1:]):
            errors.append("absent schema-2 tag snapshot has non-null identity")
    elif (
        not valid_oid(tag.get("ref_oid"))
        or tag.get("object_type") != "tag"
        or not valid_oid(tag.get("tag_object_oid"))
        or tag.get("ref_oid") != intent_tag.get("expected_tag_object_oid")
        or tag.get("tag_object_oid") != intent_tag.get("expected_tag_object_oid")
        or tag.get("peeled_commit") != intent.get("source_commit")
        or any(tag.get(key) != intent_tag.get(key) for key in (
            "tagger_name", "tagger_email", "tagger_timestamp", "tagger_timezone", "message_sha256"
        ))
    ):
        errors.append("present schema-2 tag snapshot diverges from the intent")
    release = snapshot.get("release")
    release_fields = (
        "state", "id", "url", "tag", "title", "body_sha256", "draft",
        "prerelease", "immutable",
    )
    intent_release = intent.get("release") if isinstance(intent.get("release"), dict) else {}
    if not exact_keys(release, release_fields) or release.get("state") not in ("absent", "present"):
        errors.append("schema-2 remote Release snapshot is invalid")
    elif release.get("state") == "absent":
        if any(release.get(key) is not None for key in release_fields[1:]):
            errors.append("absent schema-2 Release snapshot has non-null identity")
    elif (
        not valid_positive_int(release.get("id"))
        or release.get("url") != "https://github.com/mintgao/vibe-kit/releases/tag/v0.8.0"
        or release.get("tag") != "v0.8.0"
        or release.get("title") != intent_release.get("title")
        or release.get("body_sha256") != intent_release.get("body_sha256")
        or release.get("draft") is not False
        or release.get("prerelease") is not True
        or release.get("immutable") not in (True, False, "unknown")
    ):
        errors.append("present schema-2 Release snapshot diverges from the intent")
    assets = snapshot.get("assets")
    intended_assets = intent.get("assets") if isinstance(intent.get("assets"), list) else []
    intended = {item.get("name"): item for item in intended_assets if isinstance(item, dict)}
    if snapshot.get("asset_list_complete") is not True or not isinstance(assets, list):
        errors.append("schema-2 remote asset pagination is incomplete")
        assets = []
    elif assets != sorted(
        assets,
        key=lambda item: (
            str(item.get("name", "")).encode("utf-8"),
            item.get("id", 0) if isinstance(item, dict) else 0,
        ),
    ):
        errors.append("schema-2 remote assets are not in canonical order")
    seen_names = []
    for item in assets:
        if not exact_keys(item, ("id", "name", "size", "sha256", "download_url")):
            errors.append("schema-2 remote asset fields are invalid")
            continue
        seen_names.append(item.get("name"))
        expected = intended.get(item.get("name"))
        if (
            not valid_positive_int(item.get("id"))
            or not isinstance(item.get("name"), str)
            or not archive_name_is_safe(item["name"])
            or isinstance(item.get("size"), bool)
            or not isinstance(item.get("size"), int)
            or item["size"] < 0
            or not valid_sha256(item.get("sha256"))
            or item.get("download_url") != (
                f"https://github.com/mintgao/vibe-kit/releases/download/v0.8.0/{item.get('name')}"
            )
            or expected is None
            or item.get("size") != expected.get("size")
            or item.get("sha256") != expected.get("sha256")
        ):
            errors.append("schema-2 remote asset is unsafe, extra, or divergent")
    if len(seen_names) != len(set(seen_names)):
        errors.append("schema-2 remote assets contain duplicate names")
    if isinstance(release, dict) and release.get("state") == "absent" and assets:
        errors.append("absent schema-2 Release must have no assets")
    return errors


def validate_v080_intent(value: object) -> List[str]:
    fields = (
        "schema_version", "kind", "profile", "repository", "version",
        "source_commit", "main", "tag", "release", "assets", "asset_set_sha256",
        "local_gates", "remote_snapshot", "remote_snapshot_sha256", "operations",
        "authorization_scope", "issue_closeout_policy", "recovery_policy",
    )
    if not exact_keys(value, fields) or not isinstance(value, dict):
        return ["schema-2 publication intent fields are unknown or incomplete"]
    intent = value
    errors: List[str] = []
    if (
        intent.get("schema_version") != 2
        or intent.get("kind") != "vibe-kit-publication"
        or intent.get("profile") != V080_PUBLICATION_PROFILE
        or intent.get("repository") != publication_repository()
        or intent.get("version") != "0.8.0"
        or not valid_oid(intent.get("source_commit"))
    ):
        errors.append("schema-2 publication profile identity is invalid")
    main = intent.get("main")
    if (
        not exact_keys(main, ("branch", "expected_old_oid", "target_oid", "policy"))
        or main.get("branch") != "main"
        or not valid_oid(main.get("expected_old_oid"))
        or main.get("target_oid") != intent.get("source_commit")
        or main.get("policy") != "fast-forward-cas-only"
    ):
        errors.append("schema-2 publication main identity is invalid")
    tag = intent.get("tag")
    tag_fields = (
        "name", "object_type", "expected_tag_object_oid", "target_commit",
        "tagger_name", "tagger_email", "tagger_timestamp", "tagger_timezone",
        "message_sha256",
    )
    if (
        not exact_keys(tag, tag_fields)
        or tag.get("name") != "v0.8.0"
        or tag.get("object_type") != "tag"
        or not valid_oid(tag.get("expected_tag_object_oid"))
        or tag.get("target_commit") != intent.get("source_commit")
        or not isinstance(tag.get("tagger_name"), str)
        or not tag.get("tagger_name")
        or not isinstance(tag.get("tagger_email"), str)
        or not tag.get("tagger_email")
        or not is_iso8601(tag.get("tagger_timestamp"))
        or re.fullmatch(r"[+-][0-9]{4}", str(tag.get("tagger_timezone", ""))) is None
        or not valid_sha256(tag.get("message_sha256"))
    ):
        errors.append("schema-2 annotated-tag identity is invalid")
    release = intent.get("release")
    expected_release = {
        "title": "Vibe Kit v0.8.0",
        "body_sha256": release.get("body_sha256") if isinstance(release, dict) else None,
        "body_source_path": "docs/releases/0.8.0.md",
        "draft": False,
        "prerelease": True,
        "generated_notes": False,
        "platform_immutability_required": False,
    }
    if release != expected_release or not valid_sha256(expected_release["body_sha256"]):
        errors.append("schema-2 Release identity/state is invalid")
    assets = intent.get("assets")
    expected_names_roles = {
        "SHA256SUMS": "checksum", "release-manifest.json": "manifest",
        "vibe-kit-0.8.0.zip": "direct",
        "vibe-kit-distribution-0.8.0.zip": "distribution",
        "vibe-kit-plugin-0.8.0.zip": "plugin",
    }
    if not isinstance(assets, list) or len(assets) != 5 or assets != sorted(
        assets, key=lambda item: str(item.get("name", "")).encode("utf-8") if isinstance(item, dict) else b""
    ):
        errors.append("schema-2 publication assets are not the exact sorted five-asset set")
        assets = []
    else:
        for item in assets:
            if (
                not exact_keys(item, ("name", "role", "size", "sha256"))
                or expected_names_roles.get(item.get("name")) != item.get("role")
                or isinstance(item.get("size"), bool)
                or not isinstance(item.get("size"), int)
                or item["size"] < 0
                or not valid_sha256(item.get("sha256"))
            ):
                errors.append("schema-2 publication asset identity is invalid")
        if intent.get("asset_set_sha256") != canonical_json_sha256(assets):
            errors.append("schema-2 publication asset-set digest is invalid")
    gates = intent.get("local_gates")
    if not exact_keys(gates, ("release_gate_evidence_sha256",)) or not valid_sha256(gates.get("release_gate_evidence_sha256")):
        errors.append("schema-2 local gate binding is invalid")
    snapshot = intent.get("remote_snapshot")
    errors.extend(validate_v080_remote_snapshot(snapshot, intent))
    snapshot_sha = intent.get("remote_snapshot_sha256")
    if not valid_sha256(snapshot_sha) or snapshot_sha != canonical_json_sha256(snapshot):
        errors.append("schema-2 remote snapshot digest is invalid")
    operations = intent.get("operations")
    if not isinstance(operations, list) or len(operations) != 6:
        errors.append("schema-2 publication operation graph is invalid")
        operations = []
    for index, operation in enumerate(operations):
        fields = (
            "sequence", "operation_id", "kind", "natural_key",
            "expected_precondition", "max_write_attempts", "asset_operations",
        )
        kind = V080_PUBLICATION_ALLOWED_OPERATIONS[index]
        if not exact_keys(operation, fields):
            errors.append("schema-2 publication operation fields are invalid")
            continue
        natural_key = operation.get("natural_key")
        expected_attempts = 0 if index >= 4 else 2
        if (
            operation.get("sequence") != index
            or operation.get("kind") != kind
            or not isinstance(operation.get("operation_id"), str)
            or not operation.get("operation_id")
            or not isinstance(natural_key, str)
            or not natural_key
            or operation.get("max_write_attempts") != expected_attempts
        ):
            errors.append("schema-2 publication operation ordering/policy is invalid")
        precondition = operation.get("expected_precondition")
        initial = v080_operation_initial_observation(snapshot if isinstance(snapshot, dict) else {}, kind)
        identity = v080_operation_identity(kind, str(natural_key), str(snapshot_sha), initial)
        if (
            not exact_keys(precondition, ("kind", "remote_snapshot_sha256", "identity_sha256"))
            or precondition.get("kind") != "exact-remote-snapshot"
            or precondition.get("remote_snapshot_sha256") != snapshot_sha
            or precondition.get("identity_sha256") != canonical_json_sha256(identity)
        ):
            errors.append("schema-2 publication operation precondition is invalid")
        children = operation.get("asset_operations")
        if index != 3 and children != []:
            errors.append("asset operations exist outside the upload operation")
        if index == 3:
            if not isinstance(children, list) or len(children) != 5:
                errors.append("upload operation does not contain five asset operations")
                continue
            observed_assets = snapshot.get("assets", []) if isinstance(snapshot, dict) else []
            observed_by_name = {
                item.get("name"): item for item in observed_assets if isinstance(item, dict)
            }
            for child_index, (child, asset) in enumerate(zip(children, assets)):
                child_fields = (
                    "sequence", "operation_id", "natural_key", "name", "role", "size",
                    "sha256", "expected_precondition", "max_write_attempts",
                )
                child_natural_key = f"mintgao/vibe-kit:release:v0.8.0:asset:{asset.get('name')}"
                if not exact_keys(child, child_fields) or any(
                    child.get(key) != asset.get(key) for key in ("name", "role", "size", "sha256")
                ) or (
                    child.get("sequence") != child_index
                    or child.get("operation_id") != f"asset-{child_index}"
                    or child.get("natural_key") != child_natural_key
                    or child.get("max_write_attempts") != 2
                ):
                    errors.append("schema-2 asset operation identity is invalid")
                    continue
                initial_asset = observed_by_name.get(asset.get("name"), {
                    "state": "absent", "id": None, "size": None,
                    "sha256": None, "download_url": None,
                })
                child_identity = {
                    "schema_version": 2,
                    "profile": V080_PUBLICATION_PROFILE,
                    "parent_operation_id": operation.get("operation_id"),
                    "natural_key": child_natural_key,
                    "remote_snapshot_sha256": snapshot_sha,
                    "asset": asset,
                    "initial_observation": initial_asset,
                }
                child_pre = child.get("expected_precondition")
                if (
                    not exact_keys(child_pre, ("kind", "remote_snapshot_sha256", "identity_sha256"))
                    or child_pre.get("kind") != "exact-asset-snapshot"
                    or child_pre.get("remote_snapshot_sha256") != snapshot_sha
                    or child_pre.get("identity_sha256") != canonical_json_sha256(child_identity)
                ):
                    errors.append("schema-2 asset operation precondition is invalid")
    expected_scope = {
        "repository": "mintgao/vibe-kit", "version": "0.8.0",
        "release_kind": "prerelease",
        "allowed_operations": list(V080_PUBLICATION_ALLOWED_OPERATIONS),
        "destructive_operations_allowed": False,
    }
    if intent.get("authorization_scope") != expected_scope:
        errors.append("schema-2 publication authorization scope is invalid")
    if intent.get("issue_closeout_policy") != {
        "mode": "none", "issues": [], "allowed_operations": []
    }:
        errors.append("schema-2 publication must forbid Issue closeout")
    if intent.get("recovery_policy") != {
        "read_back_before_retry": True, "delete": False, "replace": False, "force": False
    }:
        errors.append("schema-2 publication recovery policy is invalid")
    return errors


def validate_publication_intent(value: object) -> List[str]:
    if isinstance(value, dict) and value.get("schema_version") == 1:
        return validate_publication_intent_v1(value)
    if isinstance(value, dict) and value.get("schema_version") == 2:
        return validate_v080_intent(value)
    return ["publication intent schema/profile is unsupported"]


def publication_plan(
    phase: str,
    request_path: Path,
    candidate: Optional[Path],
    comparison_candidate: Optional[Path],
    release_gate_evidence: Optional[Path],
    output_format: str,
) -> int:
    request = load_json_object_strict(request_path)
    if phase == "publish":
        if candidate is None:
            raise VibeError("publish planning requires --candidate")
        release_dir = candidate.resolve()
        manifest = load_json_object_strict(release_dir / "release-manifest.json")
        version = str(manifest.get("kit_version", ""))
        assets = publication_assets(release_dir, version)
        request = copy.deepcopy(request)
        request["assets"] = assets
        request["asset_set_sha256"] = canonical_json_sha256(assets)
        errors = validate_publication_intent(request)
        schema = request.get("schema_version")
        expected_version = "0.7.0" if schema == 1 else "0.8.0"
        if manifest.get("kit_version") != expected_version or manifest.get("status") != "prerelease":
            errors.append(
                f"publication candidate must be the exact {expected_version} prerelease"
            )
        source = manifest.get("source")
        if (
            not isinstance(source, dict)
            or source.get("tree_state") != "clean"
            or source.get("ref") != request.get("source_commit")
        ):
            errors.append("publication source commit does not match the clean candidate")
        body = request.get("release")
        body_path = source_root() / f"docs/releases/{expected_version}.md"
        if (
            not isinstance(body, dict)
            or not body_path.is_file()
            or body.get("body_sha256") != sha256(body_path)
        ):
            errors.append("publication release body does not match the accepted release note")
        captured_out = io.StringIO()
        captured_err = io.StringIO()
        with contextlib.redirect_stdout(captured_out), contextlib.redirect_stderr(captured_err):
            candidate_status = validate_release(release_dir, "json")
        if candidate_status != 0:
            errors.append("publication candidate does not pass validate-release")
        if schema == 2:
            if comparison_candidate is None:
                errors.append("schema-2 publication planning requires --comparison-candidate")
            if release_gate_evidence is None:
                errors.append("schema-2 publication planning requires --release-gate-evidence")
            gate_bundle: object = {}
            if release_gate_evidence is not None:
                try:
                    gate_bundle = load_json_object_strict(release_gate_evidence)
                except VibeError as error:
                    errors.append(str(error))
            gate_errors, source_tree_oid, gate_assets = validate_v080_release_gate_bundle(
                gate_bundle, str(request.get("source_commit", ""))
            )
            errors.extend(gate_errors)
            gates = request.get("local_gates")
            if not isinstance(gates, dict) or gates.get(
                "release_gate_evidence_sha256"
            ) != canonical_json_sha256(gate_bundle):
                errors.append("schema-2 intent does not bind the complete release-gate bundle")
            if gate_assets is not None and gate_assets != assets:
                errors.append("canonical candidate differs from release-gate build assets")
            if comparison_candidate is not None:
                comparison_dir = comparison_candidate.resolve()
                try:
                    comparison_manifest = load_json_object_strict(
                        comparison_dir / "release-manifest.json"
                    )
                    comparison_assets = publication_assets(comparison_dir, "0.8.0")
                except VibeError as error:
                    comparison_manifest, comparison_assets = {}, []
                    errors.append(str(error))
                if (
                    comparison_manifest.get("kit_version") != "0.8.0"
                    or comparison_manifest.get("status") != "prerelease"
                    or not isinstance(comparison_manifest.get("source"), dict)
                    or comparison_manifest.get("source", {}).get("tree_state") != "clean"
                    or comparison_manifest.get("source", {}).get("ref") != request.get("source_commit")
                ):
                    errors.append("comparison candidate is not the same clean v0.8.0 source")
                if comparison_assets != assets:
                    errors.append("canonical and comparison candidates are not byte-identical")
                with contextlib.redirect_stdout(io.StringIO()), contextlib.redirect_stderr(io.StringIO()):
                    comparison_status = validate_release(comparison_dir, "json")
                if comparison_status != 0:
                    errors.append("comparison candidate does not pass validate-release")
                if isinstance(gate_bundle, dict) and isinstance(gate_bundle.get("builds"), list) and len(gate_bundle["builds"]) == 2:
                    if gate_bundle["builds"][1].get("assets") != comparison_assets:
                        errors.append("comparison candidate differs from release-gate build B assets")
            if (
                platform.python_implementation() != "CPython"
                or sys.version_info[:2] != (3, 9)
            ):
                errors.append("schema-2 final publication plan must execute on CPython 3.9")
            if source_tree_oid is None:
                errors.append("schema-2 release-gate source tree identity is missing")
        kind = "publication"
        output: Dict[str, object] = {"intent": request}
    else:
        try:
            intent, bodies = build_closeout_intent(request)
            errors = []
        except VibeError as error:
            intent, bodies, errors = {}, {}, [str(error)]
        kind = "issue-closeout"
        output = {"intent": intent, "comment_bodies": bodies}
    status = "blocked" if errors else "safe"
    digest_value = canonical_json_sha256(output["intent"]) if not errors else None
    result = result_envelope(
        "publication-plan", status, phase=phase, plan_kind=kind,
        intent_sha256=digest_value, **output, errors=errors,
        write_state="none", writes_performed=False, network_used=False,
        authorization_required=True,
        execution={
            "observed_at": utc_now(),
            "interpreter": {
                "implementation": platform.python_implementation(),
                "major": sys.version_info.major,
                "minor": sys.version_info.minor,
                "patch": sys.version_info.micro,
                "platform": platform.platform(),
                "executable_name": Path(sys.executable).name,
            },
        },
        next_action=(
            {"code": "resolve-publication-plan", "detail": "Correct every local plan error."}
            if errors else None
        ),
    )
    if output_format == "json":
        print_json(result)
    elif errors:
        for error in errors:
            print(f"ERROR: {error}", file=sys.stderr)
    else:
        print(f"Publication plan safe: {phase}")
        print(f"Intent SHA-256: {digest_value}")
        print("No local or remote files were changed.")
    return 2 if errors else 0


def validate_publication_receipt_shape_v1(receipt: object) -> List[str]:
    errors: List[str] = []
    top = (
        "schema_version", "kind", "intent_sha256", "authorization_id",
        "host_operation_id", "repository", "remote_write_state", "verification_state",
        "main", "tag", "release", "assets", "operations", "downloads",
        "validate_release", "smokes", "limitations", "issue_closeout", "error",
    )
    if not exact_keys(receipt, top):
        return ["publication receipt top-level fields are unknown or incomplete"]
    value = receipt
    if not isinstance(value, dict):
        return errors
    if value.get("schema_version") != HISTORICAL_PUBLICATION_RECEIPT_SCHEMA or value.get("kind") != "vibe-kit-publication-receipt":
        errors.append("publication receipt schema/kind is unsupported")
    if value.get("remote_write_state") not in REMOTE_WRITE_STATES:
        errors.append("publication receipt remote write state is invalid")
    if value.get("verification_state") not in VERIFICATION_STATES:
        errors.append("publication receipt verification state is invalid")
    if re.fullmatch(r"[0-9a-f]{64}", str(value.get("intent_sha256", ""))) is None:
        errors.append("publication receipt intent binding is invalid")
    for key in ("authorization_id", "host_operation_id"):
        if not isinstance(value.get(key), str) or not value.get(key) or len(value[key]) > 256:
            errors.append("publication receipt authorization identity is invalid")
    if value.get("repository") != "mintgao/vibe-kit":
        errors.append("publication receipt repository is invalid")
    main = value.get("main")
    if not exact_keys(main, ("branch", "expected_old_oid", "target_oid", "observed_oid", "write_state", "read_back")):
        errors.append("publication receipt main shape is invalid")
    elif (
        main.get("branch") != "main"
        or any(re.fullmatch(r"[0-9a-f]{40}", str(main.get(key, ""))) is None for key in ("expected_old_oid", "target_oid", "observed_oid"))
        or main.get("write_state") not in REMOTE_WRITE_STATES
        or not isinstance(main.get("read_back"), bool)
    ):
        errors.append("publication receipt main value is invalid")
    tag = value.get("tag")
    if not exact_keys(tag, ("name", "expected_tag_object_oid", "observed_ref_oid", "peeled_commit", "write_state", "read_back")):
        errors.append("publication receipt tag shape is invalid")
    elif (
        tag.get("name") != "v0.7.0"
        or any(re.fullmatch(r"[0-9a-f]{40}", str(tag.get(key, ""))) is None for key in ("expected_tag_object_oid", "observed_ref_oid", "peeled_commit"))
        or tag.get("write_state") not in REMOTE_WRITE_STATES
        or not isinstance(tag.get("read_back"), bool)
    ):
        errors.append("publication receipt tag value is invalid")
    release = value.get("release")
    if not exact_keys(release, ("id", "url", "tag", "title", "body_sha256", "draft", "prerelease", "immutable", "write_state", "read_back")):
        errors.append("publication receipt release shape is invalid")
    elif (
        isinstance(release.get("id"), bool)
        or not isinstance(release.get("id"), int)
        or not isinstance(release.get("url"), str) or not release.get("url")
        or release.get("tag") != "v0.7.0"
        or not isinstance(release.get("title"), str) or not release.get("title")
        or re.fullmatch(r"[0-9a-f]{64}", str(release.get("body_sha256", ""))) is None
        or not isinstance(release.get("draft"), bool)
        or not isinstance(release.get("prerelease"), bool)
        or release.get("immutable") not in (True, False, "unknown")
        or release.get("write_state") not in REMOTE_WRITE_STATES
        or not isinstance(release.get("read_back"), bool)
    ):
        errors.append("publication receipt release value is invalid")
    assets = value.get("assets")
    if not isinstance(assets, list) or len(assets) != 5 or any(
        not exact_keys(item, ("name", "role", "size", "sha256", "id", "url", "write_state", "read_back"))
        for item in assets
    ):
        errors.append("publication receipt asset collection shape is invalid")
    else:
        for item in assets:
            if (
                not isinstance(item.get("name"), str)
                or item.get("role") not in ("checksum", "manifest", "direct", "distribution", "plugin")
                or isinstance(item.get("size"), bool) or not isinstance(item.get("size"), int) or item["size"] < 0
                or re.fullmatch(r"[0-9a-f]{64}", str(item.get("sha256", ""))) is None
                or isinstance(item.get("id"), bool) or not isinstance(item.get("id"), int)
                or not isinstance(item.get("url"), str) or not item.get("url")
                or item.get("write_state") not in REMOTE_WRITE_STATES
                or not isinstance(item.get("read_back"), bool)
            ):
                errors.append("publication receipt asset value is invalid")
        asset_names = [item.get("name") for item in assets]
        asset_roles = [item.get("role") for item in assets]
        if (
            len(set(asset_names)) != 5
            or len(set(asset_roles)) != 5
            or set(asset_roles)
            != {"checksum", "manifest", "direct", "distribution", "plugin"}
        ):
            errors.append("publication receipt assets are not one-to-one")
    downloads = value.get("downloads")
    if not isinstance(downloads, list) or len(downloads) != 5 or any(
        not exact_keys(item, ("name", "size", "sha256", "matched"))
        for item in downloads
    ):
        errors.append("publication receipt download collection shape is invalid")
    else:
        for item in downloads:
            if (
                not isinstance(item.get("name"), str)
                or isinstance(item.get("size"), bool) or not isinstance(item.get("size"), int) or item["size"] < 0
                or re.fullmatch(r"[0-9a-f]{64}", str(item.get("sha256", ""))) is None
                or not isinstance(item.get("matched"), bool)
            ):
                errors.append("publication receipt download value is invalid")
        if len({item.get("name") for item in downloads}) != 5:
            errors.append("publication receipt downloads contain duplicate names")
    operations = value.get("operations")
    initial_responses = ("not-attempted", "definite-success", "timeout", "transport-unknown", "permission-denied")
    read_backs = ("not-run", "match", "divergent", "positively-absent", "still-unknown")
    outcomes = (
        "not-attempted", "read-matched", "created", "uploaded",
        "confirmed-after-uncertain", "conflict", "permission-denied",
        "absent-after-bounded-retry", "uncertain",
    )
    if not isinstance(operations, list) or any(
        not exact_keys(item, ("sequence", "operation_id", "kind", "natural_key", "write_attempts", "initial_response", "read_back_result", "outcome", "remote_object_id", "error"))
        for item in operations
    ):
        errors.append("publication receipt operation collection shape is invalid")
    else:
        for index, item in enumerate(operations):
            if (
                item.get("sequence") != index
                or not isinstance(item.get("operation_id"), str) or not item.get("operation_id")
                or item.get("kind") not in PUBLICATION_ALLOWED_OPERATIONS
                or not isinstance(item.get("natural_key"), str) or not item.get("natural_key")
                or isinstance(item.get("write_attempts"), bool)
                or not isinstance(item.get("write_attempts"), int)
                or item.get("write_attempts") not in (0, 1, 2)
                or item.get("initial_response") not in initial_responses
                or item.get("read_back_result") not in read_backs
                or item.get("outcome") not in outcomes
                or (item.get("remote_object_id") is not None and not isinstance(item.get("remote_object_id"), (str, int)))
                or (item.get("error") is not None and not exact_keys(item.get("error"), ("code", "message", "next_action")))
            ):
                errors.append("publication receipt operation value is invalid")
    validate_result = value.get("validate_release")
    if not exact_keys(validate_result, ("status", "receipt_sha256")) or (
        isinstance(validate_result, dict)
        and (
            validate_result.get("status") not in ("valid", "invalid", "error")
            or re.fullmatch(r"[0-9a-f]{64}", str(validate_result.get("receipt_sha256", ""))) is None
        )
    ):
        errors.append("publication receipt validate-release shape is invalid")
    smokes = value.get("smokes")
    if not isinstance(smokes, list) or not smokes or any(
        not exact_keys(item, ("name", "status", "evidence_sha256"))
        for item in smokes
    ):
        errors.append("publication receipt smoke collection shape is invalid")
    else:
        for item in smokes:
            if (
                not isinstance(item.get("name"), str) or not item.get("name")
                or item.get("status") not in ("passed", "failed", "error")
                or re.fullmatch(r"[0-9a-f]{64}", str(item.get("evidence_sha256", ""))) is None
            ):
                errors.append("publication receipt smoke value is invalid")
    if not isinstance(value.get("limitations"), list) or any(not isinstance(item, str) or len(item) > 512 for item in value.get("limitations", [])):
        errors.append("publication receipt limitations are invalid")
    if value.get("issue_closeout") is not None:
        errors.append("publication receipt cannot claim issue closeout before its separate phase")
    if value.get("error") is not None and not exact_keys(value.get("error"), ("code", "message", "next_action")):
        errors.append("publication receipt error shape is invalid")
    return errors


V080_OPERATION_OUTCOMES = (
    "not-attempted", "read-matched", "updated", "created", "uploaded",
    "confirmed-after-uncertain", "verified", "conflict", "permission-denied",
    "definite-failure", "absent-after-bounded-retry", "uncertain", "error",
)
V080_SUCCESS_OUTCOMES = {
    "read-matched", "updated", "created", "uploaded",
    "confirmed-after-uncertain", "verified",
}
V080_ATTEMPT_RESPONSES = (
    "definite-success", "timeout", "transport-unknown", "permission-denied",
    "definite-failure", "execution-error",
)


def validate_v080_observation(value: object, kind: str) -> List[str]:
    errors: List[str] = []
    if kind == "main":
        if not exact_keys(value, ("observed_at", "state", "oid")):
            return ["main observation fields are invalid"]
        if (
            not is_iso8601(value.get("observed_at"))
            or value.get("state") not in ("preimage", "target", "divergent", "unknown")
            or ((value.get("oid") is None) != (value.get("state") == "unknown"))
            or (value.get("oid") is not None and not valid_oid(value.get("oid")))
        ):
            errors.append("main observation value is invalid")
        return errors
    if kind == "tag":
        identity = (
            "ref_oid", "object_type", "tag_object_oid", "peeled_commit", "tagger_name",
            "tagger_email", "tagger_timestamp", "tagger_timezone", "message_sha256",
        )
        if not exact_keys(value, ("observed_at", "state") + identity):
            return ["tag observation fields are invalid"]
        if not is_iso8601(value.get("observed_at")) or value.get("state") not in (
            "absent", "match", "divergent", "unknown"
        ):
            errors.append("tag observation state is invalid")
        if value.get("state") in ("absent", "unknown"):
            if any(value.get(key) is not None for key in identity):
                errors.append("absent/unknown tag observation has non-null identity")
        elif (
            not valid_oid(value.get("ref_oid"))
            or value.get("object_type") != "tag"
            or not valid_oid(value.get("tag_object_oid"))
            or not valid_oid(value.get("peeled_commit"))
            or not isinstance(value.get("tagger_name"), str)
            or not value.get("tagger_name")
            or not isinstance(value.get("tagger_email"), str)
            or not value.get("tagger_email")
            or not is_iso8601(value.get("tagger_timestamp"))
            or re.fullmatch(r"[+-][0-9]{4}", str(value.get("tagger_timezone", ""))) is None
            or not valid_sha256(value.get("message_sha256"))
        ):
            errors.append("tag observation identity is invalid")
        return errors
    if kind == "release":
        identity = ("id", "url", "tag", "title", "body_sha256", "draft", "prerelease", "immutable")
        if not exact_keys(value, ("observed_at", "state") + identity):
            return ["Release observation fields are invalid"]
        if not is_iso8601(value.get("observed_at")) or value.get("state") not in (
            "absent", "match", "divergent", "unknown"
        ):
            errors.append("Release observation state is invalid")
        if value.get("state") in ("absent", "unknown"):
            if any(value.get(key) is not None for key in identity):
                errors.append("absent/unknown Release observation has non-null identity")
        elif (
            not valid_positive_int(value.get("id"))
            or not isinstance(value.get("url"), str)
            or not value.get("url")
            or value.get("tag") != "v0.8.0"
            or not isinstance(value.get("title"), str)
            or not value.get("title")
            or not valid_sha256(value.get("body_sha256"))
            or not isinstance(value.get("draft"), bool)
            or not isinstance(value.get("prerelease"), bool)
            or value.get("immutable") not in (True, False, "unknown")
        ):
            errors.append("Release observation identity is invalid")
        return errors
    identity = ("id", "size", "sha256", "download_url")
    if not exact_keys(value, ("observed_at", "state") + identity):
        return ["asset observation fields are invalid"]
    if not is_iso8601(value.get("observed_at")) or value.get("state") not in (
        "absent", "match", "divergent", "unknown"
    ):
        errors.append("asset observation state is invalid")
    if value.get("state") in ("absent", "unknown"):
        if any(value.get(key) is not None for key in identity):
            errors.append("absent/unknown asset observation has non-null identity")
    elif (
        not valid_positive_int(value.get("id"))
        or isinstance(value.get("size"), bool)
        or not isinstance(value.get("size"), int)
        or value["size"] < 0
        or not valid_sha256(value.get("sha256"))
        or not isinstance(value.get("download_url"), str)
        or not value.get("download_url")
    ):
        errors.append("asset observation identity is invalid")
    return errors


def validate_v080_attempts(value: object, observation_kind: str) -> List[str]:
    if not isinstance(value, list) or len(value) > 2:
        return ["operation attempt ledger length is invalid"]
    errors: List[str] = []
    for index, attempt in enumerate(value, start=1):
        if not exact_keys(
            attempt,
            ("attempt_number", "pre_write_observation", "response", "read_back_observation"),
        ):
            errors.append("operation attempt fields are invalid")
            continue
        if attempt.get("attempt_number") != index or attempt.get("response") not in V080_ATTEMPT_RESPONSES:
            errors.append("operation attempt ordering/response is invalid")
        errors.extend(validate_v080_observation(attempt.get("pre_write_observation"), observation_kind))
        errors.extend(validate_v080_observation(attempt.get("read_back_observation"), observation_kind))
    if len(value) == 2 and isinstance(value[0], dict):
        first_read = value[0].get("read_back_observation")
        expected_absence = "preimage" if observation_kind == "main" else "absent"
        if not isinstance(first_read, dict) or first_read.get("state") != expected_absence:
            errors.append("second write attempt lacks exact positive-absence proof")
        if value[0].get("response") in (
            "permission-denied", "definite-failure", "execution-error"
        ):
            errors.append("terminal attempt response cannot be retried")
    return errors


def validate_v080_write_ledger(
    value: object,
    observation_kind: str,
    allowed_successes: Sequence[str],
    expected_precondition_sha: str,
    asset: bool = False,
) -> List[str]:
    common = (
        "sequence", "operation_id", "natural_key", "initial_observation", "attempts",
        "final_observation", "outcome", "error",
    )
    fields = common + (
        ("name", "role", "expected_size", "expected_sha256", "precondition_sha256", "remote_asset_id")
        if asset
        else ("kind", "precondition_sha256", "remote_object_id", "asset_receipts")
    )
    if not exact_keys(value, fields) or not isinstance(value, dict):
        return ["write receipt ledger fields are unknown or incomplete"]
    errors: List[str] = []
    if value.get("precondition_sha256") != expected_precondition_sha:
        errors.append("write receipt precondition digest is invalid")
    errors.extend(validate_v080_observation(value.get("initial_observation"), observation_kind))
    errors.extend(validate_v080_attempts(value.get("attempts"), observation_kind))
    errors.extend(validate_v080_observation(value.get("final_observation"), observation_kind))
    outcome = value.get("outcome")
    error = value.get("error")
    if outcome not in V080_OPERATION_OUTCOMES:
        errors.append("write receipt outcome is invalid")
    if (outcome in V080_SUCCESS_OUTCOMES) != (error is None):
        errors.append("write receipt outcome/error nullability is invalid")
    if error is not None and not valid_publication_error(error):
        errors.append("write receipt error is invalid")
    final = value.get("final_observation")
    if outcome in allowed_successes and (not isinstance(final, dict) or final.get("state") not in ("target", "match")):
        errors.append("successful write receipt lacks exact final match")
    if outcome == "absent-after-bounded-retry" and (
        not isinstance(value.get("attempts"), list)
        or len(value["attempts"]) != 2
        or not isinstance(final, dict)
        or final.get("state") != ("preimage" if observation_kind == "main" else "absent")
    ):
        errors.append("bounded-absence outcome is not proven by two attempts")
    attempts = value.get("attempts") if isinstance(value.get("attempts"), list) else []
    if outcome == "confirmed-after-uncertain" and not any(
        isinstance(attempt, dict) and attempt.get("response") in ("timeout", "transport-unknown")
        for attempt in attempts
    ):
        errors.append("confirmed-after-uncertain lacks an uncertain response")
    remote_id_key = "remote_asset_id" if asset else "remote_object_id"
    if outcome in allowed_successes and value.get(remote_id_key) is None:
        errors.append("successful write receipt lacks a remote object identity")
    return errors


def validate_v080_receipt(value: object, intent: Dict[str, object]) -> List[str]:
    fields = (
        "schema_version", "kind", "profile", "version", "intent_sha256",
        "authorization_id", "host_operation_id", "repository", "remote_write_state",
        "verification_state", "main", "tag", "release", "assets", "operations",
        "downloads", "validate_release", "smokes", "limitations", "issue_closeout",
        "error",
    )
    if not exact_keys(value, fields) or not isinstance(value, dict):
        return ["schema-2 publication receipt fields are unknown or incomplete"]
    receipt = value
    errors: List[str] = []
    if (
        receipt.get("schema_version") != 2
        or receipt.get("kind") != "vibe-kit-publication-receipt"
        or receipt.get("profile") != V080_PUBLICATION_PROFILE
        or receipt.get("version") != "0.8.0"
        or receipt.get("repository") != "mintgao/vibe-kit"
        or receipt.get("intent_sha256") != canonical_json_sha256(intent)
        or any(
            not isinstance(receipt.get(key), str) or not receipt.get(key) or len(receipt[key]) > 256
            for key in ("authorization_id", "host_operation_id")
        )
    ):
        errors.append("schema-2 publication receipt identity is invalid")
    if receipt.get("remote_write_state") not in REMOTE_WRITE_STATES or receipt.get("verification_state") not in VERIFICATION_STATES:
        errors.append("schema-2 publication receipt state is invalid")
    if receipt.get("issue_closeout") is not None:
        errors.append("schema-2 publication receipt must not contain Issue closeout")
    if receipt.get("error") is not None and not valid_publication_error(receipt.get("error")):
        errors.append("schema-2 publication receipt error is invalid")
    intent_main = intent.get("main") if isinstance(intent.get("main"), dict) else {}
    main = receipt.get("main")
    if not exact_keys(main, ("branch", "expected_old_oid", "target_oid", "observed_oid", "write_state", "read_back")) or (
        main.get("branch") != "main"
        or main.get("expected_old_oid") != intent_main.get("expected_old_oid")
        or main.get("target_oid") != intent_main.get("target_oid")
        or not valid_oid(main.get("observed_oid"))
        or main.get("write_state") not in REMOTE_WRITE_STATES
        or not isinstance(main.get("read_back"), bool)
    ):
        errors.append("schema-2 final main identity is invalid")
    intent_tag = intent.get("tag") if isinstance(intent.get("tag"), dict) else {}
    tag = receipt.get("tag")
    if not exact_keys(tag, ("name", "expected_tag_object_oid", "observed_ref_oid", "peeled_commit", "write_state", "read_back")) or (
        tag.get("name") != "v0.8.0"
        or tag.get("expected_tag_object_oid") != intent_tag.get("expected_tag_object_oid")
        or not valid_oid(tag.get("observed_ref_oid"))
        or not valid_oid(tag.get("peeled_commit"))
        or tag.get("write_state") not in REMOTE_WRITE_STATES
        or not isinstance(tag.get("read_back"), bool)
    ):
        errors.append("schema-2 final tag identity is invalid")
    release = receipt.get("release")
    if not exact_keys(release, ("id", "url", "tag", "title", "body_sha256", "draft", "prerelease", "immutable", "write_state", "read_back")) or (
        not valid_positive_int(release.get("id"))
        or release.get("url") != "https://github.com/mintgao/vibe-kit/releases/tag/v0.8.0"
        or release.get("tag") != "v0.8.0"
        or release.get("title") != "Vibe Kit v0.8.0"
        or not valid_sha256(release.get("body_sha256"))
        or release.get("draft") is not False
        or release.get("prerelease") is not True
        or release.get("immutable") not in (True, False, "unknown")
        or release.get("write_state") not in REMOTE_WRITE_STATES
        or not isinstance(release.get("read_back"), bool)
    ):
        errors.append("schema-2 final Release identity is invalid")
    intended_assets = intent.get("assets") if isinstance(intent.get("assets"), list) else []
    assets = receipt.get("assets")
    if not isinstance(assets, list) or len(assets) != 5:
        errors.append("schema-2 final asset set is invalid")
        assets = []
    for item, intended in zip(assets, intended_assets):
        if not exact_keys(item, ("name", "role", "size", "sha256", "id", "url", "write_state", "read_back")) or any(
            item.get(key) != intended.get(key) for key in ("name", "role", "size", "sha256")
        ) or (
            not valid_positive_int(item.get("id"))
            or item.get("url") != f"https://github.com/mintgao/vibe-kit/releases/download/v0.8.0/{item.get('name')}"
            or item.get("write_state") not in REMOTE_WRITE_STATES
            or not isinstance(item.get("read_back"), bool)
        ):
            errors.append("schema-2 final asset identity is invalid")
    downloads = receipt.get("downloads")
    if not isinstance(downloads, list) or len(downloads) != 5:
        errors.append("schema-2 public download set is invalid")
        downloads = []
    for item, intended in zip(downloads, intended_assets):
        if not exact_keys(item, ("name", "size", "sha256", "matched")) or any(
            item.get(key) != intended.get(key) for key in ("name", "size", "sha256")
        ) or item.get("matched") is not True:
            errors.append("schema-2 public download identity is invalid")
    validate_release_value = receipt.get("validate_release")
    if not exact_keys(validate_release_value, ("status", "receipt_sha256")) or (
        validate_release_value.get("status") not in ("valid", "invalid", "error")
        or not valid_sha256(validate_release_value.get("receipt_sha256"))
    ):
        errors.append("schema-2 validate-release evidence is invalid")
    smokes = receipt.get("smokes")
    if not isinstance(smokes, list) or len(smokes) != 6 or [
        item.get("name") for item in smokes if isinstance(item, dict)
    ] != list(V080_PUBLIC_SMOKES):
        errors.append("schema-2 public smoke set is invalid")
        smokes = []
    for item in smokes:
        if not exact_keys(item, ("name", "status", "evidence_sha256")) or (
            item.get("status") not in ("passed", "failed", "error")
            or not valid_sha256(item.get("evidence_sha256"))
        ):
            errors.append("schema-2 public smoke evidence is invalid")
    if not isinstance(receipt.get("limitations"), list) or any(
        not isinstance(item, str) or not item or len(item) > 512
        for item in receipt.get("limitations", [])
    ):
        errors.append("schema-2 publication limitations are invalid")
    intent_operations = intent.get("operations") if isinstance(intent.get("operations"), list) else []
    operations = receipt.get("operations")
    if not isinstance(operations, list) or len(operations) != 6:
        errors.append("schema-2 operation receipt graph is invalid")
        operations = []
    for index, (operation, planned) in enumerate(zip(operations, intent_operations)):
        kind = V080_PUBLICATION_ALLOWED_OPERATIONS[index]
        pre_sha = canonical_json_sha256(planned.get("expected_precondition"))
        if index in (0, 1, 2):
            observation_kind = ("main", "tag", "release")[index]
            successes = (
                ("read-matched", "updated", "confirmed-after-uncertain")
                if index == 0 else ("read-matched", "created", "confirmed-after-uncertain")
            )
            errors.extend(validate_v080_write_ledger(operation, observation_kind, successes, pre_sha))
            if isinstance(operation, dict) and operation.get("asset_receipts") != []:
                errors.append("non-upload write receipt contains asset receipts")
        elif index == 3:
            required = (
                "sequence", "operation_id", "kind", "natural_key", "precondition_sha256",
                "initial_observation", "attempts", "final_observation", "outcome",
                "remote_object_id", "asset_receipts", "error",
            )
            if not exact_keys(operation, required):
                errors.append("upload receipt fields are unknown or incomplete")
                continue
            if operation.get("initial_observation") is not None or operation.get("final_observation") is not None or operation.get("attempts") != [] or operation.get("remote_object_id") is not None:
                errors.append("upload high-level receipt must use child ledgers only")
            if operation.get("precondition_sha256") != pre_sha:
                errors.append("upload receipt precondition digest is invalid")
            children = operation.get("asset_receipts")
            planned_children = planned.get("asset_operations") if isinstance(planned, dict) else []
            if not isinstance(children, list) or len(children) != 5:
                errors.append("upload receipt requires five asset ledgers")
                children = []
            child_outcomes = []
            for child, planned_child in zip(children, planned_children):
                child_errors = validate_v080_write_ledger(
                    child, "asset", ("read-matched", "uploaded", "confirmed-after-uncertain"),
                    canonical_json_sha256(planned_child.get("expected_precondition")), True,
                )
                errors.extend(child_errors)
                if isinstance(child, dict):
                    child_outcomes.append(child.get("outcome"))
                    if any(child.get(target) != planned_child.get(source) for target, source in (
                        ("sequence", "sequence"), ("operation_id", "operation_id"),
                        ("natural_key", "natural_key"), ("name", "name"), ("role", "role"),
                        ("expected_size", "size"), ("expected_sha256", "sha256"),
                    )):
                        errors.append("asset receipt does not bind its planned child")
            if child_outcomes and all(item in ("read-matched", "uploaded", "confirmed-after-uncertain") for item in child_outcomes):
                expected_high = (
                    "confirmed-after-uncertain" if "confirmed-after-uncertain" in child_outcomes
                    else "uploaded" if "uploaded" in child_outcomes else "read-matched"
                )
            else:
                expected_high = next((item for item in child_outcomes if item not in V080_SUCCESS_OUTCOMES), None)
            if operation.get("outcome") != expected_high:
                errors.append("upload high-level outcome is not derived from child ledgers")
            if (operation.get("outcome") in V080_SUCCESS_OUTCOMES) != (operation.get("error") is None):
                errors.append("upload receipt outcome/error nullability is invalid")
            if operation.get("error") is not None and not valid_publication_error(operation.get("error")):
                errors.append("upload receipt error is invalid")
        else:
            required = (
                "sequence", "operation_id", "kind", "natural_key", "precondition_sha256",
                "initial_observation", "attempts", "final_observation", "outcome",
                "remote_object_id", "asset_receipts", "error",
            )
            if not exact_keys(operation, required) or (
                operation.get("precondition_sha256") != pre_sha
                or operation.get("initial_observation") is not None
                or operation.get("attempts") != []
                or operation.get("final_observation") is not None
                or operation.get("remote_object_id") is not None
                or operation.get("asset_receipts") != []
                or operation.get("outcome") not in ("verified", "not-attempted", "error")
                or ((operation.get("outcome") == "verified") != (operation.get("error") is None))
            ):
                errors.append("read-only operation receipt is invalid")
        if isinstance(operation, dict) and any(
            operation.get(key) != planned.get(key)
            for key in ("sequence", "operation_id", "kind", "natural_key")
        ):
            errors.append("operation receipt does not bind the planned operation")
    return errors


def validate_publication_receipt_shape(
    receipt: object, intent: Optional[Dict[str, object]] = None
) -> List[str]:
    if isinstance(receipt, dict) and receipt.get("schema_version") == 1:
        return validate_publication_receipt_shape_v1(receipt)
    if isinstance(receipt, dict) and receipt.get("schema_version") == 2 and isinstance(intent, dict):
        return validate_v080_receipt(receipt, intent)
    return ["publication receipt schema/profile is unsupported"]


def validate_publication_v1(
    intent_path: Path, receipt_path: Path, release_dir: Path, output_format: str
) -> int:
    intent = load_json_object_strict(intent_path)
    receipt = load_json_object_strict(receipt_path)
    errors = validate_publication_intent(intent)
    errors.extend(validate_publication_receipt_shape(receipt, intent))
    intent_sha = canonical_json_sha256(intent)
    if receipt.get("intent_sha256") != intent_sha:
        errors.append("publication receipt does not bind the exact intent")
    local_assets = publication_assets(release_dir.resolve(), str(intent.get("version", "")))
    if intent.get("assets") != local_assets:
        errors.append("publication intent assets do not match the local candidate")
    if receipt.get("remote_write_state") != "confirmed-complete":
        errors.append("publication remote writes are not confirmed complete")
    if receipt.get("verification_state") != "passed":
        errors.append("publication public verification did not pass")
    intent_main = intent.get("main") if isinstance(intent.get("main"), dict) else {}
    receipt_main = receipt.get("main") if isinstance(receipt.get("main"), dict) else {}
    if (
        any(receipt_main.get(key) != intent_main.get(key) for key in ("branch", "expected_old_oid", "target_oid"))
        or receipt_main.get("observed_oid") != intent_main.get("target_oid")
        or receipt_main.get("write_state") != "confirmed-complete"
        or receipt_main.get("read_back") is not True
    ):
        errors.append("publication main read-back does not match intent")
    intent_tag = intent.get("tag") if isinstance(intent.get("tag"), dict) else {}
    receipt_tag = receipt.get("tag") if isinstance(receipt.get("tag"), dict) else {}
    if (
        receipt_tag.get("name") != intent_tag.get("name")
        or receipt_tag.get("expected_tag_object_oid") != intent_tag.get("expected_tag_object_oid")
        or receipt_tag.get("observed_ref_oid") != intent_tag.get("expected_tag_object_oid")
        or receipt_tag.get("peeled_commit") != intent_tag.get("target_commit")
        or receipt_tag.get("write_state") != "confirmed-complete"
        or receipt_tag.get("read_back") is not True
    ):
        errors.append("publication annotated tag read-back does not match intent")
    intent_release = intent.get("release") if isinstance(intent.get("release"), dict) else {}
    receipt_release = receipt.get("release") if isinstance(receipt.get("release"), dict) else {}
    if (
        receipt_release.get("tag") != intent_tag.get("name")
        or receipt_release.get("title") != intent_release.get("title")
        or receipt_release.get("body_sha256") != intent_release.get("body_sha256")
        or receipt_release.get("draft") is not False
        or receipt_release.get("prerelease") is not True
        or receipt_release.get("write_state") != "confirmed-complete"
        or receipt_release.get("read_back") is not True
    ):
        errors.append("publication release read-back does not match intent")
    expected = {item["name"]: item for item in local_assets}
    remote_assets = receipt.get("assets") if isinstance(receipt.get("assets"), list) else []
    downloads = receipt.get("downloads") if isinstance(receipt.get("downloads"), list) else []
    remote_identity = [
        {key: item.get(key) for key in ("name", "role", "size", "sha256")}
        for item in remote_assets if isinstance(item, dict)
    ]
    download_identity = [
        {key: item.get(key) for key in ("name", "size", "sha256")}
        for item in downloads if isinstance(item, dict)
    ]
    expected_downloads = [
        {key: item[key] for key in ("name", "size", "sha256")}
        for item in local_assets
    ]
    if len(remote_assets) != 5 or remote_identity != local_assets:
        errors.append("publication receipt does not contain the exact five remote assets")
    if len(downloads) != 5 or download_identity != expected_downloads:
        errors.append("publication receipt does not contain the exact five public downloads")
    for item in remote_assets:
        if isinstance(item, dict) and item.get("name") in expected:
            source = expected[item["name"]]
            if (
                any(item.get(key) != source[key] for key in ("role", "size", "sha256"))
                or item.get("write_state") != "confirmed-complete"
                or item.get("read_back") is not True
            ):
                errors.append(f"remote asset does not match intent: {item.get('name')}")
    for item in downloads:
        if isinstance(item, dict) and item.get("name") in expected:
            source = expected[item["name"]]
            if item.get("size") != source["size"] or item.get("sha256") != source["sha256"] or item.get("matched") is not True:
                errors.append(f"public download does not match intent: {item.get('name')}")
    validate_result = receipt.get("validate_release")
    if not isinstance(validate_result, dict) or validate_result.get("status") != "valid":
        errors.append("inner validate-release receipt is not valid")
    for smoke in receipt.get("smokes", []) if isinstance(receipt.get("smokes"), list) else []:
        if not isinstance(smoke, dict) or smoke.get("status") != "passed":
            errors.append("a required public smoke did not pass")
    smokes = receipt.get("smokes") if isinstance(receipt.get("smokes"), list) else []
    smoke_names = [item.get("name") for item in smokes if isinstance(item, dict)]
    if len(smoke_names) != len(set(smoke_names)):
        errors.append("publication smoke evidence contains duplicate names")
    intent_operations = intent.get("operations") if isinstance(intent.get("operations"), list) else []
    receipt_operations = receipt.get("operations") if isinstance(receipt.get("operations"), list) else []
    if len(receipt_operations) != len(intent_operations):
        errors.append("publication operation receipt graph does not match intent")
    else:
        terminal_outcomes = {
            "read-matched", "created", "uploaded", "confirmed-after-uncertain"
        }
        for planned, observed in zip(intent_operations, receipt_operations):
            if (
                any(observed.get(key) != planned.get(key) for key in ("sequence", "operation_id", "kind", "natural_key"))
                or observed.get("outcome") not in terminal_outcomes
                or observed.get("read_back_result") != "match"
                or observed.get("error") is not None
            ):
                errors.append("publication operation receipt does not prove exact terminal read-back")
    if receipt.get("error") is not None:
        errors.append("publication receipt contains an error")
    captured_out = io.StringIO()
    captured_err = io.StringIO()
    with contextlib.redirect_stdout(captured_out), contextlib.redirect_stderr(captured_err):
        local_release_status = validate_release(release_dir.resolve(), "json")
    if local_release_status != 0:
        errors.append("local release directory does not pass validate-release")
    serialized = json.dumps({"intent": intent, "receipt": receipt}, ensure_ascii=False)
    if contains_secret(serialized):
        errors.append("publication evidence contains credential-like material")
    status = "invalid" if errors else "valid"
    if output_format == "json":
        print_json(result_envelope(
            "validate-publication", status, intent_sha256=intent_sha,
            release_directory=str(release_dir.resolve()), errors=errors,
            remote_write_state=receipt.get("remote_write_state"),
            verification_state=receipt.get("verification_state"),
            host_evidence_authenticated=False, network_used=False,
        ))
    elif errors:
        for error in errors:
            print(f"ERROR: {error}", file=sys.stderr)
    else:
        print("Publication validation passed.")
        print("Host evidence is structurally consistent; GitHub authenticity remains a live-host fact.")
    return 1 if errors else 0


def validate_publication_v2(
    intent_path: Path,
    receipt_path: Path,
    release_dir: Path,
    authorization_path: Optional[Path],
    output_format: str,
) -> int:
    intent = load_json_object_strict(intent_path)
    receipt = load_json_object_strict(receipt_path)
    errors = validate_v080_intent(intent)
    errors.extend(validate_v080_receipt(receipt, intent))
    authorization: object = {}
    if authorization_path is None:
        errors.append("schema-2 publication validation requires --authorization")
    else:
        authorization = load_json_object_strict(authorization_path)
        errors.extend(validate_v080_authorization(authorization, intent))
    if isinstance(authorization, dict):
        if receipt.get("authorization_id") != authorization.get("authorization_id"):
            errors.append("publication receipt authorization ID does not match")
        if receipt.get("host_operation_id") != authorization.get("host_operation_id"):
            errors.append("publication receipt host operation ID does not match")
    local_assets = publication_assets(release_dir.resolve(), "0.8.0")
    if intent.get("assets") != local_assets:
        errors.append("schema-2 intent assets do not match the local candidate")
    if receipt.get("remote_write_state") != "confirmed-complete":
        errors.append("schema-2 remote writes are not confirmed complete")
    if receipt.get("verification_state") != "passed":
        errors.append("schema-2 public verification did not pass")
    main = receipt.get("main") if isinstance(receipt.get("main"), dict) else {}
    tag = receipt.get("tag") if isinstance(receipt.get("tag"), dict) else {}
    release = receipt.get("release") if isinstance(receipt.get("release"), dict) else {}
    intent_main = intent.get("main") if isinstance(intent.get("main"), dict) else {}
    intent_tag = intent.get("tag") if isinstance(intent.get("tag"), dict) else {}
    intent_release = intent.get("release") if isinstance(intent.get("release"), dict) else {}
    if main.get("observed_oid") != intent_main.get("target_oid") or main.get("write_state") != "confirmed-complete" or main.get("read_back") is not True:
        errors.append("schema-2 final main read-back does not match")
    if tag.get("observed_ref_oid") != intent_tag.get("expected_tag_object_oid") or tag.get("peeled_commit") != intent.get("source_commit") or tag.get("write_state") != "confirmed-complete" or tag.get("read_back") is not True:
        errors.append("schema-2 final tag read-back does not match")
    if release.get("body_sha256") != intent_release.get("body_sha256") or release.get("write_state") != "confirmed-complete" or release.get("read_back") is not True:
        errors.append("schema-2 final Release read-back does not match")
    remote_assets = receipt.get("assets") if isinstance(receipt.get("assets"), list) else []
    downloads = receipt.get("downloads") if isinstance(receipt.get("downloads"), list) else []
    if [
        {key: item.get(key) for key in ("name", "role", "size", "sha256")}
        for item in remote_assets if isinstance(item, dict)
    ] != local_assets:
        errors.append("schema-2 final remote asset set does not match")
    if any(
        item.get("write_state") != "confirmed-complete" or item.get("read_back") is not True
        for item in remote_assets if isinstance(item, dict)
    ):
        errors.append("schema-2 final remote assets are not confirmed")
    if [
        {key: item.get(key) for key in ("name", "size", "sha256")}
        for item in downloads if isinstance(item, dict)
    ] != [{key: item[key] for key in ("name", "size", "sha256")} for item in local_assets]:
        errors.append("schema-2 public downloads do not match")
    if any(item.get("matched") is not True for item in downloads if isinstance(item, dict)):
        errors.append("schema-2 public download mismatch was reported")
    validate_result = receipt.get("validate_release")
    if not isinstance(validate_result, dict) or validate_result.get("status") != "valid":
        errors.append("schema-2 target validate-release evidence is not valid")
    smokes = receipt.get("smokes") if isinstance(receipt.get("smokes"), list) else []
    if any(item.get("status") != "passed" for item in smokes if isinstance(item, dict)):
        errors.append("schema-2 public smoke evidence did not pass")
    operations = receipt.get("operations") if isinstance(receipt.get("operations"), list) else []
    if len(operations) == 6 and any(
        item.get("outcome") not in V080_SUCCESS_OUTCOMES or item.get("error") is not None
        for item in operations if isinstance(item, dict)
    ):
        errors.append("schema-2 publication operation graph is not terminal")
    if receipt.get("error") is not None:
        errors.append("schema-2 publication receipt contains an error")
    with contextlib.redirect_stdout(io.StringIO()), contextlib.redirect_stderr(io.StringIO()):
        local_release_status = validate_release(release_dir.resolve(), "json")
    if local_release_status != 0:
        errors.append("local v0.8 release directory does not pass validate-release")
    if platform.python_implementation() != "CPython" or sys.version_info[:2] != (3, 9):
        errors.append("schema-2 final publication validation must execute on CPython 3.9")
    serialized = json.dumps(
        {"intent": intent, "receipt": receipt, "authorization": authorization},
        ensure_ascii=False,
    )
    if contains_secret(serialized):
        errors.append("schema-2 publication evidence contains credential-like material")
    status = "invalid" if errors else "valid"
    if output_format == "json":
        print_json(result_envelope(
            "validate-publication", status,
            profile=V080_PUBLICATION_PROFILE,
            version="0.8.0",
            intent_sha256=canonical_json_sha256(intent),
            authorization_id=(authorization.get("authorization_id") if isinstance(authorization, dict) else None),
            host_operation_id=receipt.get("host_operation_id"),
            release_directory=str(release_dir.resolve()),
            errors=errors,
            remote_write_state=receipt.get("remote_write_state"),
            verification_state=receipt.get("verification_state"),
            execution={
                "observed_at": utc_now(),
                "interpreter": {
                    "implementation": platform.python_implementation(),
                    "major": sys.version_info.major,
                    "minor": sys.version_info.minor,
                    "patch": sys.version_info.micro,
                    "platform": platform.platform(),
                    "executable_name": Path(sys.executable).name,
                },
            },
            host_evidence_authenticated=False,
            network_used=False,
        ))
    elif errors:
        for error in errors:
            print(f"ERROR: {error}", file=sys.stderr)
    else:
        print("Vibe Kit v0.8.0 publication validation passed.")
        print("Host evidence is structurally consistent; GitHub authenticity remains a live-host fact.")
    return 1 if errors else 0


def validate_publication(
    intent_path: Path,
    receipt_path: Path,
    release_dir: Path,
    authorization_path: Optional[Path],
    output_format: str,
) -> int:
    intent = load_json_object_strict(intent_path)
    schema = intent.get("schema_version")
    if schema == 1:
        if authorization_path is not None:
            raise VibeError("historical schema-1 validation does not accept --authorization")
        return validate_publication_v1(intent_path, receipt_path, release_dir, output_format)
    if schema == 2:
        return validate_publication_v2(
            intent_path, receipt_path, release_dir, authorization_path, output_format
        )
    raise VibeError("publication intent schema/profile is unsupported")


def utc_now() -> str:
    return dt.datetime.now(dt.timezone.utc).replace(microsecond=0).isoformat().replace(
        "+00:00", "Z"
    )


def feedback_project_name(target: Path) -> str:
    config = target / ".vibe/project.yaml"
    if not config.is_file():
        return target.name
    for line in config.read_text(encoding="utf-8", errors="ignore").splitlines():
        match = re.match(r"^\s{2}name:\s*(.+?)\s*$", line)
        if not match:
            continue
        raw = match.group(1)
        try:
            return str(json.loads(raw))
        except json.JSONDecodeError:
            return raw.strip("'\"")
    return target.name


def feedback_state_root(target: Path, create: bool = False) -> Path:
    root = target / FEEDBACK_ROOT
    if create:
        root.mkdir(parents=True, exist_ok=True)
        local_root = root.parent
        ignore = local_root / ".gitignore"
        if not ignore.exists():
            atomic_write_text(ignore, "*\n!.gitignore\n")
    return root


def feedback_redact_text(
    value: object, target: Path, field: str, required: bool = True
) -> Tuple[str, List[str]]:
    if not isinstance(value, str):
        raise VibeError(f"feedback field {field!r} must be a string")
    text = value.strip()
    if required and not text:
        raise VibeError(f"feedback field {field!r} is required")
    if len(text) > 2000 or text.count("\n") > 4:
        raise VibeError(
            f"feedback field {field!r} is too large; summarize instead of including raw logs or code"
        )
    for pattern in SECRET_PATTERNS:
        if pattern.search(text):
            raise VibeError(
                f"feedback field {field!r} appears to contain a secret; public feedback is blocked"
            )

    redactions: List[str] = []

    def replace(pattern: re.Pattern, replacement: str, kind: str) -> None:
        nonlocal text
        text, count = pattern.subn(replacement, text)
        redactions.extend([kind] * count)

    target_text = str(target.resolve())
    if target_text and target_text in text:
        text = text.replace(target_text, "<PROJECT_ROOT>")
        redactions.append("absolute_path")

    project_name = feedback_project_name(target)
    for private_name in (project_name, target.name):
        if len(private_name) >= 4 and private_name.lower() in text.lower():
            text, count = re.subn(
                re.escape(private_name), "<PROJECT>", text, flags=re.IGNORECASE
            )
            redactions.extend(["project_identity"] * count)

    replace(
        re.compile(
            r"(?<![A-Za-z0-9])/(?:Users|home|private|var|opt|tmp)(?:/[^\s,;]+)+"
        ),
        "<ABSOLUTE_PATH>",
        "absolute_path",
    )
    replace(
        re.compile(r"\b[A-Za-z]:\\(?:[^\s,;]+\\)*[^\s,;]+"),
        "<ABSOLUTE_PATH>",
        "absolute_path",
    )
    replace(
        re.compile(r"\b[A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,}\b", re.IGNORECASE),
        "<EMAIL>",
        "email",
    )
    replace(re.compile(r"https?://[^\s)\]>]+", re.IGNORECASE), "<URL>", "url")
    replace(
        re.compile(r"(?<!\d)(?:\+?\d[\d -]{8,}\d)(?!\d)"),
        "<PHONE>",
        "phone",
    )
    return text, redactions


def feedback_redact_list(
    value: object, target: Path, field: str
) -> Tuple[List[str], List[str]]:
    if value is None:
        return [], []
    if not isinstance(value, list) or len(value) > 5:
        raise VibeError(f"feedback field {field!r} must be a list with at most 5 items")
    sanitized: List[str] = []
    redactions: List[str] = []
    for index, item in enumerate(value):
        clean, found = feedback_redact_text(item, target, f"{field}[{index}]")
        sanitized.append(clean)
        redactions.extend(found)
    return sanitized, redactions


def feedback_fingerprint(signal: Dict[str, object]) -> str:
    raw = "|".join(
        str(signal.get(key, ""))
        for key in ("kind", "component", "summary", "expected")
    ).lower()
    normalized = re.sub(r"[^a-z0-9<>]+", " ", raw).strip()
    return "sha256:" + hashlib.sha256(normalized.encode("utf-8")).hexdigest()


def feedback_preview(report: Dict[str, object], state: Dict[str, object]) -> str:
    signal = report["signal"]
    environment = report["environment"]
    privacy = report["privacy"]
    dedup = report["dedup"]
    reproduction = signal.get("reproduction", [])
    evidence = signal.get("evidence", [])
    lines = [
        f"## Summary\n\n{signal['summary']}",
        f"## Expected\n\n{signal['expected']}",
        f"## Observed\n\n{signal['observed']}",
        f"## Impact\n\n{signal['impact']}",
        f"## Hypothesis\n\n{signal['hypothesis']}",
        f"## Proposed iteration\n\n{signal['proposal']}",
    ]
    if reproduction:
        lines.append(
            "## Generic reproduction\n\n"
            + "\n".join(f"{index}. {item}" for index, item in enumerate(reproduction, 1))
        )
    if evidence:
        lines.append(
            "## Sanitized evidence\n\n" + "\n".join(f"- {item}" for item in evidence)
        )
    lines.extend(
        (
            "## Classification\n\n"
            f"- Kind: `{signal['kind']}`\n"
            f"- Component: `{signal['component']}`\n"
            f"- Severity: `{signal['severity']}`\n"
            f"- Confidence: `{signal['confidence']}`\n"
            f"- Trigger: `{signal['trigger']}`\n"
            f"- Occurrences in this project: `{state.get('occurrence_count', 1)}`",
            "## Minimal environment\n\n"
            f"- Vibe Kit: `{environment['vibe_kit_version']}`\n"
            f"- Workflow: `{environment['workflow']}`\n"
            f"- Agent role: `{environment['agent_role']}`\n"
            f"- Runtime: `{environment['runtime']}`\n"
            f"- Platform family: `{environment['platform_family']}`",
            "## Privacy\n\n"
            f"- Status: `{privacy['status']}`\n"
            f"- Public submission: `{privacy.get('public_submission', 'allowed')}`\n"
            "- Raw code, logs, prompts, conversations and environment values are not included.",
            f"<!-- vibe-kit-feedback:fingerprint={dedup['fingerprint']} -->",
        )
    )
    return "\n\n".join(lines) + "\n"


def feedback_input(args: argparse.Namespace) -> Dict[str, object]:
    if args.input:
        try:
            raw = sys.stdin.read() if args.input == "-" else Path(args.input).read_text(
                encoding="utf-8"
            )
            value = json.loads(raw)
        except (OSError, json.JSONDecodeError) as error:
            raise VibeError(f"cannot read feedback input: {error}") from error
        if not isinstance(value, dict):
            raise VibeError("feedback input must be a JSON object")
        return value
    return {
        "kind": args.kind,
        "component": args.component,
        "title": args.title,
        "summary": args.summary,
        "expected": args.expected,
        "observed": args.observed,
        "impact": args.impact,
        "hypothesis": args.hypothesis,
        "proposal": args.proposal,
        "reproduction": args.reproduction,
        "evidence": args.evidence,
        "workflow": args.workflow,
        "agent_role": args.agent_role,
        "severity": args.severity,
        "confidence": args.confidence,
        "trigger": args.trigger,
        "security_sensitive": bool(getattr(args, "security_sensitive", False)),
    }


def feedback_revision_input(args: argparse.Namespace) -> Dict[str, object]:
    if not args.input:
        raise VibeError("feedback revise requires --input with a JSON object")
    try:
        raw = (
            sys.stdin.read()
            if args.input == "-"
            else Path(args.input).read_text(encoding="utf-8")
        )
        value = json.loads(raw)
    except (OSError, json.JSONDecodeError) as error:
        raise VibeError(f"cannot read feedback revision input: {error}") from error
    if not isinstance(value, dict):
        raise VibeError("feedback revision input must be a JSON object")
    return value


def feedback_build_report(target: Path, raw: Dict[str, object]) -> Dict[str, object]:
    kind = str(raw.get("kind", ""))
    severity = str(raw.get("severity", "medium"))
    confidence = str(raw.get("confidence", "medium"))
    if kind not in FEEDBACK_KINDS:
        raise VibeError(f"feedback kind must be one of: {', '.join(FEEDBACK_KINDS)}")
    if severity not in FEEDBACK_SEVERITIES:
        raise VibeError(
            f"feedback severity must be one of: {', '.join(FEEDBACK_SEVERITIES)}"
        )
    if confidence not in FEEDBACK_CONFIDENCE:
        raise VibeError(
            f"feedback confidence must be one of: {', '.join(FEEDBACK_CONFIDENCE)}"
        )
    security_sensitive = raw.get("security_sensitive", False)
    if not isinstance(security_sensitive, bool):
        raise VibeError("feedback field 'security_sensitive' must be a boolean")

    redactions: List[str] = []
    signal: Dict[str, object] = {
        "kind": kind,
        "severity": severity,
        "confidence": confidence,
    }
    for key in (
        "component",
        "title",
        "summary",
        "expected",
        "observed",
        "impact",
        "hypothesis",
        "proposal",
        "trigger",
    ):
        clean, found = feedback_redact_text(raw.get(key, ""), target, key)
        signal[key] = clean
        redactions.extend(found)
    reproduction, found = feedback_redact_list(raw.get("reproduction"), target, "reproduction")
    signal["reproduction"] = reproduction
    redactions.extend(found)
    evidence, found = feedback_redact_list(raw.get("evidence"), target, "evidence")
    signal["evidence"] = evidence
    redactions.extend(found)

    environment: Dict[str, str] = {}
    defaults = {
        "workflow": "unspecified",
        "agent_role": "unspecified",
        "runtime": f"Python {sys.version_info.major}.{sys.version_info.minor}",
        "platform_family": platform.system() or "Unknown",
    }
    for key, default in defaults.items():
        clean, found = feedback_redact_text(raw.get(key, default), target, key)
        environment[key] = clean
        redactions.extend(found)
    environment["vibe_kit_version"] = framework_version(target)

    counts: Dict[str, int] = {}
    for item in redactions:
        counts[item] = counts.get(item, 0) + 1
    fingerprint = feedback_fingerprint(signal)
    return {
        "schema_version": FEEDBACK_SCHEMA_VERSION,
        "created_at": utc_now(),
        "signal": signal,
        "environment": environment,
        "privacy": {
            "policy": "strict",
            "raw_evidence_persisted": False,
            "status": "redacted" if counts else "clean",
            "public_submission": "blocked" if security_sensitive else "allowed",
            "block_reason": "security-sensitive" if security_sensitive else None,
            "redactions": [
                {"class": key, "count": counts[key]} for key in sorted(counts)
            ],
        },
        "dedup": {"fingerprint": fingerprint, "local": "unique"},
    }


def feedback_record_paths(target: Path, report_id: str) -> Tuple[Path, Path, Path]:
    if not re.fullmatch(r"fb-[0-9]{8}t[0-9]{6}z-[a-f0-9]{8}", report_id):
        raise VibeError(f"invalid feedback report id: {report_id}")
    root = feedback_state_root(target) / report_id
    return root / "report.json", root / "preview.md", root / "state.json"


def load_feedback_record(
    target: Path, report_id: str
) -> Tuple[Dict[str, object], Dict[str, object], Path]:
    report_path, _, state_path = feedback_record_paths(target, report_id)
    if not report_path.is_file() or not state_path.is_file():
        raise VibeError(f"feedback report not found: {report_id}")
    try:
        report = json.loads(report_path.read_text(encoding="utf-8"))
        state = json.loads(state_path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as error:
        raise VibeError(f"cannot read feedback report {report_id}: {error}") from error
    if not isinstance(report, dict) or not isinstance(state, dict):
        raise VibeError(f"invalid feedback report: {report_id}")
    state = normalize_feedback_state(state)
    return report, state, report_path.parent


def feedback_attention(
    status: str, reason: str, revision: int = 1
) -> Dict[str, object]:
    return {
        "revision": revision,
        "status": status,
        "reason": reason,
        "last_presented": None,
    }


def normalize_feedback_state(state: Dict[str, object]) -> Dict[str, object]:
    if state.get("state_schema_version") != FEEDBACK_STATE_SCHEMA_VERSION:
        state["state_schema_version"] = FEEDBACK_STATE_SCHEMA_VERSION
        state["attention"] = feedback_attention("legacy", "legacy")
        return state
    attention = state.get("attention")
    if not isinstance(attention, dict):
        state["attention"] = feedback_attention("legacy", "legacy")
        return state
    revision = attention.get("revision", 1)
    if not isinstance(revision, int) or revision < 1:
        revision = 1
    status = str(attention.get("status", "legacy"))
    if status not in ("pending", "presented", "handled-local", "manual", "legacy"):
        status = "legacy"
    reason = str(attention.get("reason", "legacy"))
    if reason not in ("created", "material-resurface", "revised", "legacy", "manual"):
        reason = "legacy"
    last_presented = attention.get("last_presented")
    if last_presented is not None and not isinstance(last_presented, dict):
        last_presented = None
    state["attention"] = {
        "revision": revision,
        "status": status,
        "reason": reason,
        "last_presented": last_presented,
    }
    return state


def feedback_public_submission_allowed(report: Dict[str, object]) -> bool:
    privacy = report.get("privacy", {})
    return isinstance(privacy, dict) and privacy.get("public_submission", "allowed") == "allowed"


def feedback_upsert(
    target: Path, raw: Dict[str, object], attention_status: str
) -> Tuple[Dict[str, object], Dict[str, object], Path, str]:
    target = target.resolve()
    report = feedback_build_report(target, raw)
    root = feedback_state_root(target, create=True)
    fingerprint = str(report["dedup"]["fingerprint"])
    now = utc_now()
    for candidate in sorted(root.glob("fb-*/report.json")):
        try:
            existing = json.loads(candidate.read_text(encoding="utf-8"))
            state_path = candidate.parent / "state.json"
            state = json.loads(state_path.read_text(encoding="utf-8"))
        except (OSError, json.JSONDecodeError):
            continue
        if not isinstance(existing, dict) or not isinstance(state, dict):
            continue
        existing_dedup = existing.get("dedup")
        existing_signal = existing.get("signal")
        if not isinstance(existing_dedup, dict) or not isinstance(existing_signal, dict):
            continue
        if existing_dedup.get("fingerprint") != fingerprint:
            continue
        state = normalize_feedback_state(state)
        incoming_signal = report["signal"]
        new_evidence = [
            item
            for item in incoming_signal.get("evidence", [])
            if item not in existing_signal.get("evidence", [])
        ]
        severity_increased = SEVERITY_RANK[str(incoming_signal["severity"])] > SEVERITY_RANK[
            str(existing_signal["severity"])
        ]
        existing_privacy = existing.get("privacy")
        incoming_privacy = report.get("privacy")
        privacy_upgraded = False
        if isinstance(existing_privacy, dict) and isinstance(incoming_privacy, dict):
            if (
                incoming_privacy.get("public_submission") == "blocked"
                and existing_privacy.get("public_submission", "allowed") != "blocked"
            ):
                existing_privacy["public_submission"] = "blocked"
                existing_privacy["block_reason"] = incoming_privacy.get(
                    "block_reason", "security-sensitive"
                )
                privacy_upgraded = True
            if (
                incoming_privacy.get("status") == "redacted"
                and existing_privacy.get("status") == "clean"
            ):
                existing_privacy["status"] = "redacted"
                existing_privacy["redactions"] = incoming_privacy.get("redactions", [])
                privacy_upgraded = True
        state["occurrence_count"] = int(state.get("occurrence_count", 1)) + 1
        state["last_seen"] = now
        if new_evidence:
            existing_signal["evidence"] = (
                list(existing_signal.get("evidence", [])) + new_evidence
            )[:5]
        if severity_increased:
            existing_signal["severity"] = incoming_signal["severity"]
        material = bool(new_evidence or severity_increased or privacy_upgraded)
        if state.get("status") == "dismissed" and not material:
            atomic_write_json(state_path, state)
            return existing, state, candidate.parent, "suppressed"
        if state.get("status") == "submitted":
            existing_dedup["local"] = "duplicate"
            atomic_write_json(candidate, existing)
            atomic_write_json(state_path, state)
            atomic_write_text(candidate.parent / "preview.md", feedback_preview(existing, state))
            return existing, state, candidate.parent, "submitted"
        if material:
            state["status"] = "review-ready"
            state["dismiss_reason"] = None
            prior_attention = state.get("attention", {})
            revision = int(prior_attention.get("revision", 1)) + 1
            state["attention"] = feedback_attention(
                attention_status, "material-resurface", revision
            )
            state["remote"] = {"status": "not_checked", "matching_issue": None}
            state["submission"] = None
        existing_dedup["local"] = "duplicate"
        atomic_write_json(candidate, existing)
        atomic_write_json(state_path, state)
        atomic_write_text(candidate.parent / "preview.md", feedback_preview(existing, state))
        return existing, state, candidate.parent, "resurfaced" if material else "reused"

    stamp = dt.datetime.now(dt.timezone.utc).strftime("%Y%m%dt%H%M%Sz")
    report_id = f"fb-{stamp}-{fingerprint.split(':', 1)[1][:8]}"
    report["report_id"] = report_id
    state = {
        "state_schema_version": FEEDBACK_STATE_SCHEMA_VERSION,
        "status": "review-ready",
        "occurrence_count": 1,
        "last_seen": now,
        "dismiss_reason": None,
        "remote": {"status": "not_checked", "matching_issue": None},
        "submission": None,
        "attention": feedback_attention(attention_status, "created"),
    }
    report_path, preview_path, state_path = feedback_record_paths(target, report_id)
    report_path.parent.mkdir(parents=True)
    atomic_write_json(report_path, report)
    atomic_write_json(state_path, state)
    atomic_write_text(preview_path, feedback_preview(report, state))
    return report, state, report_path.parent, "created"


def feedback_draft(target: Path, raw: Dict[str, object]) -> int:
    report, state, root, outcome = feedback_upsert(target, raw, "manual")
    report_id = str(report["report_id"])
    if outcome == "created":
        print(f"Feedback draft ready: {report_id}")
        print(f"Preview: {root / 'preview.md'}")
        print(f"Privacy: {report['privacy']['status']}")
    elif outcome == "suppressed":
        print(f"Feedback suppressed by prior dismissal: {report_id}")
    elif outcome == "resurfaced":
        print(f"Feedback resurfaced with material change: {report_id}")
        print(f"Occurrences: {state['occurrence_count']}")
    elif outcome == "submitted":
        print(f"Feedback already submitted; occurrence recorded: {report_id}")
        print(f"Occurrences: {state['occurrence_count']}")
    else:
        print(f"Feedback reused existing candidate: {report_id}")
        print(f"Occurrences: {state['occurrence_count']}")
    print("Network: not used")
    return 0


def feedback_config(target: Path) -> Dict[str, object]:
    defaults: Dict[str, object] = {
        "github_host": "github.com",
        "github_repository": "",
        "labels": [],
    }
    path = target / FEEDBACK_CONFIG_PATH
    if not path.is_file():
        return defaults
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as error:
        raise VibeError(f"cannot read feedback configuration {path}: {error}") from error
    if not isinstance(value, dict):
        raise VibeError(f"invalid feedback configuration: {path}")
    defaults.update(value)
    if not isinstance(defaults.get("labels"), list):
        raise VibeError(f"feedback labels must be a list: {path}")
    return defaults


def feedback_repository(target: Path, explicit: Optional[str]) -> str:
    repository = explicit or str(feedback_config(target).get("github_repository", ""))
    if not repository:
        raise VibeError(
            "No feedback GitHub repository is configured. Local drafting and review remain available; pass --repo owner/repository."
        )
    if not re.fullmatch(r"[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+", repository):
        raise VibeError("feedback repository must use owner/repository form")
    return repository


def feedback_payload(
    target: Path, report: Dict[str, object], state: Dict[str, object], repository: str
) -> Tuple[str, str, List[str], str]:
    if not feedback_public_submission_allowed(report):
        raise VibeError(
            "public submission is blocked for this security-sensitive feedback; revise it for a public channel or keep it local"
        )
    title = f"[Vibe Kit feedback] {report['signal']['title']}"
    body = feedback_preview(report, state)
    labels = [str(item) for item in feedback_config(target).get("labels", [])]
    canonical = json.dumps(
        {"repository": repository, "title": title, "body": body, "labels": labels},
        ensure_ascii=False,
        sort_keys=True,
        separators=(",", ":"),
    )
    review_hash = "sha256:" + hashlib.sha256(canonical.encode("utf-8")).hexdigest()
    return title, body, labels, review_hash


def feedback_list(target: Path) -> int:
    root = feedback_state_root(target.resolve())
    if not root.is_dir():
        print("No feedback candidates.")
        return 0
    found = 0
    for state_path in sorted(root.glob("fb-*/state.json")):
        try:
            state = json.loads(state_path.read_text(encoding="utf-8"))
            report = json.loads((state_path.parent / "report.json").read_text(encoding="utf-8"))
        except (OSError, json.JSONDecodeError):
            continue
        print(
            f"{state_path.parent.name}\t{state.get('status', 'unknown')}\t"
            f"{state.get('occurrence_count', 1)}\t{report.get('signal', {}).get('title', '')}"
        )
        found += 1
    if not found:
        print("No feedback candidates.")
    return 0


def feedback_dedupe_label(state: Dict[str, object]) -> str:
    attention = state.get("attention", {})
    reason = attention.get("reason") if isinstance(attention, dict) else None
    if reason == "material-resurface":
        return "MATERIAL RESURFACE"
    if reason == "revised":
        return "REVISED LOCAL CANDIDATE"
    if state.get("occurrence_count", 1) != 1:
        return "EXISTING LOCAL CANDIDATE"
    return "UNIQUE LOCAL CANDIDATE"


def feedback_mark_presented(
    root: Path,
    state: Dict[str, object],
    repository: Optional[str],
    review_hash: Optional[str],
) -> None:
    attention = state.get("attention", {})
    if not isinstance(attention, dict):
        attention = feedback_attention("legacy", "legacy")
    attention["status"] = "presented"
    attention["last_presented"] = {
        "repository": repository,
        "review_hash": review_hash,
        "presented_at": utc_now(),
        "revision": attention.get("revision", 1),
    }
    state["attention"] = attention
    atomic_write_json(root / "state.json", state)


def feedback_render_review(
    target: Path,
    report_id: str,
    explicit_repo: Optional[str],
    proactive: bool,
) -> int:
    target = target.resolve()
    report, state, root = load_feedback_record(target, report_id)
    repository = explicit_repo or str(feedback_config(target).get("github_repository", ""))
    public_allowed = feedback_public_submission_allowed(report)
    if repository and public_allowed:
        repository = feedback_repository(target, repository)
        title, body, labels, review_hash = feedback_payload(
            target, report, state, repository
        )
    else:
        title = f"[Vibe Kit feedback] {report['signal']['title']}"
        body = feedback_preview(report, state)
        labels = []
        review_hash = None
    feedback_mark_presented(root, state, repository or None, review_hash)
    if proactive:
        print("Vibe Kit feedback READY — local only")
        print()
        print("发现 1 个可复用的 Vibe Kit 改进点。")
    print(f"Report: {report_id}")
    print(f"Target: {repository or '<not configured>'}")
    privacy_status = str(report["privacy"]["status"]).upper()
    if not public_allowed:
        privacy_status += " / PUBLIC SUBMISSION BLOCKED"
    print(f"Privacy: {privacy_status}")
    print(f"Dedupe: {feedback_dedupe_label(state)}")
    print("Remote access: NOT USED")
    print(f"Labels: {', '.join(labels) if labels else '<none>'}")
    if public_allowed and repository:
        print(f"Review hash: {review_hash}")
        print("--- exact GitHub Issue payload ---")
        print(f"Title: {title}\n")
        print(body, end="")
        print("--- end payload ---")
        if proactive:
            print("建议提交这条反馈。回复“提交”即可。")
            print("也可以回复“稍后”“修改”或“忽略”。")
        else:
            print(
                f"To submit after approving this exact payload:\n"
                f"  ./bin/vibe feedback submit {report_id} --repo {repository} --confirm {review_hash}"
            )
    elif not public_allowed:
        print("Review hash: <unavailable: public submission blocked>")
        print("Public payload: BLOCKED")
        print("The sanitized candidate remains local; revise it before any public submission.")
    else:
        print("Review hash: <unavailable: configure --repo owner/repository>")
        print("Public payload: NOT PREPARED")
        print("The sanitized candidate remains local; configure a repository before review.")
        print("No network was used.")
    print("Network: not used")
    return 0


def feedback_review(target: Path, report_id: str, explicit_repo: Optional[str]) -> int:
    return feedback_render_review(target, report_id, explicit_repo, proactive=False)


def feedback_close(target: Path, raw: Dict[str, object]) -> int:
    target = target.resolve()
    mode, _ = feedback_mode(target)
    if mode == "off":
        return 0
    desired_attention = "pending" if mode == "ask" else "handled-local"
    report, state, root, outcome = feedback_upsert(target, raw, desired_attention)
    report_id = str(report["report_id"])
    if mode == "local":
        if outcome not in ("suppressed", "submitted") and state.get("status") == "review-ready":
            attention = state.get("attention", {})
            if isinstance(attention, dict) and attention.get("status") != "legacy":
                attention["status"] = "handled-local"
                state["attention"] = attention
                atomic_write_json(root / "state.json", state)
        if outcome in ("created", "resurfaced"):
            print(f"Feedback saved locally: {report_id}")
            print("Network: not used")
        return 0
    attention = state.get("attention", {})
    if (
        outcome not in ("suppressed", "submitted")
        and isinstance(attention, dict)
        and attention.get("status") == "pending"
    ):
        return feedback_render_review(target, report_id, None, proactive=True)
    return 0


def feedback_revision_raw(report: Dict[str, object]) -> Dict[str, object]:
    signal = report.get("signal", {})
    environment = report.get("environment", {})
    privacy = report.get("privacy", {})
    if not isinstance(signal, dict) or not isinstance(environment, dict):
        raise VibeError("feedback report is malformed and cannot be revised")
    raw = dict(signal)
    raw.update(
        {
            "workflow": environment.get("workflow", "unspecified"),
            "agent_role": environment.get("agent_role", "unspecified"),
            "security_sensitive": isinstance(privacy, dict)
            and privacy.get("public_submission") == "blocked",
        }
    )
    return raw


def feedback_revise(
    target: Path,
    report_id: str,
    explicit_repo: Optional[str],
    changes: Dict[str, object],
) -> int:
    target = target.resolve()
    report, state, root = load_feedback_record(target, report_id)
    if state.get("status") in ("dismissed", "submitted"):
        raise VibeError(f"{state.get('status')} feedback cannot be revised")
    allowed = {
        "kind",
        "component",
        "title",
        "summary",
        "expected",
        "observed",
        "impact",
        "hypothesis",
        "proposal",
        "reproduction",
        "evidence",
        "workflow",
        "agent_role",
        "severity",
        "confidence",
        "trigger",
        "security_sensitive",
    }
    unknown = sorted(set(changes) - allowed)
    if unknown:
        raise VibeError(f"feedback revision contains unsupported fields: {', '.join(unknown)}")
    raw = feedback_revision_raw(report)
    raw.update(changes)
    revised = feedback_build_report(target, raw)
    old_privacy = report.get("privacy", {})
    new_privacy = revised.get("privacy", {})
    if (
        isinstance(old_privacy, dict)
        and isinstance(new_privacy, dict)
        and old_privacy.get("status") == "redacted"
        and new_privacy.get("status") == "clean"
    ):
        new_privacy["status"] = "redacted"
        new_privacy["redactions"] = old_privacy.get("redactions", [])
    revised["report_id"] = report_id
    revised["created_at"] = report.get("created_at", revised["created_at"])
    fingerprint = revised.get("dedup", {}).get("fingerprint")
    feedback_root = feedback_state_root(target)
    for candidate in sorted(feedback_root.glob("fb-*/report.json")):
        if candidate.parent == root:
            continue
        try:
            other = json.loads(candidate.read_text(encoding="utf-8"))
        except (OSError, json.JSONDecodeError):
            continue
        if other.get("dedup", {}).get("fingerprint") == fingerprint:
            raise VibeError(
                f"feedback revision collides with existing candidate {candidate.parent.name}; review that candidate instead"
            )
    prior_attention = state.get("attention", {})
    revision = int(prior_attention.get("revision", 1)) + 1 if isinstance(prior_attention, dict) else 2
    state["status"] = "review-ready"
    state["last_seen"] = utc_now()
    state["remote"] = {"status": "not_checked", "matching_issue": None}
    state["submission"] = None
    state["attention"] = feedback_attention("pending", "revised", revision)
    atomic_write_json(root / "report.json", revised)
    atomic_write_json(root / "state.json", state)
    atomic_write_text(root / "preview.md", feedback_preview(revised, state))
    return feedback_render_review(target, report_id, explicit_repo, proactive=True)


def feedback_gh(target: Path) -> Tuple[str, str]:
    executable = shutil.which("gh")
    if not executable:
        raise VibeError(
            "GitHub CLI is required only for feedback check and submit. The local draft is unchanged."
        )
    host = str(feedback_config(target).get("github_host", "github.com"))
    auth = subprocess.run(
        [executable, "auth", "status", "--hostname", host],
        text=True,
        capture_output=True,
        check=False,
    )
    if auth.returncode != 0:
        raise VibeError(
            f"GitHub CLI is not authenticated for {host}. The local draft is unchanged; run gh auth login --hostname {host}."
        )
    return executable, host


def feedback_remote_duplicate(
    target: Path, report: Dict[str, object], repository: str
) -> Optional[Dict[str, object]]:
    executable, _ = feedback_gh(target)
    fingerprint = str(report["dedup"]["fingerprint"])
    result = subprocess.run(
        [
            executable,
            "issue",
            "list",
            "--repo",
            repository,
            "--state",
            "all",
            "--search",
            fingerprint,
            "--json",
            "number,url,title,state",
            "--limit",
            "10",
        ],
        text=True,
        capture_output=True,
        check=False,
    )
    if result.returncode != 0:
        raise RemoteFeedbackError(
            "GitHub duplicate check failed; verify connectivity, authentication and repository access"
        )
    try:
        issues = json.loads(result.stdout or "[]")
    except json.JSONDecodeError as error:
        raise RemoteFeedbackError("GitHub duplicate response was invalid") from error
    if not isinstance(issues, list):
        raise RemoteFeedbackError("GitHub duplicate response was not a list")
    return issues[0] if issues else None


def feedback_check(target: Path, report_id: str, explicit_repo: Optional[str]) -> int:
    target = target.resolve()
    report, state, root = load_feedback_record(target, report_id)
    if not feedback_public_submission_allowed(report):
        raise VibeError(
            "remote duplicate checking is blocked for security-sensitive feedback"
        )
    repository = feedback_repository(target, explicit_repo)
    try:
        duplicate = feedback_remote_duplicate(target, report, repository)
    except RemoteFeedbackError as error:
        print(f"ERROR: Could not verify remote duplicates: {error}", file=sys.stderr)
        print("No issue was created; the local draft is unchanged.", file=sys.stderr)
        return 1
    state["remote"] = {
        "status": "duplicate" if duplicate else "unique",
        "matching_issue": duplicate,
    }
    if duplicate and state.get("status") == "submission-unknown":
        state["status"] = "submitted"
        state["submission"] = {
            "result": "existing",
            "repository": repository,
            "url": duplicate.get("url"),
        }
    elif not duplicate and state.get("status") == "submission-unknown":
        state["status"] = "review-ready"
        state["submission"] = {
            "result": "checked-unique-after-unknown",
            "repository": repository,
        }
    atomic_write_json(root / "state.json", state)
    if duplicate:
        print(f"Feedback already covered by {duplicate.get('url', '<unknown URL>')}")
        print("No new issue was created.")
    else:
        print(f"Remote duplicate check: unique in {repository}")
    return 0


def feedback_submit(
    target: Path,
    report_id: str,
    explicit_repo: Optional[str],
    confirm: Optional[str],
) -> int:
    target = target.resolve()
    report, state, root = load_feedback_record(target, report_id)
    if state.get("status") == "dismissed":
        raise VibeError("dismissed feedback cannot be submitted; create or resurface evidence first")
    if state.get("status") == "submission-unknown":
        raise VibeError(
            "feedback submission outcome is uncertain; run feedback check before any retry"
        )
    if not feedback_public_submission_allowed(report):
        raise VibeError(
            "public submission is blocked for this security-sensitive feedback; no network was used"
        )
    repository = feedback_repository(target, explicit_repo)
    title, body, labels, review_hash = feedback_payload(target, report, state, repository)
    if not confirm or confirm != review_hash:
        raise VibeError(
            "feedback confirmation is missing or stale; run feedback review for this repository and confirm its exact review hash"
        )

    print(f"Target: {repository}")
    print(f"Review hash: {review_hash}")
    print("--- exact GitHub payload ---")
    print(f"Title: {title}\n")
    print(body, end="")
    print("--- end payload ---")

    try:
        duplicate = feedback_remote_duplicate(target, report, repository)
    except RemoteFeedbackError as error:
        state["status"] = "submit-failed"
        state["submission"] = {
            "result": "duplicate-check-failed",
            "category": "remote-duplicate-check",
        }
        atomic_write_json(root / "state.json", state)
        print(f"ERROR: Could not verify remote duplicates: {error}", file=sys.stderr)
        print("No issue was created; retry with the same reviewed hash.", file=sys.stderr)
        return 1
    if duplicate:
        state["status"] = "submitted"
        state["submission"] = {
            "result": "existing",
            "repository": repository,
            "url": duplicate.get("url"),
        }
        atomic_write_json(root / "state.json", state)
        print(f"Feedback already covered by {duplicate.get('url', '<unknown URL>')}")
        print("No new issue was created.")
        return 0

    executable, _ = feedback_gh(target)
    command = [
        executable,
        "issue",
        "create",
        "--repo",
        repository,
        "--title",
        title,
        "--body-file",
        "-",
    ]
    for label in labels:
        command.extend(("--label", label))
    result = subprocess.run(
        command,
        input=body,
        text=True,
        capture_output=True,
        check=False,
    )
    if result.returncode != 0:
        state["status"] = "submission-unknown"
        state["submission"] = {
            "result": "unknown",
            "repository": repository,
            "category": "remote-create",
        }
        atomic_write_json(root / "state.json", state)
        print("ERROR: GitHub issue creation failed or its result is uncertain.", file=sys.stderr)
        print("Search by fingerprint before retrying; the local report is preserved.", file=sys.stderr)
        return 1
    urls = re.findall(r"https://[^\s]+", result.stdout)
    if not urls:
        state["status"] = "submission-unknown"
        state["submission"] = {"result": "unknown", "repository": repository}
        atomic_write_json(root / "state.json", state)
        print("ERROR: GitHub did not return an issue URL; verify before retrying.", file=sys.stderr)
        return 1
    issue_url = urls[-1]
    state["status"] = "submitted"
    state["submission"] = {
        "result": "created",
        "repository": repository,
        "url": issue_url,
        "review_hash": review_hash,
    }
    atomic_write_json(root / "state.json", state)
    print(f"Feedback submitted: {issue_url}")
    return 0


def feedback_dismiss(target: Path, report_id: str, reason: str) -> int:
    target = target.resolve()
    _, state, root = load_feedback_record(target, report_id)
    clean_reason, _ = feedback_redact_text(reason, target, "dismiss reason")
    state["status"] = "dismissed"
    state["dismiss_reason"] = clean_reason
    attention = state.get("attention")
    if isinstance(attention, dict):
        attention["status"] = "handled-local"
        state["attention"] = attention
    atomic_write_json(root / "state.json", state)
    print(f"Feedback dismissed: {report_id}")
    print("The same low-severity fingerprint will stay suppressed until material evidence changes.")
    return 0


def add_feedback_signal_arguments(parser: argparse.ArgumentParser) -> None:
    parser.add_argument("--target", default=".")
    parser.add_argument(
        "--input", help="JSON input path, or - for stdin; overrides individual fields"
    )
    parser.add_argument("--kind", choices=FEEDBACK_KINDS, default="workflow-gap")
    parser.add_argument("--component", default="other")
    parser.add_argument("--title")
    parser.add_argument("--summary")
    parser.add_argument("--expected")
    parser.add_argument("--observed")
    parser.add_argument("--impact")
    parser.add_argument("--hypothesis")
    parser.add_argument("--proposal")
    parser.add_argument("--reproduction", action="append", default=[])
    parser.add_argument("--evidence", action="append", default=[])
    parser.add_argument("--workflow", default="unspecified")
    parser.add_argument("--agent-role", default="unspecified")
    parser.add_argument("--severity", choices=FEEDBACK_SEVERITIES, default="medium")
    parser.add_argument("--confidence", choices=FEEDBACK_CONFIDENCE, default="medium")
    parser.add_argument("--trigger", default="explicit-user-request")
    parser.add_argument(
        "--security-sensitive",
        action="store_true",
        help="Keep this feedback local and block public submission.",
    )


def add_format_argument(parser: argparse.ArgumentParser) -> None:
    parser.add_argument(
        "--format",
        dest="output_format",
        choices=("text", "json"),
        default="text",
        help="Render the default human-readable result or the versioned Agent JSON result.",
    )


def add_source_arguments(parser: argparse.ArgumentParser) -> None:
    parser.add_argument(
        "--source-type",
        default="local-payload",
        help="Selected payload channel recorded in the installation manifest.",
    )
    parser.add_argument(
        "--source-ref",
        help="Exact selected tag, canonical Release/tag URL, or commit; selection does not imply platform immutability.",
    )
    parser.add_argument(
        "--artifact-sha256",
        help="SHA-256 verified by the invoking Agent for the selected transferred artifact.",
    )


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="vibe", description="Install and operate the Vibe Kit development workflow."
    )
    subparsers = parser.add_subparsers(dest="command", required=True)
    for command in ("init", "adopt"):
        child = subparsers.add_parser(command)
        child.add_argument("target", nargs="?", default=".")
        child.add_argument("--name", help="Project name written during first installation")
        add_format_argument(child)
        add_source_arguments(child)

    upgrade_parser = subparsers.add_parser("upgrade")
    upgrade_parser.add_argument("target", nargs="?", default=".")
    add_format_argument(upgrade_parser)
    add_source_arguments(upgrade_parser)

    recovery_parser = subparsers.add_parser(
        "recover-upgrade",
        description="Recover or finalize one integrity-valid interrupted upgrade transaction.",
    )
    recovery_parser.add_argument("target", nargs="?", default=".")
    add_format_argument(recovery_parser)

    doctor_parser = subparsers.add_parser("doctor")
    doctor_parser.add_argument("target", nargs="?", default=".")
    add_format_argument(doctor_parser)

    takeover_parser = subparsers.add_parser(
        "validate-takeover",
        description="Validate one host-owned takeover result from standard input.",
    )
    add_format_argument(takeover_parser)

    plan_parser = subparsers.add_parser(
        "plan", description="Preview init, adopt, or upgrade without writing files."
    )
    plan_parser.add_argument("operation", choices=("init", "adopt", "upgrade"))
    plan_parser.add_argument("target", nargs="?", default=".")
    add_format_argument(plan_parser)
    add_source_arguments(plan_parser)

    package_parser = subparsers.add_parser(
        "package", description="Build a deterministic unpublished release candidate."
    )
    package_parser.add_argument(
        "--output", type=Path, help="Empty output directory; defaults to dist/vibe-kit-<version>."
    )
    package_parser.add_argument(
        "--status",
        choices=RELEASE_STATUSES,
        default="release-candidate-unpublished",
        help="Release lifecycle status embedded in release-manifest.json.",
    )

    release_parser = subparsers.add_parser(
        "validate-release", description="Verify a local Vibe Kit release candidate."
    )
    release_parser.add_argument("release_dir")
    add_format_argument(release_parser)

    publication_parser = subparsers.add_parser(
        "publication-plan",
        description="Build a canonical offline publication or issue-closeout intent.",
    )
    publication_parser.add_argument(
        "--phase", choices=("publish", "issue-closeout"), required=True
    )
    publication_parser.add_argument("--request", type=Path, required=True)
    publication_parser.add_argument("--candidate", type=Path)
    publication_parser.add_argument("--comparison-candidate", type=Path)
    publication_parser.add_argument("--release-gate-evidence", type=Path)
    add_format_argument(publication_parser)

    publication_validation_parser = subparsers.add_parser(
        "validate-publication",
        description="Validate a host publication receipt and exact local five-asset candidate offline.",
    )
    publication_validation_parser.add_argument("--intent", type=Path, required=True)
    publication_validation_parser.add_argument("--receipt", type=Path, required=True)
    publication_validation_parser.add_argument("--candidate", type=Path, required=True)
    publication_validation_parser.add_argument("--authorization", type=Path)
    add_format_argument(publication_validation_parser)

    verify_parser = subparsers.add_parser("verify")
    verify_parser.add_argument("target", nargs="?", default=".")
    verify_parser.add_argument(
        "--only",
        action="append",
        choices=VERIFY_ORDER,
        default=[],
        help="Run only one configured check; repeat to select more than one.",
    )
    add_format_argument(verify_parser)

    item_parser = subparsers.add_parser("work-item")
    item_parser.add_argument("slug")
    item_parser.add_argument("--target", default=".")
    item_parser.add_argument("--size", choices=("S", "M", "L", "s", "m", "l"), default="M")
    item_parser.add_argument("--title")

    feedback_parser = subparsers.add_parser(
        "feedback", description="Create and optionally submit sanitized Vibe Kit feedback."
    )
    feedback_subparsers = feedback_parser.add_subparsers(
        dest="feedback_command", required=True
    )
    draft_parser = feedback_subparsers.add_parser("draft")
    add_feedback_signal_arguments(draft_parser)
    close_parser = feedback_subparsers.add_parser("close")
    add_feedback_signal_arguments(close_parser)
    mode_parser = feedback_subparsers.add_parser("mode")
    mode_parser.add_argument("--target", default=".")

    list_parser = feedback_subparsers.add_parser("list")
    list_parser.add_argument("--target", default=".")
    for feedback_command in ("review", "check"):
        child = feedback_subparsers.add_parser(feedback_command)
        child.add_argument("report_id")
        child.add_argument("--target", default=".")
        child.add_argument("--repo")
    revise_parser = feedback_subparsers.add_parser("revise")
    revise_parser.add_argument("report_id")
    revise_parser.add_argument("--target", default=".")
    revise_parser.add_argument("--repo")
    revise_parser.add_argument(
        "--input", required=True, help="Partial JSON revision path, or - for stdin"
    )
    submit_parser = feedback_subparsers.add_parser("submit")
    submit_parser.add_argument("report_id")
    submit_parser.add_argument("--target", default=".")
    submit_parser.add_argument("--repo")
    submit_parser.add_argument("--confirm")
    dismiss_parser = feedback_subparsers.add_parser("dismiss")
    dismiss_parser.add_argument("report_id")
    dismiss_parser.add_argument("--target", default=".")
    dismiss_parser.add_argument("--reason", required=True)
    return parser


def main(argv: Optional[Sequence[str]] = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    try:
        if args.command in ("init", "adopt"):
            return install(
                args.command,
                Path(args.target),
                args.name,
                args.output_format,
                args.source_type,
                args.source_ref,
                args.artifact_sha256,
            )
        if args.command == "upgrade":
            return upgrade(
                Path(args.target),
                args.output_format,
                args.source_type,
                args.source_ref,
                args.artifact_sha256,
            )
        if args.command == "recover-upgrade":
            return recover_upgrade(Path(args.target), args.output_format)
        if args.command == "plan":
            return plan(
                args.operation,
                Path(args.target),
                args.output_format,
                args.source_type,
                args.source_ref,
                args.artifact_sha256,
            )
        if args.command == "package":
            return package_release(args.output, args.status)
        if args.command == "validate-release":
            return validate_release(Path(args.release_dir), args.output_format)
        if args.command == "publication-plan":
            return publication_plan(
                args.phase,
                args.request,
                args.candidate,
                args.comparison_candidate,
                args.release_gate_evidence,
                args.output_format,
            )
        if args.command == "validate-publication":
            return validate_publication(
                args.intent,
                args.receipt,
                args.candidate,
                args.authorization,
                args.output_format,
            )
        if args.command == "doctor":
            return doctor(Path(args.target), args.output_format)
        if args.command == "validate-takeover":
            return validate_takeover(source_root(), args.output_format)
        if args.command == "verify":
            return verify(Path(args.target), args.only, args.output_format)
        if args.command == "work-item":
            return work_item(Path(args.target), args.slug, args.size, args.title)
        if args.command == "feedback":
            target = Path(args.target)
            if args.feedback_command == "draft":
                return feedback_draft(target, feedback_input(args))
            if args.feedback_command == "close":
                return feedback_close(target, feedback_input(args))
            if args.feedback_command == "mode":
                return feedback_mode_command(target)
            if args.feedback_command == "list":
                return feedback_list(target)
            if args.feedback_command == "review":
                return feedback_review(target, args.report_id, args.repo)
            if args.feedback_command == "check":
                return feedback_check(target, args.report_id, args.repo)
            if args.feedback_command == "revise":
                return feedback_revise(
                    target,
                    args.report_id,
                    args.repo,
                    feedback_revision_input(args),
                )
            if args.feedback_command == "submit":
                return feedback_submit(
                    target, args.report_id, args.repo, args.confirm
                )
            if args.feedback_command == "dismiss":
                return feedback_dismiss(target, args.report_id, args.reason)
    except VibeError as error:
        if getattr(args, "output_format", "text") == "json":
            write_state = error.write_state
            if args.command == "upgrade":
                print_json(result_envelope(
                    "upgrade", "error", operation="upgrade",
                    target=str(Path(args.target).resolve()), from_version=None,
                    target_version=None, source=None, write_state=write_state,
                    writes_performed=writes_performed(write_state),
                    installation_state="unknown",
                    transaction=transaction_shape(
                        None, "not-applied", "absent", "absent",
                        failure_kind=error.code,
                    ),
                    onboarding_bridge=None, compatibility_migrations=[],
                    summary="Upgrade failed before a target transaction could be proven.",
                    error={"code": error.code, "message": str(error)},
                    next_action={
                        "code": "rerun-upgrade-plan",
                        "detail": "Correct the reported input or state and run a fresh read-only plan.",
                    },
                ))
                return 2
            if args.command == "recover-upgrade":
                print_json(result_envelope(
                    "recover-upgrade", "error",
                    target=str(Path(args.target).resolve()), from_version=None,
                    target_version=None, write_state=write_state,
                    writes_performed=writes_performed(write_state),
                    installation_state="unknown",
                    transaction=transaction_shape(
                        None, "unknown-partial", "invalid", "invalid",
                        failure_kind=error.code,
                    ),
                    error={"code": error.code, "message": str(error)},
                    next_action={
                        "code": "inspect-upgrade-transaction",
                        "detail": "Inspect the target and transaction state without overwriting it.",
                    },
                ))
                return 2
            print_json(
                result_envelope(
                    args.command,
                    "error",
                    operation=getattr(args, "operation", args.command),
                    error={"code": error.code, "message": str(error)},
                    write_state=write_state,
                    writes_performed=writes_performed(write_state),
                    recovery=error.recovery,
                )
            )
            return 2
        print(f"error: {error}", file=sys.stderr)
        return 2
    except (OSError, UnicodeError) as error:
        if getattr(args, "output_format", "text") == "json":
            write_state = "none"
            print_json(
                result_envelope(
                    args.command,
                    "error",
                    operation=getattr(args, "operation", args.command),
                    error={"code": "filesystem_error", "message": str(error)},
                    write_state=write_state,
                    writes_performed=writes_performed(write_state),
                    recovery=None,
                )
            )
            return 2
        print(f"error: {error}", file=sys.stderr)
        return 2
    parser.error("unknown command")
    return 2


if __name__ == "__main__":
    sys.exit(main())
