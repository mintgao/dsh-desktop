def valid_predecessor_migration_mirror(value: object) -> bool:
    """Require the exact closed mirror without Python bool/int equality leaks."""
    return (
        isinstance(value, dict)
        and set(value) == {
            "schema_version", "registry_sha256", "authority", "modes"
        }
        and type(value.get("schema_version")) is int
        and value.get("schema_version") == COMPATIBILITY_MIGRATION_REGISTRY_SCHEMA
        and isinstance(value.get("registry_sha256"), str)
        and value.get("registry_sha256") == PREDECESSOR_MIGRATION_REGISTRY_SHA256
        and isinstance(value.get("authority"), str)
        and value.get("authority") == "target-cli-compiled"
        and isinstance(value.get("modes"), list)
        and value.get("modes") == [
            "create-pending-onboarding-if-absent",
            "replace-and-adopt-complete-set",
        ]
    )


