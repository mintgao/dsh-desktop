{
  "name": "@deepseek-ai/dsh-channel-weixin",
  "description": "WeChat (微信) channel provider over Tencent's iLink Bot API: QR login, one polling client per bot token, a cursor long poll, and chunked outbound sends, all on Node builtins",
  "version": "0.1.5-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/channel/channel-weixin"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/dsh-channel": "workspace:^",
    "@deepseek-ai/dsh-channel-session": "workspace:^",
    "@deepseek-ai/dsh-credentials": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/cordis-plugin-include": "workspace:^",
    "@deepseek-ai/cordis-plugin-loader": "workspace:^",
    "@deepseek-ai/dsh-channel": "workspace:^",
    "@deepseek-ai/dsh-channel-session": "workspace:^",
    "@deepseek-ai/dsh-credentials": "workspace:^",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "workspace:^"
  }
}
